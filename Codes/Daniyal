<!DOCTYPE html>
<!--
  du GEOMARKETING PORTALS & DASHBOARDS — landing page
  ─────────────────────────────────────────────────────────────────
  WHERE TO EDIT (all inside the <script> at the bottom of this file):

    CONFIG            → SharePoint site URL, access-list name, image folder   (set once at deployment)
    ① REPORT_MONTH    → change every month, e.g. "Sep-2026"
    ② POWERBI         → paste new Power BI report links
    ③ GEO_APPS        → add / update / remove ArcGIS & duGIS links per team

  Access is controlled by the SharePoint list named in CONFIG.SP_ACCESS
  (columns: UserEmailID, Role = Admin | Consumer | SME | GLK — a user may have several roles ticked).
  Nothing else in this file needs to change month to month.
-->
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GeoMarketing Portals &amp; Dashboards</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --du:#c724b1;
  --cyan:#00a9ce;
  --navy:#00215b;
  --ink:#07010f;
  --card:rgba(10,6,22,.55);
  --line:rgba(199,36,177,.35);
  --text:#fff;
  --muted:rgba(255,255,255,.72);
  --grad:linear-gradient(120deg,#c724b1 0%,#7c1fa0 48%,#00a9ce 100%);
  --img-bg-dark:url("du-geo-bg-dark.png");
  --img-bg-light:url("du-geo-bg-light.png");
  --img-consumer-dark:url("du-geo-consumer-dark.png");
  --img-consumer-light:url("du-geo-consumer-light.png");
  --img-sme-dark:url("du-geo-sme-dark.png");
  --img-sme-light:url("du-geo-sme-light.png");
  --img-glk-dark:url("du-geo-glk-dark.png");
  --img-glk-light:url("du-geo-glk-light.png");
  --photo:var(--img-bg-dark);
  --veil:linear-gradient(180deg,rgba(4,8,24,.35),rgba(8,0,18,.55));
  --wash:rgba(90,10,80,.4);
}
html[data-theme="light"]{
  --ink:#8ec4d8;
  --card:rgba(0,33,91,.52);            /* navy glass so white text stays readable over the bright map */
  --line:rgba(255,255,255,.28);
  --text:#fff;
  --muted:rgba(255,255,255,.82);
  --cyan:#4fd8f5;
  --photo:var(--img-bg-light);
  --veil:linear-gradient(180deg,rgba(0,40,90,.18),rgba(0,30,70,.34));
  --wash:transparent;
}
html[data-theme="light"] #geoRoot{text-shadow:0 1px 2px rgba(0,20,50,.35)}
html[data-theme="light"] #geoRoot .hero-title h1{text-shadow:0 2px 14px rgba(0,20,60,.55)}
html[data-theme="light"] #geoRoot .hero-title h1 em{text-shadow:none}
html[data-theme="light"] #geoRoot .card i{color:#ff6fe0}
html[data-theme="light"] #geoRoot .tag{background:rgba(79,216,245,.2)}
/* Zero-specificity reset scoped to the portal (":where" keeps it from overriding the rules below) */
:where(#geoRoot,#geoRoot *){box-sizing:border-box;margin:0;padding:0}
/* Neutralise SharePoint core CSS (headings, links, buttons, lists) inside the portal */
#geoRoot h1,#geoRoot h2,#geoRoot h3,#geoRoot h4,#geoRoot p,#geoRoot ul,#geoRoot ol,#geoRoot li,#geoRoot a,#geoRoot b,#geoRoot i,#geoRoot em,#geoRoot strong,#geoRoot span,#geoRoot div,#geoRoot button,#geoRoot select,#geoRoot input,#geoRoot main,#geoRoot header,#geoRoot section{
  font-family:"Plus Jakarta Sans",system-ui,sans-serif;color:inherit;line-height:1.35;text-decoration:none;list-style:none;letter-spacing:normal;text-align:inherit
}
#geoRoot h1,#geoRoot h2,#geoRoot h3,#geoRoot h4,#geoRoot p{font-size:inherit;font-weight:800;color:inherit;margin:0;padding:0}
#geoRoot p{font-weight:inherit}
#geoRoot a:link,#geoRoot a:visited,#geoRoot a:hover,#geoRoot a:focus{color:inherit;text-decoration:none}
#geoRoot button,#geoRoot select{background:transparent;border:0;box-shadow:none;font-size:inherit;min-width:0;min-height:0;line-height:inherit}
#geoRoot ul,#geoRoot li{list-style:none;margin:0;padding:0}
#geoRoot img,#geoRoot svg{border:0;max-width:none}
/* Standalone (opened directly, not inside SharePoint) */
html.geo-demo,html.geo-demo body{height:100%;margin:0}
html.geo-demo body{background:var(--ink);color:var(--text);overflow:hidden;font-family:"Plus Jakarta Sans",system-ui,sans-serif}
html.geo-demo #geoRoot{height:100vh;border-radius:0}
#geoRoot a{color:inherit;text-decoration:none}
#geoRoot button,#geoRoot select{font:inherit;color:inherit}
/* Portal root: lives INSIDE the web part (no full screen by default). */
#geoRoot{
  position:relative;height:82vh;min-height:600px;overflow:hidden;border-radius:18px;isolation:isolate;
  background:var(--ink);color:var(--text);
  font-family:"Plus Jakarta Sans",system-ui,sans-serif;-webkit-font-smoothing:antialiased
}
/* Optional full-screen mode (header button) — covers the SharePoint ribbon/nav. Esc or the button exits. */
html.geo-full #geoRoot{position:fixed;inset:0;z-index:2147483000;height:auto;min-height:0;border-radius:0}
html.geo-full #geoRoot .bg,html.geo-full #geoRoot .fx,html.geo-full #geoRoot .mesh,html.geo-full #geoRoot .scan,html.geo-full #geoRoot #fx,html.geo-full #geoRoot .citynet,html.geo-full #geoRoot .dev{position:fixed}
html.geo-full #geoRoot .bg{inset:-4%}
html.geo-full body{overflow:hidden}
/* SharePoint PAGE EDIT MODE: collapse to a small card so the ribbon / Save button stay reachable */
html.geo-edit #geoRoot{position:relative;inset:auto;height:150px;z-index:1;overflow:hidden;border-radius:14px}
html.geo-edit #geoRoot>*:not(.editnote){display:none!important}
#geoRoot .editnote{display:none}
html.geo-edit #geoRoot .editnote{
  display:flex;align-items:center;gap:16px;height:100%;padding:0 28px;
  background:linear-gradient(120deg,#0b0f2a,#1a0b3a 60%,#3a0a3a);color:#fff;
  font:600 15px/1.4 "Plus Jakarta Sans",system-ui,sans-serif
}
#geoRoot .editnote b{display:block;font-size:20px;letter-spacing:.02em}
#geoRoot .editnote span{display:block;font-weight:500;opacity:.75;font-size:13px;margin-top:4px}
#geoRoot .editnote i{width:14px;height:14px;border-radius:50%;background:#C724B1;box-shadow:0 0 0 6px rgba(199,36,177,.25);flex:none}

#geoRoot .bg{
  position:absolute;inset:0;z-index:0;
  background:var(--photo) center/cover no-repeat,#120018;
  animation:ken 32s ease-in-out infinite alternate
}
#geoRoot .bg:after{
  content:"";position:absolute;inset:0;
  background:var(--veil);pointer-events:none
}
html[data-theme="dark"] #geoRoot .bg{filter:saturate(1.12) brightness(.9) contrast(1.08)}
html[data-theme="light"] #geoRoot .bg{inset:0;animation:none;transform:none;filter:contrast(1.06) saturate(1.05);image-rendering:-webkit-optimize-contrast}
@keyframes ken{from{transform:scale(1)}to{transform:scale(1.1)}}
#geoRoot .fx{position:absolute;inset:0;z-index:0;pointer-events:none;background:
  radial-gradient(900px 400px at 12% -10%,rgba(199,36,177,.32),transparent 60%),
  radial-gradient(700px 380px at 110% 20%,rgba(0,169,206,.26),transparent 55%)}
html[data-theme="light"] #geoRoot .fx{opacity:.35}
#geoRoot .mesh{position:absolute;inset:0;z-index:0;pointer-events:none;opacity:.18;background-image:
  linear-gradient(rgba(0,169,206,.4) 1px,transparent 1px),
  linear-gradient(90deg,rgba(199,36,177,.32) 1px,transparent 1px);background-size:56px 56px;animation:grid 18s linear infinite}
@keyframes grid{to{background-position:56px 56px}}
#geoRoot .scan{position:absolute;inset:0;z-index:0;pointer-events:none;background:repeating-linear-gradient(0deg,transparent 0 2px,rgba(0,169,206,.035) 3px)}
#geoRoot .scan i{position:absolute;left:0;right:0;height:22%;background:linear-gradient(transparent,rgba(199,36,177,.16),transparent);animation:sweep 5.5s linear infinite}
@keyframes sweep{from{top:-25%}to{top:110%}}
#geoRoot #fx{position:absolute;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
#geoRoot .citynet{position:absolute;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
#geoRoot .citynet path{fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.6;stroke:#00a9ce;opacity:0;stroke-dasharray:340;stroke-dashoffset:340;animation:hop 9s ease-in-out infinite}
#geoRoot .citynet .tw{stroke:#c724b1;stroke-dasharray:7 6}
#geoRoot .citynet .h2{animation-delay:1.2s}#geoRoot .citynet .h3{animation-delay:2.2s}#geoRoot .citynet .h4{animation-delay:3.1s}
#geoRoot .citynet .h5{animation-delay:4.2s}#geoRoot .citynet .hub{fill:#fff;stroke:#c724b1;stroke-width:2}
@keyframes hop{
  0%,10%{stroke-dashoffset:320;opacity:0}
  28%,46%{stroke-dashoffset:0;opacity:.85}
  72%,100%{stroke-dashoffset:-320;opacity:0}
}
#geoRoot .citynet .city{fill:#00a9ce;opacity:.55;animation:city 3.4s ease-in-out infinite}
#geoRoot .citynet .city.d{fill:#c724b1}
#geoRoot .citynet .city:nth-child(2){animation-delay:.4s}#geoRoot .citynet .city:nth-child(3){animation-delay:.8s}
@keyframes city{50%{opacity:1;transform:scale(1.35)} }
#geoRoot .pkt{offset-distance:0%;animation:run 9s linear infinite;opacity:0}
#geoRoot .pkt.p2{animation-delay:1.4s}#geoRoot .pkt.p3{animation-delay:2.6s}
@keyframes run{
  0%,12%{opacity:0}
  22%{opacity:1}
  55%{opacity:1}
  68%,100%{opacity:0}
}
html[data-theme="light"] #geoRoot .citynet path{stroke-width:1.7}

#geoRoot .shell{position:relative;z-index:1;height:100%;overflow:auto;display:flex;flex-direction:column;padding:18px}
#geoRoot .nav{
  display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;
  padding:10px 14px 10px 12px;border:1px solid var(--line);border-radius:22px;
  background:var(--card);backdrop-filter:blur(22px)
}
#geoRoot .brand{display:flex;align-items:center;gap:12px}
#geoRoot .du{
  width:58px;height:42px;border-radius:14px;display:grid;place-items:center;
  background:#fff;box-shadow:0 8px 24px rgba(199,36,177,.35)
}
#geoRoot .du svg{width:40px}
#geoRoot .brand-txt b{display:block;font-size:1.02rem;font-weight:800;letter-spacing:-.03em;white-space:nowrap}
@media (max-width:640px){#geoRoot .brand-txt b{font-size:.9rem;white-space:normal}}
#geoRoot .brand-txt span{color:var(--muted);font-size:.72rem;font-weight:700}
#geoRoot .nav-right{display:flex;align-items:center;gap:12px}
#geoRoot .appear{
  display:flex;padding:3px;border-radius:999px;border:1px solid var(--line);background:rgba(0,0,0,.18)
}
html[data-theme="light"] #geoRoot .appear{background:rgba(0,20,60,.35)}
#geoRoot .appear button{
  border:0;background:transparent;padding:7px 14px;border-radius:999px;font-size:.78rem;font-weight:800;cursor:pointer;color:var(--muted)
}
#geoRoot .appear button.on{background:var(--grad);color:#fff}
#geoRoot .minbtn{
  display:flex;align-items:center;gap:7px;padding:8px 13px;border-radius:999px;cursor:pointer;
  border:1px solid var(--line);background:rgba(0,0,0,.18);font-size:.76rem;font-weight:800;color:var(--muted)
}
#geoRoot .minbtn:hover{color:var(--text);border-color:var(--cyan)}
html[data-theme="light"] #geoRoot .minbtn{background:rgba(0,20,60,.35)}
#geoRoot .minbtn .i-max,#geoRoot .minbtn .t-max{display:none}
html:not(.geo-full) #geoRoot .minbtn .i-max,html:not(.geo-full) #geoRoot .minbtn .t-max{display:inline}
html:not(.geo-full) #geoRoot .minbtn .i-min,html:not(.geo-full) #geoRoot .minbtn .t-min{display:none}
#geoRoot .who{display:flex;align-items:center;gap:10px}
#geoRoot .av{
  width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-weight:800;
  background:var(--grad);color:#fff
}
#geoRoot .who strong{display:block;font-size:.82rem}
#geoRoot .who em{font-style:normal;font-size:.7rem;font-weight:700;color:var(--cyan)}

#geoRoot .stage{flex:1;display:flex;flex-direction:column;justify-content:center;padding:22px 4px 8px}
#geoRoot .view{display:none;animation:up .45s ease}
#geoRoot .view.on{display:block}
@keyframes up{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}

#geoRoot .hero-title{margin:6px 0 22px;padding-left:4px}
#geoRoot .hero-title .kicker{display:inline-block;font-size:.68rem;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--cyan);margin-bottom:8px}
#geoRoot .hero-title h1{font-size:clamp(1.7rem,3.4vw,2.9rem);font-weight:800;letter-spacing:-.045em;line-height:1.02}
#geoRoot .hero-title h1 em{font-style:normal;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
#geoRoot .hero-title p{margin-top:8px;font-size:.88rem;font-weight:600;color:var(--muted);max-width:620px}
#geoRoot .heroes{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px;perspective:1600px}
#geoRoot .tile{height:clamp(380px,50vh,540px);min-height:380px;border:0;background:none;padding:0;text-align:left;cursor:pointer}
#geoRoot .tile.hide{display:none}
#geoRoot .flip{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .8s cubic-bezier(.19,1,.22,1)}
#geoRoot .tile:hover .flip,#geoRoot .tile.go .flip{transform:rotateY(180deg)}
#geoRoot .side{
  position:absolute;inset:0;border-radius:28px;overflow:hidden;
  backface-visibility:hidden;-webkit-backface-visibility:hidden;
  border:1px solid rgba(255,255,255,.16);box-shadow:0 30px 60px rgba(0,0,0,.35)
}
#geoRoot .back{transform:rotateY(180deg);background:linear-gradient(180deg,rgba(20,8,28,.92),rgba(8,4,16,.96));color:#fff;display:flex;flex-direction:column;padding:26px}
html[data-theme="light"] #geoRoot .back{background:linear-gradient(180deg,rgba(0,45,110,.94),rgba(0,25,70,.97));color:#fff;border-color:var(--line)}
#geoRoot .shot{position:absolute;inset:0;background-size:cover;background-position:center;transform:scale(1.04);transition:transform 1.1s ease}
#geoRoot .tile:hover .shot{transform:scale(1.14)}
#geoRoot .shot:after{content:"";position:absolute;inset:0;background:var(--wash);mix-blend-mode:color;pointer-events:none}
#geoRoot .t-c .shot{background-image:linear-gradient(180deg,transparent,rgba(8,0,20,.62)),var(--img-consumer-dark)}
#geoRoot .t-s .shot{background-image:linear-gradient(180deg,transparent,rgba(0,20,40,.62)),var(--img-sme-dark)}
#geoRoot .t-g .shot{background-image:linear-gradient(180deg,transparent,rgba(8,0,20,.62)),var(--img-glk-dark)}
html[data-theme="light"] #geoRoot .t-c .shot{background-image:linear-gradient(180deg,transparent,rgba(0,40,70,.38)),var(--img-consumer-light)}
html[data-theme="light"] #geoRoot .t-s .shot{background-image:linear-gradient(180deg,transparent,rgba(0,40,70,.38)),var(--img-sme-light)}
html[data-theme="light"] #geoRoot .t-g .shot{background-image:linear-gradient(180deg,transparent,rgba(0,40,70,.38)),var(--img-glk-light)}
html[data-theme="light"] #geoRoot .shot:after{display:none}
#geoRoot .rim{position:absolute;inset:0;border-radius:28px;padding:1.5px;pointer-events:none;background:var(--grad);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:.75}
#geoRoot .link{position:absolute;left:6%;right:6%;top:14%;height:46%;pointer-events:none}
#geoRoot .link path{fill:none;stroke-width:1.7;stroke-linecap:round;stroke:#64748b;stroke-dasharray:8 7;opacity:.35;animation:linkline 5.2s ease-in-out infinite}
#geoRoot .link circle{transform-box:fill-box;transform-origin:center;animation:linknode 5.2s ease-in-out infinite}
#geoRoot .t-s .link path,#geoRoot .t-s .link circle{animation-delay:.7s}
#geoRoot .t-g .link path,#geoRoot .t-g .link circle{animation-delay:1.3s}
@keyframes linkline{
  0%,16%{stroke:#94a3b8;stroke-dasharray:7 8;stroke-dashoffset:24;opacity:.3}
  38%{stroke:#f59e0b;stroke-dasharray:4 6;stroke-dashoffset:0;opacity:.85}
  58%,82%{stroke:#00a9ce;stroke-dasharray:140 0;stroke-dashoffset:0;opacity:1;filter:drop-shadow(0 0 6px #00a9ce)}
  100%{stroke:#94a3b8;stroke-dasharray:7 8;stroke-dashoffset:24;opacity:.3;filter:none}
}
@keyframes linknode{
  0%,16%{fill:#ef4444;transform:scale(.85)}
  38%{fill:#f59e0b;transform:scale(1)}
  58%,82%{fill:#22c55e;transform:scale(1.15)}
  100%{fill:#ef4444;transform:scale(.85)}
}
#geoRoot .body{position:absolute;inset:auto 0 0;padding:24px;color:#fff}
#geoRoot .idx{position:absolute;top:20px;left:22px;font-size:13px;font-weight:800;letter-spacing:.2em;color:#fff}
#geoRoot .live{position:absolute;top:18px;right:18px;display:flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;background:rgba(0,0,0,.35);backdrop-filter:blur(8px);font-size:.68rem;font-weight:800;color:#fff;min-width:108px}
#geoRoot .dot{width:7px;height:7px;border-radius:50%;background:#ef4444;animation:dotstate 5.2s ease-in-out infinite}
#geoRoot .t-s .dot,#geoRoot .t-s .live b{animation-delay:.7s}
#geoRoot .t-g .dot,#geoRoot .t-g .live b{animation-delay:1.3s}
@keyframes dotstate{
  0%,16%{background:#ef4444;box-shadow:0 0 0 4px rgba(239,68,68,.2)}
  38%{background:#f59e0b;box-shadow:0 0 0 4px rgba(245,158,11,.2)}
  58%,82%{background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.28)}
  100%{background:#ef4444;box-shadow:0 0 0 4px rgba(239,68,68,.2)}
}
#geoRoot .live b{position:relative;display:inline-block;height:1em;width:5.6em}
#geoRoot .live b span{position:absolute;left:0;opacity:0;animation:word 5.2s ease-in-out infinite}
#geoRoot .live .w1{animation-name:w1}#geoRoot .live .w2{animation-name:w2}#geoRoot .live .w3{animation-name:w3}
@keyframes w1{0%,16%{opacity:1}20%,100%{opacity:0}}
@keyframes w2{0%,20%{opacity:0}30%,44%{opacity:1}50%,100%{opacity:0}}
@keyframes w3{0%,52%{opacity:0}58%,82%{opacity:1}90%,100%{opacity:0}}
#geoRoot .body h2{font-size:clamp(2rem,3.2vw,3.1rem);font-weight:800;letter-spacing:-.05em;line-height:1}
#geoRoot .body p{margin-top:8px;color:rgba(255,255,255,.82);font-weight:600}
#geoRoot .stat{margin-top:16px;display:flex;gap:8px;flex-wrap:wrap}
#geoRoot .pill{padding:6px 10px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.16);font-size:.72rem;font-weight:700}
#geoRoot .shine{position:absolute;inset:0;background:linear-gradient(105deg,transparent 40%,rgba(255,255,255,.18) 50%,transparent 60%);transform:translateX(-120%);transition:transform .8s}
#geoRoot .tile:hover .shine{transform:translateX(120%)}

#geoRoot .back h3{font-size:1.6rem;font-weight:800}
#geoRoot .back ul{margin:18px 0 auto;display:flex;flex-direction:column;gap:8px;list-style:none}
#geoRoot .back li{padding:12px 14px;border-radius:14px;background:rgba(199,36,177,.12);border:1px solid rgba(199,36,177,.22);font-size:.86rem;font-weight:700}
#geoRoot .go{margin-top:18px;align-self:flex-start;padding:12px 18px;border-radius:999px;border:0;background:var(--grad);color:#fff;font-weight:800}

#geoRoot .apps{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
#geoRoot .card{
  min-height:118px;padding:16px;border-radius:18px;border:1px solid var(--line);
  background:var(--card);backdrop-filter:blur(16px);display:flex;flex-direction:column;gap:8px;
  transition:transform .2s,box-shadow .2s
}
#geoRoot .card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(199,36,177,.22)}
#geoRoot .tag{width:max-content;padding:4px 8px;border-radius:999px;background:rgba(0,169,206,.16);color:var(--cyan);font-size:.65rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
#geoRoot .card b{font-size:.92rem;line-height:1.35}
#geoRoot .card i{font-style:normal;margin-top:auto;color:var(--du);font-size:.75rem;font-weight:800}

#geoRoot .bar{display:flex;align-items:center;gap:12px;margin-bottom:16px}
#geoRoot .back-btn{border:1px solid var(--line);background:var(--card);border-radius:14px;padding:10px 14px;font-weight:800;cursor:pointer}
#geoRoot .ttl{font-size:1.7rem;font-weight:800;letter-spacing:-.04em}
#geoRoot .block{margin-bottom:22px}
#geoRoot .block h4{font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:10px;font-weight:800}

#geoRoot .sysmsg{display:none;margin:12px 0 0;padding:10px 14px;border-radius:12px;font-size:.78rem;font-weight:700;line-height:1.5;
  background:rgba(239,68,68,.14);border:1px solid rgba(239,68,68,.55);color:#fecaca;word-break:break-all}
#geoRoot .sysmsg.on{display:block}
#geoRoot .sysmsg a{color:#fff;text-decoration:underline}
#geoRoot .noaccess{display:none;max-width:560px;margin:4vh auto 0;padding:32px 30px;border-radius:24px;text-align:center;
  border:1px solid var(--line);background:var(--card);backdrop-filter:blur(18px);animation:up .45s ease}
#geoRoot .noaccess.on{display:block}
#geoRoot .noaccess .lock{width:58px;height:58px;margin:0 auto 14px;border-radius:50%;display:grid;place-items:center;background:var(--grad);color:#fff;box-shadow:0 10px 30px rgba(199,36,177,.35)}
#geoRoot .noaccess h3{font-size:1.45rem;font-weight:800;letter-spacing:-.03em}
#geoRoot .noaccess p{margin-top:10px;font-size:.9rem;font-weight:600;color:var(--muted);line-height:1.5}
#geoRoot .noaccess .owner{margin-top:16px;color:var(--text)}
