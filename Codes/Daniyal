(function(){
  const c=document.getElementById("fx"); if(!c) return;
  const x=c.getContext("2d");
  const dots=[];
  const root=document.getElementById("geoRoot");
  function size(){ c.width=root.clientWidth||innerWidth; c.height=root.clientHeight||innerHeight; }
  size(); window.addEventListener("resize", size);
  for(let i=0;i<70;i++) dots.push({x:Math.random()*c.width,y:Math.random()*c.height,r:Math.random()*1.8+.3,s:Math.random()*.35+.08,c:Math.random()>.5?"rgba(199,36,177,.55)":"rgba(0,169,206,.55)"});
  function tick(){
    x.clearRect(0,0,c.width,c.height);
    dots.forEach(function(d){
      d.y-=d.s; if(d.y<0){ d.y=c.height; d.x=Math.random()*c.width; }
      x.beginPath(); x.arc(d.x,d.y,d.r,0,Math.PI*2); x.fillStyle=d.c; x.fill();
    });
    requestAnimationFrame(tick);
  }
  tick();
})();
</script>
