<!DOCTYPE html>
<!--
  du GEO PORTAL — landing page
  ─────────────────────────────────────────────────────────────────
  WHERE TO EDIT (all inside the <script> at the bottom of this file):

    CONFIG            → SharePoint site URL, access-list name, image folder   (set once at deployment)
    ① REPORT_MONTH    → change every month, e.g. "Sep-2026"
    ② POWERBI         → paste new Power BI report links
    ③ GEO_APPS        → add / update / remove ArcGIS & duGIS links per team

  Access is controlled by the SharePoint list named in CONFIG.SP_ACCESS
  (columns: UserEmailID, Role = Admin | Consumer | SME | GLK).
  Nothing else in this file needs to change month to month.
-->
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>du Geo Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --du:#c724b1;
  --cyan:#00a9ce;
  --navy:#00215b;
  --ink:#07010f;
  --card:rgba(10,6,22,.55);
  --line:rgba(199,36,177,.35);
  --text:#fff;
  --muted:rgba(255,255,255,.72);
  --grad:linear-gradient(120deg,#c724b1 0%,#7c1fa0 48%,#00a9ce 100%);
  --img-bg-dark:url("du-geo-bg-dark.png");
  --img-bg-light:url("du-geo-bg-light.png");
  --img-consumer-dark:url("du-geo-consumer-dark.png");
  --img-consumer-light:url("du-geo-consumer-light.png");
  --img-sme-dark:url("du-geo-sme-dark.png");
  --img-sme-light:url("du-geo-sme-light.png");
  --img-glk-dark:url("du-geo-glk-dark.png");
  --img-glk-light:url("du-geo-glk-light.png");
  --photo:var(--img-bg-dark);
  --veil:linear-gradient(180deg,rgba(4,8,24,.35),rgba(8,0,18,.55));
  --wash:rgba(90,10,80,.4);
}
html[data-theme="light"]{
  --ink:#8ec4d8;
  --card:rgba(210,236,246,.62);
  --line:rgba(0,80,140,.22);
  --text:#00215b;
  --muted:#1a5f7a;
  --photo:var(--img-bg-light);
  --veil:linear-gradient(180deg,rgba(0,80,120,.08),rgba(0,50,90,.22));
  --wash:transparent;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  font-family:"Plus Jakarta Sans",system-ui,sans-serif;
  background:var(--ink);color:var(--text);
  min-height:100vh;overflow:hidden;-webkit-font-smoothing:antialiased
}
a{color:inherit;text-decoration:none}
button,select{font:inherit;color:inherit}
/* Full-page root: sits above the SharePoint ribbon/nav when embedded in a web part */
#geoRoot{
  position:fixed;inset:0;z-index:2147483000;overflow:auto;
  background:var(--ink);color:var(--text);
  font-family:"Plus Jakarta Sans",system-ui,sans-serif;-webkit-font-smoothing:antialiased
}
#geoRoot *{box-sizing:border-box}

.bg{
  position:fixed;inset:-4%;z-index:0;
  background:var(--photo) center/cover no-repeat,#120018;
  animation:ken 32s ease-in-out infinite alternate
}
.bg:after{
  content:"";position:absolute;inset:0;
  background:var(--veil);pointer-events:none
}
html[data-theme="dark"] .bg{filter:saturate(1.12) brightness(.9) contrast(1.08)}
html[data-theme="light"] .bg{inset:0;animation:none;transform:none;filter:contrast(1.06) saturate(1.05);image-rendering:-webkit-optimize-contrast}
@keyframes ken{from{transform:scale(1)}to{transform:scale(1.1)}}
.fx{position:fixed;inset:0;z-index:0;pointer-events:none;background:
  radial-gradient(900px 400px at 12% -10%,rgba(199,36,177,.32),transparent 60%),
  radial-gradient(700px 380px at 110% 20%,rgba(0,169,206,.26),transparent 55%)}
html[data-theme="light"] .fx{opacity:.35}
.mesh{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.18;background-image:
  linear-gradient(rgba(0,169,206,.4) 1px,transparent 1px),
  linear-gradient(90deg,rgba(199,36,177,.32) 1px,transparent 1px);background-size:56px 56px;animation:grid 18s linear infinite}
@keyframes grid{to{background-position:56px 56px}}
.scan{position:fixed;inset:0;z-index:0;pointer-events:none;background:repeating-linear-gradient(0deg,transparent 0 2px,rgba(0,169,206,.035) 3px)}
.scan i{position:absolute;left:0;right:0;height:22%;background:linear-gradient(transparent,rgba(199,36,177,.16),transparent);animation:sweep 5.5s linear infinite}
@keyframes sweep{from{top:-25%}to{top:110%}}
#fx{position:fixed;inset:0;z-index:0;pointer-events:none}
.citynet{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
.citynet path{fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.6;stroke:#00a9ce;opacity:0;stroke-dasharray:340;stroke-dashoffset:340;animation:hop 9s ease-in-out infinite}
.citynet .tw{stroke:#c724b1;stroke-dasharray:7 6}
.citynet .h2{animation-delay:1.2s}.citynet .h3{animation-delay:2.2s}.citynet .h4{animation-delay:3.1s}
.citynet .h5{animation-delay:4.2s}.citynet .hub{fill:#fff;stroke:#c724b1;stroke-width:2}
@keyframes hop{
  0%,10%{stroke-dashoffset:320;opacity:0}
  28%,46%{stroke-dashoffset:0;opacity:.85}
  72%,100%{stroke-dashoffset:-320;opacity:0}
}
.citynet .city{fill:#00a9ce;opacity:.55;animation:city 3.4s ease-in-out infinite}
.citynet .city.d{fill:#c724b1}
.citynet .city:nth-child(2){animation-delay:.4s}.citynet .city:nth-child(3){animation-delay:.8s}
@keyframes city{50%{opacity:1;transform:scale(1.35)} }
.pkt{offset-distance:0%;animation:run 9s linear infinite;opacity:0}
.pkt.p2{animation-delay:1.4s}.pkt.p3{animation-delay:2.6s}
@keyframes run{
  0%,12%{opacity:0}
  22%{opacity:1}
  55%{opacity:1}
  68%,100%{opacity:0}
}
html[data-theme="light"] .citynet path{stroke-width:1.7}

.shell{position:relative;z-index:1;min-height:100vh;display:flex;flex-direction:column;padding:18px}
.nav{
  display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;
  padding:10px 14px 10px 12px;border:1px solid var(--line);border-radius:22px;
  background:var(--card);backdrop-filter:blur(22px)
}
.brand{display:flex;align-items:center;gap:12px}
.du{
  width:58px;height:42px;border-radius:14px;display:grid;place-items:center;
  background:#fff;box-shadow:0 8px 24px rgba(199,36,177,.35)
}
.du svg{width:40px}
.brand-txt b{display:block;font-size:1.02rem;font-weight:800;letter-spacing:-.03em}
.brand-txt span{color:var(--muted);font-size:.72rem;font-weight:700}
.nav-right{display:flex;align-items:center;gap:12px}
.appear{
  display:flex;padding:3px;border-radius:999px;border:1px solid var(--line);background:rgba(0,0,0,.18)
}
html[data-theme="light"] .appear{background:rgba(255,255,255,.45)}
.appear button{
  border:0;background:transparent;padding:7px 14px;border-radius:999px;font-size:.78rem;font-weight:800;cursor:pointer;color:var(--muted)
}
.appear button.on{background:var(--grad);color:#fff}
.who{display:flex;align-items:center;gap:10px}
.av{
  width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-weight:800;
  background:var(--grad);color:#fff
}
.who strong{display:block;font-size:.82rem}
.who em{font-style:normal;font-size:.7rem;font-weight:700;color:var(--cyan)}

.stage{flex:1;display:flex;flex-direction:column;justify-content:center;padding:22px 4px 8px}
.view{display:none;animation:up .45s ease}
.view.on{display:block}
@keyframes up{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}

.heroes{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px;perspective:1600px}
.tile{height:min(58vh,560px);min-height:420px;border:0;background:none;padding:0;text-align:left;cursor:pointer}
.tile.hide{display:none}
.flip{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .8s cubic-bezier(.19,1,.22,1)}
.tile:hover .flip,.tile.go .flip{transform:rotateY(180deg)}
.side{
  position:absolute;inset:0;border-radius:28px;overflow:hidden;
  backface-visibility:hidden;-webkit-backface-visibility:hidden;
  border:1px solid rgba(255,255,255,.16);box-shadow:0 30px 60px rgba(0,0,0,.35)
}
.back{transform:rotateY(180deg);background:linear-gradient(180deg,rgba(20,8,28,.92),rgba(8,4,16,.96));color:#fff;display:flex;flex-direction:column;padding:26px}
html[data-theme="light"] .back{background:linear-gradient(180deg,#d7f3fb,#9fd6ea);color:#00215b;border-color:var(--line)}
.shot{position:absolute;inset:0;background-size:cover;background-position:center;transform:scale(1.04);transition:transform 1.1s ease}
.tile:hover .shot{transform:scale(1.14)}
.shot:after{content:"";position:absolute;inset:0;background:var(--wash);mix-blend-mode:color;pointer-events:none}
.t-c .shot{background-image:linear-gradient(180deg,transparent,rgba(8,0,20,.62)),var(--img-consumer-dark)}
.t-s .shot{background-image:linear-gradient(180deg,transparent,rgba(0,20,40,.62)),var(--img-sme-dark)}
.t-g .shot{background-image:linear-gradient(180deg,transparent,rgba(8,0,20,.62)),var(--img-glk-dark)}
html[data-theme="light"] .t-c .shot{background-image:linear-gradient(180deg,transparent,rgba(0,40,70,.38)),var(--img-consumer-light)}
html[data-theme="light"] .t-s .shot{background-image:linear-gradient(180deg,transparent,rgba(0,40,70,.38)),var(--img-sme-light)}
html[data-theme="light"] .t-g .shot{background-image:linear-gradient(180deg,transparent,rgba(0,40,70,.38)),var(--img-glk-light)}
html[data-theme="light"] .shot:after{display:none}
.rim{position:absolute;inset:0;border-radius:28px;padding:1.5px;pointer-events:none;background:var(--grad);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:.75}
.link{position:absolute;left:6%;right:6%;top:14%;height:46%;pointer-events:none}
.link path{fill:none;stroke-width:1.7;stroke-linecap:round;stroke:#64748b;stroke-dasharray:8 7;opacity:.35;animation:linkline 5.2s ease-in-out infinite}
.link circle{transform-box:fill-box;transform-origin:center;animation:linknode 5.2s ease-in-out infinite}
.t-s .link path,.t-s .link circle{animation-delay:.7s}
.t-g .link path,.t-g .link circle{animation-delay:1.3s}
@keyframes linkline{
  0%,16%{stroke:#94a3b8;stroke-dasharray:7 8;stroke-dashoffset:24;opacity:.3}
  38%{stroke:#f59e0b;stroke-dasharray:4 6;stroke-dashoffset:0;opacity:.85}
  58%,82%{stroke:#00a9ce;stroke-dasharray:140 0;stroke-dashoffset:0;opacity:1;filter:drop-shadow(0 0 6px #00a9ce)}
  100%{stroke:#94a3b8;stroke-dasharray:7 8;stroke-dashoffset:24;opacity:.3;filter:none}
}
@keyframes linknode{
  0%,16%{fill:#ef4444;transform:scale(.85)}
  38%{fill:#f59e0b;transform:scale(1)}
  58%,82%{fill:#22c55e;transform:scale(1.15)}
  100%{fill:#ef4444;transform:scale(.85)}
}
.body{position:absolute;inset:auto 0 0;padding:24px;color:#fff}
.idx{position:absolute;top:20px;left:22px;font-size:13px;font-weight:800;letter-spacing:.2em;color:#fff}
.live{position:absolute;top:18px;right:18px;display:flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;background:rgba(0,0,0,.35);backdrop-filter:blur(8px);font-size:.68rem;font-weight:800;color:#fff;min-width:108px}
.dot{width:7px;height:7px;border-radius:50%;background:#ef4444;animation:dotstate 5.2s ease-in-out infinite}
.t-s .dot,.t-s .live b{animation-delay:.7s}
.t-g .dot,.t-g .live b{animation-delay:1.3s}
@keyframes dotstate{
  0%,16%{background:#ef4444;box-shadow:0 0 0 4px rgba(239,68,68,.2)}
  38%{background:#f59e0b;box-shadow:0 0 0 4px rgba(245,158,11,.2)}
  58%,82%{background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.28)}
  100%{background:#ef4444;box-shadow:0 0 0 4px rgba(239,68,68,.2)}
}
.live b{position:relative;display:inline-block;height:1em;width:5.6em}
.live b span{position:absolute;left:0;opacity:0;animation:word 5.2s ease-in-out infinite}
.live .w1{animation-name:w1}.live .w2{animation-name:w2}.live .w3{animation-name:w3}
@keyframes w1{0%,16%{opacity:1}20%,100%{opacity:0}}
@keyframes w2{0%,20%{opacity:0}30%,44%{opacity:1}50%,100%{opacity:0}}
@keyframes w3{0%,52%{opacity:0}58%,82%{opacity:1}90%,100%{opacity:0}}
.body h2{font-size:clamp(2rem,3.2vw,3.1rem);font-weight:800;letter-spacing:-.05em;line-height:1}
.body p{margin-top:8px;color:rgba(255,255,255,.82);font-weight:600}
.stat{margin-top:16px;display:flex;gap:8px;flex-wrap:wrap}
.pill{padding:6px 10px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.16);font-size:.72rem;font-weight:700}
.shine{position:absolute;inset:0;background:linear-gradient(105deg,transparent 40%,rgba(255,255,255,.18) 50%,transparent 60%);transform:translateX(-120%);transition:transform .8s}
.tile:hover .shine{transform:translateX(120%)}

.back h3{font-size:1.6rem;font-weight:800}
.back ul{margin:18px 0 auto;display:flex;flex-direction:column;gap:8px;list-style:none}
.back li{padding:12px 14px;border-radius:14px;background:rgba(199,36,177,.12);border:1px solid rgba(199,36,177,.22);font-size:.86rem;font-weight:700}
.go{margin-top:18px;align-self:flex-start;padding:12px 18px;border-radius:999px;border:0;background:var(--grad);color:#fff;font-weight:800}

.apps{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
.card{
  min-height:118px;padding:16px;border-radius:18px;border:1px solid var(--line);
  background:var(--card);backdrop-filter:blur(16px);display:flex;flex-direction:column;gap:8px;
  transition:transform .2s,box-shadow .2s
}
.card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(199,36,177,.22)}
.tag{width:max-content;padding:4px 8px;border-radius:999px;background:rgba(0,169,206,.16);color:var(--cyan);font-size:.65rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
.card b{font-size:.92rem;line-height:1.35}
.card i{font-style:normal;margin-top:auto;color:var(--du);font-size:.75rem;font-weight:800}

.bar{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.back-btn{border:1px solid var(--line);background:var(--card);border-radius:14px;padding:10px 14px;font-weight:800;cursor:pointer}
.ttl{font-size:1.7rem;font-weight:800;letter-spacing:-.04em}
.block{margin-bottom:22px}
.block h4{font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:10px;font-weight:800}

.denied{display:none;max-width:460px;margin:12vh auto;padding:28px;border-radius:20px;text-align:center;border:1px solid #ef4444;background:var(--card)}
.denied.on{display:block}
.dev{position:fixed;right:14px;bottom:14px;z-index:6;display:none;gap:8px;align-items:center;padding:10px;border-radius:14px;background:var(--card);border:1px solid var(--line)}
.dev.on{display:flex}
.dev select,.dev button{border:0;border-radius:8px;padding:8px 10px}
.dev select{background:#14081a;color:#fff;border:1px solid var(--line)}
.dev button{background:var(--grad);color:#fff;font-weight:800;cursor:pointer}

@media(max-width:980px){
  body{overflow:auto}
  .heroes{grid-template-columns:1fr}
  .tile{height:280px;min-height:280px}
  .body h2{font-size:2rem}
}
</style>
</head>
<body>
<div id="geoRoot">
<div class="bg"></div>
<div class="fx"></div>
<div class="mesh"></div>
<div class="scan"><i></i></div>
<svg class="citynet" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <path class="h1" d="M560 258 C 500 300 430 332 368 358"/>
  <path class="h2" d="M560 258 C 540 310 518 360 498 398"/>
  <path class="h3 tw" d="M560 258 L 598 236"/>
  <path class="h4 tw" d="M560 258 C 610 230 650 214 692 208"/>
  <path class="h5 tw" d="M560 258 C 620 290 680 300 728 292"/>
  <circle class="hub" cx="560" cy="258" r="6"/>
  <circle class="city" cx="368" cy="358" r="3.5"/>
  <circle class="city d" cx="498" cy="398" r="3.5"/>
  <circle class="city" cx="598" cy="236" r="3"/>
  <circle class="city d" cx="692" cy="208" r="3"/>
  <circle class="city" cx="728" cy="292" r="3"/>
  <circle class="pkt" r="3" fill="#9ae6ff"><animateMotion dur="9s" repeatCount="indefinite" path="M560 258 C 500 300 430 332 368 358"/></circle>
  <circle class="pkt p2" r="3" fill="#ffb3ec"><animateMotion dur="9s" begin="1.2s" repeatCount="indefinite" path="M560 258 C 540 310 518 360 498 398"/></circle>
  <circle class="pkt p3" r="3" fill="#fff"><animateMotion dur="9s" begin="2.2s" repeatCount="indefinite" path="M560 258 C 610 230 650 214 692 208"/></circle>
</svg>
<canvas id="fx"></canvas>

<div class="shell" id="app">
  <header class="nav">
    <div class="brand">
      <div class="du" aria-label="du">
        <svg viewBox="0 0 64 36" fill="none">
          <path d="M14.5 7.2c5.9 0 10 4.1 10 10.8S20.4 28.8 14.5 28.8H8.2V7.2h6.3zm-.2 17.3c3.4 0 5.5-2.3 5.5-6.5s-2.1-6.5-5.5-6.5h-1.7v13h1.7z" fill="#c724b1"/>
          <path d="M37.2 7.2c6.3 0 10.6 4.3 10.6 10.8S43.5 28.8 37.2 28.8h-8.4V7.2h8.4zm-.4 17.3c3.6 0 6-2.4 6-6.5s-2.4-6.5-6-6.5h-2.3v13h2.3z" fill="#00a9ce"/>
        </svg>
      </div>
      <div class="brand-txt">
        <b>Geo Portal</b>
        <span>UAE coverage · sites · buildings</span>
      </div>
    </div>
    <div class="nav-right">
      <div class="appear" role="group" aria-label="Appearance">
        <button type="button" id="btnDark" class="on">Dark</button>
        <button type="button" id="btnLight">Light</button>
      </div>
      <div class="who">
        <div class="av" id="avatar">—</div>
        <div>
          <strong id="userName">Checking access…</strong>
          <em id="userRole">—</em>
        </div>
      </div>
    </div>
  </header>

  <main class="stage">
    <section class="view on" id="view-home">
      <div class="heroes" id="heroes">
        <button class="tile t-c hide" data-seg="consumer" type="button">
          <div class="flip">
            <div class="side">
              <div class="shot"></div>
              <svg class="link" viewBox="0 0 220 120" aria-hidden="true">
                <path d="M28 88 L92 34"/><path d="M92 34 L188 76"/>
                <circle cx="28" cy="88" r="5"/><circle cx="92" cy="34" r="5"/><circle cx="188" cy="76" r="5"/>
              </svg>
              <div class="rim"></div>
              <div class="shine"></div>
              <div class="idx">01</div>
              <div class="live"><i class="dot"></i><b><span class="w1">Offline</span><span class="w2">Linking</span><span class="w3">Connected</span></b></div>
              <div class="body">
                <h2>Consumer</h2>
                <p>BTL coverage and shared buildings</p>
                <div class="stat"><span class="pill" data-count="consumer">geo apps</span><span class="pill">FNE dashboard</span></div>
              </div>
            </div>
            <div class="side back">
              <h3>Consumer</h3>
              <ul>
                <li>BTL Consumer geoportal</li>
                <li>Shared Building duGIS Portal</li>
                <li>FNE Monetization Geo Dashboard</li>
              </ul>
              <div class="go">Enter workspace</div>
            </div>
          </div>
        </button>

        <button class="tile t-s hide" data-seg="sme" type="button">
          <div class="flip">
            <div class="side">
              <div class="shot"></div>
              <svg class="link" viewBox="0 0 220 120" aria-hidden="true">
                <path d="M36 72 L110 28"/><path d="M110 28 L176 86"/>
                <circle cx="36" cy="72" r="5"/><circle cx="110" cy="28" r="5"/><circle cx="176" cy="86" r="5"/>
              </svg>
              <div class="rim"></div>
              <div class="shine"></div>
              <div class="idx">02</div>
              <div class="live"><i class="dot"></i><b><span class="w1">Offline</span><span class="w2">Linking</span><span class="w3">Connected</span></b></div>
              <div class="body">
                <h2>SME</h2>
                <p>XGSPON, fixed, office wireless</p>
                <div class="stat"><span class="pill" data-count="sme">geo apps</span><span class="pill">KPI + FNE dashboards</span></div>
              </div>
            </div>
            <div class="side back">
              <h3>SME</h3>
              <ul>
                <li>XGSPON Building</li>
                <li>SME Fixed Building</li>
                <li>BTL Shared · Office Wireless · Sharjah</li>
                <li>SME KPI · FNE Monetization Dashboards</li>
              </ul>
              <div class="go">Enter workspace</div>
            </div>
          </div>
        </button>

        <button class="tile t-g hide" data-seg="glk" type="button">
          <div class="flip">
            <div class="side">
              <div class="shot"></div>
              <svg class="link" viewBox="0 0 220 120" aria-hidden="true">
                <path d="M24 40 L102 86"/><path d="M102 86 L196 32"/>
                <circle cx="24" cy="40" r="5"/><circle cx="102" cy="86" r="5"/><circle cx="196" cy="32" r="5"/>
              </svg>
              <div class="rim"></div>
