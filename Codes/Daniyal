<script>
// ══════════════════════════════════════════════════════════════════
//  CONFIG — the only block to edit for the client SharePoint
// ══════════════════════════════════════════════════════════════════
const CONFIG = {
  SP_SITE:    "http://sharedspaces:8081/sites/GM",   // SharePoint site URL (blank = auto-detect from the page)
  SP_ACCESS:  "GEO_ACCESS",                          // SharePoint list: UserEmailID (text), Role (Choice, checkboxes = multiple allowed: Admin/Consumer/SME/GLK)
  ASSET_BASE: "/sites/GM/SiteAssets/geo-portal",     // Site Assets folder holding the 8 du-geo-*.png images
  ACCESS_OWNER: { name:"Daniyal Naqash", email:"daniyal.naqash1@du.ae" }   // shown to users without access ("Send email" goes here)
};

window.addEventListener("error", function(e){
  const m = document.getElementById("sysmsg");
  if(m){ m.textContent = "Script error: "+(e.message||e.type); m.classList.add("on"); }
});
const SP_SITE = CONFIG.SP_SITE || (window._spPageContextInfo && _spPageContextInfo.webAbsoluteUrl) || "";
const SP_ACCESS = CONFIG.SP_ACCESS;
const IS_DEMO = location.protocol === "file:" || /^(localhost|127\.0\.0\.1)$/.test(location.hostname);

// Detects SharePoint page-edit mode (web part page or wiki page) so the portal
// does NOT go full-screen while you are editing / saving the page.
const SP_EDIT_MODE = (function(){
  try{
    const f = document.forms[0];
    if(f && f.MSOLayout_InDesignMode && f.MSOLayout_InDesignMode.value === "1") return true;
    if(f && f._wikiPageMode && f._wikiPageMode.value === "Edit") return true;
    if(document.querySelector("#MSOLayout_InDesignMode[value='1'], #_wikiPageMode[value='Edit']")) return true;
    if(window.SP && SP.Ribbon && SP.Ribbon.PageState && SP.Ribbon.PageState.Handlers && SP.Ribbon.PageState.Handlers.isInEditMode && SP.Ribbon.PageState.Handlers.isInEditMode()) return true;
    return /DisplayMode=Design|PageView=Shared|ToolPaneView=|ControlMode=Edit/i.test(location.search);
  }catch(e){ return false; }
})();
if(SP_EDIT_MODE) document.documentElement.classList.add("geo-edit");

// The portal renders INSIDE the web part by default (no full screen).
// Header button "Full screen" expands it over the whole page; the button again or Esc exits.
if(IS_DEMO) document.documentElement.classList.add("geo-demo");
function setFullScreen(on){
  document.documentElement.classList.toggle("geo-full", !!on);
  setTimeout(function(){ window.dispatchEvent(new Event("resize")); }, 50);
}
document.getElementById("btnMin").onclick = function(){
  setFullScreen(!document.documentElement.classList.contains("geo-full"));
};
document.addEventListener("keydown", function(e){ if(e.key === "Escape") setFullScreen(false); });
const note = document.querySelector(".editnote");
if(note) note.onclick = function(){ if(!SP_EDIT_MODE) document.documentElement.classList.remove("geo-edit"); };
const USER = { name:"Demo User", email:"demo@du.ae", role:"Admin" };

(function applyAssetBase(){
  if(IS_DEMO) return;   // local preview keeps images next to this file
  let base = CONFIG.ASSET_BASE;
  if(!base && window._spPageContextInfo) base = _spPageContextInfo.webServerRelativeUrl.replace(/\/+$/,"")+"/SiteAssets/geo-portal";
  if(!base) return;
  base = base.replace(/\/+$/,"");
  const st = document.documentElement.style;
  ["bg-dark","bg-light","consumer-dark","consumer-light","sme-dark","sme-light","glk-dark","glk-light"].forEach(function(k){
    st.setProperty("--img-"+k, 'url("'+base+'/du-geo-'+k+'.png")');
  });
  // Verify the images are really there; if not, show exactly which URL failed.
  const probe = new Image();
  probe.onerror = function(){
    const m = document.getElementById("sysmsg");
    m.innerHTML = 'Images not found. Upload the 8 du-geo-*.png files to Site Assets → geo-portal. Tried: <a href="'+probe.src+'" target="_blank">'+probe.src+'</a>';
    m.classList.add("on");
  };
  probe.src = base+"/du-geo-bg-dark.png";
})();
const META = { consumer:"Consumer", sme:"SME", glk:"GLK" };

// ╔════════════════════════════════════════════════════════════════╗
// ║  MONTHLY UPDATE AREA — everything you change each month is     ║
// ║  in the three sections below (①, ②, ③). Nothing else.          ║
// ╚════════════════════════════════════════════════════════════════╝

// ══════════════════════════════════════════════════════════════════
//  ① REPORT MONTH — change once per month.
//     This text is added to the end of every Power BI dashboard title,
//     e.g.  "SME KPI Dashboard - Aug-2026"
// ══════════════════════════════════════════════════════════════════
const REPORT_MONTH = "Aug-2026";

// ══════════════════════════════════════════════════════════════════
//  ② POWER BI DASHBOARDS — paste the new report link between the quotes.
//
//     HOW TO GET THE LINK: open the report in Power BI in the browser,
//     copy the full address from the address bar, paste it into  url:
//
//     Do NOT change the names FNE_MONETIZATION / SME_KPI / GLK_KPI —
//     the portal uses them to decide which team sees which dashboard.
// ══════════════════════════════════════════════════════════════════
const POWERBI = {

  // Shown to ALL segments (Consumer + SME + GLK)
  FNE_MONETIZATION: {
    title: "FNE 2026 Monetization Geo Dashboard",
    url:   "https://app.powerbi.com/groups/me/reports/0d6dd276-77af-49eb-8bfd-d0ae2a6898b4/ReportSection?experience=power-bi"
  },

  // Shown to SME team only
  SME_KPI: {
    title: "SME KPI Dashboard",
    url:   "https://app.powerbi.com/groups/me/reports/b18e0878-b53f-4310-86df-fd831a6fb3db/ReportSection?ctid=634c271c-fd02-4c16-9c9f-dd50af6f016c&experience=power-bi"
  },

  // Shown to GLK team only
  GLK_KPI: {
    title: "GLK KPI Dashboard",
    url:   "https://app.powerbi.com/groups/me/reports/bec1fc6b-5dd7-4cfa-974b-a5efc42ae812/ReportSection?ctid=634c271c-fd02-4c16-9c9f-dd50af6f016c&experience=power-bi"
  }
};

// ══════════════════════════════════════════════════════════════════
//  ③ GEO APPS (ArcGIS / duGIS) — one line per link, grouped by team.
//
//     TO UPDATE a link : replace the text inside  url: "..."
//     TO ADD a link    : copy any line, paste it below, change title + url
//                        (keep the comma at the end of every line except the last)
//     TO REMOVE a link : delete the whole line
//
//     badge = the small label shown on the card  →  "ArcGIS", "duGIS", "Dashboard"
//     The "N geo apps" number on each big tile updates automatically.
// ══════════════════════════════════════════════════════════════════
const GEO_APPS = {

  // ── CONSUMER team ────────────────────────────────────────────────
  consumer: [
    { badge:"ArcGIS", title:"BTL Consumer geoportal",                   url:"https://du-geomarketing.maps.arcgis.com/apps/instant/basic/index.html?appid=7102497c4a8a415985e8a2f92d9ed6bc" },
    { badge:"duGIS",  title:"Shared Building Geomarketing duGIS Portal", url:"https://dugis.corp.du.ae/Html5Viewer/index.html?viewer=gisportal.DU_gisportal&project=f1e1d6b3d58b4a51b14181f8407bb255&link=559f1363eca9405e981692b8b425b65d_7-Ty_iNbbJhkxZfx" },
    { badge:"duGIS",  title:"FNE - Fixed Expansion Program",                 url:"https://dugis.corp.du.ae/Html5Viewer/index.html?viewer=gisportal.DU_gisportal&project=0b49320193de4ce1987885f5cd13a59e" }   // FNE Consumer Buildings commercialization (Batch53)
  ],

  // ── SME team ─────────────────────────────────────────────────────
  sme: [
    { badge:"ArcGIS", title:"XGSPON Building geoportal",                                       url:"https://du-geomarketing.maps.arcgis.com/apps/instant/basic/index.html?appid=9214446a2ff14293ab66c561fe6cca72" },
    { badge:"ArcGIS", title:"SME Fixed Building geoportal",                                    url:"https://du-geomarketing.maps.arcgis.com/apps/instant/basic/index.html?appid=97f53c979aa74096bb25cb722ad84ae7" },
    { badge:"ArcGIS", title:"BTL Shared geoportal",                                            url:"https://du-geomarketing.maps.arcgis.com/apps/instant/basic/index.html?appid=edd7496df515494e8b24b2001705fac8" },
    { badge:"ArcGIS", title:"Office Wireless geoportal",                                       url:"https://du-geomarketing.maps.arcgis.com/apps/instant/basic/index.html?appid=487777765419480b924de4fc3c0e4e01" },
    { badge:"ArcGIS", title:"Sharjah Prioritized Communities for Office wireless geoportal",   url:"https://du-geomarketing.maps.arcgis.com/apps/instant/basic/index.html?appid=bf9e74ee269249e4af2eb57d7d93dca4" }
  ],

  // ── GLK team ─────────────────────────────────────────────────────
  glk: [
    { badge:"ArcGIS", title:"GLK Connected POIs geoportal", url:"https://du-geomarketing.maps.arcgis.com/apps/instant/interactivelegend/index.html?appid=7f37388cbfa9412a8e9d8e6d791fbf0a" }
  ],

  // ── SHARED — added to the Geo apps of EVERY team (Consumer + SME + GLK) ──
  shared: [
    { badge:"Dashboard", title:"Segment insights per community Dashboard", url:"https://du-geomarketing.maps.arcgis.com/apps/dashboards/c58b2d1040a6412d973840c245015a8a#" }
  ]
};

// ╔════════════════════════════════════════════════════════════════╗
// ║  END OF MONTHLY UPDATE AREA — do not edit below this line       ║
// ╚════════════════════════════════════════════════════════════════╝

// Builds the final link table from the sections above.
// Which Power BI dashboards each team sees:
//   Consumer → FNE
//   SME      → SME KPI + FNE
//   GLK      → GLK KPI + FNE
function pbiCard(item){ return { badge:"Power BI", title:item.title+" - "+REPORT_MONTH, url:item.url }; }
const LINKS = {
  pbi: {
    consumer: [ pbiCard(POWERBI.FNE_MONETIZATION) ],
    sme:      [ pbiCard(POWERBI.SME_KPI), pbiCard(POWERBI.FNE_MONETIZATION) ],
    glk:      [ pbiCard(POWERBI.GLK_KPI), pbiCard(POWERBI.FNE_MONETIZATION) ]
  },
  consumer: GEO_APPS.consumer.concat(GEO_APPS.shared),
  sme:      GEO_APPS.sme.concat(GEO_APPS.shared),
  glk:      GEO_APPS.glk.concat(GEO_APPS.shared)
};

function normRole(r){ return String(r||"").trim().toLowerCase(); }
// USER.role may hold several roles separated by " · " (multi-select Choice column in the list)
function roles(){ return String(USER.role||"").split(/[·,;|]/).map(normRole).filter(Boolean); }
function isAdmin(){ return roles().some(function(r){ return r==="admin"||r==="administrator"||r==="director"; }); }
function can(seg){ return isAdmin() || roles().includes(seg); }
// Accepts a SharePoint Choice value in any shape: "SME", "SME;#GLK", or {results:["SME","GLK"]}
function spChoiceValues(v){
  if(!v) return [];
  if(Array.isArray(v)) return v;
  if(typeof v==="object" && Array.isArray(v.results)) return v.results;
  return String(v).split(/;#|;|,/);
}
function initials(n){ return String(n||"U").split(/\s+/).slice(0,2).map(p=>p[0]||"").join("").toUpperCase(); }
function cardHTML(item){
  return '<a class="card" href="'+item.url+'" target="_blank" rel="noopener"><div class="tag">'+item.badge+'</div><b>'+item.title+'</b><i>Open →</i></a>';
}
function showHome(){
  document.getElementById("view-home").classList.add("on");
  document.getElementById("view-seg").classList.remove("on");
  document.querySelectorAll(".tile").forEach(function(b){ b.classList.remove("go"); });
}
function openSeg(seg){
  if(!can(seg)) return;
  document.getElementById("segTitle").textContent = META[seg];
  const pbi = LINKS.pbi[seg] || [];
  document.getElementById("grid-pbi").innerHTML = pbi.map(cardHTML).join("");
  document.getElementById("segPbiWrap").style.display = pbi.length ? "block" : "none";
  document.getElementById("grid-seg").innerHTML = (LINKS[seg]||[]).map(cardHTML).join("");
  document.getElementById("view-home").classList.remove("on");
  document.getElementById("view-seg").classList.add("on");
}
function render(){
  document.getElementById("noaccess").classList.remove("on");
  document.getElementById("heroes").style.display = "";
  document.getElementById("userName").textContent = USER.name;
  document.getElementById("userRole").textContent = USER.role;
  document.getElementById("avatar").textContent = initials(USER.name);
  document.querySelectorAll(".tile").forEach(function(btn){
    btn.classList.toggle("hide", !can(btn.getAttribute("data-seg")));
  });
  document.querySelectorAll("[data-count]").forEach(function(el){
    const n = (LINKS[el.getAttribute("data-count")]||[]).length;
    el.textContent = n+" geo app"+(n===1?"":"s");
  });
  showHome();
}
// No access / error: keep header + title visible, hide the tiles, show the request-access card
// with a "Send email" button that opens a pre-filled Outlook message to CONFIG.ACCESS_OWNER.
function deny(msg, technical){
  const owner = CONFIG.ACCESS_OWNER || {};
  document.getElementById("userName").textContent = USER.name || "Guest";
  document.getElementById("userRole").textContent = technical ? "Error" : "No access";
  document.getElementById("avatar").textContent = initials(USER.name || "?");
  document.getElementById("heroes").style.display = "none";
  document.getElementById("view-home").classList.add("on");
  document.getElementById("view-seg").classList.remove("on");

  document.getElementById("noaccessTitle").textContent = technical ? "The portal could not verify your access" : "You don't have access yet";
  document.getElementById("noaccessMsg").textContent = technical
    ? msg
    : "Your account"+(USER.email ? " ("+USER.email+")" : "")+" is not on the GeoMarketing Portals & Dashboards access list.";
  document.getElementById("ownerName").textContent = owner.name || "";
  const om = document.getElementById("ownerMail");
  om.textContent = owner.email || ""; om.href = "mailto:"+(owner.email||"");

  const subject = "Access request - GeoMarketing Portals & Dashboards";
  const body = [
    "Hi "+(owner.name||"").split(" ")[0]+",",
    "",
    "Please grant me access to the GeoMarketing Portals & Dashboards.",
    "",
    "Name:  "+(USER.name||""),
    "Email: "+(USER.email||""),
    "Team / segment required (Consumer, SME, GLK): ",
    "Reason: ",
    "",
    technical ? "Portal message: "+msg : "",
    "Page: "+location.href.split("#")[0],
    "",
    "Thanks."
  ].join("\r\n");
  document.getElementById("mailBtn").href = "mailto:"+encodeURIComponent(owner.email||"")+"?subject="+encodeURIComponent(subject)+"&body="+encodeURIComponent(body);
  document.getElementById("noaccess").classList.add("on");
}
function spGet(url, cb){
  const xhr = new XMLHttpRequest();
  xhr.open("GET", url, true);
  xhr.timeout = 20000;
  xhr.setRequestHeader("Accept","application/json;odata=verbose");
  xhr.onreadystatechange = function(){
    if(xhr.readyState!==4) return;
    if(xhr.status>=200 && xhr.status<300){ try{ cb(null, JSON.parse(xhr.responseText)); }catch(e){ cb(e); } }
    else cb(new Error("HTTP "+xhr.status+" — "+url));
  };
  xhr.onerror = function(){ cb(new Error("Network error — "+url)); };
  xhr.ontimeout = function(){ cb(new Error("Timed out — "+url)); };
  xhr.send();
}
function status(t){ document.getElementById("userRole").textContent = t; }
function initAccess(){
  if(IS_DEMO) document.getElementById("dev").classList.add("on");
  if(!SP_SITE){
    if(IS_DEMO){ render(); return; }
    deny("SharePoint site not detected. Set CONFIG.SP_SITE in geo-portal.html.", true); return;
  }
  status("contacting "+SP_SITE.replace(/^https?:\/\//,"")+"…");
  spGet(SP_SITE+"/_api/web/currentuser?$select=Title,Email", function(err, data){
    if(err){
      if(IS_DEMO){ render(); return; }
      deny("Cannot reach SharePoint: "+err.message, true); return;
    }
    if(!data || !data.d){ deny("Unexpected SharePoint response from /_api/web/currentuser.", true); return; }
    USER.email = (data.d.Email||"").trim();
    USER.name = (data.d.Title||"User").trim();
    if(!USER.email){ deny("SharePoint returned no email for "+USER.name+". Add an email to this account or use a different login.", true); return; }
    status("checking "+SP_ACCESS+" for "+USER.email+"…");
    const email = USER.email.replace(/'/g,"''");
    spGet(SP_SITE+"/_api/web/lists/getbytitle('"+SP_ACCESS+"')/items?$select=UserEmailID,Role&$filter=UserEmailID eq '"+email+"'", function(err2, data2){
      if(err2){ deny("Cannot load the "+SP_ACCESS+" list: "+err2.message, true); return; }
      const rows = (data2.d && data2.d.results) || [];
      if(!rows.length){ deny("No access record for "+USER.email+" in "+SP_ACCESS+"."); return; }
      // Merge roles from every matching row (multi-select column and/or several rows per user)
      const found = [];
      rows.forEach(function(r){
        spChoiceValues(r.Role).forEach(function(v){
          v = String(v).trim();
          if(v && !found.some(function(f){ return normRole(f)===normRole(v); })) found.push(v);
        });
      });
      const valid = found.filter(function(v){ return ["admin","administrator","director","consumer","sme","glk"].includes(normRole(v)); });
      if(!valid.length){ deny('Role "'+found.join(", ")+'" is not recognised. Use Admin, Consumer, SME or GLK.'); return; }
      USER.role = valid.join(" · ");
      document.getElementById("dev").classList.remove("on");
      render();
    });
  });
}
function setTheme(mode){
  document.documentElement.setAttribute("data-theme", mode);
  document.getElementById("btnDark").classList.toggle("on", mode==="dark");
  document.getElementById("btnLight").classList.toggle("on", mode==="light");
  try{ localStorage.setItem("geo_theme", mode); }catch(e){}
}

