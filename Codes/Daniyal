<script>
// ══════════════════════════════════════════════════════════════════
//  CONFIG — the only block to edit for the client SharePoint
// ══════════════════════════════════════════════════════════════════
const CONFIG = {
  SP_SITE:    "",             // e.g. "http://sharedspaces:8086/sites/GEO"  — blank = auto-detect from the SharePoint page
  SP_ACCESS:  "GEO_ACCESS",   // SharePoint list with columns: UserEmailID (text), Role (choice)
  ASSET_BASE: ""              // e.g. "/sites/GEO/SiteAssets/geo-portal"  — folder holding the du-geo-*.png files. blank = same folder as this file
};

const SP_SITE = CONFIG.SP_SITE || (window._spPageContextInfo && _spPageContextInfo.webAbsoluteUrl) || "";
const SP_ACCESS = CONFIG.SP_ACCESS;
const IS_DEMO = location.protocol === "file:" || /^(localhost|127\.0\.0\.1)$/.test(location.hostname);
const USER = { name:"Demo User", email:"demo@du.ae", role:"Admin" };

(function applyAssetBase(){
  if(!CONFIG.ASSET_BASE) return;
  const base = CONFIG.ASSET_BASE.replace(/\/+$/,"");
  const st = document.documentElement.style;
  ["bg-dark","bg-light","consumer-dark","consumer-light","sme-dark","sme-light","glk-dark","glk-light"].forEach(function(k){
    st.setProperty("--img-"+k, 'url("'+base+'/du-geo-'+k+'.png")');
  });
})();
const META = { consumer:"Consumer", sme:"SME", glk:"GLK" };

// ╔════════════════════════════════════════════════════════════════╗
// ║  MONTHLY UPDATE AREA — everything you change each month is     ║
// ║  in the three sections below (①, ②, ③). Nothing else.          ║
// ╚════════════════════════════════════════════════════════════════╝

// ══════════════════════════════════════════════════════════════════
//  ① REPORT MONTH — change once per month.
//     This text is added to the end of every Power BI dashboard title,
//     e.g.  "SME KPI Dashboard - Aug-2026"
// ══════════════════════════════════════════════════════════════════
const REPORT_MONTH = "Aug-2026";

// ══════════════════════════════════════════════════════════════════
//  ② POWER BI DASHBOARDS — paste the new report link between the quotes.
//
//     HOW TO GET THE LINK: open the report in Power BI in the browser,
//     copy the full address from the address bar, paste it into  url:
//
//     Do NOT change the names FNE_MONETIZATION / SME_KPI / GLK_KPI —
//     the portal uses them to decide which team sees which dashboard.
// ══════════════════════════════════════════════════════════════════
const POWERBI = {

  // Shown to ALL segments (Consumer + SME + GLK)
  FNE_MONETIZATION: {
    title: "FNE 2026 Monetization Geo Dashboard",
    url:   "https://app.powerbi.com/groups/me/reports/0d6dd276-77af-49eb-8bfd-d0ae2a6898b4/ReportSection?experience=power-bi"
  },

  // Shown to SME team only
  SME_KPI: {
    title: "SME KPI Dashboard",
    url:   "https://app.powerbi.com/groups/me/reports/b18e0878-b53f-4310-86df-fd831a6fb3db/ReportSection?ctid=634c271c-fd02-4c16-9c9f-dd50af6f016c&experience=power-bi"
  },

  // Shown to GLK team only
  GLK_KPI: {
    title: "GLK KPI Dashboard",
    url:   "https://app.powerbi.com/groups/me/reports/bec1fc6b-5dd7-4cfa-974b-a5efc42ae812/ReportSection?ctid=634c271c-fd02-4c16-9c9f-dd50af6f016c&experience=power-bi"
  }
};

// ══════════════════════════════════════════════════════════════════
//  ③ GEO APPS (ArcGIS / duGIS) — one line per link, grouped by team.
//
//     TO UPDATE a link : replace the text inside  url: "..."
//     TO ADD a link    : copy any line, paste it below, change title + url
//                        (keep the comma at the end of every line except the last)
//     TO REMOVE a link : delete the whole line
//
//     badge = the small label shown on the card  →  "ArcGIS", "duGIS", "Dashboard"
//     The "N geo apps" number on each big tile updates automatically.
// ══════════════════════════════════════════════════════════════════
const GEO_APPS = {

  // ── CONSUMER team ────────────────────────────────────────────────
  consumer: [
    { badge:"ArcGIS", title:"BTL Consumer geoportal",                   url:"https://du-geomarketing.maps.arcgis.com/apps/instant/basic/index.html?appid=7102497c4a8a415985e8a2f92d9ed6bc" },
    { badge:"duGIS",  title:"Shared Building Geomarketing duGIS Portal", url:"https://dugis.corp.du.ae/Html5Viewer/index.html?viewer=gisportal.DU_gisportal&project=f1e1d6b3d58b4a51b14181f8407bb255&link=559f1363eca9405e981692b8b425b65d_7-Ty_iNbbJhkxZfx" }
  ],

  // ── SME team ─────────────────────────────────────────────────────
  sme: [
    { badge:"ArcGIS", title:"XGSPON Building geoportal",                                       url:"https://du-geomarketing.maps.arcgis.com/apps/instant/basic/index.html?appid=9214446a2ff14293ab66c561fe6cca72" },
    { badge:"ArcGIS", title:"SME Fixed Building geoportal",                                    url:"https://du-geomarketing.maps.arcgis.com/apps/instant/basic/index.html?appid=97f53c979aa74096bb25cb722ad84ae7" },
    { badge:"ArcGIS", title:"BTL Shared geoportal",                                            url:"https://du-geomarketing.maps.arcgis.com/apps/instant/basic/index.html?appid=edd7496df515494e8b24b2001705fac8" },
    { badge:"ArcGIS", title:"Office Wireless geoportal",                                       url:"https://du-geomarketing.maps.arcgis.com/apps/instant/basic/index.html?appid=487777765419480b924de4fc3c0e4e01" },
    { badge:"ArcGIS", title:"Sharjah Prioritized Communities for Office wireless geoportal",   url:"https://du-geomarketing.maps.arcgis.com/apps/instant/basic/index.html?appid=bf9e74ee269249e4af2eb57d7d93dca4" }
  ],

  // ── GLK team ─────────────────────────────────────────────────────
  glk: [
    { badge:"ArcGIS", title:"GLK Connected POIs geoportal", url:"https://du-geomarketing.maps.arcgis.com/apps/instant/interactivelegend/index.html?appid=7f37388cbfa9412a8e9d8e6d791fbf0a" }
  ],

  // ── GEOMARKETING INTERNAL — shown to every team ──────────────────
  internal: [
    { badge:"Dashboard", title:"Segment insights per community Dashboard", url:"https://du-geomarketing.maps.arcgis.com/apps/dashboards/c58b2d1040a6412d973840c245015a8a#" }
  ]
};

// ╔════════════════════════════════════════════════════════════════╗
// ║  END OF MONTHLY UPDATE AREA — do not edit below this line       ║
// ╚════════════════════════════════════════════════════════════════╝

// Builds the final link table from the sections above.
// Which Power BI dashboards each team sees:
//   Consumer → FNE
//   SME      → SME KPI + FNE
//   GLK      → GLK KPI + FNE
function pbiCard(item){ return { badge:"Power BI", title:item.title+" - "+REPORT_MONTH, url:item.url }; }
const LINKS = {
  pbi: {
    consumer: [ pbiCard(POWERBI.FNE_MONETIZATION) ],
    sme:      [ pbiCard(POWERBI.SME_KPI), pbiCard(POWERBI.FNE_MONETIZATION) ],
    glk:      [ pbiCard(POWERBI.GLK_KPI), pbiCard(POWERBI.FNE_MONETIZATION) ]
  },
  consumer: GEO_APPS.consumer,
  sme:      GEO_APPS.sme,
  glk:      GEO_APPS.glk,
  internal: GEO_APPS.internal
};

function normRole(r){ return String(r||"").trim().toLowerCase(); }
function isAdmin(){ const r=normRole(USER.role); return r==="admin"||r==="administrator"||r==="director"; }
function can(seg){ return isAdmin() || normRole(USER.role)===seg; }
function initials(n){ return String(n||"U").split(/\s+/).slice(0,2).map(p=>p[0]||"").join("").toUpperCase(); }
function cardHTML(item){
  return '<a class="card" href="'+item.url+'" target="_blank" rel="noopener"><div class="tag">'+item.badge+'</div><b>'+item.title+'</b><i>Open →</i></a>';
}
function showHome(){
  document.getElementById("view-home").classList.add("on");
  document.getElementById("view-seg").classList.remove("on");
  document.querySelectorAll(".tile").forEach(function(b){ b.classList.remove("go"); });
}
function openSeg(seg){
  if(!can(seg)) return;
  document.getElementById("segTitle").textContent = META[seg];
  const pbi = LINKS.pbi[seg] || [];
  document.getElementById("grid-pbi").innerHTML = pbi.map(cardHTML).join("");
  document.getElementById("segPbiWrap").style.display = pbi.length ? "block" : "none";
  document.getElementById("grid-seg").innerHTML = (LINKS[seg]||[]).map(cardHTML).join("");
  document.getElementById("grid-internal").innerHTML = LINKS.internal.map(cardHTML).join("");
  document.getElementById("view-home").classList.remove("on");
  document.getElementById("view-seg").classList.add("on");
}
function render(){
  document.getElementById("userName").textContent = USER.name;
  document.getElementById("userRole").textContent = USER.role;
  document.getElementById("avatar").textContent = initials(USER.name);
  document.querySelectorAll(".tile").forEach(function(btn){
    btn.classList.toggle("hide", !can(btn.getAttribute("data-seg")));
  });
  document.querySelectorAll("[data-count]").forEach(function(el){
    const n = (GEO_APPS[el.getAttribute("data-count")]||[]).length;
    el.textContent = n+" geo app"+(n===1?"":"s");
  });
  showHome();
}
function deny(msg){
  document.getElementById("app").style.display="none";
  document.getElementById("denied").classList.add("on");
  document.getElementById("deniedMsg").textContent = msg;
}
function spGet(url, cb){
  const xhr = new XMLHttpRequest();
  xhr.open("GET", url, true);
  xhr.setRequestHeader("Accept","application/json;odata=verbose");
  xhr.onreadystatechange = function(){
    if(xhr.readyState!==4) return;
    if(xhr.status>=200 && xhr.status<300){ try{ cb(null, JSON.parse(xhr.responseText)); }catch(e){ cb(e); } }
    else cb(new Error("HTTP "+xhr.status));
  };
  xhr.onerror = function(){ cb(new Error("Network error")); };
  xhr.send();
}
function initAccess(){
  if(IS_DEMO) document.getElementById("dev").classList.add("on");
  if(!SP_SITE){
    if(IS_DEMO){ render(); return; }
    deny("SharePoint site not detected. Set CONFIG.SP_SITE in geo-portal.html."); return;
  }
  spGet(SP_SITE+"/_api/web/currentuser?$select=Title,Email", function(err, data){
    if(err){
      if(IS_DEMO){ render(); return; }
      deny("Cannot reach SharePoint: "+err.message); return;
    }
    USER.email = (data.d.Email||"").trim();
    USER.name = (data.d.Title||"User").trim();
    const email = USER.email.replace(/'/g,"''");
    spGet(SP_SITE+"/_api/web/lists/getbytitle('"+SP_ACCESS+"')/items?$select=UserEmailID,Role&$filter=UserEmailID eq '"+email+"'", function(err2, data2){
      if(err2){ deny("Cannot load the "+SP_ACCESS+" list: "+err2.message); return; }
      const rows = (data2.d && data2.d.results) || [];
      if(!rows.length){ deny("No access record for "+USER.email+" in "+SP_ACCESS+"."); return; }
      const role = String(rows[0].Role||"").trim();
      if(!["admin","consumer","sme","glk"].includes(normRole(role))){ deny('Role "'+role+'" is not recognised.'); return; }
      USER.role = role;
      document.getElementById("dev").classList.remove("on");
      render();
    });
  });
}
function setTheme(mode){
  document.documentElement.setAttribute("data-theme", mode);
  document.getElementById("btnDark").classList.toggle("on", mode==="dark");
  document.getElementById("btnLight").classList.toggle("on", mode==="light");
  try{ localStorage.setItem("geo_theme", mode); }catch(e){}
}

document.getElementById("heroes").addEventListener("click", function(e){
  const btn = e.target.closest(".tile");
  if(!btn || btn.classList.contains("hide")) return;
  btn.classList.add("go");
  setTimeout(function(){ openSeg(btn.getAttribute("data-seg")); }, 520);
});
document.getElementById("backHome").onclick = showHome;
document.getElementById("devApply").onclick = function(){
  USER.role = document.getElementById("devRole").value;
  USER.name = USER.role+" Team";
  render();
};
document.getElementById("btnDark").onclick = function(){ setTheme("dark"); };
document.getElementById("btnLight").onclick = function(){ setTheme("light"); };
try{ const t=localStorage.getItem("geo_theme"); if(t==="light"||t==="dark") setTheme(t); }catch(e){}
initAccess();

(function(){
  const c=document.getElementById("fx"); if(!c) return;
  const x=c.getContext("2d");
  const dots=[];
  function size(){ c.width=innerWidth; c.height=innerHeight; }
  size(); window.addEventListener("resize", size);
  for(let i=0;i<70;i++) dots.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:Math.random()*1.8+.3,s:Math.random()*.35+.08,c:Math.random()>.5?"rgba(199,36,177,.55)":"rgba(0,169,206,.55)"});
  function tick(){
    x.clearRect(0,0,c.width,c.height);
    dots.forEach(function(d){
      d.y-=d.s; if(d.y<0){ d.y=c.height; d.x=Math.random()*c.width; }
      x.beginPath(); x.arc(d.x,d.y,d.r,0,Math.PI*2); x.fillStyle=d.c; x.fill();
    });
    requestAnimationFrame(tick);
  }
  tick();
})();
</script>
