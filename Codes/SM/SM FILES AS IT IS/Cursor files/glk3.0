const num = v => { const n=parseFloat(v); return isNaN(n)?0:n; };
function fmt(v){
  const n=num(v);
  if(n>=1e9) return (n/1e9).toFixed(2)+'B';
  if(n>=1e6) return (n/1e6).toFixed(2)+'M';
  if(n>=1e3) return (n/1e3).toFixed(1)+'K';
  return n.toFixed(0);
}
function fmtGA(v){ const n=num(v); return n%1===0?n.toFixed(0):n.toFixed(2); }
function fmtExportNum(v){ const n=num(v); return n%1===0?n.toFixed(0):n.toFixed(2); }
function fmtLines(v){ const n=num(v); if(isNaN(n)) return '—'; return Math.round(n).toLocaleString('en-US'); }
const fmtDate = iso => { if(!iso) return '—'; const d=new Date(iso); return isNaN(d)?'—':d.toLocaleDateString('en-GB'); };
  function fmtYearImpact(v) {
  if (v === null || v === undefined) return '—';
  if (v === 0) return 'AED 0';
  if (v >= 1e6) return 'AED ' + (v / 1e6).toFixed(2) + 'M';
  if (v >= 1e3) return 'AED ' + v.toLocaleString('en-US');
  return 'AED ' + v.toFixed(0);
}

function calcYearImpact(bid) {
  const STATUS_SKIP = ['Lost', 'Cancelled', 'No Bid'];
  if (STATUS_SKIP.includes(bid.status)) return { val: null, note: null };
  if (!bid.expectedActivation) return { val: null, note: null };
  const actDate = new Date(bid.expectedActivation);
  if (isNaN(actDate)) return { val: null, note: null };
  const currentYear = new Date().getFullYear();
  const actYear = actDate.getFullYear();
  if (actYear < currentYear) return { val: null, note: null };
  if (actYear > currentYear) return { val: null, note: 'Expected activation in ' + actYear + ' — cannot calculate this year' };
  const monthsRemaining = 12 - actDate.getMonth();
  const impact = bid.mrc * monthsRemaining;
  return { val: impact, note: null };
}
function getInitials(name){ if(!name) return '?'; const p=name.trim().split(' '); return p.length>=2?(p[0][0]+p[p.length-1][0]).toUpperCase():name[0].toUpperCase(); }
function getRelevantDate(bid){
  const s=bid.status;
  const fc=bid.forecastCategory;
  if(s==='Won'||fc==='Closed Won') return bid.contractSigned||bid.billedDate||bid.expectedActivation;
  if(s==='Billed') return bid.billedDate||bid.contractSigned;
  if(STATUS_IP.includes(s)) return bid.expectedActivation||bid.proposedDate;
  if(STATUS_LOST.includes(s)||fc==='Closed Lost') return bid.lostDate||bid.proposedDate;
  return bid.proposedDate||bid.contractSigned||bid.expectedActivation||bid.created;
}
function glkBidMetric(b,k){ return k==='mrc'?b.mrc:k==='tcv'?b.tcv:k==='otc'?b.otc:b.gaPoints; }
function glkFilterByChartPeriod(bids,period){
  var now=new Date();
  return (bids||[]).filter(function(b){
    var iso=getRelevantDate(b);
    if(!iso) return false;
    var d=new Date(iso);
    if(isNaN(d)) return false;
    if(period==='YTD') return d.getFullYear()===now.getFullYear()&&d<=now;
    if(period==='Y') return d.getFullYear()===now.getFullYear();
    if(period==='Q') return d.getFullYear()===now.getFullYear()&&Math.ceil((d.getMonth()+1)/3)===Math.ceil((now.getMonth()+1)/3);
    if(period==='M') return d.getFullYear()===now.getFullYear()&&d.getMonth()===now.getMonth();
    if(period==='W') return d.getFullYear()===now.getFullYear()&&getWeekOfYear(d)===getWeekOfYear(now);
    return true;
  });
}
function glkChartMetricBtns(){
  return ['mrc','tcv'].map(function(m){
    var act=chartMetric===m;
    return '<button type="button" onclick="setChartMetric(\''+m+'\')" style="padding:.25rem .7rem;border-radius:6px;font-size:.72rem;font-weight:700;border:1px solid var(--border);cursor:pointer;background:'+(act?'var(--grad)':'var(--bg-secondary)')+';color:'+(act?'#fff':'var(--t3)')+';">'+(m==='mrc'?'MRC':'TCV')+'</button>';
  }).join('');
}
function glkChartPeriodSelect(id){
  var periods=[{v:'W',l:'This week'},{v:'M',l:'This month'},{v:'Q',l:'This quarter'},{v:'Y',l:'This year'},{v:'YTD',l:'Year to date'}];
  return '<select id="'+id+'" class="fb-select" style="font-size:.72rem;padding:.32rem .55rem;min-width:130px;" onchange="setChartPeriod(this.value)">'+
    periods.map(function(p){return '<option value="'+p.v+'"'+(chartPeriod===p.v?' selected':'')+'>'+p.l+'</option>';}).join('')+
    '</select>';
}
function glkChartControlsHtml(periodSelectId){
  return '<div style="display:flex;justify-content:flex-end;align-items:center;margin-top:.65rem;flex-wrap:wrap;gap:.5rem;">'+
    glkChartMetricBtns()+glkChartPeriodSelect(periodSelectId||'chartPeriodSelectPie')+'</div>';
}
function glkPieExternalLabelsPlugin(groups,total,c){
  return {id:'glkPieExtLabels',afterDraw:function(chart){
    var ctx=chart.ctx,meta=chart.getDatasetMeta(0),ca=chart.chartArea;
    if(!meta||!meta.data||!ca) return;
    var cx=(ca.left+ca.right)/2,cy=(ca.top+ca.bottom)/2;
    var outerR=meta.data[0]?meta.data[0].outerRadius:0;
    var items=[];
    meta.data.forEach(function(arc,i){
      var g=groups[i];
      if(!g||g.value<=0) return;
      var pct=total>0?(g.value/total*100):0;
      var mid=(arc.startAngle+arc.endAngle)/2;
      items.push({g:g,pct:pct,mid:mid,right:Math.cos(mid)>=0});
    });
    var left=items.filter(function(it){return !it.right;}).sort(function(a,b){return a.mid-b.mid;});
    var right=items.filter(function(it){return it.right;}).sort(function(a,b){return a.mid-b.mid;});
    var rowH=26,minGap=4;
    function stackSide(list,side){
      if(!list.length) return;
      var n=list.length;
      var totalH=n*rowH+(n-1)*minGap;
      var startY=cy-totalH/2+rowH/2;
      list.forEach(function(it,idx){
        var ly=startY+idx*(rowH+minGap);
        var lx=side==='right'?(ca.right+8):(ca.left-8);
        var elbowX=side==='right'?(cx+outerR+6):(cx-outerR-6);
        var edgeX=cx+Math.cos(it.mid)*outerR,edgeY=cy+Math.sin(it.mid)*outerR;
        ctx.save();
        ctx.strokeStyle=it.g.color;
        ctx.lineWidth=1.2;
        ctx.beginPath();
        ctx.moveTo(edgeX,edgeY);
        ctx.lineTo(elbowX,ly);
        ctx.lineTo(lx,ly);
        ctx.stroke();
        ctx.fillStyle=it.g.color;
        ctx.font='bold 10px Inter,sans-serif';
        ctx.textAlign=side==='right'?'left':'right';
        ctx.textBaseline='bottom';
        ctx.fillText(it.g.label,lx+(side==='right'?4:-4),ly-1);
        ctx.fillStyle=c.text;
        ctx.font='600 9px Inter,sans-serif';
        ctx.textBaseline='top';
        ctx.fillText(it.g.count+' · '+it.pct.toFixed(1)+'% · '+fmt(it.g.value),lx+(side==='right'?4:-4),ly+1);
        ctx.restore();
      });
    }
    stackSide(left,'left');
    stackSide(right,'right');
  }};
}
function glkFilterByChartPeriodYear(bids,period,year){
  year=parseInt(year,10);
  var now=new Date();
  var ref=new Date(year,now.getMonth(),now.getDate());
  return (bids||[]).filter(function(b){
    var iso=getRelevantDate(b);
    if(!iso) return false;
    var d=new Date(iso);
    if(isNaN(d)) return false;
    if(period==='YTD') return d.getFullYear()===year&&d<=ref;
    if(period==='Y') return d.getFullYear()===year;
    if(period==='Q') return d.getFullYear()===year&&Math.ceil((d.getMonth()+1)/3)===Math.ceil((ref.getMonth()+1)/3);
    if(period==='M') return d.getFullYear()===year&&d.getMonth()===ref.getMonth();
    if(period==='W') return d.getFullYear()===year&&getWeekOfYear(d)===getWeekOfYear(ref);
    return true;
  });
}
function glkBridgeScope(bids){
  var s=glkFilterByChartPeriod(bids,chartPeriod);
  if(bridgeDrill==='vertical'&&bridgeDrillVal) s=s.filter(function(b){return b.vertical===bridgeDrillVal;});
  else if(bridgeDrill==='am'&&bridgeDrillVal) s=s.filter(function(b){return b.amName===bridgeDrillVal||b.amEmail===bridgeDrillVal;});
  return s;
}
function glkBridgeTop10Asc(bids,metric){
  var map={};
  (bids||[]).forEach(function(b){
    var k=b.customerName||'Unknown';
    map[k]=(map[k]||0)+glkBidMetric(b,metric);
  });
  var sorted=Object.keys(map).map(function(k){return [k,map[k]];}).filter(function(p){return p[1]>0;}).sort(function(a,b){return b[1]-a[1];});
  var top10=sorted.slice(0,10).sort(function(a,b){return a[1]-b[1];});
  var others=sorted.slice(10).reduce(function(s,p){return s+p[1];},0);
  return {items:top10.map(function(p){return {name:p[0],value:p[1]};}),others:others};
}
function glkBridgeCalc(bids,metric,targetVal,isBest){
  var scoped=glkBridgeScope(bids);
  var wonBilledVal=scoped.filter(function(b){return b.status==='Won'||b.status==='Billed';}).reduce(function(s,b){return s+glkBidMetric(b,metric);},0);
  var inForecastBids=scoped.filter(function(b){return b.status==='Proposed';});
  var top=glkBridgeTop10Asc(inForecastBids,metric);
  var top10Sum=top.items.reduce(function(s,p){return s+p.value;},0);
  var inForecastOthers=top.others;
  var outForecastVal=isBest?scoped.filter(function(b){return b.status==='Opportunity';}).reduce(function(s,b){return s+glkBidMetric(b,metric);},0):0;
  var total=wonBilledVal+top10Sum+inForecastOthers+outForecastVal;
  var gap=targetVal-total;
  return {scoped:scoped,wonBilledVal:wonBilledVal,top:top,top10Sum:top10Sum,inForecastOthers:inForecastOthers,outForecastVal:outForecastVal,total:total,gap:gap,over:gap<=0};
}
function glkBridgeCaseBtns(){
  return ['worst','best'].map(function(c){
    var act=bridgeCase===c;
    var lbl=mqCaseDisplayName(c);
    return '<button type="button" onclick="setBridgeCase(\''+c+'\')" style="padding:.25rem .7rem;border-radius:6px;font-size:.72rem;font-weight:700;border:1px solid var(--border);cursor:pointer;background:'+(act?'var(--grad)':'var(--bg-secondary)')+';color:'+(act?'#fff':'var(--t3)')+';">'+lbl+'</button>';
  }).join('');
}
function glkBridgeDrillHtml(bids){
  var scoped=glkFilterByChartPeriod(bids,chartPeriod);
  var verts=[...new Set(scoped.map(function(b){return b.vertical;}).filter(function(v){return v&&v!=='—';}))].sort();
  var ams=[...new Set(scoped.map(function(b){return b.amName||b.amEmail;}).filter(function(v){return v&&v!=='—';}))].sort();
  var drillSel='<select class="fb-select" style="font-size:.72rem;padding:.32rem .55rem;" onchange="setBridgeDrill(this.value)">'+
    '<option value="all"'+(bridgeDrill==='all'?' selected':'')+'>All pipeline</option>'+
    '<option value="vertical"'+(bridgeDrill==='vertical'?' selected':'')+'>By Vertical</option>'+
    '<option value="am"'+(bridgeDrill==='am'?' selected':'')+'>By AM</option></select>';
  var valSel='';
  if(bridgeDrill==='vertical'){
    valSel='<select class="fb-select" style="font-size:.72rem;padding:.32rem .55rem;min-width:120px;" onchange="setBridgeDrillVal(this.value)">'+
      '<option value="">Select vertical</option>'+verts.map(function(v){return '<option value="'+v+'"'+(bridgeDrillVal===v?' selected':'')+'>'+v+'</option>';}).join('')+'</select>';
  }else if(bridgeDrill==='am'){
    valSel='<select class="fb-select" style="font-size:.72rem;padding:.32rem .55rem;min-width:120px;" onchange="setBridgeDrillVal(this.value)">'+
      '<option value="">Select AM</option>'+ams.map(function(v){return '<option value="'+v+'"'+(bridgeDrillVal===v?' selected':'')+'>'+v+'</option>';}).join('')+'</select>';
  }
  return drillSel+valSel;
}
function glkBridgeControlsHtml(bids){
  return '<div style="display:flex;justify-content:space-between;align-items:center;margin-top:.65rem;flex-wrap:wrap;gap:.5rem;">'+
    '<div style="display:flex;gap:.35rem;align-items:center;flex-wrap:wrap;">'+glkBridgeCaseBtns()+'</div>'+
    '<div style="display:flex;gap:.4rem;align-items:center;flex-wrap:wrap;">'+glkBridgeDrillHtml(bids)+
    glkChartMetricBtns()+glkChartPeriodSelect('chartPeriodSelectBridge')+'</div></div>';
}
function glkBridgeBarLabel(name,value){
  if(value<=0&&name==='—') return '—';
  return name==='Others'?'Others':(name.length>13?name.slice(0,11)+'…':name);
}
function glkBridgeFloatBar(b){
  return [b.displayStart,b.displayEnd];
}
function glkBridgeMinPxPlugin(bars,minPx){
  minPx=minPx||28;
  return {id:'glkBridgeMinPx',afterLayout:function(chart){
    var meta=chart.getDatasetMeta(0);
    if(!meta||!meta.data) return;
    meta.data.forEach(function(bar,i){
      var b=bars[i];
      if(!b||!(b.type==='step'||b.type==='outforecast'||b.type==='gap'||b.type==='over')) return;
      if(bar.base==null||bar.y==null||isNaN(bar.base)||isNaN(bar.y)) return;
      var h=Math.abs(bar.base-bar.y);
      if(h<minPx) bar.y=bar.base-minPx;
    });
  }};
}
function glkBridgeConnectorPlugin(bars){
  return {id:'glkBridgeConnectors',afterDatasetsDraw:function(chart){
    var meta=chart.getDatasetMeta(0),ctx=chart.ctx;
    if(!meta||!meta.data) return;
    for(var i=1;i<meta.data.length;i++){
      var prev=bars[i-1],cur=bars[i];
      if(cur.type!=='step') continue;
      if(prev.type!=='base'&&prev.type!=='step') continue;
      var pBar=meta.data[i-1],cBar=meta.data[i];
      if(!pBar||!cBar) continue;
      var topPrev=Math.min(pBar.y,pBar.base);
      ctx.save();
      ctx.strokeStyle='rgba(100,116,139,.35)';
      ctx.lineWidth=1;
      ctx.setLineDash([4,3]);
      ctx.beginPath();
      ctx.moveTo(pBar.x,topPrev);
      ctx.lineTo(cBar.x,topPrev);
      ctx.stroke();
      ctx.restore();
    }
  }};
}
function glkBridgeBarLabelPlugin(bars){
  return {id:'glkBridgeLabels',afterDatasetsDraw:function(chart){
    var ctx=chart.ctx,meta=chart.getDatasetMeta(0),area=chart.chartArea;
    if(!meta||!meta.data) return;
    meta.data.forEach(function(bar,i){
      var b=bars[i]; if(!b||b.value<=0) return;
      var top=Math.min(bar.y,bar.base),bot=Math.max(bar.y,bar.base),h=bot-top;
      var midY=top+h/2;
      ctx.save();
      if(h<14&&b.type==='step'){
        ctx.fillStyle=b.color||MQ_CLR_INFLIGHT[0];
        ctx.font='bold 9px Inter';
        ctx.textAlign='center';
        ctx.textBaseline='bottom';
        ctx.fillText(fmt(b.value),bar.x,top-3);
      }else{
        if(h<10) midY=top-8;
        ctx.fillStyle='#fff';
        ctx.font='bold 10px Inter';
        ctx.textAlign='center';
        ctx.textBaseline='middle';
        ctx.fillText(fmt(b.value),bar.x,midY);
      }
      if(b.custName){
        ctx.fillStyle=chart.options.scales.x.ticks.color||'#94a3b8';
        ctx.font='600 9px Inter';
        ctx.textBaseline='top';
        ctx.fillText(b.custName,bar.x,area.bottom+18);
      }
      ctx.restore();
    });
  }};
}
function glkBridgeGroupPlugin(sectionGroups,c){
  return {id:'glkBridgeGroups',afterDraw:function(chart){
    var ctx=chart.ctx,meta=chart.getDatasetMeta(0),area=chart.chartArea;
    if(!meta||!meta.data||!sectionGroups.length) return;
    ctx.save();
    ctx.lineWidth=1.2;
    ctx.font='bold 10px Inter';
    ctx.textAlign='center';
    ctx.textBaseline='middle';
    var bracketY=area.bottom+34;
    var labelY=area.bottom+48;
    var rowRight=[];
    sectionGroups.forEach(function(g){
      var b0=meta.data[g.startIdx],b1=meta.data[g.endIdx];
      if(!b0||!b1) return;
      var x1=b0.x-b0.width/2,x2=b1.x+b1.width/2,cx=(x1+x2)/2;
      var col=g.color||c.text||'#64748b';
      ctx.strokeStyle=col;ctx.fillStyle=col;
      ctx.beginPath();ctx.moveTo(x1,bracketY);ctx.lineTo(x1,bracketY+5);ctx.lineTo(x2,bracketY+5);ctx.lineTo(x2,bracketY);ctx.stroke();
      var w=ctx.measureText(g.label).width,half=w/2+6;
      var row=0;
      while(rowRight[row]!==undefined&&(cx-half)<rowRight[row]) row++;
      rowRight[row]=cx+half;
      ctx.fillText(g.label,cx,labelY+row*14);
    });
    ctx.restore();
  }};
}
function glkBarLabelPlugin(){
  return {id:'glkBarLabels',afterDatasetsDraw:function(chart){
    var ctx=chart.ctx,meta=chart.getDatasetMeta(0);
    if(!meta||!meta.data) return;
    meta.data.forEach(function(bar,i){
      var val=chart.data.datasets[0].data[i];
      if(val==null||val<=0) return;
      var midY=(bar.y+bar.base)/2;
      ctx.save();
      ctx.fillStyle='#fff';
      ctx.font='bold 10px Inter';
      ctx.textAlign='center';
      ctx.textBaseline='middle';
      ctx.fillText(val+'M',bar.x,midY);
      ctx.restore();
    });
  }};
}
function glkTopCustomersPlusOthers(bids,metric,topN){
  const map={};
  (bids||[]).forEach(function(b){
    const k=b.customerName||'Unknown';
    map[k]=(map[k]||0)+glkBidMetric(b,metric);
  });
  const sorted=Object.entries(map).sort(function(a,b){return b[1]-a[1];});
  return {
    top:sorted.slice(0,topN),
    others:sorted.slice(topN).reduce(function(s,p){return s+p[1];},0),
    total:sorted.reduce(function(s,p){return s+p[1];},0)
  };
}
class GlkValueListFilter{
  init(params){
    this.params=params;
    this.colDef=params.colDef;
    this.selected=new Set();
    this.gui=document.createElement('div');
    this.gui.className='glk-ag-filter';
    this.gui.style.cssText='padding:8px;min-width:190px;max-height:240px;overflow:auto;background:var(--bg-card);color:var(--t1);';
    this.search=document.createElement('input');
    this.search.placeholder='Search values...';
    this.search.style.cssText='width:100%;margin-bottom:6px;padding:5px 8px;border:1px solid var(--border);border-radius:6px;background:var(--bg-input);color:var(--t1);font-size:12px;box-sizing:border-box;';
    this.list=document.createElement('div');
    this.actions=document.createElement('div');
    this.actions.style.cssText='display:flex;gap:6px;margin-top:8px;';
    const btnReset=document.createElement('button');
    btnReset.textContent='Reset';
    btnReset.style.cssText='flex:1;padding:4px;border-radius:6px;border:1px solid var(--border);background:var(--bg-secondary);color:var(--t1);cursor:pointer;font-size:11px;font-weight:700;';
    btnReset.onclick=()=>{this.selected.clear();this.renderList();this.params.filterChangedCallback();};
    this.actions.appendChild(btnReset);
    this.gui.appendChild(this.search);
    this.gui.appendChild(this.list);
    this.gui.appendChild(this.actions);
    this.search.addEventListener('input',()=>this.renderList());
    this.renderList();
  }
  cellVal(row){
    const cd=this.colDef,p={data:row,colDef:cd,api:this.params.api,column:this.params.column};
    if(cd.filterValueGetter) return cd.filterValueGetter(p);
    if(cd.valueGetter) return cd.valueGetter(p);
    if(cd.field) return row[cd.field];
    return null;
  }
  cellStr(row){
    const v=this.cellVal(row);
    if(v==null||v==='') return '—';
    return String(v);
  }
  getValues(){
    const vals=[];
    this.params.api.forEachNode(function(n){
      if(!n.data) return;
      const s=this.cellStr(n.data);
      if(s&&s!=='—') vals.push(s);
    }.bind(this));
    return [...new Set(vals)].sort();
  }
  renderList(){
    const q=this.search.value.toLowerCase();
    const vals=this.getValues().filter(function(v){return v.toLowerCase().includes(q);});
    const self=this;
    this.list.innerHTML=vals.map(function(v){
      const esc=v.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
      return '<label style="display:flex;align-items:center;gap:6px;padding:4px 0;cursor:pointer;font-size:12px;"><input type="checkbox" data-v="'+esc+'"'+(self.selected.has(v)?' checked':'')+'><span>'+esc+'</span></label>';
    }).join('')||(vals.length?'':'<div style="font-size:11px;color:var(--t3);padding:4px 0;">No values</div>');
    this.list.querySelectorAll('input[type=checkbox]').forEach(function(inp){
      inp.addEventListener('change',function(){
        const v=inp.getAttribute('data-v');
        if(inp.checked) self.selected.add(v); else self.selected.delete(v);
        self.params.filterChangedCallback();
      });
    });
  }
  getGui(){return this.gui;}
  isFilterActive(){return this.selected.size>0;}
  doesFilterPass(params){
    if(!this.isFilterActive()) return true;
    return this.selected.has(this.cellStr(params.data));
  }
  getModel(){return this.isFilterActive()?{values:[...this.selected]}:null;}
  setModel(model){
    this.selected=new Set(model&&model.values?model.values:[]);
    this.renderList();
  }
}
function glkGridTextVal(p){
  const v=p.data[p.colDef.field];
  return (v==null||v==='')?'—':String(v);
}
function glkGridDateVal(p){ return fmtDate(p.data[p.colDef.field]); }
function glkGridMoneyVal(p){
  const v=p.data[p.colDef.field];
  return (v==null||v==='')?'—':fmt(v);
}
function glkGridNumVal(p){
  const v=p.data[p.colDef.field];
  if(v==null||v==='') return '—';
  return String(v);
}
function glkResolveForecastCategory(rawFC,rawProb){
  if(rawFC) return rawFC;
  return PROB_TO_FORECAST[rawProb]||'';
}
const getQuarter = d => 'Q'+Math.ceil((new Date(d).getMonth()+1)/3);
function getWeekOfYear(date){ const d=new Date(date); d.setHours(0,0,0,0); d.setDate(d.getDate()+3-(d.getDay()+6)%7); const w1=new Date(d.getFullYear(),0,4); return 1+Math.round(((d-w1)/864e5-3+(w1.getDay()+6)%7)/7); }
function getVisitCount(){ try{ return parseInt(localStorage.getItem('glk_vc_'+USER.email)||'0'); }catch(e){return 0;} }
function incVisit(){ try{ const c=getVisitCount()+1; localStorage.setItem('glk_vc_'+USER.email,c); return c; }catch(e){return 1;} }
function getLastVisit(){
  try{
    const lv=localStorage.getItem('glk_lv_'+USER.email);
    if(!lv) return 'First visit';
    const diff=Date.now()-new Date(lv).getTime();
    const m=Math.floor(diff/6e4),h=Math.floor(diff/36e5),day=Math.floor(diff/864e5);
    if(m<60) return m+'m ago'; if(h<24) return h+'h ago'; if(day<7) return day+'d ago';
    return new Date(lv).toLocaleDateString('en-GB');
  }catch(e){ return '—'; }
}
function saveLastVisit(){ try{ localStorage.setItem('glk_lv_'+USER.email,new Date().toISOString()); }catch(e){} }
function el(id){ return document.getElementById(id); }
function set(id,val){ const e=el(id); if(e) e.textContent=val; }



// ══════════════════════════════════════════════════════════════════
//  SHAREPOINT FETCH
// ══════════════════════════════════════════════════════════════════
function spGet(url,cb){
  const xhr=new XMLHttpRequest();
  xhr.open('GET',url,true);
  xhr.timeout=20000;
  xhr.setRequestHeader('Accept','application/json;odata=verbose');
  xhr.onreadystatechange=function(){
    if(xhr.readyState!==4) return;
    if(xhr.status>=200&&xhr.status<300){ try{ cb(null,JSON.parse(xhr.responseText)); }catch(e){ cb(e,null); } }
    else { cb(new Error('HTTP '+xhr.status),null); }
  };
  xhr.onerror=function(){ cb(new Error('Network error'),null); };
  xhr.ontimeout=function(){ cb(new Error('Request timed out'),null); };
  xhr.send();
}
function spEscPath(p){ return String(p||'').replace(/'/g,"''"); }
function spGetRequestDigest(cb){
  var xhr=new XMLHttpRequest();
  xhr.open('POST',SP_SITE+'/_api/contextinfo',true);
  xhr.setRequestHeader('Accept','application/json;odata=verbose');
  xhr.onreadystatechange=function(){
    if(xhr.readyState!==4) return;
    if(xhr.status>=200&&xhr.status<300){
      try{ cb(null,JSON.parse(xhr.responseText).d.GetContextWebInformation.FormDigestValue); }
      catch(e){ cb(e,null); }
    }else cb(new Error('Digest HTTP '+xhr.status),null);
  };
  xhr.onerror=function(){ cb(new Error('Network error'),null); };
  xhr.send();
}
function spPostJson(url,body,digest,cb){
  var xhr=new XMLHttpRequest();
  xhr.open('POST',url,true);
  xhr.setRequestHeader('Accept','application/json;odata=verbose');
  xhr.setRequestHeader('Content-Type','application/json;odata=verbose');
  xhr.setRequestHeader('X-RequestDigest',digest);
  xhr.onreadystatechange=function(){
    if(xhr.readyState!==4) return;
    if(xhr.status>=200&&xhr.status<300){
      try{ cb(null,JSON.parse(xhr.responseText)); }catch(e){ cb(e,null); }
    }else cb(new Error('HTTP '+xhr.status+(xhr.responseText?': '+xhr.responseText.slice(0,120):'')),null);
  };
  xhr.onerror=function(){ cb(new Error('Network error'),null); };
  xhr.send(JSON.stringify(body));
}
function spGetBinary(url,cb){
  var done=false;
  function finish(err,buf){
    if(done) return;
    done=true;
    cb(err,buf);
  }
  var xhr=new XMLHttpRequest();
  xhr.open('GET',url,true);
  xhr.responseType='arraybuffer';
  xhr.timeout=45000;
  xhr.setRequestHeader('Cache-Control','no-cache, no-store, must-revalidate');
  xhr.setRequestHeader('Pragma','no-cache');
  xhr.onreadystatechange=function(){
    if(xhr.readyState!==4) return;
    if(xhr.status>=200&&xhr.status<300) finish(null,xhr.response);
    else finish(new Error('HTTP '+xhr.status+(xhr.status===500?' — SharePoint file error (locked or missing?)':'')));
  };
  xhr.onerror=function(){ finish(new Error('Network error')); };
  xhr.ontimeout=function(){ finish(new Error('Download timed out after 45s')); };
  xhr.send();
  setTimeout(function(){
    if(!done){ try{ xhr.abort(); }catch(e){} finish(new Error('Download timed out')); }
  },48000);
}
function spUploadBinary(url,arrayBuffer,digest,cb){
  var xhr=new XMLHttpRequest();
  xhr.open('POST',url,true);
  xhr.setRequestHeader('Accept','application/json;odata=verbose');
  xhr.setRequestHeader('Content-Type','application/octet-stream');
  xhr.setRequestHeader('X-RequestDigest',digest);
  xhr.onreadystatechange=function(){
    if(xhr.readyState!==4) return;
    if(xhr.status>=200&&xhr.status<300){
      try{ cb(null,JSON.parse(xhr.responseText)); }catch(e){ cb(null,{}); }
    }else cb(new Error('Upload HTTP '+xhr.status),null);
  };
  xhr.onerror=function(){ cb(new Error('Network error'),null); };
  xhr.send(arrayBuffer);
}
function spPostEmpty(url,digest,cb){
  var xhr=new XMLHttpRequest();
  xhr.open('POST',url,true);
  xhr.setRequestHeader('Accept','application/json;odata=verbose');
  xhr.setRequestHeader('X-RequestDigest',digest);
  xhr.onreadystatechange=function(){
    if(xhr.readyState!==4) return;
    if(xhr.status>=200&&xhr.status<300) cb(null);
    else if(xhr.status===409||xhr.status===500&&/already exists|duplicate/i.test(xhr.responseText||'')) cb(null);
    else cb(new Error('HTTP '+xhr.status+(xhr.responseText?': '+String(xhr.responseText).slice(0,160):'')),null);
  };
  xhr.onerror=function(){ cb(new Error('Network error'),null); };
  xhr.send();
}
function spUploadSiteAssetFile(fileName,arrayBuffer,originalName,cb){
  spGetRequestDigest(function(err2,digest){
    if(err2) return cb(err2);
    var path=SP_MOBILE_REPORT_FOLDER+'/'+fileName;
    var uploadUrl=SP_SITE+"/_api/web/GetFolderByServerRelativeUrl('"+spEscPath(SP_MOBILE_REPORT_FOLDER)+"')/Files/add(url='"+String(fileName).replace(/'/g,"''")+"',overwrite=true)";
    spUploadBinary(uploadUrl,arrayBuffer,digest,function(err3,data){
      if(err3) return cb(err3);
      var modified=null;
      try{ modified=data.d.TimeLastModified||data.d.Modified||null; }catch(e){}
      cb(null,{
        filename:fileName,
        originalName:originalName||fileName,
        uploadedAt:modified||new Date().toISOString(),
        serverPath:path,
        spUrl:SP_SITE+'/SiteAssets/'+encodeURIComponent(fileName),
        storage:'sharepoint'
      });
    });
  });
}
function spUploadTrendsReport(arrayBuffer,originalName,cb){
  spUploadSiteAssetFile(SP_TRENDS_REPORT_FILE,arrayBuffer,originalName,cb);
}
function spDownloadTrendsReport(cb){
  var fileUrl=SP_SITE+"/_api/web/GetFileByServerRelativeUrl('"+spEscPath(SP_TRENDS_REPORT_PATH)+"')/$value";
  spGetBinary(fileUrl,cb);
}
function spGetTrendsReportMeta(cb){
  var metaUrl=SP_SITE+"/_api/web/GetFileByServerRelativeUrl('"+spEscPath(SP_TRENDS_REPORT_PATH)+"')?$select=Name,TimeLastModified,Length";
  spGet(metaUrl,function(err,data){
    if(err) return cb(err,null);
    try{
      var d=data.d;
      cb(null,{filename:d.Name,uploadedAt:d.TimeLastModified,size:d.Length,serverPath:SP_TRENDS_REPORT_PATH,spUrl:SP_TRENDS_REPORT_WEB_URL,storage:'sharepoint'});
    }catch(e){ cb(e,null); }
  });
}
function spUploadMobileReport(arrayBuffer,originalName,cb){
  var uploadTime=new Date().toISOString();
  spUploadSiteAssetFile(SP_MOBILE_REPORT_FILE,arrayBuffer,originalName,function(err,meta){
    if(err) return cb(err);
    spGetMobileReportMeta(function(err4,meta2){
      cb(null,Object.assign({},meta2||{},meta||{},{
        originalName:originalName||SP_MOBILE_REPORT_FILE,
        storage:'sharepoint',
        uploadedAt:uploadTime
      }));
    });
  });
}
function spDownloadMobileReport(cb){
  var fileUrl=SP_SITE+"/_api/web/GetFileByServerRelativeUrl('"+spEscPath(SP_MOBILE_REPORT_PATH)+"')/$value?nocache="+Date.now();
  spGetBinary(fileUrl,cb);
}
function spGetMobileReportMeta(cb){
  var metaUrl=SP_SITE+"/_api/web/GetFileByServerRelativeUrl('"+spEscPath(SP_MOBILE_REPORT_PATH)+"')?$select=Name,TimeLastModified,Length";
  spGet(metaUrl,function(err,data){
    if(err) return cb(err,null);
    try{
      var d=data.d;
      cb(null,{
        filename:d.Name,
        uploadedAt:d.TimeLastModified,
        size:d.Length,
        serverPath:SP_MOBILE_REPORT_PATH,
        spUrl:SP_MOBILE_REPORT_WEB_URL
      });
    }catch(e){ cb(e,null); }
  });
}
function mqIdbOpen(cb){
  if(typeof indexedDB==='undefined') return cb(new Error('IndexedDB unavailable'));
  try{
    var req=indexedDB.open(MQ_IDB_NAME,1);
    req.onerror=function(){ cb(req.error||new Error('IndexedDB open failed')); };
    req.onupgradeneeded=function(e){
      var db=e.target.result;
      if(!db.objectStoreNames.contains(MQ_IDB_STORE)) db.createObjectStore(MQ_IDB_STORE);
    };
    req.onsuccess=function(){ cb(null,req.result); };
  }catch(e){ cb(e); }
}
function mqArrayBufferCopy(buf){
  if(!buf) return null;
  try{ return buf.slice(0); }catch(e){
    var u=new Uint8Array(buf);
    return u.buffer.slice(u.byteOffset,u.byteOffset+u.byteLength);
  }
}
function mqBufToB64(buf){
  var bytes=new Uint8Array(buf);
  var CHUNK=0x8000,parts=[];
  for(var i=0;i<bytes.length;i+=CHUNK) parts.push(String.fromCharCode.apply(null,bytes.subarray(i,i+CHUNK)));
  return btoa(parts.join(''));
}
function mqB64ToBuf(b64){
  var bin=atob(b64),len=bin.length,buf=new ArrayBuffer(len),u=new Uint8Array(buf);
  for(var i=0;i<len;i++) u[i]=bin.charCodeAt(i);
  return buf;
}
function mqCacheSaveReport(arrayBuffer,meta,cb){
  cb=cb||function(){};
  var metaOut=Object.assign({},meta||{},{storage:meta&&meta.storage?meta.storage:'local',cachedAt:new Date().toISOString()});
  var bufCopy=mqArrayBufferCopy(arrayBuffer);
  try{ localStorage.setItem(MQ_LS_META_KEY,JSON.stringify(metaOut)); }catch(e){}
  try{
    if(bufCopy&&bufCopy.byteLength<=MQ_LS_MAX_B64) localStorage.setItem(MQ_LS_DATA_KEY,mqBufToB64(bufCopy));
    else localStorage.removeItem(MQ_LS_DATA_KEY);
  }catch(e2){ try{ localStorage.removeItem(MQ_LS_DATA_KEY); }catch(e3){} }
  mqIdbOpen(function(err,db){
    if(err){
      console.warn('[GLK] IDB cache save skipped:',err.message);
      return cb(null,metaOut);
    }
    var tx=db.transaction(MQ_IDB_STORE,'readwrite');
    tx.objectStore(MQ_IDB_STORE).put({buffer:bufCopy,meta:metaOut},'latest');
    tx.oncomplete=function(){ cb(null,metaOut); };
    tx.onerror=function(){ cb(null,metaOut); };
  });
}
function mqCacheLoadReport(cb){
  var meta=null;
  try{ meta=JSON.parse(localStorage.getItem(MQ_LS_META_KEY)||'null'); }catch(e){}
  function tryLsB64(){
    try{
      var b64=localStorage.getItem(MQ_LS_DATA_KEY);
      if(b64&&b64.length>20) return cb(null,mqB64ToBuf(b64),meta);
    }catch(e){}
    return cb(new Error('No cached report'),null,null);
  }
  mqIdbOpen(function(err,db){
    if(err) return tryLsB64();
    var tx=db.transaction(MQ_IDB_STORE,'readonly');
    var req=tx.objectStore(MQ_IDB_STORE).get('latest');
    req.onsuccess=function(){
      if(!req.result||!req.result.buffer) return tryLsB64();
      cb(null,mqArrayBufferCopy(req.result.buffer),req.result.meta||meta);
    };
    req.onerror=function(){ tryLsB64(); };
  });
}
function glkSpLoadMobileReport(cb){
  cb=cb||function(){};
  var finished=false;
  function done(err,parsed,meta){
    if(finished) return;
    finished=true;
    cb(err,parsed,meta);
  }
  setTimeout(function(){
    if(!finished){
      console.warn('[GLK] Mobile report load timed out — using cache if available');
      loadFromCache(new Error('Load timed out after 60s'));
    }
  },60000);
  function loadFromCache(spErr){
    mqCacheLoadReport(function(errC,bufferC,metaC){
      if(!errC&&bufferC&&bufferC.byteLength>0){
        glkParseAndSetMobileReport(bufferC,function(e,parsed){
          if(!e&&parsed){
            GLK_MOBILE_REPORT_META=Object.assign({},metaC||{},{storage:(metaC&&metaC.storage)||'local-cache',spError:spErr?spErr.message:null});
            return done(null,parsed,GLK_MOBILE_REPORT_META);
          }
          done(spErr||errC||new Error('No mobile report found. Check SharePoint SiteAssets file or use Replace File.'),null,null);
        });
        return;
      }
      done(spErr||errC||new Error('No mobile report found at SharePoint SiteAssets. Upload the workbook once with Replace File.'),null,null);
    });
  }
  spDownloadMobileReport(function(err,buffer){
    if(!err&&buffer&&buffer.byteLength>0){
      glkParseAndSetMobileReport(buffer,function(e3,parsed){
        if(e3) return loadFromCache(e3);
        mqCacheLoadReport(function(errCache,cacheBuf,cacheMeta){
          spGetMobileReportMeta(function(e2,meta){
            var uploadIso=(cacheMeta&&(cacheMeta.uploadedAt||cacheMeta.cachedAt))||(meta&&meta.uploadedAt)||null;
            var m=Object.assign({},meta||{},{storage:'sharepoint',filename:SP_MOBILE_REPORT_FILE,spUrl:SP_MOBILE_REPORT_WEB_URL,uploadedAt:uploadIso});
            GLK_MOBILE_REPORT_META=m;
            mqCacheSaveReport(buffer,m,function(){});
            done(null,parsed,m);
          });
        });
      });
      return;
    }
    console.warn('[GLK] SharePoint report load failed:',err?err.message:err);
    loadFromCache(err);
  });
}
function glkFinishMobileReportLoad(err,opts){
  opts=opts||{};
  window._glkMobileSpRefreshing=false;
  window._GLK_BRIDGE_MENU_LOADED=true;
  var refreshBtn=el('mobileReportRefreshBtn');
  if(refreshBtn) refreshBtn.disabled=false;
  glkHideLoader();
  if(window._glkClearLoaderSafety){
    clearTimeout(window._glkClearLoaderSafety);
    window._glkClearLoaderSafety=null;
  }
  glkMobileQtdRefreshUI();
  try{ if(mqGetActiveReport()) renderMobileQtdBridge(); }catch(e){ console.error('[GLK] Bridge render after refresh:',e); }
  if(window._glkMobileSpRefreshAfterNav){
    var cb=window._glkMobileSpRefreshAfterNav;
    window._glkMobileSpRefreshAfterNav=null;
    try{ cb(err); }catch(e2){}
  }
  if(err&&opts.alertOnError) alert('Could not load from SharePoint:\n'+err.message+'\n\nUsing browser cache if available. If the Excel file is locked, ask whoever has it open to close it, then Refresh again.');
}
function glkEnsureBridgeReportOnShow(opts){
  opts=opts||{};
  var metaEl=el('mobileReportMeta');
  if(metaEl) metaEl.textContent='Loading from SharePoint…';
  if(window._glkMobileSpRefreshing){
    window._glkMobileSpRefreshAfterNav=function(err){ glkFinishMobileReportLoad(err,{alertOnError:false}); };
    return;
  }
  window._glkMobileSpRefreshing=true;
  var refreshBtn=el('mobileReportRefreshBtn');
  if(refreshBtn) refreshBtn.disabled=true;
  try{
    glkSpLoadMobileReport(function(err){
      glkFinishMobileReportLoad(err,{alertOnError:false});
    });
  }catch(e){
    glkFinishMobileReportLoad(e,{alertOnError:false});
  }
}
window.glkMobileReportRefreshFromSharePoint=function(){
  if(window._glkMobileSpRefreshing) return;
  window._glkMobileSpRefreshing=true;
  var metaEl=el('mobileReportMeta');
  var refreshBtn=el('mobileReportRefreshBtn');
  if(metaEl) metaEl.textContent='Refreshing from SharePoint…';
  if(refreshBtn) refreshBtn.disabled=true;
  glkShowLoader('Loading GLK report from SharePoint…');
  if(window._glkClearLoaderSafety) clearTimeout(window._glkClearLoaderSafety);
  window._glkClearLoaderSafety=setTimeout(function(){ glkHideLoader(); },65000);
  try{
    glkSpLoadMobileReport(function(err){
      glkFinishMobileReportLoad(err,{alertOnError:true});
    });
  }catch(e){
    glkFinishMobileReportLoad(e,{alertOnError:true});
  }
};

// ══════════════════════════════════════════════════════════════════
//  ACCESS CONTROL
// ══════════════════════════════════════════════════════════════════
function initAccess(){
  var accessDone=false;
  function finishAccess(fn){ if(!accessDone){ accessDone=true; fn(); } }
  var accessTimer=setTimeout(function(){
    finishAccess(function(){
      var btn=el('launchBtn');
      if(btn&&btn.disabled) showDenied('Connection timed out. Open this page from the GKA SharePoint site (not a local file) and ensure you are signed in.');
    });
  },18000);
  spGet(SP_SITE+'/_api/web/currentuser?$select=Title,Email',function(err,data){
    if(err){
      clearTimeout(accessTimer);
      finishAccess(function(){ showDenied('Cannot reach SharePoint: '+err.message); });
      return;
    }
    if(!data||!data.d){
      clearTimeout(accessTimer);
      finishAccess(function(){ showDenied('Unexpected SharePoint response. Please refresh.'); });
      return;
    }
    USER.email=(data.d.Email||'').trim();
    USER.name=(data.d.Title||'User').trim();
    if(!USER.email){
      clearTimeout(accessTimer);
      finishAccess(function(){ showDenied('Could not read your SharePoint email.'); });
      return;
    }
    var safeEmail=USER.email.replace(/'/g,"''");
    spGet(SP_SITE+"/_api/web/lists/getbytitle('"+SP_ACCESS+"')/items?$select=UserEmailID,Role&$filter=UserEmailID eq '"+safeEmail+"'",function(err2,data2){
      clearTimeout(accessTimer);
      if(err2){
        finishAccess(function(){ showDenied('Access list error: '+err2.message); });
        return;
      }
      var results=(data2&&data2.d&&data2.d.results)?data2.d.results:[];
      if(!results.length){
        finishAccess(function(){ showDenied('You are not authorised. Contact tehleel.lone@du.ae'); });
        return;
      }
      var role=(results[0].Role||'').trim();
      var ALLOWED=['Admin','CEO','Head Director','Account Director','Account Manager','Viewer'];
      if(!ALLOWED.includes(role)){
        finishAccess(function(){ showDenied('Your role "'+role+'" has no access. Contact tehleel.lone@du.ae'); });
        return;
      }
      USER.role=role;
      console.log('[GLK] Role:', JSON.stringify(results[0]));
      finishAccess(populateLanding);
    });
  });
}
function showDenied(msg){
  set('lName','Access Denied'); set('lEmail',msg); set('lRole','No Access');
  var btn=el('launchBtn');
  if(btn){
    btn.disabled=true;
    var txt=btn.querySelector('.btn-text');
    if(txt) txt.textContent='Access Denied';
  }
  el('accessNote').innerHTML='<svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:#dc2626;fill:none;stroke-width:2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg><span style="color:#dc2626;">'+msg+'</span>';
}
function populateLanding(){
  el('lAvatar').textContent=getInitials(USER.name);
  set('lName',USER.name); set('lEmail',USER.email); set('lRole',USER.role);
  set('lLastVisit',getLastVisit());
  const btn=el('launchBtn');
  btn.disabled=false;
  btn.innerHTML='<span class="btn-icon"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg></span><span class="btn-text">Go to Dashboard</span><span class="btn-shine"></span>';
  btn.onclick=launchDashboard;
  el('accessNote').innerHTML='<svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:#16a34a;fill:none;stroke-width:2"><polyline points="20 6 9 17 4 12"/></svg><span style="color:#16a34a;font-weight:600;">Access verified</span>';
}
function glkShowLoader(msg){var l=el('glkLoader');if(!l)return;if(msg)el('glkLoaderText').textContent=msg;l.style.display='flex';}
function glkHideLoader(){var l=el('glkLoader');if(l)l.style.display='none';}
function glkShowDashboardLoading(msg){
  var o=el('dashboardLoadingOverlay'); if(!o) return;
  if(msg){ var t=el('dashboardLoadingText'); if(t) t.textContent=msg; }
  o.style.display='flex';
}
function glkHideDashboardLoading(){
  var o=el('dashboardLoadingOverlay'); if(o) o.style.display='none';
}
function glkOnPipelineLoadProgress(count){
  var lt=el('glkLoaderText');
  if(lt&&count) lt.textContent='Loading your pipeline… '+count+' records';
  var t=el('dashboardLoadingText');
  if(t&&count) t.textContent='Loading pipeline from SharePoint… '+count+' records';
}
function glkOnPipelineReady(){
  glkHideDashboardLoading();
  glkHideLoader();
  if(window._glkClearLoaderSafety){
    clearTimeout(window._glkClearLoaderSafety);
    window._glkClearLoaderSafety=null;
  }
}
function launchDashboard(){
  saveLastVisit();
  glkShowLoader('Loading your pipeline…');
  if(window._glkClearLoaderSafety) clearTimeout(window._glkClearLoaderSafety);
  window._glkClearLoaderSafety=setTimeout(function(){ glkHideLoader(); },65000);

  document.getElementById('landingPage').style.cssText='display:none!important';
  el('dashboardContent').style.display='flex';
  el('dashboardContent').style.flexDirection='column';
  set('dbUserBadge',USER.name+' · '+USER.role);
  glkApplyRoleUI();
  el('currentDate').textContent=new Date().toLocaleDateString('en-US',{weekday:'short',year:'numeric',month:'short',day:'numeric'});
  try{
    const bt=localStorage.getItem('glk_base_theme')||'magenta';
    const dm=localStorage.getItem('glk_dark_mode')==='true';
    const sel=el('colorSchemeSelector'); if(sel) sel.value=bt;
    applyTheme(bt,dm);
  }catch(e){}

  window._glkPipelineReady=false;
  window._glkPipelineLoading=false;
  window._glkPipelineLoadStarted=false;
  window._GLK_BRIDGE_MENU_LOADED=false;
  window._GLK_TRENDS_SP_LOADED=false;

  glkShowDashboard();
  loadData();
  rrInitView(true);
  glkEnterFullscreen();

  setTimeout(function(){
    if(USER.email.toLowerCase()==='tehleel.lone@du.ae') glkInitViewAs();
  },1500);
}

function glkInitViewAs(){
  if(document.getElementById('viewAsPanel')) return;
  if(USER.email.toLowerCase()!=='tehleel.lone@du.ae') return;
  const panel=document.createElement('div');
  panel.id='viewAsPanel';
  panel.style.cssText='position:fixed;bottom:16px;left:16px;z-index:999999;background:var(--bg-card);border:2px solid var(--border-s);border-radius:14px;padding:12px 16px;box-shadow:0 8px 32px rgba(0,0,0,0.35);font-family:Inter,sans-serif;font-size:.78rem;min-width:320px;';
  panel.innerHTML=`
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
      <div style="font-weight:800;font-size:.82rem;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">
        🔍 View As &nbsp;<span style="font-size:.65rem;background:rgba(168,85,247,.15);border:1px solid rgba(168,85,247,.4);color:var(--acc);padding:2px 8px;border-radius:20px;font-weight:700;-webkit-text-fill-color:var(--acc);">ADMIN ONLY</span>
      </div>
      <div onclick="document.getElementById('viewAsPanel').classList.toggle('va-collapsed')" style="cursor:pointer;width:22px;height:22px;border-radius:50%;border:1px solid var(--border);background:var(--bg-secondary);display:flex;align-items:center;justify-content:center;font-size:.7rem;color:var(--t3);">▼</div>
    </div>
    <div id="vaBody">
      <div id="vaCurrentUser" style="font-size:.72rem;color:var(--t3);padding:6px 10px;background:var(--bg-secondary);border-radius:7px;border:1px solid var(--border);margin-bottom:8px;">
        Viewing as: <strong style="color:var(--acc)">${USER.email}</strong> · <strong style="color:var(--acc)">${USER.role}</strong>
      </div>
      <div style="display:flex;gap:.5rem;margin-bottom:8px;">
        <input type="text" id="vaEmailInput" placeholder="email@du.ae"
          style="flex:1;padding:.4rem .7rem;border-radius:8px;border:1px solid var(--border);background:var(--bg-input);color:var(--t1);font-size:.78rem;font-family:inherit;"
          onkeydown="if(event.key==='Enter')glkViewAs()">
        <select id="vaRoleOverride"
          style="padding:.4rem .6rem;border-radius:8px;border:1px solid var(--border);background:var(--bg-input);color:var(--t1);font-size:.78rem;font-family:inherit;">
          <option value="">Auto</option>
          <option value="Admin">Admin</option>
          <option value="Viewer">Viewer</option>
          <option value="Head Director">Head Director</option>
          <option value="Account Director">Account Director</option>
          <option value="Account Manager">Account Manager</option>
        </select>
      </div>
      <div style="display:flex;gap:.5rem;margin-bottom:6px;">
        <button onclick="glkViewAs()" style="flex:1;padding:.4rem 1rem;border-radius:8px;background:var(--grad);color:#fff;border:none;font-size:.78rem;font-weight:700;cursor:pointer;font-family:inherit;">Apply View</button>
      </div>
      <button id="vaRestoreBtn" onclick="glkRestoreMyView()"
        style="display:none;width:100%;margin-top:4px;padding:.38rem;border-radius:8px;background:var(--bg-secondary);color:var(--t2);border:1px solid var(--border);font-size:.76rem;font-weight:700;cursor:pointer;font-family:inherit;text-align:center;">
        ↩ Restore My View (${USER.email})
      </button>
      <div id="vaLog" style="margin-top:8px;font-size:.68rem;color:var(--t3);max-height:50px;overflow-y:auto;"></div>
    </div>`;
  document.body.appendChild(panel);
  const s=document.createElement('style');
  s.innerHTML='#viewAsPanel.va-collapsed #vaBody{display:none}';
  document.head.appendChild(s);
}

let _realUser=null;

function glkViewAs(){
  const email=(document.getElementById('vaEmailInput').value||'').trim();
  const roleOv=document.getElementById('vaRoleOverride').value;
  if(!email){document.getElementById('vaLog').innerHTML='⚠ Enter an email';return;}

  document.getElementById('vaLog').innerHTML='⏳ Looking up '+email+'...';
  if(!_realUser) _realUser={email:USER.email,name:USER.name,role:USER.role};

  // Step 1: Get real display name from SharePoint
  spGet(SP_SITE+"/_api/web/siteusers?$filter=Email eq '"+email+"'&$select=Title,Email",
    function(err,userData){
      const resolvedName=(!err&&userData.d.results.length)
        ?userData.d.results[0].Title
        :email.split('@')[0].replace(/\./g,' ').replace(/\b\w/g,c=>c.toUpperCase());

      // Step 2: Get role from access list
      spGet(SP_SITE+"/_api/web/lists/getbytitle('"+SP_ACCESS+"')/items?$select=UserEmailID,Role&$filter=UserEmailID eq '"+email+"'",
        function(err2,data){
          let role=roleOv;
          if(!err2&&data.d.results.length){
            role=(data.d.results[0].Role||'').trim();
            document.getElementById('vaLog').innerHTML='✓ Found: '+resolvedName+' · '+role;
          } else if(!role){
            document.getElementById('vaLog').innerHTML='⚠ Not in access list. Select role manually.';
            return;
          }

          USER.email=email;
          USER.name=resolvedName;
          USER.role=role;

          el('dashboardContent').style.cssText='display:none!important';
          el('landingPage').style.cssText='display:flex!important';
          el('lAvatar').textContent=getInitials(resolvedName);
          set('lName',resolvedName);
          set('lEmail',email);
          set('lRole',role+' (Spoofed)');
          set('lLastVisit',getLastVisit());

          const btn=el('launchBtn');
          btn.disabled=false;
          btn.innerHTML='<span class="btn-icon"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg></span><span class="btn-text">Open as '+resolvedName+'</span><span class="btn-shine"></span>';
          btn.onclick=function(){glkLaunchSpoofed();};
          el('accessNote').innerHTML='<svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:#f97316;fill:none;stroke-width:2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg><span style="color:#f97316;font-weight:600;">👁 Spoofed as '+resolvedName+'</span>';
          document.getElementById('vaLog').innerHTML='✓ Ready. Click Launch to enter as '+resolvedName+' ('+role+')';
        }
      );
    }
  );
}function glkRestoreMyView(){
  if(!_realUser) return;
  USER.email=_realUser.email;
  USER.name=_realUser.name;
  USER.role=_realUser.role;

  // Go back to landing as real user
  el('dashboardContent').style.cssText='display:none!important';
  el('landingPage').style.cssText='display:flex!important';

  el('lAvatar').textContent=getInitials(USER.name);
  set('lName',USER.name);
  set('lEmail',USER.email);
  set('lRole',USER.role);
  set('lLastVisit',getLastVisit());

  const btn=el('launchBtn');
  btn.disabled=false;
  btn.innerHTML='<span class="btn-icon"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg></span><span class="btn-text">Go to Dashboard</span><span class="btn-shine"></span>';
  btn.onclick=launchDashboard;
  el('accessNote').innerHTML='<svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:#16a34a;fill:none;stroke-width:2"><polyline points="20 6 9 17 4 12"/></svg><span style="color:#16a34a;font-weight:600;">Access verified</span>';

  el('vaRestoreBtn').style.display='none';
  el('vaCurrentUser').innerHTML='Viewing as: <strong style="color:var(--acc)">'+USER.email+'</strong> · <strong style="color:var(--acc)">'+USER.role+'</strong>';
  document.getElementById('vaLog').innerHTML='↩ Restored to '+USER.email;
}
function glkLaunchSpoofed(){
  saveLastVisit();
  el('landingPage').style.cssText='display:none!important';
  el('dashboardContent').style.display='flex';
  el('dashboardContent').style.flexDirection='column';
  
  set('dbUserBadge','👁 '+USER.name+' · '+USER.role+' (Spoofed)');
  el('dbUserBadge').style.color='#f97316';
  el('dbUserBadge').style.fontWeight='800';

  el('currentDate').textContent=new Date().toLocaleDateString('en-US',{weekday:'short',year:'numeric',month:'short',day:'numeric'});

  glkApplyRoleUI();
  try{
    const bt=localStorage.getItem('glk_base_theme')||'magenta';
    const dm=localStorage.getItem('glk_dark_mode')==='true';
    const sel=el('colorSchemeSelector'); if(sel) sel.value=bt;
    applyTheme(bt,dm);
  }catch(e){}

  window._glkPipelineReady=false;
  window._glkPipelineLoading=false;
  window._glkPipelineLoadStarted=false;
  window._GLK_BRIDGE_MENU_LOADED=false;
  window._GLK_TRENDS_SP_LOADED=false;
  resetAll();
  buildFilters();
  applyRoleLocks();
  glkShowDashboard();
  loadData();
  rrInitView(true);
  glkEnterFullscreen();

  // Re-show the View-As panel with restore button visible
  setTimeout(function(){
    const cur=el('vaCurrentUser');
    if(cur) cur.innerHTML='👁 Spoofed: <strong style="color:#f97316">'+USER.email+'</strong> · <strong style="color:#f97316">'+USER.role+'</strong>';
    const rb=el('vaRestoreBtn');
    if(rb) rb.style.display='block';
  },200);
}
function glkIsAdminRole(){
  var role=String(USER&&USER.role||'').trim();
  return role==='Admin'||role==='CEO'||role.toLowerCase().indexOf('admin')>=0;
}
function glkApplyAdminOnlyControls(){
  var show=glkIsAdminRole();
  document.querySelectorAll('.glk-admin-only').forEach(function(n){
    n.style.display=show?'':'none';
  });
}
function glkApplyRoleUI(){
  const role=USER.role;
  ['navMobileQtd','navRevenueRec','navGovernance'].forEach(function(id){
    var n=el(id);
    if(n) n.style.display='flex';
  });
  const hds=el('hd-section-nav');
  if(hds) hds.style.display=(role==='Account Director'||role==='Account Manager'||role==='Viewer')?'none':'block';
  const pft=el('pfTabs');
  if(pft) pft.style.display='flex';
  glkApplyAdminOnlyControls();
}
// ══════════════════════════════════════════════════════════════════
//  DEV CONSOLE — login as any email
// ══════════════════════════════════════════════════════════════════
// Activate with: Ctrl+Shift+D
document.addEventListener('keydown',function(e){
  if(e.ctrlKey&&e.shiftKey&&e.key==='D'){
    const dc=el('devConsole'); dc.style.display=dc.style.display==='none'?'flex':'none';
  }
});
function devLogin(){
  const email=el('devEmailInput').value.trim();
  if(!email){ alert('Enter an email'); return; }
  USER.email=email;
  USER.name=email.split('@')[0].replace(/\./g,' ').replace(/\b\w/g,c=>c.toUpperCase());
USER.role=el('devRoleInput').value.trim()||'Admin';  el('devConsole').style.display='none';
  // Bypass SP and launch directly
  el('lAvatar').textContent=getInitials(USER.name);
  set('lName',USER.name); set('lEmail',USER.email); set('lRole',USER.role+' (Dev)');
  set('lLastVisit',getLastVisit());
  const btn=el('launchBtn');
  btn.disabled=false;
  btn.innerHTML='<span class="btn-text">Go to Dashboard (Dev)</span>';
  btn.onclick=launchDashboard;
  el('landingPage').style.display='flex';
  console.log('[DEV] Logged in as:',USER.email);
}
// Also expose as console function: window.loginAs('email@x.com')
window.loginAs=function(email,role){
  el('devEmailInput').value=email;
  if(role) USER.role=role;
  devLogin();
};

// ══════════════════════════════════════════════════════════════════
//  LOAD DATA
// ══════════════════════════════════════════════════════════════════
function loadData(){
  window._glkPipelineLoadStarted=true;
  window._glkPipelineReady=false;
  window._glkPipelineLoading=true;
  glkShowLoader('Loading your pipeline…');
  const select=[
    'Id','Title','Type_x0020_of_x0020_Request','Type_x0020_of_x0020_Contract',
    'Segment','Account_x0020_Director','Solution_x0020_Manager','Head_x0020_Director',
    'Product_x0020_Family','Product_x0020_Category','Services','Gross_x0020_Adds',
    'Monthly_x0020_Recurring_x0020_Ch','One_x0020_Time_x0020_Charges_x00',
    'Contract_x0020_Duration','Total_x0020_Contact_x0020_Value_','Opportunity_x0020_Status',
    'Closure_x0020_Probability','Expected_x0020_Contract_x0020_Si','Actual_x0020_Contract_x0020_Sign',
    'Proposed_x0020_Date','No_x0020_Bid_x002f_Lost_x002f_Ca','BilledDate','Lost_x0020_Reason',
    'CustomerCode','Complexity','BidManager','ProjectManager0','field5','field8',
    'BidRequest','Comments_x002f_Remarks','POCName','POCEmailID','ContactNo',
    'MNP','Third_x0020_Party','Vendor_x0020_Name','GA_x0020_Lines',
    'RFP_x0020_Submission_x0020_Date','SolutionAssignedDate',
    'Building_x0020_Name','Building_x0020_Unit','Building_x0020_Floor','field3','field6','field4',
    'BidManagerRequired','SolutionManagerRequired','ServiceRequirement','RFPs',
    'M2M_x0020_Use_x0020_Case','M2M_x0020_Customer_x0020_Type','M2M_x0020_Industry_x0020_Vertica',
    'My_x0020_ID','UserName','BMassingedDate','Forecast_Category0',
    'Created','Modified',
    'group/Title','group/EMail'
  ].join(',');

  let allResults=[];
  mqInitSpListEditUrl(function(){});

  function fetchPage(url){
    spGet(url,function(err,data){
      if(err){
        console.error('Data load error:',err);
        ALL_BIDS=[];
        remapBlankHD();
        buildFilters();
        applyAll();
        window._glkPipelineLoading=false;
        window._glkPipelineReady=true;
        glkOnPipelineReady();
        glkRestoreActiveNav();
        return;
      }
      allResults=allResults.concat(data.d.results);
      console.log('[GLK] Fetched so far:',allResults.length);
      glkOnPipelineLoadProgress(allResults.length);
      if(data.d.__next){
        fetchPage(data.d.__next);
      } else {
        console.log('[GLK] All records loaded:',allResults.length);
        ALL_BIDS=allResults.map(mapItem);
        remapBlankHD();
        buildFilters();
        applyAll();
        window._glkPipelineLoading=false;
        window._glkPipelineReady=true;
        glkOnPipelineReady();
        glkRestoreActiveNav();
        if((GLK_ACTIVE_NAV==='navGovernance'||window._PG_AUTO_LOAD_PENDING)&&!PG_LOADING){
          pgStartGovernanceLoad(false);
        }
        if(GLK_ACTIVE_NAV==='navMobileQtd'){
          try{ if(mqGetActiveReport()) renderMobileQtdBridge(); }catch(e){}
        }
        if(GLK_ACTIVE_NAV==='navRevenueRec'){
          try{ glkPaintTrends(); }catch(e){}
        }
      }
    });
  }

  const firstUrl=SP_SITE+
    "/_api/web/lists/getbytitle('"+SP_LIST+"')/items"+
    "?$select="+encodeURIComponent(select)+
    "&$expand=group"+
    "&$filter=Created ge '2024-01-01T00:00:00Z' or "+
    "Expected_x0020_Contract_x0020_Si ge '2024-01-01T00:00:00Z' or "+
    "Actual_x0020_Contract_x0020_Sign ge '2024-01-01T00:00:00Z' or "+
    "Proposed_x0020_Date ge '2024-01-01T00:00:00Z' or "+
    "No_x0020_Bid_x002f_Lost_x002f_Ca ge '2024-01-01T00:00:00Z' or "+
    "BilledDate ge '2024-01-01T00:00:00Z' or "+
    "Modified ge '2024-01-01T00:00:00Z'"+
    "&$top=5000&$orderby=Id asc";

  fetchPage(firstUrl);
}function mapItem(it){
  const rawFC=(it.Forecast_Category0||'').trim();
  const rawProb=it.Closure_x0020_Probability||'—';
  const rawStatus=(it.Opportunity_x0020_Status||'—').trim();
  const forecastCategory=glkResolveForecastCategory(rawFC,rawProb);
  let closureProb=rawProb;
  let status=rawStatus;
  if(forecastCategory&&FORECAST_TO_PROB[forecastCategory]) closureProb=FORECAST_TO_PROB[forecastCategory];
  if(forecastCategory&&FORECAST_TO_STATUS[forecastCategory]) status=FORECAST_TO_STATUS[forecastCategory];
  return {
    id:it.Id,customerName:it.Title||'—',typeOfRequest:it.Type_x0020_of_x0020_Request||'—',
    oppStatus:rawStatus||'—',
    typeOfContract:it.Type_x0020_of_x0020_Contract||'—',vertical:it.Segment||'—',
    accountDirector:it.Account_x0020_Director||'—',solutionManager:it.Solution_x0020_Manager||'—',
   headDirector:it.Head_x0020_Director||'(Blank)',productFamily:it.Product_x0020_Family||'—',
    productCategory:it.Product_x0020_Category||'—',services:it.Services||'—',
    gaPoints:num(it.Gross_x0020_Adds),mrc:num(it.Monthly_x0020_Recurring_x0020_Ch),
    otc:num(it.One_x0020_Time_x0020_Charges_x00),duration:it.Contract_x0020_Duration||'—',
    tcv:num(it.Total_x0020_Contact_x0020_Value_),status:status,
    closureProb:closureProb,forecastCategory:forecastCategory||'—',
    expectedActivation:it.Expected_x0020_Contract_x0020_Si||null,
    contractSigned:it.Actual_x0020_Contract_x0020_Sign||null,
    proposedDate:it.Proposed_x0020_Date||null,lostDate:it.No_x0020_Bid_x002f_Lost_x002f_Ca||null,
    billedDate:it.BilledDate||null,lostReason:it.Lost_x0020_Reason||'—',
    customerCode:it.CustomerCode||'—',complexity:it.Complexity||'—',
    bidManager:it.BidManager||'—',projectManager:it.ProjectManager0||'—',
    pcv:num(it.field5),prepaidPostpaid:it.field8||'—',
    bidRequest:it.BidRequest||'—',comments:it.Comments_x002f_Remarks||'—',
    pocName:it.POCName||'—',pocEmail:it.POCEmailID||'—',contactNo:it.ContactNo||'—',
    mnp:it.MNP||'—',thirdParty:it.Third_x0020_Party||'—',vendorName:it.Vendor_x0020_Name||'—',
    gaLines:num(it.GA_x0020_Lines),rfpSubmissionDate:it.RFP_x0020_Submission_x0020_Date||null,
    solutionAssignedDate:it.SolutionAssignedDate||null,
    buildingName:it.Building_x0020_Name||'—',buildingUnit:it.Building_x0020_Unit||'—',
    buildingFloor:it.Building_x0020_Floor||'—',buildingStatus:it.field3||'—',
    churnReason:it.field6||'—',pocJobRole:it.field4||'—',
    bidManagerRequired:it.BidManagerRequired||'—',solutionManagerRequired:it.SolutionManagerRequired||'—',
    serviceRequirement:it.ServiceRequirement||'—',rfps:it.RFPs||'—',
    m2mUseCase:it.M2M_x0020_Use_x0020_Case||'—',m2mCustomerType:it.M2M_x0020_Customer_x0020_Type||'—',
    m2mIndustryVertical:it.M2M_x0020_Industry_x0020_Vertica||'—',
    myId:it.My_x0020_ID||'—',userName:it.UserName||'—',bmAssignedDate:it.BMassingedDate||null,
    amName:it.group?(it.group.Title||'—'):'—',amEmail:it.group?(it.group.EMail||''):'',
    created:it.Created||null,modified:it.Modified||null,
  };
}

// ══════════════════════════════════════════════════════════════════
//  FILTERS
// ══════════════════════════════════════════════════════════════════
const FILTER_DEFS=[
  {key:'typeOfRequest',label:'Type of Request'},
  {key:'typeOfContract',label:'Type of Contract'},
  {key:'vertical',label:'Vertical'},
  {key:'status',label:'Opp. Status'},
  {key:'closureProb',label:'Closure Probability'},
  {key:'forecastCategory',label:'Forecast Category'},
];
const MONTH_NAMES=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const GLK_DATE_FIELD_OPTS=[
  {key:'created',label:'Created'},
  {key:'contractSigned',label:'Won Date (Contract Signed)'},
  {key:'billedDate',label:'Billed Date'},
  {key:'expectedActivation',label:'Expected Activation'},
  {key:'proposedDate',label:'Proposed Date'},
  {key:'lostDate',label:'Lost / Cancelled Date'},
  {key:'rfpSubmissionDate',label:'RFP Submission Date'},
  {key:'solutionAssignedDate',label:'Solution Assigned Date'},
  {key:'bmAssignedDate',label:'BM Assigned Date'},
  {key:'modified',label:'Last Modified'},
];
let glkDateRules=[];
let glkCompareEnabled=false;
let glkCompareYear=String(new Date().getFullYear()-1);
let glkRuleSeq=0;
let glkThisYearEnabled=true;

function glkDefaultDateRule(field){
  return {id:'r'+(glkRuleSeq++),dateField:field||'created',dateMode:'any',from:'',to:'',specific:'',ytdYear:'',years:[],quarters:[],months:[],weeks:[]};
}
function glkThisYearRule(){
  return {id:'r'+(glkRuleSeq++),dateField:'expectedActivation',dateMode:'period',from:'',to:'',specific:'',ytdYear:'',years:[String(new Date().getFullYear())],quarters:[],months:[],weeks:[]};
}
function glkApplyThisYearRule(){
  if(glkThisYearEnabled) glkDateRules=[glkThisYearRule()];
  else glkDateRules=[glkDefaultDateRule('created')];
  glkBuildDateFilters();
  onDateFilterChange();
}
window.glkToggleThisYear=function(){
  glkThisYearEnabled=!!(el('glkThisYearToggle')&&el('glkThisYearToggle').checked);
  glkApplyThisYearRule();
};
function glkTileMetricTotals(bids){
  return {
    count:bids.length,
    mrc:bids.reduce(function(s,b){return s+b.mrc;},0),
    otc:bids.reduce(function(s,b){return s+b.otc;},0),
    tcv:bids.reduce(function(s,b){return s+b.tcv;},0),
    gaLines:bids.reduce(function(s,b){return s+(b.gaLines||0);},0),
    gaPoints:bids.reduce(function(s,b){return s+b.gaPoints;},0)
  };
}
function glkTopStatMetricsHtml(grp,isMobile){
  var t=glkTileMetricTotals(grp);
  var rows=isMobile?[
    ['GA Lines',fmtLines(t.gaLines)],
    ['MRC',fmt(t.mrc)],
    ['TCV',fmt(t.tcv)],
    ['GA Points',fmtGA(t.gaPoints)],
    ['OTC',fmt(t.otc)]
  ]:[
    ['MRC',fmt(t.mrc)],
    ['OTC',fmt(t.otc)],
    ['TCV',fmt(t.tcv)]
  ];
  return rows.map(function(pair){
    return '<div style="display:flex;justify-content:space-between;font-size:.86rem;"><span style="color:var(--t2);font-weight:700;">'+pair[0]+'</span><span style="font-weight:800;color:var(--t1);">'+pair[1]+'</span></div>';
  }).join('');
}
function glkLmStatusHtml(billed,won,lost,ip){
  return '<div class="lm-status-grid">'+
    '<div><span class="lm-status-lbl">Billed:</span> <strong class="lm-status-val">'+billed+'</strong></div>'+
    '<div><span class="lm-status-lbl">Won:</span> <strong class="lm-status-val won">'+won+'</strong></div>'+
    '<div><span class="lm-status-lbl">Lost:</span> <strong class="lm-status-val lost">'+lost+'</strong></div>'+
    '<div><span class="lm-status-lbl">In progress:</span> <strong class="lm-status-val">'+ip+'</strong></div></div>';
}
function glkLmMetricBreakdownHtml(bids,isMobile){
  var t=glkTileMetricTotals(bids);
  if(isMobile){
    return '<div class="lm-revenue-breakdown">'+
      '<div class="lm-revenue-item"><div class="lm-revenue-item-label">MRC</div><div class="lm-revenue-item-value">'+fmt(t.mrc)+'</div></div>'+
      '<div class="lm-revenue-item"><div class="lm-revenue-item-label">GA Points</div><div class="lm-revenue-item-value">'+fmtGA(t.gaPoints)+'</div></div>'+
      '<div class="lm-revenue-item"><div class="lm-revenue-item-label">OTC</div><div class="lm-revenue-item-value">'+fmt(t.otc)+'</div></div>'+
      '<div class="lm-revenue-item"><div class="lm-revenue-item-label">TCV</div><div class="lm-revenue-item-value">'+fmt(t.tcv)+'</div></div></div>';
  }
  return '<div class="lm-revenue-breakdown">'+
    '<div class="lm-revenue-item"><div class="lm-revenue-item-label">OTC</div><div class="lm-revenue-item-value">'+fmt(t.otc)+'</div></div>'+
    '<div class="lm-revenue-item"><div class="lm-revenue-item-label">TCV</div><div class="lm-revenue-item-value">'+fmt(t.tcv)+'</div></div></div>';
}
function glkLmProgressHtml(s,billedCount,isMobile){
  var contribLabel=isMobile?'Pipeline share':'Pipeline share';
  var contribPct=s.contribPct;
  var metricPct=isMobile?s.gaLinesPct:s.mrcPct;
  var metricLabel=isMobile?'GA Lines share':'MRC share';
  return '<div class="lm-progress-section">'+
    '<div class="lm-progress-row"><span class="lm-progress-label">Billed ratio</span><span class="lm-progress-value">'+(s.total?(billedCount/s.total*100).toFixed(1):0)+'%</span></div>'+
    '<div class="progress-bar"><div class="progress-fill" style="width:'+(s.total?(billedCount/s.total*100).toFixed(1):0)+'%"></div></div>'+
    '<div class="lm-progress-row"><span class="lm-progress-label">'+contribLabel+'</span><span class="lm-progress-value">'+contribPct+'%</span></div>'+
    '<div class="progress-bar"><div class="progress-fill" style="width:'+contribPct+'%"></div></div>'+
    '<div class="lm-progress-row"><span class="lm-progress-label">'+metricLabel+'</span><span class="lm-progress-value">'+metricPct+'%</span></div>'+
    '<div class="progress-bar"><div class="progress-fill" style="width:'+metricPct+'%"></div></div></div>';
}
function glkBidDateValue(bid,field){ return bid&&field?bid[field]||null:null; }
function glkWeekOfMonth(d){ if(!(d instanceof Date)||isNaN(d)) return null; return Math.ceil(d.getDate()/7); }
function glkDateMeta(iso){
  if(!iso) return null;
  const d=new Date(iso); if(isNaN(d)) return null;
  const y=d.getFullYear(),mi=d.getMonth();
  return {year:y,quarter:Math.floor(mi/3)+1,monthIndex:mi,week:glkWeekOfMonth(d),dayStart:new Date(y,mi,d.getDate()).getTime()};
}
function glkDateFieldLabel(key){ const o=GLK_DATE_FIELD_OPTS.find(x=>x.key===key); return o?o.label:key; }
function glkDateModeHint(mode){
  if(mode==='range') return 'Start and end date — both days included.';
  if(mode==='single') return 'Records on exactly one day.';
  if(mode==='period') return 'Combine year, quarter, month, week.';
  if(mode==='ytd') return '1 Jan through today for selected year.';
  return 'Choose a filter mode to activate this criterion.';
}
function glkRulePrefix(id){ return 'glkR_'+id; }
function glkGetSelectVal(id){ const e=el(id); return e?String(e.value||'').trim():''; }
function glkGetRuleChecked(ruleId,part){
  const drop=el(glkRulePrefix(ruleId)+'_'+part);
  if(!drop) return [];
  return Array.from(drop.querySelectorAll('input:checked')).map(c=>c.value);
}
function glkUpdateRuleMsText(ruleId,part,label){
  const checked=glkGetRuleChecked(ruleId,part);
  const te=el(glkRulePrefix(ruleId)+'_'+part+'Text'); if(!te) return;
  if(!checked.length){ te.textContent='All '+label; return; }
  if(checked.length===1){
    if(part==='quarter') te.textContent='Q'+checked[0];
    else if(part==='month') te.textContent=MONTH_NAMES[+checked[0]]||checked[0];
    else if(part==='week') te.textContent='W'+checked[0];
    else te.textContent=checked[0];
    return;
  }
  te.textContent=checked.length+' selected';
}
function glkToggleRuleMs(ruleId,part){
  const drop=el(glkRulePrefix(ruleId)+'_'+part),trig=el(glkRulePrefix(ruleId)+'_'+part+'Trig');
  if(!drop||!trig) return;
  const isOpen=drop.classList.contains('open');
  document.querySelectorAll('.glk-date-rule .ms-dropdown.open').forEach(d=>{d.classList.remove('open');if(d.previousElementSibling)d.previousElementSibling.classList.remove('open');});
  if(!isOpen){
    const rect=trig.getBoundingClientRect();
    drop.style.top=(rect.bottom+4)+'px';drop.style.left=rect.left+'px';
    drop.style.width=Math.max(rect.width,180)+'px';
    drop.classList.add('open');trig.classList.add('open');
  }
}
function glkBuildRuleMs(ruleId,part,label,values,selected,labelFn){
  const drop=el(glkRulePrefix(ruleId)+'_'+part); if(!drop) return;
  const selSet={}; (selected||[]).forEach(v=>{selSet[String(v)]=true;});
  drop.innerHTML=values.map(function(val){
    const disp=labelFn?labelFn(val):val;
    const cid=glkRulePrefix(ruleId)+'_'+part+'_'+String(val).replace(/\W/g,'_');
    return '<div class="ms-option" onclick="event.stopPropagation()"><input type="checkbox" id="'+cid+'" value="'+val+'"'+(selSet[String(val)]?' checked':'')+' onchange="glkUpdateRuleMsText(\''+ruleId+'\',\''+part+'\',\''+label+'\');onDateFilterChange()"><label for="'+cid+'">'+disp+'</label></div>';
  }).join('');
  glkUpdateRuleMsText(ruleId,part,label);
}
function glkCollectDateMetas(items,field){
  const metas=[];
  (items||[]).forEach(function(b){ const meta=glkDateMeta(glkBidDateValue(b,field)); if(meta) metas.push(meta); });
  return metas;
}
function glkPopulateRulePeriodDropdowns(rule,items){
  const field=rule.dateField||'created';
  const metas=glkCollectDateMetas(items,field);
  const ySel=rule.years||[], qSel=rule.quarters||[], mSel=rule.months||[];
  const years=[],quarters=[],months=[],weeks=[];
  metas.forEach(function(m){ const ys=String(m.year); if(years.indexOf(ys)<0) years.push(ys); });
  years.sort((a,b)=>parseInt(b,10)-parseInt(a,10));
  metas.forEach(function(m){
    if(ySel.length&&ySel.indexOf(String(m.year))<0) return;
    const qs=String(m.quarter); if(quarters.indexOf(qs)<0) quarters.push(qs);
  });
  quarters.sort((a,b)=>parseInt(a,10)-parseInt(b,10));
  metas.forEach(function(m){
    if(ySel.length&&ySel.indexOf(String(m.year))<0) return;
    if(qSel.length&&qSel.indexOf(String(m.quarter))<0) return;
    const ms=String(m.monthIndex); if(months.indexOf(ms)<0) months.push(ms);
  });
  months.sort((a,b)=>parseInt(a,10)-parseInt(b,10));
  metas.forEach(function(m){
    if(ySel.length&&ySel.indexOf(String(m.year))<0) return;
    if(qSel.length&&qSel.indexOf(String(m.quarter))<0) return;
    if(mSel.length&&mSel.indexOf(String(m.monthIndex))<0) return;
    if(m.week!=null){ const ws=String(m.week); if(weeks.indexOf(ws)<0) weeks.push(ws); }
  });
  weeks.sort((a,b)=>parseInt(a,10)-parseInt(b,10));
  glkBuildRuleMs(rule.id,'year','Years',years,rule.years);
  glkBuildRuleMs(rule.id,'quarter','Quarters',quarters,rule.quarters,v=>'Q'+v);
  glkBuildRuleMs(rule.id,'month','Months',months,rule.months,v=>MONTH_NAMES[+v]||v);
  glkBuildRuleMs(rule.id,'week','Weeks',weeks,rule.weeks,v=>'W'+v);
}
function glkReadDateRuleFromDom(ruleId){
  const p=glkRulePrefix(ruleId);
  return {
    id:ruleId,
    dateField:glkGetSelectVal(p+'Field')||'created',
    dateMode:glkGetSelectVal(p+'Mode')||'any',
    from:glkGetSelectVal(p+'From'),to:glkGetSelectVal(p+'To'),specific:glkGetSelectVal(p+'Specific'),
    ytdYear:glkGetSelectVal(p+'YtdYear'),
    years:glkGetRuleChecked(ruleId,'year'),quarters:glkGetRuleChecked(ruleId,'quarter'),
    months:glkGetRuleChecked(ruleId,'month'),weeks:glkGetRuleChecked(ruleId,'week'),
  };
}
function glkReadAllDateRules(){ return glkDateRules.map(r=>glkReadDateRuleFromDom(r.id)); }
function glkSyncRuleModeUI(ruleId){
  const p=glkRulePrefix(ruleId), mode=glkGetSelectVal(p+'Mode')||'any';
  ['Range','Single','Period','Ytd'].forEach(function(suffix){
    const g=el(p+suffix+'Group'); if(g) g.style.display=(mode===suffix.toLowerCase()?'grid':'none');
  });
  const hint=el(p+'Hint'); if(hint) hint.textContent=glkDateModeHint(mode);
}
function glkApplyDateRule(bid,rule){
  if(!rule||rule.dateMode==='any') return true;
  const meta=glkDateMeta(glkBidDateValue(bid,rule.dateField));
  if(!meta) return false;
  if(rule.dateMode==='range'){
    if(rule.from){ const fromD=new Date(rule.from); if(!isNaN(fromD)){ fromD.setHours(0,0,0,0); if(meta.dayStart<fromD.getTime()) return false; } }
    if(rule.to){ const toD=new Date(rule.to); if(!isNaN(toD)){ toD.setHours(23,59,59,999); if(meta.dayStart>toD.getTime()) return false; } }
    return true;
  }
  if(rule.dateMode==='single'){
    if(!rule.specific) return true;
    const spec=new Date(rule.specific); if(isNaN(spec)) return true;
    spec.setHours(0,0,0,0); return meta.dayStart===spec.getTime();
  }
  if(rule.dateMode==='ytd'){
    const yr=parseInt(rule.ytdYear||String(new Date().getFullYear()),10);
    if(meta.year!==yr) return false;
    const today=new Date(); today.setHours(23,59,59,999);
    const ytdEnd=(yr===today.getFullYear())?today.getTime():new Date(yr,11,31,23,59,59,999).getTime();
    return meta.dayStart>=new Date(yr,0,1).getTime()&&meta.dayStart<=ytdEnd;
  }
  if(rule.dateMode==='period'){
    if(rule.years&&rule.years.length&&rule.years.indexOf(String(meta.year))<0) return false;
    if(rule.quarters&&rule.quarters.length&&rule.quarters.indexOf(String(meta.quarter))<0) return false;
    if(rule.months&&rule.months.length&&rule.months.indexOf(String(meta.monthIndex))<0) return false;
    if(rule.weeks&&rule.weeks.length&&rule.weeks.indexOf(String(meta.week))<0) return false;
    return true;
  }
  return true;
}
function glkApplyDateRules(bids,rules){
  const active=(rules||[]).filter(r=>r.dateMode&&r.dateMode!=='any');
  if(!active.length) return bids;
  return bids.filter(b=>active.every(r=>glkApplyDateRule(b,r)));
}
function glkRuleIsActive(rule){ return rule&&rule.dateMode&&rule.dateMode!=='any'; }
function glkSummarizeRules(rules,compareYear){
  const active=(rules||[]).filter(glkRuleIsActive);
  if(!active.length) return 'All dates';
  return active.map(function(r){
    const fld=glkDateFieldLabel(r.dateField);
    const yr=compareYear||(r.ytdYear||(r.years&&r.years[0])||'');
    if(r.dateMode==='ytd') return fld+' YTD '+yr;
    if(r.dateMode==='range') return fld+' '+(r.from||'…')+' → '+(r.to||'…');
    if(r.dateMode==='single') return fld+' on '+r.specific;
    if(r.dateMode==='period'){
      const bits=[];
      const ys=compareYear?[compareYear]:(r.years||[]);
      if(ys.length) bits.push(ys.join(','));
      if(r.quarters&&r.quarters.length) bits.push('Q'+r.quarters.join(','));
      if(r.months&&r.months.length) bits.push(r.months.map(m=>MONTH_NAMES[+m]||m).join(','));
      return fld+' '+bits.join(' · ');
    }
    return fld;
  }).join(' + ');
}
function glkRulesForCompareYear(rules){
  const cy=glkCompareYear||String(new Date().getFullYear()-1);
  return rules.map(function(r){
    const c=Object.assign({},r);
    if(r.dateMode==='period') c.years=[cy];
    else if(r.dateMode==='ytd') c.ytdYear=cy;
    else if(r.dateMode==='range'){
      const py=(r.years&&r.years[0])?parseInt(r.years[0],10):(r.from?new Date(r.from).getFullYear():new Date().getFullYear());
      const diff=parseInt(cy,10)-py;
      if(r.from){ const d=new Date(r.from); if(!isNaN(d)){ d.setFullYear(d.getFullYear()+diff); c.from=d.toISOString().slice(0,10); } }
      if(r.to){ const d=new Date(r.to); if(!isNaN(d)){ d.setFullYear(d.getFullYear()+diff); c.to=d.toISOString().slice(0,10); } }
    }
    return c;
  });
}
function glkQuickMetrics(bids){
  const pfTest=PF_FAMILIES[selPF];
  const scoped=(bids||[]).filter(b=>!pfTest||pfTest(b.productFamily));
  const won=scoped.filter(b=>STATUS_WON.includes(b.status));
  const lost=scoped.filter(b=>STATUS_LOST.includes(b.status));
  const ip=scoped.filter(b=>STATUS_IP.includes(b.status));
  return {count:scoped.length,tcv:scoped.reduce((s,b)=>s+b.tcv,0),won:won.length,lost:lost.length,ip:ip.length,mrc:scoped.reduce((s,b)=>s+b.mrc,0)};
}
function glkFmtDelta(a,b){ if(!b) return a>0?'+100%':'—'; return ((a-b)/b*100>0?'+':'')+((a-b)/b*100).toFixed(1)+'%'; }
function glkRenderCompareBanner(baseBids,rules){
  const banner=el('glkCompareBanner'); if(!banner) return;
  if(!glkCompareEnabled||!rules.some(glkRuleIsActive)){ banner.classList.remove('visible'); banner.innerHTML=''; return; }
  const mA=glkQuickMetrics(glkApplyDateRules(baseBids,rules));
  const mB=glkQuickMetrics(glkApplyDateRules(baseBids,glkRulesForCompareYear(rules)));
  banner.classList.add('visible');
  banner.innerHTML=
    '<div class="glk-compare-col primary"><div class="glk-compare-col-label">Current · '+glkSummarizeRules(rules)+'</div>'+
      '<div class="glk-compare-metric"><span>Opportunities</span><span>'+mA.count+'</span></div>'+
      '<div class="glk-compare-metric"><span>TCV</span><span>'+fmt(mA.tcv)+'</span></div>'+
      '<div class="glk-compare-metric"><span>Won / Billed</span><span>'+mA.won+'</span></div>'+
      '<div class="glk-compare-metric"><span>Pipeline</span><span>'+mA.ip+'</span></div>'+
      '<div class="glk-compare-metric"><span>MRC</span><span>'+fmt(mA.mrc)+'</span></div></div>'+
    '<div class="glk-compare-vs">vs</div>'+
    '<div class="glk-compare-col"><div class="glk-compare-col-label">Compare · '+glkSummarizeRules(rules,glkCompareYear)+'</div>'+
      '<div class="glk-compare-metric"><span>Opportunities</span><span>'+mB.count+'</span></div>'+
      '<div class="glk-compare-metric"><span>TCV</span><span>'+fmt(mB.tcv)+'</span></div>'+
      '<div class="glk-compare-metric"><span>Won / Billed</span><span>'+mB.won+'</span></div>'+
      '<div class="glk-compare-metric"><span>Pipeline</span><span>'+mB.ip+'</span></div>'+
      '<div class="glk-compare-metric"><span>MRC</span><span>'+fmt(mB.mrc)+'</span></div></div>'+
    '<div class="glk-compare-delta">'+
      '<span>Δ Opps: '+glkFmtDelta(mA.count,mB.count)+'</span>'+
      '<span>Δ TCV: '+glkFmtDelta(mA.tcv,mB.tcv)+'</span>'+
      '<span>Δ Won: '+glkFmtDelta(mA.won,mB.won)+'</span>'+
      '<span>Δ Pipeline: '+glkFmtDelta(mA.ip,mB.ip)+'</span></div>';
}
function glkRenderDateRuleCard(rule,index){
  const p=glkRulePrefix(rule.id), mode=rule.dateMode||'any';
  const fieldOpts=GLK_DATE_FIELD_OPTS.map(o=>'<option value="'+o.key+'"'+(rule.dateField===o.key?' selected':'')+'>'+o.label+'</option>').join('');
  const modeOpts=[
    {v:'any',l:'Any date'},{v:'ytd',l:'Year to date'},{v:'range',l:'Date range'},
    {v:'single',l:'Specific day'},{v:'period',l:'Year / quarter / month'},
  ].map(o=>'<option value="'+o.v+'"'+(mode===o.v?' selected':'')+'>'+o.l+'</option>').join('');
  const years=[...new Set(ALL_BIDS.map(b=>{const m=glkDateMeta(glkBidDateValue(b,rule.dateField));return m?String(m.year):null;}).filter(Boolean))].sort((a,b)=>parseInt(b,10)-parseInt(a,10));
  const ytdOpts=years.map(y=>'<option value="'+y+'"'+(String(rule.ytdYear||new Date().getFullYear())===y?' selected':'')+'>'+y+'</option>').join('');
  const ms=function(part,label){
    return '<div class="filter-group"><div class="filter-label">'+label+'</div><div class="ms-wrap"><div class="ms-trigger" id="'+p+'_'+part+'Trig" onclick="event.stopPropagation();glkToggleRuleMs(\''+rule.id+'\',\''+part+'\')"><span id="'+p+'_'+part+'Text">All '+label+'</span><svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></div><div class="ms-dropdown" id="'+p+'_'+part+'"></div></div></div>';
  };
  return '<div class="glk-date-rule" id="'+p+'Card">'+
    '<div class="glk-rule-header"><span class="glk-rule-title">Date criterion '+(index+1)+'</span>'+
      (glkDateRules.length>1?'<button type="button" class="glk-rule-remove" onclick="glkRemoveDateRule(\''+rule.id+'\')">Remove</button>':'')+
    '</div>'+
    '<div class="filter-bar-grid">'+
      '<div class="fb-group"><div class="fb-group-label">Date field</div><select class="fb-select" id="'+p+'Field" onchange="onDateFilterChange()">'+fieldOpts+'</select></div>'+
      '<div class="fb-group"><div class="fb-group-label">Filter by</div><select class="fb-select" id="'+p+'Mode" onchange="glkSyncRuleModeUI(\''+rule.id+'\');onDateFilterChange()">'+modeOpts+'</select></div>'+
    '</div>'+
    '<div class="glk-date-hint" id="'+p+'Hint">'+glkDateModeHint(mode)+'</div>'+
    '<div id="'+p+'RangeGroup" class="filter-bar-grid" style="display:'+(mode==='range'?'grid':'none')+';margin-top:.4rem;">'+
      '<div class="fb-group"><div class="fb-group-label">From</div><input type="date" class="fb-select" id="'+p+'From" value="'+(rule.from||'')+'" onchange="onDateFilterChange()"></div>'+
      '<div class="fb-group"><div class="fb-group-label">To</div><input type="date" class="fb-select" id="'+p+'To" value="'+(rule.to||'')+'" onchange="onDateFilterChange()"></div></div>'+
    '<div id="'+p+'SingleGroup" class="filter-bar-grid" style="display:'+(mode==='single'?'grid':'none')+';margin-top:.4rem;">'+
      '<div class="fb-group"><div class="fb-group-label">Day</div><input type="date" class="fb-select" id="'+p+'Specific" value="'+(rule.specific||'')+'" onchange="onDateFilterChange()"></div></div>'+
    '<div id="'+p+'YtdGroup" class="filter-bar-grid" style="display:'+(mode==='ytd'?'grid':'none')+';margin-top:.4rem;">'+
      '<div class="fb-group"><div class="fb-group-label">YTD year</div><select class="fb-select" id="'+p+'YtdYear" onchange="onDateFilterChange()">'+ytdOpts+'</select></div></div>'+
    '<div id="'+p+'PeriodGroup" class="filter-bar-grid" style="display:'+(mode==='period'?'grid':'none')+';margin-top:.4rem;">'+
      ms('year','Years')+ms('quarter','Quarters')+ms('month','Months')+ms('week','Weeks')+'</div></div>';
}
function glkBuildDateFilters(){
  if(!glkDateRules.length){
    glkDateRules=glkThisYearEnabled?[glkThisYearRule()]:[glkDefaultDateRule('created')];
  }
  const wrap=el('glkDateRulesWrap'); if(!wrap) return;
  wrap.innerHTML=glkDateRules.map((r,i)=>glkRenderDateRuleCard(r,i)).join('');
  glkDateRules.forEach(function(r){
    glkSyncRuleModeUI(r.id);
    glkPopulateRulePeriodDropdowns(glkReadDateRuleFromDom(r.id),ALL_BIDS);
  });
  const cySel=el('glkCompareYear');
  if(cySel){
    const yrs=[...new Set(ALL_BIDS.flatMap(b=>GLK_DATE_FIELD_OPTS.map(o=>{const m=glkDateMeta(b[o.key]);return m?String(m.year):null;})).filter(Boolean))].sort((a,b)=>parseInt(b,10)-parseInt(a,10));
    cySel.innerHTML=yrs.map(y=>'<option value="'+y+'"'+(glkCompareYear===y?' selected':'')+'>'+y+'</option>').join('');
    cySel.style.display=glkCompareEnabled?'block':'none';
  }
  const ct=el('glkCompareToggle'); if(ct) ct.checked=glkCompareEnabled;
  const ty=el('glkThisYearToggle'); if(ty) ty.checked=glkThisYearEnabled;
}
window.glkAddDateRule=function(){ glkDateRules.push(glkDefaultDateRule('created')); glkBuildDateFilters(); };
window.glkRemoveDateRule=function(ruleId){
  glkDateRules=glkDateRules.filter(r=>r.id!==ruleId);
  if(!glkDateRules.length) glkDateRules=[glkDefaultDateRule('created')];
  glkBuildDateFilters(); onDateFilterChange();
};
window.glkToggleCompare=function(){
  glkCompareEnabled=!!(el('glkCompareToggle')&&el('glkCompareToggle').checked);
  if(el('glkCompareYear')) el('glkCompareYear').style.display=glkCompareEnabled?'block':'none';
  onDateFilterChange();
};
window.onDateFilterChange=function(){
  glkDateRules=glkReadAllDateRules();
  if(el('glkCompareYear')) glkCompareYear=glkGetSelectVal('glkCompareYear')||glkCompareYear;
  glkDateRules.forEach(r=>glkPopulateRulePeriodDropdowns(r,ALL_BIDS));
  applyAll();
};

function getFilterVals(key){
  if(key==='closureProb') return PROB_ORDER;
  if(key==='forecastCategory') return FORECAST_OPTIONS;
  return [...new Set(ALL_BIDS.map(b=>b[key]).filter(Boolean))].sort();
}

function remapBlankHD(){
  const STATUS_ONGOING=['Lead','Opportunity','On Hold','Proposed'];

  // Step 1: Build AD -> HD map from bids that have a real (non-blank) HD
  const adToHD={};
  ALL_BIDS.forEach(function(b){
    if(b.headDirector&&b.headDirector!=='(Blank)'&&b.headDirector!=='—'&&b.accountDirector&&b.accountDirector!=='—'){
      adToHD[b.accountDirector]=b.headDirector;
    }
  });

  // Step 2: Process blank HD bids
  const remapped=[];
  ALL_BIDS.forEach(function(b){
    if(b.headDirector!=='(Blank)'){
      remapped.push(b); // normal bid, keep as is
      return;
    }
    // Blank HD bid
    if(!STATUS_ONGOING.includes(b.status)){
      // Closed bid with blank HD -> discard completely
      return;
    }
    // Ongoing bid with blank HD -> try to remap
    const realHD=adToHD[b.accountDirector];
    if(!realHD){
      // AD has no known HD mapping -> discard
      return;
    }
    // Reassign HD and keep
    remapped.push(Object.assign({},b,{headDirector:realHD}));
  });

  ALL_BIDS=remapped;
}
function buildFilters(){
  const grid=el('filtersGrid'); grid.innerHTML='';
  const lockedKeys=new Set();
  if(USER.role==='Head Director') lockedKeys.add('headDirector');
  if(USER.role==='Account Director'){lockedKeys.add('headDirector');lockedKeys.add('accountDirector');}
  if(USER.role==='Account Manager'){lockedKeys.add('headDirector');lockedKeys.add('accountDirector');lockedKeys.add('amName');}

  FILTER_DEFS.forEach(function(fd){
    const isLocked=lockedKeys.has(fd.key);
    const div=document.createElement('div'); div.className='filter-group';
    div.innerHTML='<div class="filter-label">'+fd.label+'</div>';
    const wrap=document.createElement('div'); wrap.className='ms-wrap'; wrap.id='ms_'+fd.key;
    const trig=document.createElement('div'); trig.className='ms-trigger'; trig.id='mst_'+fd.key;
    if(isLocked) trig.style.opacity='.5';
    trig.innerHTML='<span id="mstext_'+fd.key+'">All</span><svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>';
    if(!isLocked) trig.onclick=function(e){e.stopPropagation();toggleMs(fd.key);};
    const drop=document.createElement('div'); drop.className='ms-dropdown'; drop.id='msd_'+fd.key;
    getFilterVals(fd.key).forEach(function(v){
      if(!v||v==='—'||v==='All') return;
      const label=v;
      const opt=document.createElement('div'); opt.className='ms-option';
      const cid='cb_'+fd.key+'_'+v.toString().replace(/[^a-zA-Z0-9]/g,'_');
      opt.innerHTML='<input type="checkbox" id="'+cid+'" value="'+v+'" onchange="onFilterChange(\''+fd.key+'\')"><label for="'+cid+'">'+label+'</label>';
      drop.appendChild(opt);
    });
    wrap.appendChild(trig); wrap.appendChild(drop); div.appendChild(wrap); grid.appendChild(div);
  });
  applyRoleLocks();
  glkBuildDateFilters();
}
function applyRoleLocks(){
  if(USER.role==='Viewer'||USER.role==='Admin'||USER.role==='CEO') return;
  
  if(USER.role==='Head Director'){
    const v=findMyHD();
    if(!v){preSelectAndLock('headDirector',['__NOACCESS__']);return;}
    preSelectAndLock('headDirector',[v]);
  }
  
  if(USER.role==='Account Director'){
    const v=findMyAD();
    if(!v){preSelectAndLock('accountDirector',['__NOACCESS__']);return;}
    const hd=[...new Set(ALL_BIDS.filter(b=>b.accountDirector===v).map(b=>b.headDirector))];
    preSelectAndLock('headDirector',hd);
    preSelectAndLock('accountDirector',[v]);
  }
  
if(USER.role==='Account Manager'){
    let amBids=ALL_BIDS.filter(b=>b.amEmail&&b.amEmail.toLowerCase()===USER.email.toLowerCase());
    if(!amBids.length&&USER.name) amBids=ALL_BIDS.filter(b=>b.amName&&b.amName.toLowerCase()===USER.name.toLowerCase());
    if(!amBids.length){preSelectAndLock('amName',['__NOACCESS__']);return;}
    const amName=amBids[0].amName;
    preSelectAndLock('headDirector',[...new Set(amBids.map(b=>b.headDirector))]);
    preSelectAndLock('accountDirector',[...new Set(amBids.map(b=>b.accountDirector))]);
    preSelectAndLock('amName',[amName]);
  }
}
function findMyHD(){ 
  const name=USER.name.toLowerCase().trim();
  const d=ALL_BIDS.find(b=>b.headDirector&&(
    b.headDirector.toLowerCase().trim()===name||
    b.headDirector.toLowerCase().includes(name)||
    name.includes(b.headDirector.toLowerCase().trim())
  ));
  return d?d.headDirector:null; 
}
function findMyAD(){ 
  const name=USER.name.toLowerCase().trim();
  const d=ALL_BIDS.find(b=>b.accountDirector&&(
    b.accountDirector.toLowerCase().trim()===name||
    b.accountDirector.toLowerCase().includes(name)||
    name.includes(b.accountDirector.toLowerCase().trim())
  ));
  return d?d.accountDirector:null; 
}
function preSelectAndLock(key,values){
  const drop=el('msd_'+key); if(!drop) return;
  drop.querySelectorAll('input[type=checkbox]').forEach(function(cb){cb.checked=values.includes(cb.value);cb.disabled=true;});
  updateMsText(key);
}
function toggleMs(key){
  const drop=el('msd_'+key),trig=el('mst_'+key);
  const isOpen=drop.classList.contains('open');
  document.querySelectorAll('.ms-dropdown.open').forEach(d=>{
    d.classList.remove('open');
    const t=el('mst_'+d.id.replace('msd_',''));
    if(t) t.classList.remove('open');
  });
  if(!isOpen){
    const rect=trig.getBoundingClientRect();
    drop.style.top=(rect.bottom+4)+'px';
    drop.style.left=rect.left+'px';
    drop.style.width=Math.max(rect.width,180)+'px';
    drop.classList.add('open');
    trig.classList.add('open');
  }
}
document.addEventListener('click',function(){ document.querySelectorAll('.ms-dropdown.open').forEach(function(d){ d.classList.remove('open'); const t=el('mst_'+d.id.replace('msd_','')); if(t) t.classList.remove('open'); }); });
window.addEventListener('scroll', function(){
  document.querySelectorAll('.ms-dropdown.open').forEach(function(d){
    const key=d.id.replace('msd_','');
    const trig=el('mst_'+key);
    if(trig){const rect=trig.getBoundingClientRect();d.style.top=(rect.bottom+4)+'px';d.style.left=rect.left+'px';}
  });
}, true);
window.addEventListener('resize', function(){
  document.querySelectorAll('.ms-dropdown.open').forEach(function(d){
    const key=d.id.replace('msd_','');
    const trig=el('mst_'+key);
    if(trig){const rect=trig.getBoundingClientRect();d.style.top=(rect.bottom+4)+'px';d.style.left=rect.left+'px';}
  });
});
function getChecked(key){ const drop=el('msd_'+key); if(!drop) return []; return Array.from(drop.querySelectorAll('input:checked')).map(c=>c.value); }
function updateMsText(key){
  const checked=getChecked(key); const e=el('mstext_'+key); if(!e) return;
  if(!checked.length) e.textContent='All';
  else if(checked.length===1) e.textContent=checked[0];
  else e.textContent=checked.length+' selected';
}
function onFilterChange(key){
  updateMsText(key);
  applyAll();
}
function clearFilter(key){ const drop=el('msd_'+key); if(!drop) return; drop.querySelectorAll('input:not([disabled])').forEach(c=>c.checked=false); updateMsText(key); }

// ══════════════════════════════════════════════════════════════════
//  APPLY ALL
// ══════════════════════════════════════════════════════════════════
function applyAll(){
  const filters={};
  FILTER_DEFS.forEach(function(fd){ filters[fd.key]=getChecked(fd.key); });
FILTERED=ALL_BIDS.filter(function(bid){
    for(const fd of FILTER_DEFS){
      const vals=filters[fd.key]; if(!vals.length) continue;
      if(!vals.includes(bid[fd.key])) return false;
    }
    return true;
  });

  // Hard-scope FILTERED by role regardless of filter dropdowns
  if(USER.role==='Head Director'){
    const myHD=findMyHD();
    if(myHD) FILTERED=FILTERED.filter(b=>b.headDirector===myHD);
  }
  if(USER.role==='Account Director'){
    const myAD=findMyAD();
    if(myAD) FILTERED=FILTERED.filter(b=>b.accountDirector===myAD);
  }
  if(USER.role==='Account Manager'){
    const byEmail=FILTERED.filter(b=>b.amEmail&&b.amEmail.toLowerCase()===USER.email.toLowerCase());
    FILTERED=byEmail.length?byEmail:FILTERED.filter(b=>b.amName&&b.amName.toLowerCase()===USER.name.toLowerCase());
  }

  const baseForCompare=FILTERED.slice();
  const dateRules=glkReadAllDateRules();
  FILTERED=glkApplyDateRules(FILTERED,dateRules);
  glkRenderCompareBanner(baseForCompare,dateRules);

updateTopStats();

// For Account Manager role
  if(USER.role==='Account Manager'){
    el('hd-section-nav').style.display='none';
    el('adSection').style.display='none';
    renderAMTile();
    return;
  }

  // For Account Director role — skip HD tiles, show only their AD tile
  if(USER.role==='Account Director'){
    el('hd-section-nav').style.display='none';
    const myAD=findMyAD();
    if(myAD){
      const myHD=ALL_BIDS.find(b=>b.accountDirector===myAD);
      if(myHD) selHD=myHD.headDirector;
    }
    renderADTiles(selHD);
    el('adSection').style.display='block';
    if(selAD){ renderAMRows(selAD); el('amSection').style.display='block'; }
    else { el('amSection').style.display='none'; }
    renderCharts();
    renderGrid();
    return;
  }

  renderHDTiles();
  if(selHD){ renderADTiles(selHD); el('adSection').style.display='block'; }
  else { el('adSection').style.display='none'; }
  if(selAD){ renderAMRows(selAD); el('amSection').style.display='block'; }
  else { el('amSection').style.display='none'; }
  renderCharts();
  renderGrid();
}
function renderAMTile(){
  el('amSection').style.display='block';
  set('amContext','');

  // Get this AM's bids
  let amBids=FILTERED.filter(b=>b.amEmail&&b.amEmail.toLowerCase()===USER.email.toLowerCase());
  if(!amBids.length && USER.name){
    amBids=FILTERED.filter(b=>b.amName&&b.amName.toLowerCase()===USER.name.toLowerCase());
  }

  // Apply PF filter
  const pfTest=PF_FAMILIES[selPF];
  if(pfTest) amBids=amBids.filter(b=>pfTest(b.productFamily));

  const isMobile=selPF===MOBILE_PF;
  const s=buildTileStats(amBids,amBids);
  const billed=amBids.filter(b=>b.status==='Billed');
  const won=amBids.filter(b=>b.status==='Won');
  const lost=amBids.filter(b=>STATUS_LOST.includes(b.status));
  const ip=amBids.filter(b=>STATUS_IP.includes(b.status));
  const t=glkTileMetricTotals(amBids);
  const primaryLabel=isMobile?'GA Lines':'MRC';
  const primaryVal=isMobile?fmtLines(t.gaLines):fmt(t.mrc);

  set('amBadge','1');

  const list=el('amList');
  list.innerHTML=`
    <div class="manager-row selected" style="cursor:default;">
      <div class="rank-badge rank-1">★</div>
      <div class="manager-name-col">
        <div class="manager-name">${USER.name}</div>
        <div class="manager-tag">Account Manager</div>
      </div>
      <div class="stat-col"><div class="stat-label">Opportunities</div><div class="stat-value">${s.total}</div></div>
      <div class="stat-col"><div class="stat-label">Billed</div><div class="stat-value" style="color:#16a34a">${billed.length}</div></div>
      <div class="stat-col"><div class="stat-label">Won</div><div class="stat-value" style="color:#16a34a">${won.length}</div></div>
      <div class="stat-col"><div class="stat-label">Lost</div><div class="stat-value" style="color:#dc2626">${lost.length}</div></div>
      <div class="stat-col"><div class="stat-label">In progress</div><div class="stat-value">${ip.length}</div></div>
      <div class="stat-col"><div class="stat-label">${primaryLabel}</div><div class="stat-value">${primaryVal}</div></div>
      ${isMobile?'<div class="stat-col"><div class="stat-label">MRC</div><div class="stat-value">'+fmt(t.mrc)+'</div></div>':''}
      <div class="stat-col"><div class="stat-label">OTC</div><div class="stat-value">${fmt(t.otc)}</div></div>
      <div class="stat-col"><div class="stat-label">TCV</div><div class="stat-value">${fmt(t.tcv)}</div></div>
      ${isMobile?'<div class="stat-col"><div class="stat-label">GA Points</div><div class="stat-value">'+fmtGA(t.gaPoints)+'</div></div>':''}
      <div class="progress-bar-col">
        <div class="progress-label">Billed ratio: ${s.total?(billed.length/s.total*100).toFixed(1):0}%</div>
        <div class="progress-bar"><div class="progress-fill" style="width:${s.total?(billed.length/s.total*100).toFixed(1):0}%"></div></div>
      </div>
    </div>`;

  // Also update grid and charts to only show AM's data
  renderCharts();
  renderGrid();
}
function getViewBids(){
  const pfTest=PF_FAMILIES[selPF];
  let bids=FILTERED.filter(b=>pfTest(b.productFamily));

  if(USER.role==='Account Manager'){
    const byEmail=FILTERED.filter(b=>b.amEmail&&b.amEmail.toLowerCase()===USER.email.toLowerCase());
    bids=byEmail.length?byEmail:FILTERED.filter(b=>b.amName&&b.amName.toLowerCase()===USER.name.toLowerCase());
    bids=bids.filter(b=>pfTest(b.productFamily));
    if(selStatusTile) bids=bids.filter(b=>b.status===selStatusTile);
    return bids;
  }

  if(selAM) bids=bids.filter(b=>b.headDirector===selHD&&b.accountDirector===selAD&&(b.amEmail===selAM||b.amName===selAM));
  else if(selAD) bids=bids.filter(b=>b.headDirector===selHD&&b.accountDirector===selAD);
  else if(selHD) bids=bids.filter(b=>b.headDirector===selHD);
  if(selStatusTile) bids=bids.filter(b=>b.status===selStatusTile);
  return bids;
}// ══════════════════════════════════════════════════════════════════
function updateTopStats(){
  const isMobile=selPF===MOBILE_PF;
  const container=el('topStats');
  container.innerHTML='';
  const pfTest=PF_FAMILIES[selPF];
  let baseBids;

  if(USER.role==='Account Manager'){
    const byEmail=FILTERED.filter(b=>b.amEmail&&b.amEmail.toLowerCase()===USER.email.toLowerCase());
    baseBids=byEmail.length?byEmail:FILTERED.filter(b=>b.amName&&b.amName.toLowerCase()===USER.name.toLowerCase());
    baseBids=baseBids.filter(b=>pfTest(b.productFamily));
  } else {
    baseBids=FILTERED.filter(b=>pfTest(b.productFamily));
    if(selAM) baseBids=baseBids.filter(b=>b.amEmail===selAM||b.amName===selAM);
    else if(selAD) baseBids=baseBids.filter(b=>b.accountDirector===selAD);
    else if(selHD) baseBids=baseBids.filter(b=>b.headDirector===selHD);
  }

  const total=baseBids.length;
  const pct=n=>total?((n/total)*100).toFixed(1)+'%':'0%';

  const ongoingStatuses=['Lead','Opportunity','Proposed','Won','On Hold'];
  const ongoing=baseBids.filter(b=>ongoingStatuses.includes(b.status));
  const closed=baseBids.filter(b=>!ongoingStatuses.includes(b.status));

  const tileDefs=[
    {key:null,label:'Overall Opportunity',isOverall:true,value:total,color:'var(--sc)'},
    {key:'Billed',    label:'Billed',      color:'#16a34a'},
    {key:'Won',       label:'Won',         color:'#16a34a'},
    {key:'Proposed',  label:'Proposed',    color:'#b45309'},
    {key:'Opportunity',label:'Opportunity',color:'var(--acc)'},
    {key:'_blank',    isBlank:true},
    {key:'Lead',      label:'Lead',        color:'var(--acc)'},
    {key:'On Hold',   label:'On Hold',     color:'#b45309'},
    {key:'Lost',      label:'Lost',        color:'#dc2626'},
    {key:'Cancelled', label:'Cancelled',   color:'#dc2626'},
    {key:'No Bid',    label:'No Bid',      color:'#6b7280'},
  ];
  container.style.gridTemplateColumns='repeat(6,minmax(150px,1fr))';

  tileDefs.forEach(td=>{
    if(td.isBlank){
      const spacer=document.createElement('div');
      spacer.className='stat-card stat-card-blank';
      spacer.setAttribute('aria-hidden','true');
      container.appendChild(spacer);
      return;
    }
    const card=document.createElement('div');
    const isActive=selStatusTile===td.key&&td.key;
    const isDimmed=selStatusTile&&!isActive&&td.key;
    card.className='stat-card'+(isActive?' tile-active':'')+(isDimmed?' tile-dimmed':'');
    card.style.cursor=td.key?'pointer':'default';

    if(td.isOverall){
      card.innerHTML=`
        <div class="stat-label">${td.label}</div>
        <div class="stat-value" style="color:${td.color}">${total}</div>
        <div class="stat-subtitle">All Opportunities</div>
        <div class="stat-breakdown">
          <div class="breakdown-item"><span class="breakdown-label">Ongoing</span>&nbsp;<span class="breakdown-value">${ongoing.length}</span></div>
          <div class="breakdown-item"><span class="breakdown-label">Closed</span>&nbsp;<span class="breakdown-value">${closed.length}</span></div>
        </div>`;
    } else {
      const grp=baseBids.filter(b=>b.status===td.key);
      const cnt=grp.length;
      card.innerHTML=`
        <div class="stat-label">${td.label}</div>
        <div class="stat-value" style="color:${td.color}">${cnt}</div>
        <div class="stat-subtitle"><span class="stat-pct">${pct(cnt)}</span></div>
        <div style="margin-top:.5rem;display:flex;flex-direction:column;gap:.4rem;">
          ${glkTopStatMetricsHtml(grp,isMobile)}
        </div>`;
      card.onclick=()=>toggleStatusTile(td.key);
    }
    container.appendChild(card);
  });
}
function toggleStatusTile(status){
  if(selStatusTile===status) selStatusTile=null;
  else selStatusTile=status;
  applyAll();
  updateSelectionBadge();
}
// ══════════════════════════════════════════════════════════════════
//  TILE STATS HELPER
// ══════════════════════════════════════════════════════════════════
function buildTileStats(bids, parentBids){
  const total=bids.length;
  const won=bids.filter(b=>STATUS_WON.includes(b.status));
  const ip=bids.filter(b=>STATUS_IP.includes(b.status));
  const lost=bids.filter(b=>STATUS_LOST.includes(b.status));
  const wonTCV=won.reduce((s,b)=>s+b.tcv,0);
  const ipTCV=ip.reduce((s,b)=>s+b.tcv,0);
  const lostTCV=lost.reduce((s,b)=>s+b.tcv,0);
  const allTCV=bids.reduce((s,b)=>s+b.tcv,0);
  const allMRC=bids.reduce((s,b)=>s+b.mrc,0);
  const gaLines=bids.reduce((s,b)=>s+(b.gaLines||0),0);
  const winRatio=total?(won.length/total*100).toFixed(1):0;
  const ga=bids.reduce((s,b)=>s+b.gaPoints,0);
  const pool=parentBids||FILTERED;
  const contribPct=pool.length?(bids.length/pool.length*100).toFixed(1):0;
  const poolMRC=pool.reduce((s,b)=>s+b.mrc,0);
  const poolGaLines=pool.reduce((s,b)=>s+(b.gaLines||0),0);
  const mrcPct=poolMRC?(allMRC/poolMRC*100).toFixed(1):0;
  const gaLinesPct=poolGaLines?(gaLines/poolGaLines*100).toFixed(1):0;
  return {total,won:won.length,ip:ip.length,lost:lost.length,wonTCV,ipTCV,lostTCV,allTCV,allMRC,gaLines,winRatio,ga,contribPct,mrcPct,gaLinesPct,highProb:bids.filter(b=>['75%','100%'].includes(b.closureProb)).length};
}

// ══════════════════════════════════════════════════════════════════
//  HD TILES (= LM tiles)
// ══════════════════════════════════════════════════════════════════
function renderHDTiles(){
  const pfTest=PF_FAMILIES[selPF];
  const isMobile=selPF===MOBILE_PF;
const allPFBids=FILTERED.filter(b=>pfTest(b.productFamily)&&(!selStatusTile||b.status===selStatusTile));
let hds=[...new Set(allPFBids.map(b=>b.headDirector).filter(v=>v&&v!=='—'))].sort();
if(USER.role==='Head Director'){
  const myHD=findMyHD();
  if(myHD) hds=hds.filter(h=>h===myHD);
  else hds=[];
}  set('hdBadge',hds.length);
  const grid=el('hdGrid'); grid.innerHTML='';
hds.forEach(function(hd){
    const hdBids=FILTERED.filter(b=>pfTest(b.productFamily)&&b.headDirector===hd&&(!selStatusTile||b.status===selStatusTile));    const s=buildTileStats(hdBids,FILTERED.filter(b=>pfTest(b.productFamily)));
    const billed=hdBids.filter(b=>b.status==='Billed');
    const won=hdBids.filter(b=>b.status==='Won');
    const lost=hdBids.filter(b=>STATUS_LOST.includes(b.status));
    const ip=hdBids.filter(b=>STATUS_IP.includes(b.status));
    const t=glkTileMetricTotals(hdBids);
    const primaryLabel=isMobile?'GA Lines':'MRC';
    const primaryVal=isMobile?fmtLines(t.gaLines):fmt(t.mrc);
    const tile=document.createElement('div');
    tile.className='lm-tile'+(selHD===hd?' selected':'');
    tile.innerHTML=`
      <div class="lm-header"><div><h3>${hd}</h3><div class="lm-meta">Head Director</div></div></div>
      <div class="lm-stats-grid">
        <div class="lm-stat-box"><div class="lm-stat-label">Opportunities</div><div class="lm-stat-value">${s.total}</div></div>
        <div class="lm-stat-box"><div class="lm-stat-label">${primaryLabel}</div><div class="lm-stat-value">${primaryVal}</div></div>
        ${isMobile?'<div class="lm-stat-box"><div class="lm-stat-label">MRC</div><div class="lm-stat-value">'+fmt(t.mrc)+'</div></div>':''}
      </div>
      <div class="lm-revenue">
        ${glkLmStatusHtml(billed.length,won.length,lost.length,ip.length)}
        ${glkLmMetricBreakdownHtml(hdBids,isMobile)}
      </div>
      ${glkLmProgressHtml(s,billed.length,isMobile)}`;
    tile.onclick=function(){ selectHD(hd); };
    grid.appendChild(tile);
  });
}
function selectHD(hd){
  if(selHD===hd){selHD=null;selAD=null;selAM=null;hideAD();hideAM();}
  else{selHD=hd;selAD=null;selAM=null;renderADTiles(hd);hideAM();}
  renderHDTiles(); updateTopStats(); renderCharts(); renderGrid();

    updateSelectionBadge();
}
function hideAD(){el('adSection').style.display='none';selAD=null;}
function hideAM(){el('amSection').style.display='none';selAM=null;}

// ══════════════════════════════════════════════════════════════════
//  AD TILES (= LM tiles style)
// ══════════════════════════════════════════════════════════════════
function renderADTiles(hd){
  el('adSection').style.display='block';
  set('adContext','← '+hd);
  const pfTest=PF_FAMILIES[selPF];
  const isMobile=selPF===MOBILE_PF;
const hdBids=FILTERED.filter(b=>pfTest(b.productFamily)&&b.headDirector===hd&&(!selStatusTile||b.status===selStatusTile));
let ads=[...new Set(hdBids.map(b=>b.accountDirector).filter(v=>v&&v!=='—'))].sort();
if(USER.role==='Account Director'){
  const myAD=findMyAD();
  if(myAD) ads=ads.filter(a=>a===myAD);
}  set('adBadge',ads.length);
  const grid=el('adGrid'); grid.innerHTML='';
  if(!ads.length){grid.innerHTML='<div style="color:var(--t3);font-size:.84rem;padding:20px;">No account directors found.</div>';return;}
  ads.forEach(function(ad){
    const adBids=hdBids.filter(b=>b.accountDirector===ad);
    const s=buildTileStats(adBids,hdBids);
    const billed=adBids.filter(b=>b.status==='Billed');
    const won=adBids.filter(b=>b.status==='Won');
    const lost=adBids.filter(b=>STATUS_LOST.includes(b.status));
    const ip=adBids.filter(b=>STATUS_IP.includes(b.status));
    const t=glkTileMetricTotals(adBids);
    const primaryLabel=isMobile?'GA Lines':'MRC';
    const primaryVal=isMobile?fmtLines(t.gaLines):fmt(t.mrc);
    const tile=document.createElement('div');
    tile.className='lm-tile'+(selAD===ad?' selected':'');
    tile.innerHTML=`
      <div class="lm-header"><div><h3>${ad}</h3><div class="lm-meta">Account Director</div></div></div>
      <div class="lm-stats-grid">
        <div class="lm-stat-box"><div class="lm-stat-label">Opportunities</div><div class="lm-stat-value">${s.total}</div></div>
        <div class="lm-stat-box"><div class="lm-stat-label">${primaryLabel}</div><div class="lm-stat-value">${primaryVal}</div></div>
        ${isMobile?'<div class="lm-stat-box"><div class="lm-stat-label">MRC</div><div class="lm-stat-value">'+fmt(t.mrc)+'</div></div>':''}
      </div>
      <div class="lm-revenue">
        ${glkLmStatusHtml(billed.length,won.length,lost.length,ip.length)}
        ${glkLmMetricBreakdownHtml(adBids,isMobile)}
      </div>
      ${glkLmProgressHtml(s,billed.length,isMobile)}`;
    tile.onclick=function(){ selectAD(ad); };
    grid.appendChild(tile);
  });
}function selectAD(ad){
  if(selAD===ad){selAD=null;selAM=null;hideAM();}
  else{selAD=ad;selAM=null;renderAMRows(ad);}
  renderADTiles(selHD); updateTopStats(); renderCharts(); renderGrid();
  updateSelectionBadge();
}

// ══════════════════════════════════════════════════════════════════
//  AM ROWS (= SM rows style)
// ══════════════════════════════════════════════════════════════════
function renderAMRows(ad){
  el('amSection').style.display='block';
  set('amContext','← '+ad);
  const pfTest=PF_FAMILIES[selPF];
  const isMobile=selPF===MOBILE_PF;
const adBids=FILTERED.filter(b=>pfTest(b.productFamily)&&b.headDirector===selHD&&b.accountDirector===ad&&(!selStatusTile||b.status===selStatusTile));  const amMap={};
  adBids.forEach(function(b){
    const key=b.amEmail||b.amName||'Unknown';
    if(!amMap[key]) amMap[key]={name:b.amName,email:b.amEmail,bids:[]};
    amMap[key].bids.push(b);
  });
  const ams=Object.values(amMap).filter(a=>a.name&&a.name!=='—').sort((a,b)=>b.bids.reduce((s,x)=>s+x.tcv,0)-a.bids.reduce((s,x)=>s+x.tcv,0));
  set('amBadge',ams.length);
  const list=el('amList'); list.innerHTML='';
  if(!ams.length){list.innerHTML='<div style="color:var(--t3);font-size:.84rem;padding:20px;">No account managers found.</div>';return;}
  ams.forEach(function(am,i){
    const s=buildTileStats(am.bids,adBids);
    const key=am.email||am.name;
    const rankClass=i===0?'rank-1':i===1?'rank-2':i===2?'rank-3':'rank-other';
    const billed=am.bids.filter(b=>b.status==='Billed');
    const won=am.bids.filter(b=>b.status==='Won');
    const lost=am.bids.filter(b=>STATUS_LOST.includes(b.status));
    const ip=am.bids.filter(b=>STATUS_IP.includes(b.status));
    const t=glkTileMetricTotals(am.bids);
    const primaryLabel=isMobile?'GA Lines':'MRC';
    const primaryVal=isMobile?fmtLines(t.gaLines):fmt(t.mrc);
    const metricShare=isMobile?s.gaLinesPct:s.mrcPct;
    const metricShareLabel=isMobile?'GA Lines share':'MRC share';
    const row=document.createElement('div');
    row.className='manager-row'+(selAM===key?' selected':'');
    row.innerHTML=`
      <div class="rank-badge ${rankClass}">${i+1}</div>
      <div class="manager-name-col">
        <div class="manager-name">${am.name}</div>
        <div class="manager-tag">Account Manager</div>
      </div>
      <div class="stat-col"><div class="stat-label">Opportunities</div><div class="stat-value">${s.total}</div></div>
      <div class="stat-col"><div class="stat-label">Billed</div><div class="stat-value" style="color:#16a34a">${billed.length}</div></div>
      <div class="stat-col"><div class="stat-label">Won</div><div class="stat-value" style="color:#16a34a">${won.length}</div></div>
      <div class="stat-col"><div class="stat-label">Lost</div><div class="stat-value" style="color:#dc2626">${lost.length}</div></div>
      <div class="stat-col"><div class="stat-label">In progress</div><div class="stat-value">${ip.length}</div></div>
      <div class="stat-col"><div class="stat-label">${primaryLabel}</div><div class="stat-value">${primaryVal}</div></div>
      ${isMobile?'<div class="stat-col"><div class="stat-label">MRC</div><div class="stat-value">'+fmt(t.mrc)+'</div></div>':''}
      <div class="stat-col"><div class="stat-label">OTC</div><div class="stat-value">${fmt(t.otc)}</div></div>
      <div class="stat-col"><div class="stat-label">TCV</div><div class="stat-value">${fmt(t.tcv)}</div></div>
      ${isMobile?'<div class="stat-col"><div class="stat-label">GA Points</div><div class="stat-value">'+fmtGA(t.gaPoints)+'</div></div>':''}
      <div class="progress-bar-col">
        <div class="progress-label">Billed ratio: ${s.total?(billed.length/s.total*100).toFixed(1):0}%</div>
        <div class="progress-bar"><div class="progress-fill" style="width:${s.total?(billed.length/s.total*100).toFixed(1):0}%"></div></div>
      </div>
      <div class="progress-bar-col">
        <div class="progress-label">Pipeline share: ${s.contribPct}%</div>
        <div class="progress-bar"><div class="progress-fill" style="width:${s.contribPct}%"></div></div>
      </div>
      <div class="progress-bar-col">
        <div class="progress-label">${metricShareLabel}: ${metricShare}%</div>
        <div class="progress-bar"><div class="progress-fill" style="width:${metricShare}%"></div></div>
      </div>`;
    row.onclick=function(){ selectAM(key); };
    list.appendChild(row);
  });
}function selectAM(key){
  if(selAM===key) selAM=null; else selAM=key;
  renderAMRows(selAD); updateTopStats(); renderCharts(); renderGrid();
  updateSelectionBadge();
}

// ══════════════════════════════════════════════════════════════════
//  CHARTS
// ══════════════════════════════════════════════════════════════════
function toggleCharts(){
  chartsVisible=!chartsVisible;
  el('chartsSection').style.display=chartsVisible?'block':'none';
  el('chartsToggleText').textContent=chartsVisible?'Hide Analytics Charts':'Show Analytics Charts';
  if(chartsVisible) setTimeout(()=>renderCharts(),80);
}
function getChartColors(){
  const t=document.body.getAttribute('data-theme')||'';
  const isDark=t==='dark'||t==='duralux-dark';
  const isDural=t==='duralux'||t==='duralux-dark';
  return {
    text:isDark?'rgba(255,255,255,0.6)':'rgba(0,0,0,0.5)',
    grid:isDark?'rgba(255,255,255,0.07)':'rgba(0,0,0,0.06)',
p1:isDural?'#4c6fff':'#a855f7',
    p2:isDural?'#818cf8':'#c724b1',
    p1a:isDural?'rgba(76,111,255,':'rgba(168,85,247,',
    p2a:isDural?'rgba(129,140,248,':'rgba(199,36,177,',

  };
}
function destroyChart(k){ if(CHARTS[k]){ CHARTS[k].destroy(); CHARTS[k]=null; } }
const dataLabelPlugin={id:'dlp',afterDatasetsDraw(chart){
  const ctx=chart.ctx;
  chart.data.datasets.forEach((ds,di)=>{
    const meta=chart.getDatasetMeta(di);
    if(meta.hidden)return;
    meta.data.forEach((el,i)=>{
      const v=ds.data[i]; if(!v&&v!==0)return;
      const isH=chart.options.indexAxis==='y';
      ctx.save();
      ctx.font='bold 11px Inter,sans-serif';
      ctx.fillStyle=chart.options.scales[isH?'x':'y'].ticks.color||'#666';
      const lbl=v>=1e6?(v/1e6).toFixed(1)+'M':v>=1e3?(v/1e3).toFixed(0)+'K':Number.isInteger(v)?String(v):v.toFixed(1);
      if(isH){ctx.textAlign='left';ctx.textBaseline='middle';const p=el.tooltipPosition();ctx.fillText(lbl,p.x+6,p.y);}
      else{ctx.textAlign='center';ctx.textBaseline='bottom';const p=el.tooltipPosition();ctx.fillText(lbl,p.x,p.y-4);}
      ctx.restore();
    });
  });
}};
function renderCharts(){
  if(!chartsVisible) return;
  const bids=getViewBids(); const c=getChartColors();
  var safe=function(fn,name){try{fn(bids,c);}catch(e){console.error('[GLK] '+name+' chart error:',e);}};
  safe(renderWinLoss,'WinLoss');
  safe(renderTrend,'Trend');
  safe(renderProbTCV,'ProbTCV');
  safe(renderForecastPie,'ForecastPie');
  // Forecast Bridge hidden — use Mobile QTD Bridge nav instead
  safe(renderLeaderboard,'Leaderboard');
  safe(renderVertical,'Vertical');
  safe(renderTopChart,'TopCust');
  safe(renderGA,'GA');
}

function renderWinLoss(bids,c){
  destroyChart('wl');
  let groups={};
  if(selAM) groups[selAM]=bids;
  else if(selAD) bids.forEach(b=>{const k=b.amName||'?';if(!groups[k])groups[k]=[];groups[k].push(b);});
  else if(selHD) bids.forEach(b=>{const k=b.accountDirector||'?';if(!groups[k])groups[k]=[];groups[k].push(b);});
  else bids.forEach(b=>{const k=b.headDirector||'?';if(!groups[k])groups[k]=[];groups[k].push(b);});
  const sorted=Object.entries(groups)
    .map(([k,v])=>({k,billed:v.filter(b=>b.status==='Billed').length,ip:v.filter(b=>STATUS_IP.includes(b.status)).length,lost:v.filter(b=>STATUS_LOST.includes(b.status)).length}))
    .sort((a,b)=>(b.billed+b.ip+b.lost)-(a.billed+a.ip+a.lost))
    .slice(0,8);
  const labels=sorted.map(s=>s.k);
  CHARTS.wl=new Chart(el('chartWinLoss'),{type:'bar',
    data:{labels,datasets:[
      {label:'Billed',data:sorted.map(s=>s.billed),backgroundColor:'#10b981',borderRadius:6,borderSkipped:false,barPercentage:.55,categoryPercentage:.7},
      {label:'Pipeline',data:sorted.map(s=>s.ip),backgroundColor:c.p1,borderRadius:6,borderSkipped:false,barPercentage:.55,categoryPercentage:.7},
      {label:'Lost',data:sorted.map(s=>s.lost),backgroundColor:'#ef4444',borderRadius:6,borderSkipped:false,barPercentage:.55,categoryPercentage:.7},
    ]},
    options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,
      plugins:{
        legend:{position:'top',labels:{color:c.text,font:{size:12,weight:'600'},usePointStyle:true,pointStyleWidth:10,padding:20}},
        tooltip:{backgroundColor:'rgba(0,0,0,.75)',padding:12,cornerRadius:10,bodyFont:{size:12}}
      },
      scales:{
        x:{ticks:{color:c.text,font:{size:11}},grid:{color:c.grid},border:{dash:[4,4]},beginAtZero:true},
        y:{ticks:{color:c.text,font:{size:12,weight:'600'},padding:8},grid:{display:false}}
      }}});
}
let trendMetric='tcv';
function renderTrend(bids,c){
  destroyChart('trend');
  const isMobile=selPF===MOBILE_PF;
  const metrics=isMobile?
    [{k:'tcv',l:'TCV'},{k:'gaLines',l:'GA Lines'},{k:'ga',l:'GA Points'},{k:'otc',l:'OTC'}]:
    [{k:'tcv',l:'TCV'},{k:'mrc',l:'MRC'},{k:'otc',l:'OTC'}];
  const now=new Date();
  let labels=[];
  const getVal=(b,k)=>k==='tcv'?b.tcv:k==='mrc'?b.mrc:k==='otc'?b.otc:k==='gaLines'?(b.gaLines||0):b.gaPoints;
  const periods=trendPeriod==='W'?12:trendPeriod==='M'?12:trendPeriod==='Q'?8:5;
  const getBucket=(rd)=>{
    const d=new Date(rd);
    if(trendPeriod==='W') return d.getFullYear()+'-W'+String(getWeekOfYear(d)).padStart(2,'0');
    if(trendPeriod==='M') return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
    if(trendPeriod==='Q') return d.getFullYear()+'-Q'+Math.ceil((d.getMonth()+1)/3);
    return String(d.getFullYear());
  };
  const buckets=[];
  for(let i=periods-1;i>=0;i--){
    let label,bucket;
    if(trendPeriod==='W'){
      const d=new Date(now);d.setDate(d.getDate()-i*7);
      bucket=d.getFullYear()+'-W'+String(getWeekOfYear(d)).padStart(2,'0');
      label='W'+getWeekOfYear(d);
    } else if(trendPeriod==='M'){
      const d=new Date(now.getFullYear(),now.getMonth()-i,1);
      bucket=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
      label=d.toLocaleDateString('en-US',{month:'short',year:'2-digit'});
    } else if(trendPeriod==='Q'){
      const totalQ=now.getFullYear()*4+Math.ceil((now.getMonth()+1)/3)-1-i;
      const yr=Math.floor(totalQ/4);
      const q=(totalQ%4)+1;
      bucket=yr+'-Q'+q;
      label='Q'+q+' '+String(yr).slice(2);
    } else {
      const yr=now.getFullYear()-i;
      bucket=String(yr);label=String(yr);
    }
    labels.push(label);buckets.push(bucket);
  }
  const billedD=[],wonD=[],pipeD=[];
  buckets.forEach(bkt=>{
    const mb=bids.filter(b=>{const rd=getRelevantDate(b);if(!rd)return false;return getBucket(rd)===bkt;});
    billedD.push(+(mb.filter(b=>b.status==='Billed').reduce((s,b)=>s+getVal(b,trendMetric),0)/1e6).toFixed(2));
    wonD.push(+(mb.filter(b=>b.status==='Won').reduce((s,b)=>s+getVal(b,trendMetric),0)/1e6).toFixed(2));
    pipeD.push(+(mb.filter(b=>STATUS_IP.includes(b.status)).reduce((s,b)=>s+getVal(b,trendMetric),0)/1e6).toFixed(2));
  });
  const ctx=el('chartTrend').getContext('2d');
  const mkGrad=(r,g,b2)=>{const g2=ctx.createLinearGradient(0,0,0,280);g2.addColorStop(0,`rgba(${r},${g},${b2},.35)`);g2.addColorStop(1,`rgba(${r},${g},${b2},.02)`);return g2;};
  CHARTS.trend=new Chart(el('chartTrend'),{type:'line',
    data:{labels,datasets:[
     {label:'Billed',data:billedD,borderColor:'#10b981',backgroundColor:'rgba(16,185,129,.25)',fill:true,tension:.35,pointRadius:4,pointHoverRadius:7,pointBackgroundColor:'#10b981',pointBorderColor:'#fff',pointBorderWidth:2,borderWidth:2.5,stack:'revenue'},
      {label:'Won',data:wonD,borderColor:'#6366f1',backgroundColor:'rgba(99,102,241,.25)',fill:true,tension:.35,pointRadius:4,pointHoverRadius:7,pointBackgroundColor:'#6366f1',pointBorderColor:'#fff',pointBorderWidth:2,borderWidth:2.5,stack:'revenue'},
      {label:'Pipeline',data:pipeD,borderColor:c.p1,backgroundColor:'rgba(168,85,247,.25)',fill:true,tension:.35,pointRadius:4,pointHoverRadius:7,pointBackgroundColor:c.p1,pointBorderColor:'#fff',pointBorderWidth:2,borderWidth:2.5,stack:'revenue'},
    ]},
options:{responsive:true,maintainAspectRatio:false,
      interaction:{mode:'index',intersect:false},
      plugins:{
        legend:{position:'top',labels:{color:c.text,font:{size:12,weight:'600'},usePointStyle:true,pointStyleWidth:10,padding:20}},
        tooltip:{
          backgroundColor:'rgba(15,10,30,.85)',padding:14,cornerRadius:12,
          titleFont:{size:13,weight:'700'},bodyFont:{size:12},
          bodySpacing:6,
          callbacks:{
            label:ctx=>'  '+ctx.dataset.label+':  '+ctx.parsed.y.toFixed(2)+'M'
          }
        }
      },
      scales:{
        x:{ticks:{color:c.text,font:{size:11,weight:'600'}},grid:{color:c.grid},border:{dash:[4,4]}},
        y:{stacked:true,ticks:{color:c.text,font:{size:11},callback:v=>v+'M'},grid:{color:c.grid},border:{dash:[4,4]},beginAtZero:true}
      }}});

  // render metric + period toggle buttons below chart
  const wrap=el('trendControlsWrap');
  if(wrap){
    wrap.innerHTML=`
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:.65rem;flex-wrap:wrap;gap:.5rem;">
        <div style="display:flex;gap:.35rem;">
          ${metrics.map(m=>`<button type="button" onclick="trendMetric='${m.k}';renderTrend(getViewBids(),getChartColors())" style="padding:.25rem .7rem;border-radius:6px;font-size:.72rem;font-weight:700;border:1px solid var(--border);cursor:pointer;transition:all .15s;background:${trendMetric===m.k?'var(--grad)':'var(--bg-secondary)'};color:${trendMetric===m.k?'#fff':'var(--t3)'}">${m.l}</button>`).join('')}
        </div>
        <div style="display:flex;gap:.35rem;">
          ${['W','M','Q','Y'].map(p=>`<button type="button" onclick="trendPeriod='${p}';renderTrend(getViewBids(),getChartColors())" style="padding:.25rem .7rem;border-radius:6px;font-size:.72rem;font-weight:700;border:1px solid var(--border);cursor:pointer;transition:all .15s;background:${trendPeriod===p?'var(--grad)':'var(--bg-secondary)'};color:${trendPeriod===p?'#fff':'var(--t3)'}">${p==='W'?'Week':p==='M'?'Month':p==='Q'?'Quarter':'Year'}</button>`).join('')}
        </div>
      </div>`;
  }
}
function renderProbTCV(bids,c){
  destroyChart('ptcv');
  const tcvs=PROB_ORDER.map(p=>+(bids.filter(b=>b.closureProb===p).reduce((s,b)=>s+b.tcv,0)/1e6).toFixed(2));
  const counts=PROB_ORDER.map(p=>bids.filter(b=>b.closureProb===p).length);
  const palette=['#ef4444','#f97316','#eab308','#10b981','#6366f1'];
  const totalTCV=tcvs.reduce((a,b)=>a+b,0);
  const centerPlugin={id:'probCenter',beforeDraw(chart){
    const{ctx,chartArea:{width,height,left,top}}=chart;
    ctx.save();
    ctx.font='bold 22px Inter';
    ctx.fillStyle=document.body.getAttribute('data-theme')||''?'rgba(255,255,255,0.9)':'rgba(30,17,51,0.9)';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(totalTCV.toFixed(1)+'M',left+width/2,top+height/2-12);
    ctx.font='600 11px Inter';
    ctx.fillStyle=c.text;
    ctx.fillText('Total TCV',left+width/2,top+height/2+10);
    ctx.restore();
  }};
  CHARTS.ptcv=new Chart(el('chartProbTCV'),{type:'doughnut',plugins:[centerPlugin],
    data:{
      labels:PROB_ORDER.map((p,i)=>p+' — '+counts[i]+' bids — '+tcvs[i]+'M'),
      datasets:[{
        data:tcvs,
        backgroundColor:palette,
        borderWidth:4,
        borderColor:'var(--bg-card)',
        hoverOffset:14,
        hoverBorderWidth:2,
      }]
    },
    options:{
      responsive:true,maintainAspectRatio:false,cutout:'58%',
      plugins:{
        legend:{
          position:'right',
          labels:{color:c.text,font:{size:11,weight:'600'},padding:12,usePointStyle:true,pointStyleWidth:10,
            generateLabels:chart=>{
              return chart.data.labels.map((lbl,i)=>({
                text:lbl,fillStyle:palette[i],strokeStyle:palette[i],
                fontColor:c.text,hidden:false,index:i,
              }));
            }
          }
        },
        tooltip:{
          backgroundColor:'rgba(0,0,0,.8)',padding:14,cornerRadius:10,
          callbacks:{
            label:ctx=>{
              const pct=totalTCV>0?(ctx.parsed/totalTCV*100).toFixed(1):'0';
              return ['  TCV: '+ctx.parsed.toFixed(2)+'M','  Share: '+pct+'%','  Bids: '+counts[ctx.dataIndex]];
            }
          }
        }
      }
    }
  });
}
function renderForecastPie(bids,c){
  destroyChart('fcPie');
  var canvas=el('chartForecastPie');
  if(!canvas) return;
  var scoped=glkFilterByChartPeriod(bids,chartPeriod);
  var metric=chartMetric;
  var groups=PIPELINE_PIE_GROUPS.map(function(g){
    var matched=scoped.filter(g.match);
    return {label:g.label,color:g.color,count:matched.length,value:matched.reduce(function(s,b){return s+glkBidMetric(b,metric);},0)};
  }).filter(function(g){return g.value>0||g.count>0;});
  if(!groups.length) groups=PIPELINE_PIE_GROUPS.map(function(g){return {label:g.label,color:g.color,count:0,value:0};});
  var total=groups.reduce(function(a,g){return a+g.value;},0);
  var totalCnt=groups.reduce(function(a,g){return a+g.count;},0);
  var shortLabels=groups.map(function(g){return g.label;});
  var values=groups.map(function(g){return g.value;});
  var colors=groups.map(function(g){return g.color;});
  var centerPlugin={id:'fcPieCenter',beforeDraw:function(chart){
    var ca=chart.chartArea,ctx=chart.ctx;
    if(!ca) return;
    ctx.save();
    ctx.font='bold 22px Inter,sans-serif';
    ctx.fillStyle=c.text;
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(fmt(total),ca.left+ca.width/2,ca.top+ca.height/2-10);
    ctx.font='600 11px Inter,sans-serif';
    ctx.fillStyle=c.text;
    ctx.fillText((metric==='mrc'?'Total MRC':'Total TCV')+' · '+totalCnt+' opps',ca.left+ca.width/2,ca.top+ca.height/2+14);
    ctx.restore();
  }};
  var extLabels=glkPieExternalLabelsPlugin(groups,total,c);
  try{
  CHARTS.fcPie=new Chart(canvas,{type:'doughnut',plugins:[centerPlugin,extLabels],
    data:{labels:shortLabels,datasets:[{
      data:values,
      backgroundColor:colors,
      borderWidth:3,
      borderColor:'var(--bg-card)',
      hoverOffset:10,
      hoverBorderWidth:2,
      spacing:2,
      borderRadius:6
    }]},
    options:{responsive:true,maintainAspectRatio:false,cutout:'58%',
      layout:{padding:{top:20,bottom:12,left:118,right:118}},
      plugins:{
        legend:{display:false},
        tooltip:{backgroundColor:'rgba(15,10,30,.88)',padding:14,cornerRadius:12,titleFont:{size:13,weight:'700'},bodyFont:{size:12},
          callbacks:{
            title:function(items){return groups[items[0].dataIndex].label;},
            label:function(ctx){
              var g=groups[ctx.dataIndex];
              var pct=total>0?(ctx.parsed/total*100).toFixed(1):'0';
              return ['  '+fmt(ctx.parsed),'  Share: '+pct+'%','  Opportunities: '+g.count];
            }
          }
        }
      }
    }
  });
  }catch(err){console.error('[GLK] Forecast pie error:',err);}
  var wrap=el('forecastPieControlsWrap');
  if(wrap) wrap.innerHTML=glkChartControlsHtml('chartPeriodSelectPie');
}
function glkBridgeTargetLinePlugin(targetDispY,labelText,c){
  return {id:'glkBridgeTargetLine',afterDatasetsDraw:function(chart){
    var y=chart.scales.y,area=chart.chartArea,ctx=chart.ctx;
    if(!y) return;
    var py=y.getPixelForValue(targetDispY);
    if(py<area.top-2||py>area.bottom+2) return;
    ctx.save();
    ctx.strokeStyle='#ef4444';
    ctx.lineWidth=1.5;
    ctx.setLineDash([6,4]);
    ctx.beginPath();ctx.moveTo(area.left,py);ctx.lineTo(area.right,py);ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle='#ef4444';
    ctx.font='bold 10px Inter';
    ctx.textAlign='right';
    ctx.textBaseline='bottom';
    ctx.fillText(labelText,area.right-6,py-3);
    ctx.restore();
  }};
}
function glkBridgeOverZonePlugin(wonBilledVal,targetVal){
  return {id:'glkBridgeOverZone',afterDatasetsDraw:function(chart){
    if(wonBilledVal<=targetVal) return;
    var y=chart.scales.y,meta=chart.getDatasetMeta(0),bar=meta&&meta.data?meta.data[0]:null;
    if(!bar||!y) return;
    var targetPy=y.getPixelForValue(targetVal/1e6);
    var topPy=Math.min(bar.y,bar.base);
    var x1=bar.x-bar.width/2,x2=bar.x+bar.width/2;
    if(targetPy<=topPy) return;
    var ctx=chart.ctx;
    ctx.save();
    ctx.fillStyle='rgba(14,165,233,.22)';
    ctx.fillRect(x1,topPy,x2-x1,targetPy-topPy);
    ctx.fillStyle='#0ea5e9';
    ctx.font='bold 9px Inter';
    ctx.textAlign='center';
    ctx.textBaseline='bottom';
    ctx.fillText('+'+fmt(wonBilledVal-targetVal)+' secured over target',bar.x,topPy-4);
    ctx.restore();
  }};
}
function renderBridge(bids,c){
  destroyChart('bridge');
  var metric=chartMetric;
  var targetVal=bridgeTarget;
  var isBest=bridgeCase==='best';
  var calc=glkBridgeCalc(bids,metric,targetVal,isBest);
  var wonBilledVal=calc.wonBilledVal,top=calc.top,top10Sum=calc.top10Sum;
  var inForecastOthers=calc.inForecastOthers,outForecastVal=calc.outForecastVal;
  var total=calc.total,gap=calc.gap,over=calc.over;
  var bars=[],barMeta=[],sectionGroups=[],labelList=[];
  var trueCum=0,dispTopM=0;
  var targetM=targetVal/1e6;
  var minStepM=Math.max(0.55,targetM*0.06);
  var STEP_COLORS=['#1d4ed8','#2563eb','#3b82f6','#60a5fa','#93c5fd','#4f46e5','#6366f1','#818cf8','#a5b4fc','#c7d2fe'];
  function dispHM(v){return Math.max(v/1e6,minStepM);}
  function pushBar(b,meta){
    var idx=bars.length;
    bars.push(b);
    barMeta.push({label:meta||b.meta||''});
    labelList.push(b.custName||'');
    return idx;
  }
  var wbM=wonBilledVal/1e6;
  dispTopM=wbM>0?wbM:0;
  var wbIdx=pushBar({
    value:wonBilledVal,trueCum:wonBilledVal,
    displayStart:0,displayEnd:dispTopM,
    color:'#16a34a',type:'base',meta:'Won + Billed · '+fmt(wonBilledVal),custName:'Won+Billed'
  },'Won + Billed · '+fmt(wonBilledVal));
  sectionGroups.push({key:'wb',label:'Won + Billed',color:'#16a34a',startIdx:wbIdx,endIdx:wbIdx});
  trueCum=wonBilledVal;
  var infStart=-1;
  top.items.forEach(function(p,i){
    if(p.value<=0) return;
    trueCum+=p.value;
    var dStart=dispTopM,dEnd=dispTopM+dispHM(p.value);
    dispTopM=dEnd;
    var idx=pushBar({
      value:p.value,trueCum:trueCum,
      displayStart:dStart,displayEnd:dEnd,
      color:STEP_COLORS[i%STEP_COLORS.length],type:'step',
      meta:'Proposed (In Forecast) · '+p.name+' · '+fmt(p.value),
      custName:glkBridgeBarLabel(p.name,p.value)
    },'Proposed · '+p.name+' · '+fmt(p.value));
    if(infStart<0){infStart=idx;sectionGroups.push({key:'inf',label:'In Forecast',color:'#2563eb',startIdx:idx,endIdx:idx});}
    else sectionGroups[sectionGroups.length-1].endIdx=idx;
  });
  if(inForecastOthers>0){
    trueCum+=inForecastOthers;
    var dStart=dispTopM,dEnd=dispTopM+dispHM(inForecastOthers);
    dispTopM=dEnd;
    var oIdx=pushBar({
      value:inForecastOthers,trueCum:trueCum,
      displayStart:dStart,displayEnd:dEnd,color:'#3b82f6',type:'step',
      meta:'Proposed (In Forecast) · Others · '+fmt(inForecastOthers),custName:'Others'
    },'In Forecast · Others · '+fmt(inForecastOthers));
    if(sectionGroups.length&&sectionGroups[sectionGroups.length-1].key==='inf') sectionGroups[sectionGroups.length-1].endIdx=oIdx;
    else sectionGroups.push({key:'inf',label:'In Forecast',color:'#2563eb',startIdx:oIdx,endIdx:oIdx});
  }
  if(isBest&&outForecastVal>0){
    trueCum+=outForecastVal;
    var odStart=dispTopM,odEnd=dispTopM+dispHM(outForecastVal);
    dispTopM=odEnd;
    var outIdx=pushBar({
      value:outForecastVal,trueCum:trueCum,
      displayStart:odStart,displayEnd:odEnd,color:'#ea580c',type:'outforecast',
      meta:'Opportunity (Out Forecast) · '+fmt(outForecastVal),custName:'Out Forecast'
    },'Opportunity · Out Forecast · '+fmt(outForecastVal));
    sectionGroups.push({key:'outf',label:'Out Forecast',color:'#ea580c',startIdx:outIdx,endIdx:outIdx});
  }
  var gapVal=over?0:gap;
  var overVal=over?Math.abs(gap):0;
  if(gapVal>0){
    var gStart=dispTopM;
    var gEnd=Math.max(dispTopM+dispHM(gapVal),targetM);
    dispTopM=gEnd;
    var gIdx=pushBar({
      value:gapVal,trueCum:targetVal,
      displayStart:gStart,displayEnd:gEnd,color:'#f59e0b',type:'gap',
      meta:'Gap · '+fmt(gapVal)+' short of target',custName:'Gap'
    },'Gap · '+fmt(gapVal)+' short');
    sectionGroups.push({key:'gap',label:'Gap to Target',color:'#f59e0b',startIdx:gIdx,endIdx:gIdx});
  }else if(overVal>0){
    var ovStart=dispTopM,ovEnd=dispTopM+dispHM(overVal);
    dispTopM=ovEnd;
    var ovIdx=pushBar({
      value:overVal,trueCum:total,
      displayStart:ovStart,displayEnd:ovEnd,color:'#0ea5e9',type:'over',
      meta:'Over Target · +'+fmt(overVal),custName:'Over Target'
    },'Over Target · +'+fmt(overVal));
    sectionGroups.push({key:'over',label:'Over Target',color:'#0ea5e9',startIdx:ovIdx,endIdx:ovIdx});
  }
  var targetOffScale=targetM>dispTopM*1.8;
  var targetDisp=targetOffScale?null:targetM;
  var yMax=Math.max(dispTopM,targetDisp||0,targetM,0.001)*1.08;
  var floatData=bars.map(glkBridgeFloatBar);
  var bg=bars.map(function(b){return b.color;});
  var bridgePlugins=[
    glkBridgeMinPxPlugin(bars,42),
    glkBridgeBarLabelPlugin(bars),
    glkBridgeGroupPlugin(sectionGroups,c),
    glkBridgeConnectorPlugin(bars)
  ];
  if(targetDisp!=null){
    bridgePlugins.push(glkBridgeTargetLinePlugin(targetDisp,'Target '+fmt(targetVal),c));
    bridgePlugins.push(glkBridgeOverZonePlugin(wonBilledVal,targetVal));
  }
  var canvas=el('chartBridge');
  if(!canvas) return;
  try{
  CHARTS.bridge=new Chart(canvas,{
    type:'bar',
    plugins:bridgePlugins,
    data:{labels:labelList,glkBars:bars,datasets:[{
      label:(metric==='mrc'?'MRC':'TCV'),
      data:floatData,
      backgroundColor:bg,
      borderRadius:5,
      borderSkipped:false,
      barPercentage:.88,
      categoryPercentage:.82,
      maxBarThickness:64
    }]},
    options:{responsive:true,maintainAspectRatio:false,
      layout:{padding:{bottom:78,top:targetOffScale?20:12,left:6,right:10}},
      plugins:{
        legend:{display:false},
        tooltip:{backgroundColor:'rgba(15,10,30,.88)',padding:14,cornerRadius:12,titleFont:{size:12,weight:'700'},bodyFont:{size:12},
          callbacks:{
            title:function(items){return barMeta[items[0].dataIndex]?barMeta[items[0].dataIndex].label:'';},
            label:function(ctx){
              var b=bars[ctx.dataIndex];
              if(b.type==='base') return '  Won + Billed '+fmt(b.value);
              if(b.type==='gap') return '  Gap '+fmt(b.value)+' short of target';
              if(b.type==='over') return '  Over Target +'+fmt(b.value);
              if(b.type==='outforecast') return '  Out Forecast '+fmt(b.value);
              return '  +'+fmt(b.value);
            },
            afterBody:function(items){
              var b=bars[items[0].dataIndex];
              if(b.type==='step'||b.type==='outforecast') return ['  Running total: '+fmt(b.trueCum)];
              return [];
            }
          }
        }
      },
      scales:{
        x:{ticks:{display:false},grid:{display:false}},
        y:{min:0,max:yMax,grace:0,ticks:{color:c.text,font:{size:10},callback:function(v){return v+'M';}},grid:{color:c.grid},
          title:{display:true,text:'AED (M) · '+mqCaseDisplayName(isBest?'best':'worst'),color:c.text,font:{size:9,weight:'600'}}}
      }
    }
  });
  }catch(err){console.error('[GLK] Bridge chart error:',err);}
  var wrap=el('bridgeControlsWrap');
  if(wrap){
    var gapTxt=over?('<span style="color:#0ea5e9;">+'+fmt(overVal)+' over target</span>'):('<span style="color:#f59e0b;">'+fmt(gapVal)+' short of target</span>');
    wrap.innerHTML='<div style="display:flex;flex-direction:column;gap:.45rem;margin-top:.65rem;">'+
      glkBridgeControlsHtml(bids)+
      '<div style="font-size:.68rem;color:var(--t3);font-weight:600;line-height:1.5;">'+
      '<strong>'+mqCaseDisplayName(isBest?'best':'worst')+'</strong> · Won+Billed '+fmt(wonBilledVal)+
      ' · In Forecast '+fmt(top10Sum+inForecastOthers)+
      (isBest?' · Out Forecast '+fmt(outForecastVal):'')+
      ' · Total '+fmt(total)+' · Target '+fmt(targetVal)+' · '+gapTxt+
      (bridgeDrill!=='all'&&bridgeDrillVal?' · Drill: '+bridgeDrillVal:'')+
      (targetOffScale?' · <span style="color:#ef4444;">Target above chart</span>':'')+
      '</div></div>';
  }
  // Compare year summary
  if(glkCompareEnabled&&wrap){
    var prevScoped=glkFilterByChartPeriodYear(bids,chartPeriod,glkCompareYear);
    if(bridgeDrill==='vertical'&&bridgeDrillVal) prevScoped=prevScoped.filter(function(b){return b.vertical===bridgeDrillVal;});
    else if(bridgeDrill==='am'&&bridgeDrillVal) prevScoped=prevScoped.filter(function(b){return b.amName===bridgeDrillVal||b.amEmail===bridgeDrillVal;});
    var pw=prevScoped.filter(function(b){return b.status==='Won'||b.status==='Billed';}).reduce(function(s,b){return s+glkBidMetric(b,metric);},0);
    var pi=glkBridgeTop10Asc(prevScoped.filter(function(b){return b.status==='Proposed';}),metric);
    var po=isBest?prevScoped.filter(function(b){return b.status==='Opportunity';}).reduce(function(s,b){return s+glkBidMetric(b,metric);},0):0;
    var pt=pw+pi.items.reduce(function(s,p){return s+p.value;},0)+pi.others+po;
    var pg=targetVal-pt;
    var cmpLine=el('bridgeCompareLine');
    if(!cmpLine){
      cmpLine=document.createElement('div');
      cmpLine.id='bridgeCompareLine';
      cmpLine.style.cssText='font-size:.66rem;color:var(--t3);font-weight:600;margin-top:.2rem;';
      wrap.appendChild(cmpLine);
    }
    cmpLine.textContent='Compare '+glkCompareYear+': Total '+fmt(pt)+(pg>0?' · '+fmt(pg)+' short':' · +'+fmt(Math.abs(pg))+' over');
  }else{
    var rm=el('bridgeCompareLine'); if(rm) rm.remove();
  }
}
let lbMode='hd';
let lbMetric='tcv';
let vertMetric='tcv';
function renderLeaderboard(bids,c){
  destroyChart('lb');
  const role=USER.role;

  // Determine available modes based on role
  let modes=[];
if(role==='Admin'||role==='CEO'||role==='Admin (Dev)'||role==='admin'||role==='ADMIN'){    modes=[
      {k:'hd',l:'Head Directors'},
      {k:'ad',l:'Account Directors'},
      {k:'am',l:'Account Managers'}
    ];
  } else if(role==='Head Director'){
    modes=[
      {k:'ad',l:'Account Directors'},
      {k:'am',l:'Account Managers'}
    ];
    if(lbMode==='hd') lbMode='ad';
  } else if(role==='Account Director'){
    modes=[{k:'am',l:'Account Managers'}];
    lbMode='am';
  } else {
    // Account Manager — hide leaderboard entirely
    const card=el('chartLeaderboard')?.closest('.chart-card');
    if(card) card.style.display='none';
    return;
  }

  // Build HD/AD/AM toggle buttons
  const wrap=el('lbControlsWrap');
  if(wrap){
    wrap.innerHTML=`<div style="display:flex;gap:.5rem;margin-bottom:.75rem;flex-wrap:wrap;">
      ${modes.map(m=>`<button type="button"
        onclick="lbMode='${m.k}';renderLeaderboard(getViewBids(),getChartColors())"
        style="padding:.35rem 1rem;border-radius:8px;font-size:.78rem;font-weight:700;
        border:2px solid ${lbMode===m.k?'transparent':'var(--border)'};cursor:pointer;
        background:${lbMode===m.k?'var(--grad)':'var(--bg-secondary)'};
        color:${lbMode===m.k?'#fff':'var(--t3)'};transition:all .18s;">
        ${m.l}</button>`).join('')}
    </div>`;
  }

  // Build metric toggle buttons
  const metricWrap=el('lbMetricToggle');
  if(metricWrap){
    const isMobile=selPF==='Mobile';
    const metrics=isMobile?
      [{k:'tcv',l:'TCV'},{k:'gaLines',l:'GA Lines'},{k:'ga',l:'GA Pts'},{k:'otc',l:'OTC'}]:
      [{k:'tcv',l:'TCV'},{k:'mrc',l:'MRC'},{k:'otc',l:'OTC'}];
    metricWrap.innerHTML=metrics.map(m=>`<button type="button"
      onclick="lbMetric='${m.k}';renderLeaderboard(getViewBids(),getChartColors())"
      style="padding:.25rem .75rem;border-radius:6px;font-size:.72rem;font-weight:700;
      border:1px solid ${lbMetric===m.k?'transparent':'var(--border)'};cursor:pointer;
      background:${lbMetric===m.k?'var(--grad)':'var(--bg-secondary)'};
      color:${lbMetric===m.k?'#fff':'var(--t3)'};transition:all .15s;">
      ${m.l}</button>`).join('');
  }

  // Build data entries scoped correctly per role + mode
  const map={};

  if(lbMode==='hd'){
    // Admin only — all HDs
    bids.forEach(b=>{
      const k=b.headDirector||'?';
      if(!k||k==='—') return;
      if(!map[k]) map[k]={won:0,total:0,wonTCV:0,mrc:0,otc:0,ga:0,gaLines:0};
      if(STATUS_WON.includes(b.status)){map[k].won++;map[k].wonTCV+=b.tcv;}
      map[k].mrc+=b.mrc;map[k].otc+=b.otc;map[k].ga+=b.gaPoints;map[k].gaLines+=(b.gaLines||0);map[k].total++;
    });

  } else if(lbMode==='ad'){
    // Admin → all ADs | HD → only ADs under this HD
    let scope=bids;
    if(role==='Head Director'){
      const myHD=findMyHD();
      scope=bids.filter(b=>b.headDirector===myHD);
    }
    scope.forEach(b=>{
      const k=b.accountDirector||'?';
      if(!k||k==='—') return;
      if(!map[k]) map[k]={won:0,total:0,wonTCV:0,mrc:0,otc:0,ga:0,gaLines:0};
      if(STATUS_WON.includes(b.status)){map[k].won++;map[k].wonTCV+=b.tcv;}
      map[k].mrc+=b.mrc;map[k].otc+=b.otc;map[k].ga+=b.gaPoints;map[k].gaLines+=(b.gaLines||0);map[k].total++;
    });

  } else {
    // Admin → all AMs | HD → AMs under his ADs | AD → only his AMs
    let scope=bids;
    if(role==='Head Director'){
      const myHD=findMyHD();
      scope=bids.filter(b=>b.headDirector===myHD);
    } else if(role==='Account Director'){
      const myAD=findMyAD();
      scope=bids.filter(b=>b.accountDirector===myAD);
    }
    scope.forEach(b=>{
      const k=b.amName||'?';
      if(!k||k==='—') return;
      if(!map[k]) map[k]={won:0,total:0,wonTCV:0,mrc:0,otc:0,ga:0,gaLines:0};
      if(STATUS_WON.includes(b.status)){map[k].won++;map[k].wonTCV+=b.tcv;}
      map[k].mrc+=b.mrc;map[k].otc+=b.otc;map[k].ga+=b.gaPoints;map[k].gaLines+=(b.gaLines||0);map[k].total++;
    });
  }

  const getMetricVal=(v)=>{
    if(lbMetric==='tcv') return +(v.wonTCV/1e6).toFixed(2);
    if(lbMetric==='mrc') return +(v.mrc/1e6).toFixed(2);
    if(lbMetric==='otc') return +(v.otc/1e6).toFixed(2);
    if(lbMetric==='ga') return +(v.ga/1e6).toFixed(2);
    if(lbMetric==='gaLines') return +(v.gaLines/1e6).toFixed(2);
    return 0;
  };
  const metricLabel={'tcv':'TCV','mrc':selPF==='Mobile'?'GA Pts':'MRC','otc':'OTC','ga':'GA Pts','gaLines':'GA Lines'}[lbMetric];

  const entries=Object.entries(map);
  const sorted=entries.sort((a,b)=>getMetricVal(b[1])-getMetricVal(a[1])).slice(0,12);

  if(!sorted.length){
    el('chartLeaderboard').parentElement.innerHTML+='<div style="padding:20px;color:var(--t3);text-align:center;font-size:.85rem;">No data available</div>';
    return;
  }

  // Color bars: green=high win rate, accent=mid, red=low
  const barColors=sorted.map(([,v])=>{
    const wr=v.total?v.won/v.total:0;
    return wr>=.55?'#10b981':wr>=.30?c.p1:'#ef4444';
  });

  // Dynamic height based on number of entries
  const chartHeight=Math.max(320, sorted.length*52);
  const canvasWrap=el('chartLeaderboard').parentElement;
  canvasWrap.style.height=chartHeight+'px';

  CHARTS.lb=new Chart(el('chartLeaderboard'),{
    type:'bar',
    data:{
      labels:sorted.map(([k])=>k),
      datasets:[{
        label:metricLabel+' (M)',
        data:sorted.map(([,v])=>getMetricVal(v)),
        backgroundColor:barColors,
        borderRadius:8,
        borderSkipped:false,
        barThickness:28,
      }]
    },
    options:{
      indexAxis:'y',
      responsive:true,
      maintainAspectRatio:false,
      layout:{padding:{right:60}},
      plugins:{
        legend:{display:false},
        tooltip:{
          backgroundColor:'rgba(0,0,0,.82)',
          padding:14,
          cornerRadius:10,
          titleFont:{size:13,weight:'700'},
          bodyFont:{size:12},
          bodySpacing:5,
          callbacks:{
            label:ctx=>'  '+metricLabel+': '+ctx.parsed.x.toFixed(2)+'M',
            afterLabel:ctx=>{
              const d=sorted[ctx.dataIndex][1];
              const wr=d.total?(d.won/d.total*100).toFixed(1):0;
              return [
                '  Total Bids: '+d.total,
                '  Won: '+d.won,
                '  Win Rate: '+wr+'%',
                '  MRC: '+fmt(d.mrc),
                '  OTC: '+fmt(d.otc),
              ];
            }
          }
        }
      },
      scales:{
        x:{
          ticks:{color:c.text,font:{size:11},callback:v=>v+'M'},
          grid:{color:c.grid},
          border:{dash:[4,4]},
          beginAtZero:true
        },
        y:{
          ticks:{
            color:c.text,
            font:{size:12,weight:'700'},
            padding:12,
          },
          grid:{display:false}
        }
      }
    },
    plugins:[{
      id:'lbValueLabels',
      afterDatasetsDraw(chart){
        const ctx=chart.ctx;
        chart.data.datasets[0].data.forEach((val,i)=>{
          const meta=chart.getDatasetMeta(0);
          const bar=meta.data[i];
          const pos=bar.tooltipPosition();
          ctx.save();
          ctx.font='bold 11px Inter,sans-serif';
          ctx.fillStyle=c.text;
          ctx.textAlign='left';
          ctx.textBaseline='middle';
          ctx.fillText(val.toFixed(2)+'M', pos.x+8, pos.y);
          ctx.restore();
        });
      }
    }]
  });
}
function renderVertical(bids,c){
  destroyChart('vert');
  const vm={};
  bids.forEach(b=>{const v=b.vertical||'Other';if(!vm[v])vm[v]={count:0,tcv:0};vm[v].count++;vm[v].tcv+=b.tcv;});
  const sorted=Object.entries(vm).sort((a,b)=>b[1][vertMetric]-a[1][vertMetric]).slice(0,10);
  const palette=['rgba(168,85,247,.85)','rgba(99,102,241,.85)','rgba(59,130,246,.85)','rgba(6,182,212,.85)','rgba(16,185,129,.85)','rgba(251,146,60,.85)','rgba(236,72,153,.85)','rgba(239,68,68,.85)','rgba(234,179,8,.85)','rgba(20,184,166,.85)'];
  const isValue=vertMetric==='tcv';
  CHARTS.vert=new Chart(el('chartVertical'),{type:'bar',plugins:[dataLabelPlugin],
    data:{labels:sorted.map(([k])=>k),datasets:[{
      data:sorted.map(([,v])=>isValue?+(v.tcv/1e6).toFixed(2):v.count),
      backgroundColor:palette.slice(0,sorted.length),
      borderRadius:8,borderSkipped:false}]},
options:{responsive:true,maintainAspectRatio:false,      plugins:{
        legend:{display:false},
        tooltip:{backgroundColor:'rgba(0,0,0,.75)',padding:12,cornerRadius:10,
          callbacks:{label:ctx=>isValue?ctx.parsed.x.toFixed(2)+'M':ctx.parsed.x+' bids'}}
      },
     scales:{
        x:{ticks:{color:c.text,font:{size:10,weight:'600'}},grid:{display:false}},
        y:{ticks:{color:c.text,callback:v=>isValue?v+'M':v},grid:{color:c.grid},beginAtZero:true}
      }}});
}

function setVertMetric(m){
  vertMetric=m;
  el('vertBtnTCV').style.background=m==='tcv'?'var(--grad)':'var(--bg-secondary)';
  el('vertBtnTCV').style.color=m==='tcv'?'#fff':'var(--t3)';
  el('vertBtnCount').style.background=m==='count'?'var(--grad)':'var(--bg-secondary)';
  el('vertBtnCount').style.color=m==='count'?'#fff':'var(--t3)';
  renderVertical(getViewBids(),getChartColors());
}
function renderServices(bids,c){
  destroyChart('svc');
  const sm={};
  bids.forEach(b=>{const s=b.services||'Unknown';if(s==='—'||!s)return;if(!sm[s])sm[s]=0;sm[s]++;});
  const sorted=Object.entries(sm).sort((a,b)=>b[1]-a[1]).slice(0,7);
  const total=sorted.reduce((s,[,v])=>s+v,0);
  const palette=['rgba(168,85,247,.88)','rgba(59,130,246,.88)','rgba(6,182,212,.88)','rgba(16,185,129,.88)','rgba(251,146,60,.88)','rgba(236,72,153,.88)','rgba(239,68,68,.88)'];
  const centerPlugin={id:'svcCenter',beforeDraw(chart){
    const{ctx,chartArea:{width,height,left,top}}=chart;
    ctx.save();
    ctx.font='bold 26px Inter';
    ctx.fillStyle=c.text==='rgba(255,255,255,0.6)'?'rgba(255,255,255,0.9)':'rgba(0,0,0,0.8)';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(total,left+width/2,top+height/2-10);
    ctx.font='600 11px Inter';ctx.fillStyle=c.text;
    ctx.fillText('Total Bids',left+width/2,top+height/2+14);
    ctx.restore();
  }};
  CHARTS.svc=new Chart(el('chartServices'),{type:'doughnut',plugins:[centerPlugin],
    data:{labels:sorted.map(([k])=>k),datasets:[{data:sorted.map(([,v])=>v),
      backgroundColor:palette.slice(0,sorted.length),borderWidth:3,borderColor:'var(--bg-card)',hoverOffset:10}]},
    options:{responsive:true,maintainAspectRatio:false,cutout:'62%',
      plugins:{legend:{position:'right',labels:{color:c.text,font:{size:10},padding:10,usePointStyle:true,pointStyleWidth:8}}}}});
}

let topChartMode='customers';
let svcMetric='tcv';

function setTopChart(mode){
  topChartMode=mode;
  const custBtn=el('topChartBtnCust'),svcBtn=el('topChartBtnSvc'),subToggle=el('svcSubToggle');
  const titleEl=el('topChartTitle');
  if(mode==='customers'){
    custBtn.style.background='var(--grad)';custBtn.style.color='#fff';
    svcBtn.style.background='var(--bg-secondary)';svcBtn.style.color='var(--t3)';
    if(subToggle){subToggle.style.display='none';}
    if(titleEl) titleEl.innerHTML=`<svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--acc);fill:none;stroke-width:2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg> Top 10 Customers by TCV`;
  } else {
    svcBtn.style.background='var(--grad)';svcBtn.style.color='#fff';
    custBtn.style.background='var(--bg-secondary)';custBtn.style.color='var(--t3)';
    if(subToggle){subToggle.style.display='flex';}
    if(titleEl) titleEl.innerHTML=`<svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--acc);fill:none;stroke-width:2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M4.93 4.93a10 10 0 0 0 0 14.14"/></svg> Top Services by ${svcMetric==='tcv'?'TCV':'Bid Count'}`;
  }
  renderTopChart(getViewBids(),getChartColors());
}

function setSvcMetric(m){
  svcMetric=m;
  el('svcBtnTCV').style.background=m==='tcv'?'var(--grad)':'var(--bg-secondary)';
  el('svcBtnTCV').style.color=m==='tcv'?'#fff':'var(--t3)';
  el('svcBtnBids').style.background=m==='bids'?'var(--grad)':'var(--bg-secondary)';
  el('svcBtnBids').style.color=m==='bids'?'#fff':'var(--t3)';
  const titleEl=el('topChartTitle');
  if(titleEl) titleEl.innerHTML=`<svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--acc);fill:none;stroke-width:2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M4.93 4.93a10 10 0 0 0 0 14.14"/></svg> Top Services by ${m==='tcv'?'TCV':'Bid Count'}`;
  renderTopChart(getViewBids(),getChartColors());
}

function renderTopChart(bids,c){
  destroyChart('topCust');
  let labels=[],data=[],colors=[];
  const palette=['#6366f1','#8b5cf6','#a855f7','#c084fc','#06b6d4','#10b981','#f59e0b','#ef4444','#ec4899','#14b8a6'];

  if(topChartMode==='customers'){
    const cm={};
    bids.forEach(b=>{if(!b.customerName||b.customerName==='—')return;if(!cm[b.customerName])cm[b.customerName]=0;cm[b.customerName]+=b.tcv;});
    const sorted=Object.entries(cm).sort((a,b)=>b[1]-a[1]).slice(0,10);
    labels=sorted.map(([k])=>k);
    data=sorted.map(([,v])=>+(v/1e6).toFixed(2));
    colors=palette.slice(0,labels.length);
  } else {
    const sm={};
    bids.forEach(b=>{if(!b.services||b.services==='—')return;if(!sm[b.services])sm[b.services]={tcv:0,bids:0};sm[b.services].tcv+=b.tcv;sm[b.services].bids++;});
    const sorted=Object.entries(sm).sort((a,b)=>b[1][svcMetric]-a[1][svcMetric]).slice(0,10);
    labels=sorted.map(([k])=>k);
    data=svcMetric==='tcv'?sorted.map(([,v])=>+(v.tcv/1e6).toFixed(2)):sorted.map(([,v])=>v.bids);
    colors=palette.slice(0,labels.length);
  }

  CHARTS.topCust=new Chart(el('chartTopCustomers'),{type:'bar',plugins:[dataLabelPlugin],
    data:{labels,datasets:[{
      data,backgroundColor:colors,borderRadius:8,borderSkipped:false,
      barThickness:22,
    }]},
    options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,
      plugins:{
        legend:{display:false},
        tooltip:{backgroundColor:'rgba(0,0,0,.75)',padding:12,cornerRadius:10,
          callbacks:{label:ctx=>topChartMode==='customers'||svcMetric==='tcv'?ctx.parsed.x.toFixed(2)+'M':ctx.parsed.x+' bids'}}
      },
      scales:{
        x:{ticks:{color:c.text,font:{size:11},callback:v=>topChartMode==='customers'||svcMetric==='tcv'?v+'M':v},grid:{color:c.grid},border:{dash:[4,4]}},
        y:{ticks:{color:c.text,font:{size:11,weight:'600'}},grid:{display:false}}
      }}});
}
let gaTrendMetric='auto';
function renderGA(bids,c){
destroyChart('ga');
  const isMobile=selPF===MOBILE_PF;
  const useGA=isMobile;
  const titleEl=el('gaTrendTitle'); if(titleEl) titleEl.textContent=useGA?'GA Points Trend':'MRC Trend';
  const metricKey=useGA?'gaPoints':'mrc';
  const metricLabel=useGA?'GA Points':'MRC';
  const now=new Date();
  let labels=[],vals=[];
  const getBucket=(rd)=>{
    const d=new Date(rd);
    if(gaPeriod==='W') return d.getFullYear()+'-W'+String(getWeekOfYear(d)).padStart(2,'0');
    if(gaPeriod==='M') return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
    if(gaPeriod==='Q') return d.getFullYear()+'-Q'+Math.ceil((d.getMonth()+1)/3);
    return String(d.getFullYear());
  };
  const periods=gaPeriod==='W'?12:gaPeriod==='M'?12:gaPeriod==='Q'?8:5;
  const buckets=[];
  for(let i=periods-1;i>=0;i--){
    let label,bucket;
    if(gaPeriod==='W'){
      const d=new Date(now);d.setDate(d.getDate()-i*7);
      bucket=d.getFullYear()+'-W'+String(getWeekOfYear(d)).padStart(2,'0');
      label='W'+getWeekOfYear(d);
    } else if(gaPeriod==='M'){
      const d=new Date(now.getFullYear(),now.getMonth()-i,1);
      bucket=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
      label=d.toLocaleDateString('en-US',{month:'short',year:'2-digit'});
    } else if(gaPeriod==='Q'){
      const totalQ=now.getFullYear()*4+Math.ceil((now.getMonth()+1)/3)-1-i;
      const yr=Math.floor(totalQ/4);const q=(totalQ%4)+1;
      bucket=yr+'-Q'+q;label='Q'+q+' '+String(yr).slice(2);
    } else {
      const yr=now.getFullYear()-i;bucket=String(yr);label=String(yr);
    }
    labels.push(label);buckets.push(bucket);
    vals.push(bids.filter(b=>{const rd=getRelevantDate(b);if(!rd)return false;return getBucket(rd)===bucket;}).reduce((s,b)=>s+b[metricKey],0));
  }
  const ctx=el('chartGA').getContext('2d');
  const gaGrad=ctx.createLinearGradient(0,0,0,260);
  gaGrad.addColorStop(0,c.p2a+'0.4)');gaGrad.addColorStop(1,c.p2a+'0.02)');
  CHARTS.ga=new Chart(el('chartGA'),{type:'line',
    data:{labels,datasets:[{label:metricLabel,data:vals,borderColor:c.p2,backgroundColor:gaGrad,fill:true,tension:.42,pointRadius:5,pointHoverRadius:8,pointBackgroundColor:c.p2,pointBorderColor:'#fff',pointBorderWidth:2,borderWidth:2.5}]},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{
        legend:{display:false},
        tooltip:{backgroundColor:'rgba(0,0,0,.75)',padding:12,cornerRadius:10,titleFont:{size:13,weight:'700'},bodyFont:{size:12}}
      },
      scales:{x:{ticks:{color:c.text,font:{size:11,weight:'600'}},grid:{color:c.grid},border:{dash:[4,4]}},y:{ticks:{color:c.text},grid:{color:c.grid},border:{dash:[4,4]},beginAtZero:true}}}});

  const wrap=el('gaControlsWrap');
  if(wrap){
    wrap.innerHTML=`
      <div style="display:flex;justify-content:flex-end;margin-top:.65rem;gap:.35rem;">
        ${['W','M','Q','Y'].map(p=>`<button type="button" onclick="gaPeriod='${p}';renderGA(getViewBids(),getChartColors())" style="padding:.25rem .7rem;border-radius:6px;font-size:.72rem;font-weight:700;border:1px solid var(--border);cursor:pointer;background:${gaPeriod===p?'var(--grad)':'var(--bg-secondary)'};color:${gaPeriod===p?'#fff':'var(--t3)'}">${p==='W'?'Week':p==='M'?'Month':p==='Q'?'Quarter':'Year'}</button>`).join('')}
      </div>`;
  }
}

// ══════════════════════════════════════════════════════════════════
//  AG GRID
// ══════════════════════════════════════════════════════════════════
function glkCol(cfg,kind){
  kind=kind||'text';
  var base={filter:GlkValueListFilter};
  if(kind==='date') base.filterValueGetter=glkGridDateVal;
  else if(kind==='money') base.filterValueGetter=glkGridMoneyVal;
  else if(kind==='num') base.filterValueGetter=glkGridNumVal;
  else base.filterValueGetter=glkGridTextVal;
  return Object.assign(base,cfg);
}
var GLK_BID_DETAIL_FIELDS=[
  {k:'headDirector',l:'Head Director'},{k:'accountDirector',l:'Account Director'},{k:'amName',l:'Account Manager'},
  {k:'customerName',l:'Customer'},{k:'vertical',l:'Vertical'},{k:'productCategory',l:'Product'},
  {k:'productFamily',l:'Product Family'},{k:'services',l:'Services'},{k:'status',l:'Status'},
  {k:'closureProb',l:'Closure Prob.'},{k:'mrc',l:'MRC',money:true},{k:'otc',l:'OTC',money:true},{k:'tcv',l:'TCV',money:true},
  {k:'gaLines',l:'GA Lines',num:true},{k:'gaPoints',l:'GA Points',num:true},{k:'expectedActivation',l:'Expected Activation',date:true},
  {k:'typeOfRequest',l:'Type of Request'},{k:'typeOfContract',l:'Type of Contract'},{k:'forecastCategory',l:'Forecast Category'},
  {k:'complexity',l:'Complexity'},{k:'created',l:'Created',date:true},{k:'proposedDate',l:'Proposed Date',date:true},
  {k:'contractSigned',l:'Contract Signed',date:true},{k:'billedDate',l:'Billed Date',date:true},{k:'lostDate',l:'Lost Date',date:true},
  {k:'lostReason',l:'Lost Reason'},{k:'duration',l:'Duration'},{k:'customerCode',l:'Customer Code'},
  {k:'solutionManager',l:'Solution Manager'},{k:'bidManager',l:'Bid Manager'},{k:'projectManager',l:'Project Manager'},
  {k:'buildingName',l:'Building Name'},{k:'buildingUnit',l:'Building Unit'},{k:'buildingFloor',l:'Building Floor'},
  {k:'buildingStatus',l:'Building Status'},{k:'bidRequest',l:'Bid Request'},{k:'mnp',l:'MNP'},{k:'churnReason',l:'Churn Reasons'},
  {k:'thirdParty',l:'Third Party'},{k:'vendorName',l:'Vendor Name'},{k:'pocName',l:'POC Name'},{k:'pocJobRole',l:'POC Job Role'},
  {k:'pocEmail',l:'POC Email'},{k:'contactNo',l:'Contact No'},{k:'serviceRequirement',l:'Service Requirement'},
  {k:'bidManagerRequired',l:'BM Required'},{k:'solutionManagerRequired',l:'SM Required'},{k:'rfps',l:'RFPs'},
  {k:'m2mUseCase',l:'M2M Use Case'},{k:'m2mCustomerType',l:'M2M Customer Type'},{k:'m2mIndustryVertical',l:'M2M Industry'},
  {k:'myId',l:'My ID'},{k:'userName',l:'User Name'},{k:'bmAssignedDate',l:'BM Assigned Date',date:true},
  {k:'rfpSubmissionDate',l:'RFP Submission Date',date:true},{k:'solutionAssignedDate',l:'Solution Assigned Date',date:true},
  {k:'comments',l:'Comments/Remarks'},{k:'prepaidPostpaid',l:'Pre/Postpaid'},{k:'modified',l:'Modified',date:true}
];
function glkFormatBidDetailVal(bid,field){
  var fk=field.k||field.key;
  var v=bid[fk];
  if(v==null||v==='') return '—';
  if(field.date) return fmtDate(v);
  if(field.money) return fmt(v);
  if(field.num) return fk==='gaPoints'?fmtGA(v):fmtLines(v);
  return String(v);
}
function glkCloseBidDetail(){
  var bd=el('glkBidDetailBackdrop');
  if(bd) bd.remove();
}
var _glkBidRowCache={};
function glkOpenBidDetail(bidId){
  var bid=_glkBidRowCache[String(bidId)];
  if(!bid) bid=(ALL_BIDS||[]).find(function(b){return String(b.id)===String(bidId);});
  if(!bid) bid=getViewBids().find(function(b){return String(b.id)===String(bidId);});
  if(!bid) return;
  glkCloseBidDetail();
  var spUrl=mqBidEditUrl(bid);
  var backdrop=document.createElement('div');
  backdrop.id='glkBidDetailBackdrop';
  backdrop.className='glk-row-modal-backdrop';
  backdrop.onclick=function(e){ if(e.target===backdrop) glkCloseBidDetail(); };
  var modal=document.createElement('div');
  modal.id='glkBidDetailModal';
  modal.onclick=function(e){ e.stopPropagation(); };
  var kv=GLK_BID_DETAIL_FIELDS.map(function(f){
    return '<div><dt>'+f.l+'</dt><dd>'+glkFormatBidDetailVal(bid,f)+'</dd></div>';
  }).join('');
  modal.innerHTML=
    '<div class="glk-row-modal-hdr">'+
      '<div><h3>'+(bid.customerName||'Bid record')+'</h3><div style="font-size:.72rem;color:var(--t3);margin-top:.2rem;">'+(mqBidRefValue(bid)||('ID '+bid.id))+'</div></div>'+
      '<div class="glk-row-modal-actions">'+
        (spUrl?'<a href="'+spUrl+'" target="_blank" rel="noopener">Open SharePoint form ↗</a>':'')+
        '<button type="button" onclick="glkCloseBidDetail()">Close</button>'+
      '</div></div>'+
    '<dl class="glk-row-modal-kv">'+kv+'</dl>';
  backdrop.appendChild(modal);
  document.body.appendChild(backdrop);
}
window.glkOpenBidDetail=glkOpenBidDetail;
window.glkCloseBidDetail=glkCloseBidDetail;
function glkGridActionsRenderer(p){
  var d=p.data; if(!d) return '';
  _glkBidRowCache[String(d.id)]=d;
  return '<div class="glk-grid-actions">'+
    '<button type="button" class="glk-grid-eye" title="View full record" onclick="event.stopPropagation();glkOpenBidDetail(\''+String(d.id).replace(/'/g,'\\\'')+'\')">'+
      '<svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>'+
  '</div>';
}
function renderGrid(){
  if(typeof agGrid==='undefined'){ el('myGrid').innerHTML='<div style="padding:20px;color:var(--t3);">AG Grid not loaded.</div>'; return; }
  const data=getViewBids();
  const cols=[
    {colId:'actions',headerName:'',width:52,pinned:'left',sortable:false,filter:false,suppressHeaderMenuButton:true,resizable:false,cellRenderer:glkGridActionsRenderer,cellStyle:{display:'flex',alignItems:'center',justifyContent:'center',padding:0}},
    glkCol({field:'headDirector',headerName:'Head Director',width:170,minWidth:150}),
    glkCol({field:'accountDirector',headerName:'Account Director',width:170,minWidth:150}),
    glkCol({field:'amName',headerName:'Account Manager',width:160,minWidth:140}),
    glkCol({field:'customerName',headerName:'Customer',width:200,minWidth:160}),
    glkCol({field:'vertical',headerName:'Vertical',width:100,minWidth:80}),
    glkCol({field:'productCategory',headerName:'Product',width:160,minWidth:120}),
    glkCol({field:'productFamily',headerName:'Product Family',width:140,minWidth:110}),
    glkCol({field:'services',headerName:'Services',width:170,minWidth:130}),
    glkCol({field:'status',headerName:'Status',width:115,cellRenderer:function(p){
      var s=p.value||'—',cl=STATUS_WON.includes(s)?'badge-success':STATUS_LOST.includes(s)?'badge-danger':'badge-warning';
      return '<span class="status-badge '+cl+'">'+s+'</span>';
    }}),
    glkCol({field:'closureProb',headerName:'Closure Prob.',width:120,cellRenderer:function(p){
      var v=p.value||'—',col=v==='100%'?'#16a34a':v==='75%'?'rgba(22,163,74,.8)':v==='50%'?'#b45309':'#dc2626';
      return '<span style="font-weight:700;color:'+col+'">'+v+'</span>';
    }}),
    glkCol({field:'mrc',headerName:'MRC',width:110,valueFormatter:function(p){return fmt(p.value);}},'money'),
    glkCol({field:'otc',headerName:'OTC',width:110,valueFormatter:function(p){return fmt(p.value);}},'money'),
    glkCol({field:'tcv',headerName:'TCV',width:120,valueFormatter:function(p){return fmt(p.value);},cellStyle:{fontWeight:'700'}},'money'),
    glkCol({field:'gaLines',headerName:'GA Lines',width:90,valueFormatter:function(p){return fmtLines(p.value);}},'num'),
    glkCol({field:'gaPoints',headerName:'GA Points',width:100,valueFormatter:function(p){return fmtGA(p.value);}},'num'),
    glkCol({field:'expectedActivation',headerName:'Expected Activation',width:150,valueFormatter:function(p){return fmtDate(p.value);}},'date'),
    glkCol({field:'typeOfRequest',headerName:'Type of Request',width:140}),
    glkCol({field:'typeOfContract',headerName:'Type of Contract',width:140}),
    {
      colId:'yearImpact',headerName:'Year Impact ⓘ',width:155,sortable:true,resizable:true,
      filter:GlkValueListFilter,
      filterValueGetter:function(p){var r=calcYearImpact(p.data);return r.val!=null?fmtYearImpact(r.val):'—';},
      headerTooltip:'Year Impact = MRC × months remaining in current year from Expected Activation date (inclusive). Only current-year activation dates are calculated. Past year = skipped. Next year = shown with note. Excludes Lost / Cancelled / No Bid.',
      valueGetter:function(p){return calcYearImpact(p.data).val;},
      cellRenderer:function(p){
        var r=calcYearImpact(p.data);
        if(r.val===null&&r.note) return '<span style="color:var(--t3);font-size:.76rem;font-style:italic">— <span title="'+r.note+'" style="cursor:help;border-bottom:1px dashed var(--t3);">ⓘ</span></span>';
        if(r.val===null) return '<span style="color:var(--t3);">—</span>';
        return '<span style="font-weight:700;color:var(--sc);">'+fmtYearImpact(r.val)+'</span>';
      },
      cellStyle:{display:'flex',alignItems:'center'}
    },
    glkCol({field:'forecastCategory',headerName:'Forecast Category',width:170}),
    glkCol({field:'complexity',headerName:'Complexity',width:110}),
    glkCol({field:'created',headerName:'Created',width:120,valueFormatter:function(p){return fmtDate(p.value);}},'date'),
    glkCol({field:'proposedDate',headerName:'Proposed Date',width:130,valueFormatter:function(p){return fmtDate(p.value);}},'date'),
    glkCol({field:'contractSigned',headerName:'Contract Signed',width:140,valueFormatter:function(p){return fmtDate(p.value);}},'date'),
    glkCol({field:'billedDate',headerName:'Billed Date',width:120,valueFormatter:function(p){return fmtDate(p.value);}},'date'),
    glkCol({field:'lostDate',headerName:'Lost Date',width:120,valueFormatter:function(p){return fmtDate(p.value);}},'date'),
    glkCol({field:'lostReason',headerName:'Lost Reason',width:160}),
    glkCol({field:'duration',headerName:'Duration',width:100}),
    glkCol({field:'customerCode',headerName:'Customer Code',width:130}),
    glkCol({field:'solutionManager',headerName:'Solution Manager',width:140}),
    glkCol({field:'bidManager',headerName:'Bid Manager',width:140}),
    glkCol({field:'projectManager',headerName:'Project Manager',width:140}),
    glkCol({field:'buildingName',headerName:'Building Name',width:130}),
    glkCol({field:'buildingUnit',headerName:'Building Unit',width:110}),
    glkCol({field:'buildingFloor',headerName:'Building Floor',width:110}),
    glkCol({field:'buildingStatus',headerName:'Building Status',width:120}),
    glkCol({field:'bidRequest',headerName:'Bid Request',width:110}),
    glkCol({field:'mnp',headerName:'MNP',width:80}),
    glkCol({field:'churnReason',headerName:'Churn Reasons',width:130}),
    glkCol({field:'thirdParty',headerName:'Third Party',width:100}),
    glkCol({field:'vendorName',headerName:'Vendor Name',width:130}),
    glkCol({field:'pocName',headerName:'POC Name',width:130}),
    glkCol({field:'pocJobRole',headerName:'POC Job Role',width:130}),
    glkCol({field:'pocEmail',headerName:'POC Email',width:160}),
    glkCol({field:'contactNo',headerName:'Contact No',width:115}),
    glkCol({field:'serviceRequirement',headerName:'Service Requirement',width:150}),
    glkCol({field:'bidManagerRequired',headerName:'BM Required',width:110}),
    glkCol({field:'solutionManagerRequired',headerName:'SM Required',width:110}),
    glkCol({field:'rfps',headerName:'RFPs',width:90}),
    glkCol({field:'m2mUseCase',headerName:'M2M Use Case',width:130}),
    glkCol({field:'m2mCustomerType',headerName:'M2M Customer Type',width:130}),
    glkCol({field:'m2mIndustryVertical',headerName:'M2M Industry',width:130}),
    glkCol({field:'myId',headerName:'My ID',width:100}),
    glkCol({field:'userName',headerName:'User Name',width:120}),
    glkCol({field:'bmAssignedDate',headerName:'BM Assigned Date',width:130,valueFormatter:function(p){return fmtDate(p.value);}},'date'),
    glkCol({field:'rfpSubmissionDate',headerName:'RFP Submission Date',width:140,valueFormatter:function(p){return fmtDate(p.value);}},'date'),
    glkCol({field:'solutionAssignedDate',headerName:'Solution Assigned Date',width:150,valueFormatter:function(p){return fmtDate(p.value);}},'date'),
    glkCol({field:'comments',headerName:'Comments/Remarks',width:200}),
    glkCol({field:'prepaidPostpaid',headerName:'Pre/Postpaid',width:115}),
    glkCol({field:'modified',headerName:'Modified',width:120,valueFormatter:function(p){return fmtDate(p.value);}},'date'),
  ];
  var portal=el('dashboardContent')||document.body;
  const opts={
    columnDefs:cols,rowData:data,
    defaultColDef:{sortable:true,filter:GlkValueListFilter,filterValueGetter:glkGridTextVal,resizable:true},
    suppressMenuHide:true,
    popupParent:portal,
    pagination:true,paginationPageSize:50,paginationPageSizeSelector:[25,50,100,250],
    rowHeight:44,headerHeight:48,animateRows:true,enableCellTextSelection:true,
    onGridReady:p=>{GRID_API=p.api;}
  };
  if(GRID_API){try{GRID_API.destroy();}catch(e){} GRID_API=null;}
  el('myGrid').innerHTML='';
  agGrid.createGrid(el('myGrid'),opts);
}
function gridSearch(v){ if(GRID_API) GRID_API.setGridOption('quickFilterText',v); }

// ══════════════════════════════════════════════════════════════════
//  EXPORT
// ══════════════════════════════════════════════════════════════════
function exportExcel(){
  const data=getViewBids();
  const cols=['headDirector','accountDirector','amName','customerName','vertical','productCategory','productFamily','services','status','closureProb','mrc','otc','tcv','gaLines','gaPoints','expectedActivation','typeOfRequest','typeOfContract','forecastCategory','complexity','created','proposedDate','contractSigned','billedDate','lostDate','lostReason','duration','customerCode','solutionManager','bidManager','projectManager','buildingName','buildingUnit','buildingFloor','buildingStatus','bidRequest','mnp','churnReason','thirdParty','vendorName','pocName','pocJobRole','pocEmail','contactNo','serviceRequirement','bidManagerRequired','solutionManagerRequired','rfps','m2mUseCase','m2mCustomerType','m2mIndustryVertical','myId','userName','bmAssignedDate','rfpSubmissionDate','solutionAssignedDate','comments','prepaidPostpaid','modified'];
  const headers=['Head Director','Account Director','Account Manager','Customer','Vertical','Product','Product Family','Services','Status','Closure Prob.','MRC','OTC','TCV','GA Lines','GA Points','Expected Activation','Type of Request','Type of Contract','Forecast Category','Complexity','Created','Proposed Date','Contract Signed','Billed Date','Lost Date','Lost Reason','Duration','Customer Code','Solution Manager','Bid Manager','Project Manager','Building Name','Building Unit','Building Floor','Building Status','Bid Request','MNP','Churn Reasons','Third Party','Vendor Name','POC Name','POC Job Role','POC Email','Contact No','Service Requirement','BM Required','SM Required','RFPs','M2M Use Case','M2M Customer Type','M2M Industry','My ID','User Name','BM Assigned Date','RFP Submission Date','Solution Assigned Date','Comments/Remarks','Pre/Postpaid','Modified'];
  let html='<html><head><meta charset="utf-8"></head><body><table border="1" cellpadding="4" cellspacing="0">';
  html+='<tr>'+headers.map(h=>'<th style="background:#a855f7;color:white;font-weight:bold;padding:10px;">'+h+'</th>').join('')+'</tr>';
  const dateCols=['created','proposedDate','expectedActivation','contractSigned','billedDate','lostDate','bmAssignedDate','rfpSubmissionDate','solutionAssignedDate','modified'];
  const numCols=['mrc','otc','tcv','gaPoints','gaLines'];
  data.forEach((row,i)=>{
    const bg=i%2===0?'#f9f0ff':'#ffffff';
    html+='<tr>'+cols.map(c=>{let v=row[c];if(v==null||v==='')v='—';else if(dateCols.includes(c))v=fmtDate(v);else if(numCols.includes(c))v=fmtExportNum(v);else if(!v)v='—';return '<td style="background:'+bg+';padding:8px;">'+v+'</td>';}).join('')+'</tr>';
  });
  html+='</table></body></html>';
  const blob=new Blob([html],{type:'application/vnd.ms-excel'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob);
  a.download='GLK_Pipeline_'+new Date().toISOString().split('T')[0]+'.xls'; a.click();
}

// ══════════════════════════════════════════════════════════════════
//  RESET
// ══════════════════════════════════════════════════════════════════
function resetAll(){
  selHD=null;selAD=null;selAM=null;selStatusTile=null; hideAD(); hideAM();
  document.querySelectorAll('.ms-dropdown input:not([disabled])').forEach(cb=>cb.checked=false);
  FILTER_DEFS.forEach(fd=>updateMsText(fd.key));
  glkThisYearEnabled=true;
  glkDateRules=[glkThisYearRule()];
  glkCompareEnabled=false;
  glkCompareYear=String(new Date().getFullYear()-1);
  glkBuildDateFilters();
  applyAll();
  updateSelectionBadge();
}

// ══════════════════════════════════════════════════════════════════
//  SIDEBAR / THEME / SECTION SWITCHING
// ══════════════════════════════════════════════════════════════════
function toggleSidebar(){
  const sb=el('sidebar'); sb.classList.toggle('collapsed');
  const collapsed=sb.classList.contains('collapsed');
  el('sidebarToggleIcon').innerHTML=collapsed?
    '<polyline points="9 18 15 12 9 6"/><polyline points="15 18 21 12 15 6"/>':
    '<polyline points="15 18 9 12 15 6"/><polyline points="9 18 3 12 9 6"/>';
}
function switchSection(id,navEl){
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  const target=document.getElementById(id);
  if(target) target.scrollIntoView({behavior:'smooth',block:'start'});
  const active=navEl||(typeof event!=='undefined'&&event?event.currentTarget:null);
  if(active) active.classList.add('active');
}
function applyTheme(base,dark){
  if(base==='duralux') document.body.setAttribute('data-theme',dark?'duralux-dark':'duralux');
  else { if(dark) document.body.setAttribute('data-theme','dark'); else document.body.removeAttribute('data-theme'); }
  const icon=el('themeIcon');
  if(icon) icon.innerHTML=dark?
    '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>':
    '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';
}
let GLK_ACTIVE_NAV='navDashboard';
var GLK_NAV_IDS=['navDashboard','navMobileQtd','navRevenueRec','navGovernance'];
function glkSetActiveNav(navId){
  navId=navId||'navDashboard';
  if(GLK_NAV_IDS.indexOf(navId)<0) navId='navDashboard';
  GLK_ACTIVE_NAV=navId;
  try{ sessionStorage.setItem('glk_active_nav',GLK_ACTIVE_NAV); }catch(e){}
  GLK_NAV_IDS.forEach(function(id){
    var n=document.getElementById(id);
    if(!n) return;
    var on=(id===navId);
    n.classList.toggle('active',on);
    if(on){
      n.setAttribute('aria-current','page');
      n.setAttribute('data-active','true');
    }else{
      n.removeAttribute('aria-current');
      n.removeAttribute('data-active');
    }
  });
}
function glkRestoreActiveNav(){
  glkSetActiveNav(GLK_ACTIVE_NAV);
}
function glkHideAllMainViews(){
  ['dashboard-view','mobile-qtd-view','revenue-rec-view','governance-view'].forEach(function(id){
    var n=el(id); if(n) n.style.display='none';
  });
}
function glkShowDashboard(){
  glkHideAllMainViews();
  var dv=el('dashboard-view'); if(dv) dv.style.display='block';
  var tn=el('table-nav'); if(tn) tn.style.display='block';
  var ct=el('content'); if(ct) ct.classList.add('mq-view');
  var dc=el('dashboardContent'); if(dc) dc.classList.add('mq-full');
  glkSetActiveNav('navDashboard');
  if(!window._glkPipelineReady){
    glkShowDashboardLoading(window._glkPipelineLoading?'Loading pipeline from SharePoint…':'Loading pipeline from SharePoint…');
  }else{
    glkHideDashboardLoading();
  }
}
function glkPaintMobileQtd(){
  glkMobileQtdRefreshUI();
  try{ if(mqGetActiveReport()) renderMobileQtdBridge(); }catch(e){ console.error('[GLK] Bridge paint:',e); }
  try{ if(CHARTS.mobileQtd) CHARTS.mobileQtd.resize(); }catch(e2){}
}
function glkShowMobileQtd(){
  glkHideAllMainViews();
  var tn=el('table-nav'); if(tn) tn.style.display='none';
  var mv=el('mobile-qtd-view'); if(mv) mv.style.display='block';
  var ct=el('content'); if(ct) ct.classList.add('mq-view');
  var dc=el('dashboardContent'); if(dc) dc.classList.add('mq-full');
  glkSetActiveNav('navMobileQtd');
  glkMobileQtdInit(true);
  mqInitWowPriorStore();
  if(window._glkMobileSpRefreshing){
    glkEnsureBridgeReportOnShow();
  }else if(!window._GLK_BRIDGE_MENU_LOADED || !mqGetActiveReport()){
    glkMobileReportRefreshFromSharePoint();
  }else{
    glkPaintMobileQtd();
  }
  requestAnimationFrame(function(){ glkSetActiveNav('navMobileQtd'); });
  setTimeout(function(){ glkSetActiveNav('navMobileQtd'); },100);
}
function glkPaintTrends(){
  try{ if(RR_PARSED&&Object.keys(RR_PARSED).length) rrRenderActiveChart(); }catch(e){ console.error('[GLK] Trends paint:',e); }
  try{ if(CHARTS.revenueRec) CHARTS.revenueRec.resize(); }catch(e2){}
}
function glkShowRevenueRec(){
  glkHideAllMainViews();
  var rv=el('revenue-rec-view'); if(rv) rv.style.display='block';
  var tn=el('table-nav'); if(tn) tn.style.display='none';
  var ct=el('content'); if(ct) ct.classList.add('mq-view');
  var dc=el('dashboardContent'); if(dc) dc.classList.add('mq-full');
  glkSetActiveNav('navRevenueRec');
  requestAnimationFrame(function(){ glkSetActiveNav('navRevenueRec'); });
  rrInitControlsPanel();
  glkEnsureTrendsLoaded(true);
  setTimeout(glkPaintTrends,80);
  setTimeout(glkPaintTrends,280);
}
function changeTheme(event){
  const base=event.target.value;
  const cur=document.body.getAttribute('data-theme')||'';
  const isDark=cur==='dark'||cur==='duralux-dark';
  applyTheme(base,isDark);
  try{localStorage.setItem('glk_base_theme',base);}catch(e){}
  setTimeout(function(){ renderCharts(); if(el('revenue-rec-view')&&el('revenue-rec-view').style.display!=='none'&&RR_PARSED) rrRenderActiveChart(); },100);
}
function toggleTheme(){
  const cur=document.body.getAttribute('data-theme')||'';
  const isDark=cur==='dark'||cur==='duralux-dark';
  const isDural=cur==='duralux'||cur==='duralux-dark';
  applyTheme(isDural?'duralux':'magenta',!isDark);
  try{localStorage.setItem('glk_dark_mode',String(!isDark));}catch(e){}
  setTimeout(function(){ renderCharts(); if(el('revenue-rec-view')&&el('revenue-rec-view').style.display!=='none'&&RR_PARSED) rrRenderActiveChart(); },100);
}
function glkFullscreenElement(){
  return document.fullscreenElement||document.webkitFullscreenElement||null;
}
function glkIsFullscreen(){
  return !!(window._glkFullPage!==false || glkFullscreenElement());
}
function glkResizeAfterFullscreen(){
  setTimeout(function(){
    try{ renderCharts(); }catch(e){}
    try{ if(CHARTS.mobileQtd){ CHARTS.mobileQtd.resize(); mqSyncChartLabels(CHARTS.mobileQtd,GLK_MQ_LAST_BARS||[]); } }catch(e2){}
    try{ if(CHARTS.revenueRec) CHARTS.revenueRec.resize(); }catch(e3){}
    try{ if(el('revenue-rec-view')&&el('revenue-rec-view').style.display!=='none'&&RR_PARSED) rrRenderActiveChart(); }catch(e4){}
  },80);
  setTimeout(function(){
    try{ if(CHARTS.mobileQtd){ CHARTS.mobileQtd.resize(); mqSyncChartLabels(CHARTS.mobileQtd,GLK_MQ_LAST_BARS||[]); } }catch(e5){}
  },280);
}
function glkSyncFullscreenBtn(){
  var on=window._glkFullPage!==false || !!glkFullscreenElement();
  document.querySelectorAll('.glk-fs-btn').forEach(function(btn){
    btn.classList.toggle('active-fs',on);
    btn.title=on?'Minimize':'Full screen';
    var icon=btn.querySelector('svg');
    if(!icon) return;
    icon.innerHTML=on
      ?'<polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="14" y1="10" x2="21" y2="3"/><line x1="3" y1="21" x2="10" y2="14"/>'
      :'<polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/>';
  });
}
function glkOnFullscreenChange(){
  if(!glkFullscreenElement()&&window._glkWantNativeFs) window._glkWantNativeFs=false;
  glkSyncFullscreenBtn();
  glkResizeAfterFullscreen();
}
function glkExitNativeFullscreen(){
  var exitFn=document.exitFullscreen||document.webkitExitFullscreen;
  if(exitFn&&glkFullscreenElement()) exitFn.call(document);
}
function glkEnterFullscreen(){
  window._glkFullPage=true;
  document.documentElement.classList.add('glk-fullpage');
  glkSyncFullscreenBtn();
  var node=document.documentElement;
  var req=node.requestFullscreen||node.webkitRequestFullscreen;
  if(!req||glkFullscreenElement()) return;
  window._glkWantNativeFs=true;
  var p=req.call(node);
  if(p&&p.catch) p.catch(function(){ window._glkWantNativeFs=false; });
}
function glkMinimizeFullscreen(){
  window._glkFullPage=false;
  document.documentElement.classList.remove('glk-fullpage');
  glkExitNativeFullscreen();
  glkSyncFullscreenBtn();
  glkResizeAfterFullscreen();
}
function glkToggleFullscreen(){
  if(window._glkFullPage!==false || glkFullscreenElement()) glkMinimizeFullscreen();
  else glkEnterFullscreen();
}
function glkBindFullscreenOnGesture(){
  function go(e){
    if(e&&e.target&&e.target.closest&&e.target.closest('.glk-fs-btn')) return;
    if(window._glkFullPage===false) return;
    glkEnterFullscreen();
  }
  document.addEventListener('pointerdown',go,true);
  document.addEventListener('keydown',go,true);
}
document.addEventListener('fullscreenchange',glkOnFullscreenChange);
document.addEventListener('webkitfullscreenchange',glkOnFullscreenChange);
function updateSelectionBadge(){
  const b=el('selectionBadge'); if(!b) return;
  const parts=[];
  if(selHD) parts.push('HD: '+selHD);
  if(selAD) parts.push('AD: '+selAD);
  if(selAM) parts.push('AM: '+selAM);
  if(selStatusTile) parts.push('Status: '+selStatusTile);
  if(parts.length){ b.textContent=parts.join(' › '); b.style.display='flex'; }
  else { b.textContent=''; b.style.display='none'; }
}

// ══════════════════════════════════════════════════════════════════
//  MOBILE QTD BRIDGE
// ══════════════════════════════════════════════════════════════════
window.glkSetMobileQtdCase=function(c){
  mqCase=c==='best'?'best':'worst';
  mqSyncBridgeControlsUi();
  renderMobileQtdBridge();
};
window.glkSetMqProductFamily=function(pf){
  mqProductFamily=pf==='fixed'?'fixed':'mobile';
  if(mqProductFamily==='mobile') mqPeriod='qtd';
  GLK_MOBILE_REPORT=mqGetActiveReport();
  mqRefreshYtdTargetsOnReport(mqGetActiveReport());
  mqSyncBridgeControlsUi();
  mqBuildReportLevelFilter();
  GLK_MQ_DETAIL_IDX=-1;
  renderMobileQtdBridge();
};
window.glkToggleMqFutureQuarter=function(){
  mqFutureQuarter=!!(el('mqFutureQuarterToggle')&&el('mqFutureQuarterToggle').checked);
  GLK_MQ_DETAIL_IDX=-1;
  renderMobileQtdBridge();
};
window.glkSetMqPeriod=function(p){
  if(mqProductFamily!=='fixed'&&(p==='qtg'||p==='ytg')) return;
  mqPeriod=p==='ytd'?'ytd':(p==='qtg'?'qtg':(p==='ytg'?'ytg':'qtd'));
  if(mqPeriod!=='qtd') mqFutureQuarter=false;
  if(mqPeriod==='ytd'&&mqProductFamily==='mobile') mqPromptYtdMobileSetup();
  mqRefreshYtdTargetsOnReport(mqGetActiveReport());
  mqSyncBridgeControlsUi();
  GLK_MQ_DETAIL_IDX=-1;
  renderMobileQtdBridge();
};
function mqLoadYtdManual(){
  try{
    var s=localStorage.getItem(GLK_YTD_STORAGE_KEY);
    if(s){
      GLK_YTD_MANUAL=JSON.parse(s)||{mobile:{overall:{},byVert:{}},fixed:{byVert:{}}};
    }else{
      ['GLK_YTD_MANUAL','GLK_MOBILE_YTD_MANUAL'].forEach(function(oldKey){
        var legacy=localStorage.getItem(oldKey);
        if(!legacy) return;
        try{
          var old=JSON.parse(legacy)||{};
          GLK_YTD_MANUAL={mobile:{overall:{},byVert:{}},fixed:{byVert:{}}};
          if(old.q1Target!=null) GLK_YTD_MANUAL.mobile.overall.q1=old.q1Target;
          if(old.mobile){
            GLK_YTD_MANUAL.mobile.overall=Object.assign({},GLK_YTD_MANUAL.mobile.overall,old.mobile.overall||{});
            GLK_YTD_MANUAL.mobile.byVert=Object.assign({},GLK_YTD_MANUAL.mobile.byVert,old.mobile.byVert||{});
          }
          mqSaveYtdManual();
        }catch(e2){}
      });
    }
  }catch(e){ GLK_YTD_MANUAL={mobile:{overall:{},byVert:{}},fixed:{byVert:{}}}; }
  if(!GLK_YTD_MANUAL.mobile) GLK_YTD_MANUAL.mobile={overall:{},byVert:{}};
  if(!GLK_YTD_MANUAL.mobile.overall) GLK_YTD_MANUAL.mobile.overall={};
  if(!GLK_YTD_MANUAL.mobile.byVert) GLK_YTD_MANUAL.mobile.byVert={};
  if(!GLK_YTD_MANUAL.fixed) GLK_YTD_MANUAL.fixed={byVert:{}};
  if(!GLK_YTD_MANUAL.fixed.byVert) GLK_YTD_MANUAL.fixed.byVert={};
}
function mqSaveYtdManual(){
  try{ localStorage.setItem(GLK_YTD_STORAGE_KEY,JSON.stringify(GLK_YTD_MANUAL)); }catch(e){}
}
function mqLoadMobileYtdManual(){ mqLoadYtdManual(); }
function mqSaveMobileYtdManual(){ mqSaveYtdManual(); }
function glkYtdManualScopeKey(scopeName){
  if(!scopeName||/overall|glk overall|total/i.test(scopeName)) return 'overall';
  return mqNormVertKey(scopeName);
}
function glkGetYtdManualOverrides(scopeName){
  mqLoadYtdManual();
  var k=glkYtdManualScopeKey(scopeName);
  if(k==='overall') return GLK_YTD_MANUAL.mobile.overall||{};
  return (GLK_YTD_MANUAL.mobile.byVert&&GLK_YTD_MANUAL.mobile.byVert[k])||{};
}
function mqSetYtdManualValue(field,value,scopeName){
  mqLoadYtdManual();
  var k=glkYtdManualScopeKey(scopeName);
  if(k==='overall'){
    if(!GLK_YTD_MANUAL.mobile.overall) GLK_YTD_MANUAL.mobile.overall={};
    GLK_YTD_MANUAL.mobile.overall[field]=value;
  }else{
    if(!GLK_YTD_MANUAL.mobile.byVert) GLK_YTD_MANUAL.mobile.byVert={};
    if(!GLK_YTD_MANUAL.mobile.byVert[k]) GLK_YTD_MANUAL.mobile.byVert[k]={};
    GLK_YTD_MANUAL.mobile.byVert[k][field]=value;
  }
}
function glkMobileTargetEntryForScope(tb,scopeName){
  if(!tb) return null;
  if(!scopeName||/overall|glk overall|total/i.test(scopeName)) return tb.overall||null;
  return (tb.byVert&&tb.byVert[mqNormVertKey(scopeName)])||null;
}
function glkListYtdTargetMissingForScope(tb,scopeName,manual){
  var entry=glkMobileTargetEntryForScope(tb,scopeName);
  var baseT=entry&&entry.targets?Object.assign({},entry.targets):{q1:null,q2:0,q3:null,apr:null,mayJune:0,ytd:0};
  return {baseT:baseT,missing:glkListYtdTargetMissing(baseT,manual||{},false),merged:glkMergeTargetsWithManual(baseT,manual||{})};
}
function mqCollectMobileYtdMissingScopes(report){
  report=report||mqGetActiveReport();
  if(mqGetActiveReportLevels().length) return [];
  var tb=report&&report.targetBlock;
  var manual=glkGetYtdManualOverrides('GLK Overall');
  var pack=glkListYtdTargetMissingForScope(tb,'GLK Overall',manual);
  var missing=pack.missing.filter(function(m){return m.key==='q1';});
  if(!missing.length) return [];
  return [{scopeName:'GLK Overall',label:'Overall',missing:missing,value:glkCalcMobileYtdTarget(pack.merged)}];
}
function mqMobileYtdVerticalTargetWarn(){
  if(!mqIsYtdBridge()||mqProductFamily!=='mobile') return '';
  if(mqGetActiveReportLevels().length){
    return 'Per-vertical YTD targets are not entered here — update the Net Add Lines › Target block in the Excel file for '+mqGetActiveReportLevels().join(', ')+'.';
  }
  return '';
}
function glkMergeTargetsWithManual(baseT,manual){
  var t=Object.assign({q1:null,q2:0,q3:null,q4:null,apr:null,mayJune:0,ytd:0,ytdTotal:0},baseT||{});
  mqYtdTargetFieldsForReport(mqGetActiveReport()).forEach(function(f){
    if(manual[f.key]!=null&&manual[f.key]!=='') t[f.key]=num(manual[f.key]);
  });
  t.q2=num(t.apr)+num(t.mayJune);
  t.ytd=(t.q1!=null?num(t.q1):0)+num(t.q2)+num(t.q3)+num(t.q4);
  if(!t.ytdTotal) t.ytdTotal=t.ytd;
  return t;
}
function mqYtdMissingSummaryForType(type,report){
  if(type!=='mobile'||!report) return [];
  return mqCollectMobileYtdMissingScopes(report).map(function(sc){
    return sc.label+': '+sc.missing.map(function(m){return m.label;}).join(', ');
  });
}
function glkTargetFieldPresent(baseT,field){
  if(!baseT) return false;
  var v=baseT[field];
  return v!=null&&v!=='';
}
function glkListYtdTargetMissing(baseT,manual,isFixed){
  if(isFixed&&baseT&&num(baseT.ytdTotal)) return [];
  var missing=[];
  mqYtdTargetFieldsForReport(mqGetActiveReport()).forEach(function(f){
    var fromExcel=glkTargetFieldPresent(baseT,f.key);
    var mv=manual[f.key];
    if(!fromExcel&&(mv==null||mv==='')) missing.push(f);
  });
  return missing;
}
function mqGetYtdCurrentMonth(){
  return (GLK_YTD_META&&GLK_YTD_META.currentMonth)||{month:new Date().getMonth(),year:new Date().getFullYear()};
}
function glkComputeYtdTargetForType(type,report,scopeName,currentMonth){
  mqLoadYtdManual();
  var tb=report&&report.targetBlock;
  var cm=currentMonth||mqGetYtdCurrentMonth();
  if(type==='fixed'){
    var fKey=mqNormVertKey(scopeName);
    var fEntry=(/overall|glk overall|total/i.test(scopeName)?(tb&&tb.overall):null)||(tb&&tb.byVert&&tb.byVert[fKey])||null;
    if(fEntry&&fEntry.targets){
      var ft=fEntry.targets;
      return {value:glkCalcFixedYtdTarget(ft,cm),missing:[],merged:ft,complete:true};
    }
    return {value:0,missing:[],merged:null,complete:false};
  }
  var manual=glkGetYtdManualOverrides('GLK Overall');
  var pack=glkListYtdTargetMissingForScope(tb,'GLK Overall',manual);
  return {value:glkCalcMobileYtdTarget(pack.merged),missing:pack.missing,merged:pack.merged,complete:!pack.missing.length};
}
function mqGetFixedYtdTarget(report,scopeName){
  var sn=scopeName||'GLK Overall';
  var fKey=mqNormVertKey(sn);
  if(/overall|glk overall|total/i.test(sn)){
    if(GLK_FIXED_YTD_TARGETS.overall&&GLK_FIXED_YTD_TARGETS.overall.targets)
      return num(GLK_FIXED_YTD_TARGETS.overall.targets.ytdTotal);
  }else if(GLK_FIXED_YTD_TARGETS.byVert&&GLK_FIXED_YTD_TARGETS.byVert[fKey])
    return num(GLK_FIXED_YTD_TARGETS.byVert[fKey].targets.ytdTotal);
  report=report||mqGetActiveReport();
  var tb=report&&report.targetBlock;
  var fEnt=(/overall|glk overall|total/i.test(sn)?(tb&&tb.overall):null)||(tb&&tb.byVert&&tb.byVert[fKey])||null;
  if(fEnt&&fEnt.targets&&fEnt.targets.ytdTotal!=null) return num(fEnt.targets.ytdTotal);
  return 0;
}
function glkSetFixedYtdTargetsFromBlock(block,sheetName){
  if(!block||!block.overall) return;
  GLK_FIXED_YTD_TARGETS={
    overall:block.overall,
    byVert:block.byVert||{},
    sourceSheet:sheetName||null,
    periodCols:block.periodCols||[]
  };
}
function mqGetYtdScopeTarget(report,scopeName){
  report=report||mqGetActiveReport();
  if(mqProductFamily==='fixed'){
    return Object.assign({scopeName:scopeName},{value:mqGetFixedYtdTarget(report,scopeName),missing:[],merged:null,complete:true});
  }
  return Object.assign({scopeName:'GLK Overall'},glkComputeYtdTargetForType('mobile',report,'GLK Overall',mqGetYtdCurrentMonth()));
}
function mqGetYtdTargetScopeList(){
  return [{name:'GLK Overall',label:'Net Add Lines — Overall'}];
}
function mqGetMobileYtdOverallTarget(report){
  return mqGetYtdScopeTarget(report,'GLK Overall').value;
}
function mqRefreshAllYtdTargetsAfterParse(parsed){
  mqLoadYtdManual();
  var cm=(parsed&&parsed.ytdMeta&&parsed.ytdMeta.currentMonth)||mqGetYtdCurrentMonth();
  if(parsed&&parsed.mobile){
    var tbM=parsed.mobile.targetBlock;
    if(parsed.mobile.overall){
      parsed.mobile.overall.targetYtd=glkComputeYtdTargetForType('mobile',parsed.mobile,'GLK Overall',cm).value;
    }
    (parsed.mobile.verticals||[]).forEach(function(v){
      if(parsed.mobile.overall) v.targetYtd=parsed.mobile.overall.targetYtd;
    });
  }
  if(parsed&&parsed.fixed){
    if(GLK_FIXED_YTD_TARGETS.overall&&parsed.fixed.overall){
      parsed.fixed.overall.targetYtd=num(GLK_FIXED_YTD_TARGETS.overall.targets.ytdTotal);
    }
    (parsed.fixed.verticals||[]).forEach(function(v){
      var fEnt=GLK_FIXED_YTD_TARGETS.byVert&&GLK_FIXED_YTD_TARGETS.byVert[mqNormVertKey(v.name)];
      v.targetYtd=fEnt?num(fEnt.targets.ytdTotal):0;
    });
  }
}
function mqRefreshYtdTargetsOnReport(report){
  report=report||mqGetActiveReport();
  if(!report) return;
  var cm=mqGetYtdCurrentMonth();
  if(mqProductFamily==='mobile'){
    if(report.overall) report.overall.targetYtd=mqGetYtdScopeTarget(report,'GLK Overall').value;
    return;
  }
  if(mqProductFamily==='fixed'){
    if(report.overall&&GLK_FIXED_YTD_TARGETS.overall)
      report.overall.targetYtd=num(GLK_FIXED_YTD_TARGETS.overall.targets.ytdTotal);
    (report.verticals||[]).forEach(function(v){
      var fEnt=GLK_FIXED_YTD_TARGETS.byVert&&GLK_FIXED_YTD_TARGETS.byVert[mqNormVertKey(v.name)];
      v.targetYtd=fEnt?num(fEnt.targets.ytdTotal):0;
    });
  }
}
function mqYtdMissingSummary(report){
  if(mqProductFamily!=='mobile') return [];
  return mqYtdMissingSummaryForType('mobile',report||mqGetActiveReport());
}
function mqMobileYtdQ1Missing(report){
  var res=glkComputeYtdTargetForType('mobile',report||mqGetActiveReport(),'GLK Overall',mqGetYtdCurrentMonth());
  return res.missing.some(function(m){return m.key==='q1';});
}
function mqPromptYtdMobileSetup(){
  var lines=mqYtdMissingSummary();
  if(!lines.length) return;
  alert('Net Add Lines — Q1\'2026 target is missing from Excel.\n\nEnter it in the orange panel below (saved as '+GLK_YTD_STORAGE_KEY+').');
}
window.mqApplyYtdManualTargets=function(){
  if(mqProductFamily!=='mobile') return;
  var report=mqGetActiveReport();
  if(!report){ alert('Load the GLK report first.'); return; }
  var scopes=mqCollectMobileYtdMissingScopes(report);
  if(!scopes.length){ alert('No missing Mobile YTD targets — nothing to save.'); return; }
  var saved=0;
  for(var si=0;si<scopes.length;si++){
    var sc=scopes[si];
    var scopeKey=glkYtdManualScopeKey(sc.scopeName);
    for(var fi=0;fi<sc.missing.length;fi++){
      var f=sc.missing[fi];
      var inpId='mqYtd_'+scopeKey+'_'+f.key;
      var inp=el(inpId);
      if(!inp||!String(inp.value||'').trim()) continue;
      var v=glkParseReportNum(inp.value);
      if(v==null){ alert('Enter a valid number for '+sc.label+' · '+f.label); return; }
      mqSetYtdManualValue(f.key,v,sc.scopeName);
      saved++;
    }
  }
  if(!saved){ alert('Enter the missing target value(s) first.'); return; }
  mqSaveYtdManual();
  mqRefreshYtdTargetsOnReport(report);
  mqSyncYtdManualPanel();
  renderMobileQtdBridge();
};
window.mqApplyMobileYtdQ1=window.mqApplyYtdManualTargets;
function mqSyncYtdManualPanel(){
  var panel=el('mqYtdManualPanel');
  var body=el('mqYtdManualBody');
  var vertRow=el('mqYtdVertWarnRow');
  var show=mqIsYtdBridge()&&mqProductFamily==='mobile';
  if(!show||!panel||!body){
    if(panel) panel.style.display='none';
    return;
  }
  var report=mqGetActiveReport();
  if(!report){
    panel.style.display='none';
    return;
  }
  var vertWarn=mqMobileYtdVerticalTargetWarn();
  if(vertWarn){
    panel.style.display='block';
    body.innerHTML='<div style="color:#92400e;font-weight:600;">'+vertWarn+'</div>';
    if(vertRow) vertRow.style.display='none';
    return;
  }
  var scopes=mqCollectMobileYtdMissingScopes(report);
  if(!scopes.length){
    panel.style.display='none';
    return;
  }
  panel.style.display='block';
  var sc=scopes[0];
  var scopeKey=glkYtdManualScopeKey(sc.scopeName);
  var missLbl=sc.missing.map(function(m){return m.label;}).join(', ')||'targets';
  var html='<div style="margin-bottom:.3rem;">Missing <strong>'+missLbl+'</strong> on Overall · partial YTD target <strong>'+fmtLines(sc.value)+'</strong></div>';
  sc.missing.forEach(function(f){
    var inpId='mqYtd_'+scopeKey+'_'+f.key;
    var manual=glkGetYtdManualOverrides(sc.scopeName);
    var cur=manual[f.key]!=null?manual[f.key]:'';
    html+='<div style="display:flex;align-items:center;gap:.4rem;margin-bottom:.25rem;flex-wrap:wrap;">';
    html+='<label for="'+inpId+'" style="min-width:6.5rem;font-weight:600;">'+f.label+'</label>';
    html+='<input id="'+inpId+'" type="text" inputmode="decimal" value="'+(cur!==''?cur:'')+'" placeholder="Enter '+f.label+'" style="width:7.5rem;padding:.25rem .45rem;border:1px solid #f59e0b;border-radius:6px;font-size:.72rem;">';
    html+='</div>';
  });
  body.innerHTML=html;
  if(vertRow) vertRow.style.display='none';
}
function mqSyncYtdMobileManualPanel(){ mqSyncYtdManualPanel(); }
/** Bridge quarter/year: always from parsed GLK report when loaded — never hardcoded to a calendar quarter. */
function mqReportYearQuarter(){
  var report=mqGetActiveReport();
  if(report&&report.year&&report.quarter) return {year:report.year,quarter:report.quarter};
  var cm=GLK_YTD_META&&GLK_YTD_META.currentMonth;
  if(cm&&cm.year!=null&&cm.month!=null) return {year:cm.year,quarter:Math.floor(cm.month/3)+1};
  return mqLiveYearQuarter();
}
function glkInferYearFromWorkbook(wb){
  if(!wb||!wb.SheetNames) return new Date().getFullYear();
  for(var si=0;si<wb.SheetNames.length;si++){
    var rows=glkSheetToRows(wb.Sheets[wb.SheetNames[si]]);
    var asOf=glkParseReportAsOf(rows);
    if(asOf&&asOf.year) return asOf.year;
  }
  return new Date().getFullYear();
}
function mqBridgeLiveMonthIndex(viewYQ){
  var cm=GLK_YTD_META&&GLK_YTD_META.currentMonth;
  if(cm&&cm.year===viewYQ.year&&Math.floor(cm.month/3)+1===viewYQ.quarter) return cm.month;
  return new Date().getMonth();
}
function mqBridgeViewYearQuarter(){
  var live=mqReportYearQuarter();
  if(!mqFutureQuarter||mqPeriod!=='qtd') return Object.assign({},live,{future:false});
  var q=live.quarter+1,y=live.year;
  if(q>4){q=1;y++;}
  return {year:y,quarter:q,future:true};
}
function mqIsFutureQuarterBridge(){
  return !!(mqFutureQuarter&&mqPeriod==='qtd'&&!mqIsYtdBridge()&&!mqIsForwardBridge());
}
function mqPeriodLongName(p){
  p=p||mqPeriod;
  if(mqIsFutureQuarterBridge()) return 'QTD Bridge · Q'+mqBridgeViewYearQuarter().quarter+' '+mqBridgeViewYearQuarter().year+' (next quarter)';
  if(p==='ytd') return 'YTD Bridge';
  if(p==='qtg') return 'Aggregated Revenue — QTG';
  if(p==='ytg') return 'Aggregated Revenue — YTG';
  return 'QTD Bridge';
}
function mqPeriodShortName(p){
  p=p||mqPeriod;
  if(mqIsFutureQuarterBridge()) return 'Q'+mqBridgeViewYearQuarter().quarter+' '+mqBridgeViewYearQuarter().year+' preview';
  if(p==='ytd') return 'YTD Bridge';
  if(p==='qtg') return 'QTG';
  if(p==='ytg') return 'YTG';
  return 'QTD Bridge';
}
function mqIsYtdBridge(){ return mqPeriod==='ytd'; }
function mqSetControlsPanelCollapsed(collapsed){
  var panel=el('mqControlsPanel');
  var lbl=el('mqControlsToggleLabel');
  var btn=el('mqControlsToggleBtn');
  if(!panel) return;
  panel.classList.toggle('collapsed',!!collapsed);
  if(lbl) lbl.textContent=collapsed?'Show controls':'Hide controls';
  if(btn) btn.classList.toggle('collapsed',!!collapsed);
  try{ localStorage.setItem('glk_mq_controls_collapsed',collapsed?'1':'0'); }catch(e){}
  if(!collapsed){
    setTimeout(function(){
      if(CHARTS.mobileQtd){
        CHARTS.mobileQtd.resize();
        mqSyncChartLabels(CHARTS.mobileQtd,GLK_MQ_LAST_BARS||[]);
      }
    },260);
  }
}
window.mqToggleControlsPanel=function(){
  var panel=el('mqControlsPanel');
  if(!panel) return;
  mqSetControlsPanelCollapsed(!panel.classList.contains('collapsed'));
};
function mqInitControlsPanel(){
  var collapsed=false;
  try{ collapsed=localStorage.getItem('glk_mq_controls_collapsed')==='1'; }catch(e){}
  mqSetControlsPanelCollapsed(collapsed);
}
function mqGetFieldInfoText(key){
  var isFixed=mqProductFamily==='fixed';
  var map={
    pf:isFixed
      ?'Fixed: Net MRC (QTD + YTD) and Aggregated Revenue (QTG + YTG).'
      :'Mobile: Net Add Lines QTD and YTD. Switch to Fixed for Net MRC and Aggregated Revenue.',
    period:isFixed
      ?'Net MRC · QTD = quarter to date · YTD = Jan through current month (history sheet + live current month).'
      :'Net Add Lines · QTD and YTD against Excel actuals and target. YTD uses history for prior months; current month from live sheet.',
    agg:'Aggregated Revenue (Fixed only). QTG = activation through quarter-end. YTG = activation through 31 Dec. Formula uses MRC proration + OTC on gross/Won.',
    scenario:'Most Likely includes Proposed only in Needle Movers. Upside adds Opportunity status. Won bar is unchanged in both.',
    hd:'Khaled → AUH, F-NE, HUNT · Amer → DXB · Kamil → KEY-A, KEY-B, LE. Selecting a head director auto-selects matching report-level verticals.',
    rl:'Report level filters pipeline rows by GLK Excel vertical (AUH, DXB, KEY-A…). Applies to all bridge types.',
    search:'Find where a bid lands: Won · Top 5 / Others Needle Movers · Top 5 / Others churn · or why it was excluded.',
    drill:'Click any bar or product-table cell → account cards below with bid reference, HD/AD/AM, and Open in SharePoint. Click an account for the full pipeline row.',
    table:'Click a product row or Gross / Churn / Net cell → same account drill-down as the bridge chart.',
    futureq:'Preview the upcoming quarter from live pipeline only. Shows Won, Needle Movers, and Churn for activations in the next calendar quarter. Actuals and target bars are hidden because the quarter has not started yet.'
  };
  return map[key]||'';
}
window.mqShowFieldInfo=function(e,key){
  if(e) e.stopPropagation();
  var pop=el('mqFieldInfoPop');
  if(!pop) return;
  var txt=mqGetFieldInfoText(key);
  if(!txt) return;
  if(pop.classList.contains('open')&&pop.getAttribute('data-key')===key){
    pop.classList.remove('open');
    return;
  }
  pop.innerHTML='<div style="font-weight:800;color:var(--t1);margin-bottom:.35rem;text-transform:capitalize;">'+key.replace(/([a-z])([A-Z])/g,'$1 $2')+'</div>'+txt;
  pop.setAttribute('data-key',key);
  pop.classList.add('open');
  var btn=e&&e.currentTarget?e.currentTarget:null;
  if(btn){
    var r=btn.getBoundingClientRect();
    pop.style.top=(r.bottom+6)+'px';
    pop.style.left=Math.min(r.left,window.innerWidth-340)+'px';
  }
};
document.addEventListener('click',function(){ var p=el('mqFieldInfoPop'); if(p) p.classList.remove('open'); });
function mqSyncBridgeControlsUi(){
  var isFixed=mqProductFamily==='fixed';
  var pfLbl=isFixed?(mqIsForwardBridge()?'Fixed':'Fixed Net MRC'):'Mobile Net Add Lines';
  var stateBar=el('mqBridgeStateBar');
  if(stateBar){
    stateBar.innerHTML='<span class="mq-state-chip">'+pfLbl+'</span><span class="mq-state-sep">›</span>'+
      '<span class="mq-state-chip">'+mqPeriodShortName()+'</span><span class="mq-state-sep">›</span>'+
      '<span class="mq-state-chip">'+mqCaseDisplayName()+'</span>';
  }
  var title=isFixed
    ?('Fixed '+(mqIsForwardBridge()?mqPeriodLongName():('Net MRC — '+mqPeriodLongName())))
    :('Mobile Net Add Lines — '+mqPeriodLongName());
  var st=el('mqSectionTitle'); if(st) st.textContent=title;
  var ct=el('mqChartTitle'); if(ct) ct.textContent=title;
  var desc=el('mqSectionDesc');
  if(desc) desc.innerHTML='GLK report loads from <strong>SharePoint › SiteAssets</strong>. Use the <strong>i</strong> icons on each control for help.';
  mqUpdateHeadDirectorUi();
  el('mqPfMobile')?.classList.toggle('active',!isFixed);
  el('mqPfFixed')?.classList.toggle('active',isFixed);
  var groupLbl=el('mqPeriodGroupLabel');
  if(groupLbl) groupLbl.textContent=isFixed?'Net MRC':'Net Add Lines';
  var aggBlock=el('mqAggRevGroup');
  if(aggBlock) aggBlock.style.display=isFixed?'flex':'none';
  el('mqPeriodQtd')?.classList.toggle('active',mqPeriod==='qtd');
  el('mqPeriodYtd')?.classList.toggle('active',mqPeriod==='ytd');
  el('mqPeriodQtg')?.classList.toggle('active',mqPeriod==='qtg');
  el('mqPeriodYtg')?.classList.toggle('active',mqPeriod==='ytg');
  var fqWrap=el('mqFutureQuarterWrap');
  if(fqWrap) fqWrap.style.display=(mqPeriod==='qtd'&&!mqIsForwardBridge())?'flex':'none';
  var fqCb=el('mqFutureQuarterToggle');
  if(fqCb) fqCb.checked=mqFutureQuarter;
  mqSyncYtdManualPanel();
  el('mqCaseWorst')?.classList.toggle('active',mqCase==='worst');
  el('mqCaseBest')?.classList.toggle('active',mqCase==='best');
  var rlBlock=el('mqReportLevelBlock');
  if(rlBlock) rlBlock.style.display='';
}
function mqUpdatePeriodTabsUi(){ mqSyncBridgeControlsUi(); }
function mqUpdateProductFamilyUi(){ mqSyncBridgeControlsUi(); }
function mqIsForwardBridge(){
  return mqProductFamily==='fixed'&&(mqPeriod==='qtg'||mqPeriod==='ytg');
}
function mqGetActiveReport(){
  return GLK_QTD_REPORT[mqProductFamily]||null;
}
function mqSyncActiveReport(){
  GLK_MOBILE_REPORT=mqGetActiveReport();
}
function mqBidMetric(b){
  if(mqProductFamily==='fixed') return num(b.mrc);
  return num(b.gaLines);
}
function mqMetricUnit(){
  return mqProductFamily==='fixed'?'MRC':'GA Lines';
}
function mqMetricShort(){
  return mqProductFamily==='fixed'?'MRC':'Lines';
}
function mqTopPoolLabel(n,type){
  n=Math.max(0,Math.floor(num(n)||0));
  if(!n) return '';
  if(type==='churn'){
    if(n===1) return 'Top Churn';
    return 'Top '+n+' Churn';
  }
  if(n===1) return 'Top Opportunity';
  return 'Top '+n+' Opportunities';
}
function mqInflightTop5Label(n){
  return mqTopPoolLabel(n!=null?n:5,'gross');
}
function mqChurnTopLabel(n){
  return mqTopPoolLabel(n!=null?n:5,'churn');
}
function mqInflightOthersLabel(){
  return mqProductFamily==='fixed'?'Others MRC':'Others Opportunities';
}
function mqBidMatchesPf(b){
  var pf=String(b.productFamily||'').trim().toLowerCase();
  if(mqProductFamily==='fixed') return pf==='fixed'||pf.indexOf('fixed')>=0;
  return pf==='mobile'||pf.indexOf('mobile')>=0;
}
function mqGetReportLevelsChecked(){
  var drop=el('mqmsd_reportLevel');
  if(!drop) return mqReportLevels.slice();
  return Array.from(drop.querySelectorAll('input:checked')).map(function(c){return c.value;});
}
function mqSetReportLevelsChecked(names){
  var drop=el('mqmsd_reportLevel');
  if(!drop) return;
  var set={};
  (names||[]).forEach(function(n){ set[n]=true; });
  drop.querySelectorAll('input[type=checkbox]').forEach(function(inp){
    inp.checked=!!set[inp.value];
  });
  mqUpdateReportLevelText();
}
function mqResolveReportVerticalNames(patterns){
  var report=mqGetActiveReport();
  var verts=(report&&report.verticals)||[];
  var out=[];
  (patterns||[]).forEach(function(pat){
    verts.forEach(function(v){
      if(v.name&&mqMatchVerticalName(v.name,pat)&&out.indexOf(v.name)<0) out.push(v.name);
    });
  });
  return out;
}
function mqUpdateHeadDirectorUi(){
  ['','khalid','amir','kamil'].forEach(function(k){
    var btn=el(k?('mqHd_'+k):'mqHd_all');
    if(btn) btn.classList.toggle('active',mqHeadDirector===k);
  });
}
function mqSyncHeadDirectorFromLevels(){
  var checked=mqGetReportLevelsChecked();
  var matched='';
  Object.keys(MQ_HEAD_DIRECTORS).forEach(function(hd){
    var expected=mqResolveReportVerticalNames(MQ_HEAD_DIRECTORS[hd].patterns);
    if(expected.length&&checked.length===expected.length&&expected.every(function(n){return checked.indexOf(n)>=0;})){
      matched=hd;
    }
  });
  mqHeadDirector=matched;
  mqUpdateHeadDirectorUi();
}
window.glkSetMqHeadDirector=function(hd){
  mqHeadDirector=hd||'';
  mqUpdateHeadDirectorUi();
  if(mqHeadDirector){
    mqSetReportLevelsChecked(mqResolveReportVerticalNames(MQ_HEAD_DIRECTORS[mqHeadDirector].patterns));
  }else{
    mqSetReportLevelsChecked([]);
  }
  mqUpdateReportLevelText();
  if(mqIsYtdBridge()&&mqProductFamily==='mobile'&&mqGetActiveReportLevels().length){
    alert("Net Add Lines targets are on Overall level only — not per vertical.\n\nActuals will filter by your selection; the target bar stays GLK Overall.");
  }
  mqSyncYtdManualPanel();
  GLK_MQ_DETAIL_IDX=-1;
  renderMobileQtdBridge();
};
function mqUpdateReportLevelText(){
  var checked=mqGetReportLevelsChecked();
  var te=el('mqmstext_reportLevel'); if(!te) return;
  if(!checked.length){ te.textContent='GLK Overall (all verticals)'; return; }
  if(checked.length===1) te.textContent=checked[0];
  else te.textContent=checked.length+' verticals';
  mqReportLevels=checked.slice();
}
window.mqToggleReportLevel=function(){
  var drop=el('mqmsd_reportLevel'),trig=el('mqmst_reportLevel');
  if(!drop||!trig) return;
  var isOpen=drop.classList.contains('open');
  document.querySelectorAll('#mobile-qtd-view .ms-dropdown.open').forEach(function(d){
    d.classList.remove('open');
    var t=el('mqmst_reportLevel'); if(t) t.classList.remove('open');
  });
  if(!isOpen){
    var rect=trig.getBoundingClientRect();
    drop.style.top=(rect.bottom+4)+'px';
    drop.style.left=rect.left+'px';
    drop.style.width=Math.max(rect.width,200)+'px';
    drop.classList.add('open');
    trig.classList.add('open');
  }
};
window.mqOnReportLevelChange=function(){
  mqUpdateReportLevelText();
  mqSyncHeadDirectorFromLevels();
  if(mqIsYtdBridge()&&mqProductFamily==='mobile'&&mqGetActiveReportLevels().length){
    alert("Net Add Lines targets are on Overall level only — not per vertical.\n\nActuals will filter by your selection; the target bar stays GLK Overall.");
  }
  mqSyncYtdManualPanel();
  GLK_MQ_DETAIL_IDX=-1;
  renderMobileQtdBridge();
};
function mqBuildReportLevelFilter(){
  var drop=el('mqmsd_reportLevel'); if(!drop) return;
  var prev=mqGetReportLevelsChecked();
  drop.innerHTML='';
  (mqGetActiveReport()?.verticals||[]).forEach(function(v){
    if(!v.name) return;
    var opt=document.createElement('div'); opt.className='ms-option';
    var cid='mqrl_'+v.name.replace(/[^a-zA-Z0-9]/g,'_');
    var checked=prev.indexOf(v.name)>=0;
    opt.innerHTML='<input type="checkbox" id="'+cid+'" value="'+v.name+'"'+(checked?' checked':'')+' onchange="mqOnReportLevelChange()"><label for="'+cid+'">'+v.name+'</label>';
    drop.appendChild(opt);
  });
  mqUpdateReportLevelText();
}
function mqGetActiveReportLevels(){
  return mqGetReportLevelsChecked();
}
function mqResolveReportScope(report,levelNames){
  if(!report) return {actualsQtd:0,actualsYtd:0,target:0,targetYtd:0,label:'GLK Overall',scopes:[],missing:[],ytdMissing:[]};
  var useYtd=mqIsYtdBridge();
  var mobileYtdOverall=useYtd&&mqProductFamily==='mobile';
  function pickActuals(entry){
    if(!entry) return 0;
    return useYtd?num(entry.actualYtd!=null?entry.actualYtd:entry.actualQtd):num(entry.actualQtd);
  }
  function pickTarget(entry,scopeName){
    if(!useYtd) return num(entry?entry.target:0);
    if(mobileYtdOverall) return mqGetYtdScopeTarget(report,'GLK Overall').value;
    if(mqProductFamily==='fixed') return mqGetFixedYtdTarget(report,scopeName||(entry&&entry.name)||'GLK Overall');
    return mqGetYtdScopeTarget(report,scopeName||(entry&&entry.name)||'GLK Overall').value;
  }
  function pickTargetYtd(scopeName){
    if(mqProductFamily==='fixed') return mqGetFixedYtdTarget(report,scopeName||'GLK Overall');
    return mqGetYtdScopeTarget(report,'GLK Overall').value;
  }
  if(!levelNames||!levelNames.length){
    var ov=report.overall||null;
    var tgt=useYtd&&mqProductFamily==='fixed'?pickTargetYtd('GLK Overall'):pickTarget(ov,'GLK Overall');
    var ytdMiss=useYtd&&mobileYtdOverall?mqGetYtdScopeTarget(report,'GLK Overall').missing.map(function(m){return m.label;}):[];
    return {
      actualsQtd:pickActuals(ov),actualsYtd:ov?num(ov.actualYtd):0,
      target:tgt,targetYtd:tgt,
      label:'GLK Overall',scopes:ov?[ov]:[],missing:[],ytdMissing:ytdMiss
    };
  }
  var scopes=[],missing=[],actuals=0,target=0,ytdMissing=[];
  levelNames.forEach(function(name){
    var sc=mqFindReportScope(report,name);
    if(sc){ scopes.push(sc); actuals+=pickActuals(sc); }
    else missing.push(name);
  });
  if(mobileYtdOverall){
    target=mqGetYtdScopeTarget(report,'GLK Overall').value;
    ytdMissing=mqGetYtdScopeTarget(report,'GLK Overall').missing.map(function(m){return m.label;});
  }else{
    levelNames.forEach(function(name){
      var sc=mqFindReportScope(report,name);
      if(sc) target+=useYtd&&mqProductFamily==='fixed'?pickTargetYtd(name):pickTarget(sc,name);
    });
  }
  return {
    actualsQtd:actuals,actualsYtd:actuals,target:target,targetYtd:target,
    label:levelNames.length===1?levelNames[0]:levelNames.length+' verticals',
    scopes:scopes,missing:missing,ytdMissing:ytdMissing
  };
}
function mqBidMatchesReportLevels(bid,levelNames){
  if(!levelNames||!levelNames.length) return true;
  return levelNames.some(function(v){return mqMatchVerticalName(bid.vertical,v);});
}
function mqIsMobileBid(b){ return mqBidMatchesPf(b); }
function glkParseFixedNetMrcRows(rows,opts){
  opts=opts||{};
  var cands=glkFindFixedNetMrcCandidates(rows);
  var withHdr=cands.filter(function(c){return glkSecHasQtdMonthHeaders(rows,c);});
  var tryList=withHdr.length?withHdr:cands;
  for(var ci=0;ci<tryList.length;ci++){
    var parsed=glkParseFixedNetMrcBlock(rows,tryList[ci],opts);
    if(parsed) return parsed;
  }
  return null;
}
function glkParseFixedNetMrcBlock(rows,sec,opts){
  opts=opts||{};
  var startCol=sec.col, blockEnd=glkFindMobileBlockEnd(rows,sec);
  var headerRow=-1,monthCols=[],targetCol=-1,quarterLabel='',year=null,quarter=null;
  for(var hr=sec.row;hr<Math.min(sec.row+8,rows.length);hr++){
    var row=rows[hr]||[];
    var foundMonths=[],foundTarget=null,foundTargetCol=-1;
    for(var c=startCol;c<=blockEnd;c++){
      var cell=row[c];
      var mo=glkParseMonthHeader(cell);
      if(mo) foundMonths.push({col:c,label:mo.label,month:mo.month,year:mo.year});
      var tg=glkParseTargetHeader(String(cell||'').trim());
      if(tg&&!tg.targetOnly&&!foundTarget){ foundTarget=tg; foundTargetCol=c; }
      else if(/target/i.test(cell)&&foundTargetCol<0) foundTargetCol=c;
    }
    if(foundMonths.length>=1){
      headerRow=hr; monthCols=foundMonths;
      if(foundTarget){ targetCol=foundTargetCol; quarterLabel=foundTarget.label; quarter=foundTarget.quarter; year=foundTarget.year; }
      else if(foundTargetCol>=0) targetCol=foundTargetCol;
      break;
    }
  }
  if(headerRow<0||!monthCols.length) return null;
  if(targetCol<0){
    for(var tc=startCol;tc<=blockEnd;tc++){
      var h=String((rows[headerRow]||[])[tc]||'');
      if(/Q\d/i.test(h)){
        targetCol=tc; quarterLabel=h;
        var tgH=glkParseTargetHeader(h);
        if(tgH&&!tgH.targetOnly){ quarter=tgH.quarter; year=tgH.year; }
        break;
      }
    }
  }
  if(!quarterLabel&&monthCols.length){
    var qm=monthCols[0].month;
    quarter=Math.floor(qm/3)+1;
    year=monthCols[0].year;
    quarterLabel='Q'+quarter+"'"+String(year).slice(-2);
  }
  if(!year&&monthCols.length) year=monthCols[0].year;
  if(!year) year=new Date().getFullYear();
  if(!quarter&&monthCols.length) quarter=Math.floor(monthCols[0].month/3)+1;
  if(!quarter) quarter=Math.floor(new Date().getMonth()/3)+1;
  var qMonths=monthCols.filter(function(m){
    return Math.floor(m.month/3)+1===quarter&&m.year===year;
  });
  if(opts.allMonths) qMonths=monthCols.filter(function(m){return m.year===year;});
  else if(!qMonths.length) qMonths=monthCols;
  var dataStart=headerRow+1;
  if(rows[dataStart]){
    var hdrTxt=glkQtdBlockJoined(rows[dataStart],startCol,blockEnd);
    if(hdrTxt.indexOf('actual')>=0||hdrTxt.indexOf('achiev')>=0) dataStart++;
  }
  var entries=[],overall=null;
  for(var dr=dataStart;dr<rows.length;dr++){
    var drow=rows[dr]||[];
    if(/^note$/i.test(String(drow[0]||'').trim())) break;
    var blockSlice=drow.slice(startCol,blockEnd+1);
    var blockJoined=glkQtdBlockJoined(drow,startCol,blockEnd);
    if(!blockJoined&&!(blockSlice.some(function(x){return glkParseReportNum(x)!=null;}))) continue;
    if(glkQtdShouldBreakDataRow(drow,startCol,blockEnd,dr,dataStart)) break;
    var name=glkRowVertName(drow,startCol,monthCols);
    if(/^note$/i.test(name)) break;
    var actualSum=0,hasNum=false,monthValues={};
    qMonths.forEach(function(m){
      var v=glkParseReportNum(drow[m.col]);
      if(v!=null){ actualSum+=v; hasNum=true; }
    });
    monthCols.forEach(function(m){
      if(m.year!==year) return;
      var v=glkParseReportNum(drow[m.col]);
      if(v!=null) monthValues[m.month]=v;
    });
    var target=targetCol>=0?glkParseReportNum(drow[targetCol]):null;
    if(!hasNum&&!target&&!name) continue;
    if(/actual|target|achiev|Q\d/i.test(name)&&!hasNum) continue;
    var entry={name:name||'Overall',monthValues:monthValues,actualQtd:hasNum?actualSum:0,actualYtd:0,target:target||0,targetYtd:0,isOverall:false};
    if(!overall&&(/total|overall|^fixed$/i.test(name)||(!entries.length&&hasNum))){
      entry.isOverall=true; entry.name='GLK Overall'; overall=entry;
    }else entries.push(entry);
  }
  if(!overall&&entries.length){ overall=entries.shift(); overall.isOverall=true; overall.name='GLK Overall'; }
  if(!overall) return null;
  return {
    blockType:'fixed',metric:'mrc',title:sec.title,
    quarter:quarter,year:year,quarterLabel:quarterLabel||('Q'+quarter+"'"+String(year).slice(-2)),
    months:qMonths.map(function(m){return m.label;}),
    monthCols:monthCols.filter(function(m){return m.year===year;}),
    overall:overall,verticals:entries
  };
}
function glkQtdBlockJoined(drow,startCol,blockEnd){
  var parts=[];
  for(var c=startCol;c<=blockEnd;c++) parts.push(drow[c]);
  return glkNormCellTxt(parts.join(' '));
}
function glkQtdShouldBreakDataRow(drow,startCol,blockEnd,dr,dataStart){
  if(dr<=dataStart) return false;
  var titleAtStart=glkNormCellTxt(String(drow[startCol]||''));
  if(!titleAtStart) return false;
  return /fixed\s*net\s*mrc|fixed\s*(gross|net)\s*adds|mobile\s*(gross|net)\s*adds|broadcast|datamena|revenue trend|mrc trend/i.test(titleAtStart);
}
function glkIsVertNameCell(s){
  if(!s) return false;
  var t=String(s).trim();
  if(!t||t==='—') return false;
  if(/actual|target|achiev|mobile|net adds|fixed|gross|revenue|mrc trend|^note$/i.test(t)) return false;
  if(/^\d+([.,]\d+)?%?$/.test(t.replace(/,/g,''))) return false;
  if(glkParseReportNum(t)!=null&&!/[a-zA-Z]/.test(t)) return false;
  return true;
}
function mqNormVertKey(s){
  return String(s||'').trim().toLowerCase().replace(/[\s\-–—_]+/g,'');
}
function glkRowVertName(drow,startCol,monthCols){
  var col0=String((drow[0]||'')).trim();
  if(glkIsVertNameCell(col0)) return col0;
  var tryCols=[];
  if(monthCols.length) tryCols.push(monthCols[0].col-1);
  tryCols.push(startCol,startCol-1,startCol+1);
  for(var i=0;i<tryCols.length;i++){
    var c=tryCols[i];
    if(c==null||c<0) continue;
    var n=String(drow[c]||'').trim();
    if(glkIsVertNameCell(n)) return n;
  }
  for(var c=0;c<Math.min(drow.length,startCol+5);c++){
    var cand=String(drow[c]||'').trim();
    if(glkIsVertNameCell(cand)) return cand;
  }
  return '';
}
function glkParseReportNum(v){
  if(v==null||v==='') return null;
  if(typeof v==='number') return isNaN(v)?null:v;
  var s=String(v).trim().replace(/\u00a0/g,' ');
  if(!s||s==='—'||s==='-') return null;
  var neg=/^\(.*\)$/.test(s);
  s=s.replace(/[(),\s,]/g,'');
  var n=parseFloat(s);
  if(isNaN(n)) return null;
  return neg?-n:n;
}
function glkNormCellTxt(v){
  return String(v==null?'':v).toLowerCase().replace(/[\s\-–—_]+/g,' ').trim();
}
function glkSheetToRows(sheet){
  if(!sheet||!sheet['!ref']) return [];
  var range=XLSX.utils.decode_range(sheet['!ref']);
  var rows=[];
  for(var R=range.s.r;R<=range.e.r;R++){
    var row=[];
    for(var C=range.s.c;C<=range.e.c;C++){
      var addr=XLSX.utils.encode_cell({r:R,c:C});
      var cell=sheet[addr];
      if(!cell){ row.push(''); continue; }
      if(cell.w!=null&&String(cell.w).trim()!=='') row.push(String(cell.w).trim());
      else if(cell.t==='n'&&cell.v!=null){
        if(typeof XLSX!=='undefined'&&XLSX.SSF&&cell.z&&/[dmy]/i.test(String(cell.z)))
          row.push(XLSX.SSF.format(cell.z,cell.v));
        else row.push(cell.v);
      }else row.push(cell.v!=null?String(cell.v):'');
    }
    while(row.length&&row[row.length-1]==='') row.pop();
    rows.push(row);
  }
  return rows;
}
function glkFindMobileBlockEnd(rows,sec){
  var sub=rows[sec.row+1]||[];
  var end=sec.col;
  for(var c=sec.col;c<sec.col+12;c++){
    var t=glkNormCellTxt(sub[c]);
    if(c>sec.col&&t==='actual') break;
    if(sub[c]!=null&&String(sub[c]).trim()!=='') end=c;
  }
  return Math.max(end,sec.col+4);
}
function glkFindMobileNetAddsSection(rows){
  var best=null,bestScore=0;
  for(var r=0;r<rows.length;r++){
    var row=rows[r]||[];
    for(var c=0;c<row.length;c++){
      var raw=String(row[c]||'').trim();
      if(!raw) continue;
      var t=glkNormCellTxt(raw);
      var score=0;
      if(/mobile/.test(t)&&/net adds/.test(t)) score+=15;
      else if(/net adds/.test(t)) score+=8;
      if(/lines/.test(t)) score+=25;
      if(/points/.test(t)) score-=20;
      if(/mrc|revenue|fixed gross|fixed net/.test(t)) score-=25;
      if(score>bestScore){ bestScore=score; best={row:r,col:c,title:raw}; }
    }
  }
  if(best&&bestScore>=20) return best;
  return null;
}
function glkParseMonthHeader(cell,defaultYear){
  var s=String(cell||'').trim();
  if(!s) return null;
  var m=s.match(/^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\s'\.\-/]*(\d{2,4})?$/i);
  if(m){
    var mo=MONTH_NAMES.findIndex(function(x){return x.toLowerCase()===m[1].slice(0,3).toLowerCase();});
    if(mo<0) return null;
    var yr=m[2]?parseInt(m[2],10):(defaultYear||new Date().getFullYear());
    if(yr<100) yr+=2000;
    return {month:mo,year:yr,label:s};
  }
  m=s.match(/^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[\s'\.\-/]*(\d{2,4})$/i);
  if(!m){
    var n=typeof cell==='number'?cell:parseFloat(s.replace(/,/g,''));
    if(!isNaN(n)&&n>40000&&n<60000){
      var epoch=Date.UTC(1899,11,30);
      var d=new Date(epoch+n*86400000);
      if(!isNaN(d.getTime())){
        var mo2=d.getUTCMonth(), yr2=d.getUTCFullYear();
        var label=MONTH_NAMES[mo2]+'-'+String(yr2).slice(-2);
        return {month:mo2,year:yr2,label:label};
      }
    }
    return null;
  }
  var mo3=MONTH_NAMES.findIndex(function(x){return x.toLowerCase()===m[1].toLowerCase();});
  if(mo3<0) return null;
  var yr3=parseInt(m[2],10); if(yr3<100) yr3+=2000;
  return {month:mo3,year:yr3,label:s};
}
function glkParseTargetPeriodHeader(cell){
  var s=String(cell||'').trim();
  if(!s) return null;
  var bare=s.match(/^Q([1-4])$/i);
  if(bare) return {kind:'quarter',quarter:parseInt(bare[1],10),year:null,label:s};
  var tq=glkParseTargetHeader(s);
  if(tq&&!tq.targetOnly) return {kind:'quarter',quarter:tq.quarter,year:tq.year,label:s};
  if(/^apr/i.test(s)) return {kind:'apr',month:3,label:s};
  if(/may\s*[&+]\s*june/i.test(s)) return {kind:'mayjune',label:s};
  if(/^total$/i.test(s)) return {kind:'total',label:s};
  return null;
}
function glkScoreTargetBlock(tb,type){
  if(!tb) return 0;
  var score=0;
  var pc=tb.periodCols||[];
  score+=pc.length*20;
  if(pc.some(function(p){return p.ph.kind==='total';})) score+=2000;
  if(pc.some(function(p){return p.ph.kind==='apr'||p.ph.kind==='mayjune';})) score+=800;
  var t=tb.overall&&tb.overall.targets;
  if(t){
    if(t.ytdTotal!=null&&num(t.ytdTotal)>1000000) score+=3000;
    else if(t.ytdTotal!=null&&num(t.ytdTotal)>0) score+=400;
    if(t.q1!=null&&t.q2!=null&&t.q3!=null) score+=200;
    if(t.apr!=null&&t.mayJune!=null&&t.q3!=null) score+=200;
  }
  if(tb.byVert) score+=Object.keys(tb.byVert).length*5;
  if(pc.length<=1) score-=5000;
  if(type==='fixed'&&t&&t.ytdTotal!=null&&num(t.ytdTotal)<500000) score-=10000;
  if(type==='mobile'&&t&&t.ytdTotal!=null&&num(t.ytdTotal)>500000) score-=10000;
  return score;
}
function glkFindBestTargetBlock(sheetBlocks,type){
  var key=type==='mobile'?'mobileTarget':'fixedTarget';
  if(!sheetBlocks||!sheetBlocks.length) return null;
  var best=null,bestScore=-999999;
  for(var i=0;i<sheetBlocks.length;i++){
    var tb=sheetBlocks[i][key];
    if(!tb) continue;
    var score=glkScoreTargetBlock(tb,type);
    if(sheetBlocks[i].isYtdRef) score+=500;
    if(score>bestScore){ bestScore=score; best=tb; }
  }
  return best;
}
function glkAttachTargetBlocks(mobile,fixed,sheetBlocks){
  var bestM=glkFindBestTargetBlock(sheetBlocks,'mobile');
  var bestF=glkFindBestTargetBlock(sheetBlocks,'fixed');
  if(mobile&&bestM) mobile.targetBlock=bestM;
  if(fixed&&bestF) fixed.targetBlock=bestF;
  return {mobile:mobile,fixed:fixed};
}
function glkSheetIsYtdReference(blocks){
  var mc=Math.max((blocks.mobileAll&&blocks.mobileAll.monthCols)?blocks.mobileAll.monthCols.length:0,(blocks.fixedAll&&blocks.fixedAll.monthCols)?blocks.fixedAll.monthCols.length:0);
  if(mc>=7) return true;
  if((blocks.fixedTarget||blocks.mobileTarget)&&mc>=7) return true;
  return false;
}
function glkSheetMonthCount(blocks){
  return Math.max((blocks.mobileAll&&blocks.mobileAll.monthCols)?blocks.mobileAll.monthCols.length:0,(blocks.fixedAll&&blocks.fixedAll.monthCols)?blocks.fixedAll.monthCols.length:0);
}
function glkPickRefAndLiveSheets(sheetBlocks){
  var withData=sheetBlocks.filter(function(s){return s.mobileQtd||s.fixedQtd||s.mobileAll||s.fixedAll;});
  if(!withData.length) return {ref:null,live:null};
  if(withData.length===1) return {ref:null,live:withData[0]};
  var glkLive=withData.find(function(s){return /^glk$/i.test(String(s.sheetName||'').trim());});
  if(glkLive){
    var refs=withData.filter(function(s){return s!==glkLive&&glkSheetIsYtdReference(s);});
    refs.sort(function(a,b){return glkSheetMonthCount(b)-glkSheetMonthCount(a);});
    return {ref:refs.length?refs[0]:null,live:glkLive};
  }
  withData.sort(function(a,b){return glkSheetMonthCount(b)-glkSheetMonthCount(a);});
  return {ref:withData[0],live:withData[withData.length-1]};
}
function glkLatestMonthFromLiveSheet(live){
  if(!live) return null;
  return glkLatestMonthFromBlocks(live.mobileQtd,live.fixedQtd,live.mobileAll,live.fixedAll);
}
function glkLatestMonthFromBlocks(){
  var best=null;
  for(var i=0;i<arguments.length;i++){
    var block=arguments[i];
    if(!block||!block.monthCols) continue;
    block.monthCols.forEach(function(m){
      var k=m.year*12+m.month;
      if(!best||k>best.k) best={month:m.month,year:m.year,label:m.label,k:k};
    });
  }
  return best;
}
function glkMonthKey(m){ return m&&m.year!=null&&m.month!=null?(m.year*12+m.month):null; }
function glkCapCurrentMonth(candidate,cap){
  if(!candidate) return cap||candidate;
  if(!cap) return candidate;
  var ck=glkMonthKey(cap), kk=glkMonthKey(candidate);
  if(ck==null||kk==null) return candidate;
  if(kk>ck) return {month:cap.month,year:cap.year,label:cap.label||MONTH_NAMES[cap.month]};
  return candidate;
}
/** Live month from GLK row 1 "Report as of" — not the last month column (Q4 templates list Oct–Dec). */
function glkParseReportAsOf(rows){
  if(!rows||!rows.length) return null;
  for(var r=0;r<Math.min(6,rows.length);r++){
    var row=rows[r]||[];
    for(var c=0;c<Math.min(row.length,12);c++){
      if(!/report\s*as\s*of/i.test(String(row[c]||''))) continue;
      for(var c2=c+1;c2<Math.min(c+5,row.length);c2++){
        var cell=row[c2];
        if(cell==null||cell==='') continue;
        var mo=glkParseMonthHeader(cell);
        if(mo) return {month:mo.month,year:mo.year,label:mo.label||MONTH_NAMES[mo.month]};
        if(cell instanceof Date&&!isNaN(cell.getTime())){
          return {month:cell.getMonth(),year:cell.getFullYear(),label:MONTH_NAMES[cell.getMonth()]};
        }
        var d=new Date(cell);
        if(!isNaN(d.getTime())){
          return {month:d.getMonth(),year:d.getFullYear(),label:MONTH_NAMES[d.getMonth()]};
        }
      }
    }
  }
  return null;
}
function glkResolveCurrentMonth(wb,live,ref){
  var fromHeaders=glkLatestMonthFromLiveSheet(live);
  if(!fromHeaders&&!live&&ref) fromHeaders=glkLatestMonthFromBlocks(ref.mobileAll,ref.fixedAll,ref.mobileQtd,ref.fixedQtd);
  var reportAsOf=null;
  if(wb&&live&&live.sheetName&&wb.Sheets[live.sheetName]){
    reportAsOf=glkParseReportAsOf(glkSheetToRows(wb.Sheets[live.sheetName]));
  }
  var current=reportAsOf||fromHeaders;
  if(reportAsOf&&fromHeaders) current=glkCapCurrentMonth(fromHeaders,reportAsOf);
  if(!current){
    var now=new Date();
    current={month:now.getMonth(),year:now.getFullYear(),label:MONTH_NAMES[now.getMonth()]};
  }
  return {currentMonth:current,reportAsOf:reportAsOf};
}
function glkIndexReportEntries(block){
  var map={};
  if(!block) return map;
  if(block.overall) map[mqNormVertKey(block.overall.name||'overall')]=block.overall;
  (block.verticals||[]).forEach(function(v){
    if(v&&v.name) map[mqNormVertKey(v.name)]=v;
  });
  return map;
}
function glkTargetHeaderRowMatch(joined){
  if(/Q1['']?\s*\d{2,4}/i.test(joined)&&(/Q2|Q3|Total|Apr|May/i.test(joined))) return true;
  if(/Apr/i.test(joined)&&/May/i.test(joined)&&/Q3/i.test(joined)) return true;
  if(/Q2['']?\s*\d{2,4}/i.test(joined)&&/Total/i.test(joined)) return true;
  return false;
}
function glkTitleReMatch(titleRe,raw){
  var n=glkNormCellTxt(raw);
  if(typeof titleRe==='function') return titleRe(raw,n);
  return titleRe.test(n);
}
function glkFindTargetBlockRows(rows,findSecFn,titleRe){
  var out=[];
  for(var r=0;r<rows.length;r++){
    var row=rows[r]||[];
    for(var c=0;c<row.length;c++){
      var raw=String(row[c]||'').trim();
      if(!raw||!glkTitleReMatch(titleRe,raw)) continue;
      for(var hr=r+1;hr<Math.min(r+8,rows.length);hr++){
        var sub=rows[hr]||[];
        var joined=glkQtdBlockJoined(sub,c,c+12);
        if(glkTargetHeaderRowMatch(joined)){
          out.push({row:r,col:c,title:raw,headerRow:hr});
          break;
        }
      }
    }
  }
  return out;
}
function glkRowHasTargetLabel(rows,r,c){
  var row=rows[r]||[];
  for(var tc=c;tc<Math.min(c+8,row.length);tc++){
    if(/^target$/i.test(String(row[tc]||'').trim())) return true;
  }
  for(var tr=r;tr<Math.min(r+3,rows.length);tr++){
    var rr=rows[tr]||[];
    for(var tc2=0;tc2<rr.length;tc2++){
      if(/^target$/i.test(String(rr[tc2]||'').trim())) return true;
    }
  }
  return false;
}
function glkParseFixedTargetBlock(rows){
  var best=null,bestScore=-999999;
  for(var r=0;r<rows.length;r++){
    var row=rows[r]||[];
    for(var c=0;c<row.length;c++){
      var raw=String(row[c]||'').trim();
      if(!raw||!/fixed\s*net\s*mrc/i.test(glkNormCellTxt(raw))) continue;
      if(!glkRowHasTargetLabel(rows,r,c)) continue;
      var headerRow=-1,periodCols=[],nameCol=c;
      for(var hr=r;hr<Math.min(r+6,rows.length);hr++){
        var hrow=rows[hr]||[], cols=[];
        for(var pc=0;pc<hrow.length;pc++){
          var ph=glkParseTargetPeriodHeader(String(hrow[pc]||'').trim());
          if(ph) cols.push({col:pc,ph:ph});
        }
        if(cols.length>=3&&cols.some(function(x){return x.ph.kind==='total';})){
          headerRow=hr;
          periodCols=cols;
          nameCol=Math.min(nameCol,cols[0].col);
          break;
        }
      }
      if(headerRow<0||!periodCols.length) continue;
      var blockEnd=Math.max.apply(null,periodCols.map(function(p){return p.col;}))+2;
      var entries={},overall=null;
      for(var dr=headerRow+1;dr<rows.length;dr++){
        var drow=rows[dr]||[];
        var joined=glkQtdBlockJoined(drow,nameCol,blockEnd);
        if(!joined&&!drow.some(function(x){return glkParseReportNum(x)!=null;})) break;
        if(glkQtdShouldBreakDataRow(drow,nameCol,blockEnd,dr,headerRow+1)) break;
        var name=glkRowVertName(drow,nameCol,[]);
        if(!name||/actual|target|achiev/i.test(name)) continue;
        var t={q1:null,q2:null,q3:null,q4:null,apr:null,mayJune:null,ytd:null,ytdTotal:null};
        periodCols.forEach(function(pc){
          var v=glkParseReportNum(drow[pc.col]);
          if(v==null) return;
          if(pc.ph.kind==='quarter'){
            if(pc.ph.quarter===1) t.q1=v;
            else if(pc.ph.quarter===2) t.q2=v;
            else if(pc.ph.quarter===3) t.q3=v;
            else if(pc.ph.quarter===4) t.q4=v;
          }else if(pc.ph.kind==='total'){ t.ytd=v; t.ytdTotal=v; }
        });
        if(t.ytdTotal==null) t.ytdTotal=(t.q1!=null?num(t.q1):0)+num(t.q2)+num(t.q3)+num(t.q4);
        if(t.ytd==null) t.ytd=t.ytdTotal;
        var entry={name:name,targets:t,target:t.q3,targetYtd:t.ytdTotal||0};
        if(/overall|total/i.test(name)){ entry.isOverall=true; overall=entry; }
        else entries[mqNormVertKey(name)]=entry;
      }
      if(!overall||overall.targets.ytdTotal==null||num(overall.targets.ytdTotal)<500000) continue;
      var candidate={overall:overall,byVert:entries,periodCols:periodCols};
      var score=num(overall.targets.ytdTotal)+Object.keys(entries).length*100;
      if(score>bestScore){ bestScore=score; best=candidate; }
    }
  }
  return best;
}
function glkParseMobileTargetBlock(rows){
  var blocks=glkFindTargetBlockRows(rows,function(){return null;},function(raw,n){return n==='net add lines';});
  var best=null,bestScore=-999999;
  for(var bi=0;bi<blocks.length;bi++){
    var sec=blocks[bi], startCol=sec.col, blockEnd=startCol+14;
    var headerRow=-1,periodCols=[];
    for(var hr=sec.headerRow;hr<Math.min(sec.headerRow+4,rows.length);hr++){
      var row=rows[hr]||[], cols=[];
      for(var c=startCol;c<=blockEnd;c++){
        var ph=glkParseTargetPeriodHeader(String(row[c]||'').trim());
        if(ph) cols.push({col:c,ph:ph});
      }
      if(cols.length>=2){ headerRow=hr; periodCols=cols; break; }
    }
    if(headerRow<0||!periodCols.length) continue;
    if(!periodCols.some(function(pc){return pc.ph.kind==='quarter'||pc.ph.kind==='apr'||pc.ph.kind==='mayjune';})) continue;
    var entries={},overall=null;
    for(var dr=headerRow+1;dr<rows.length;dr++){
      var drow=rows[dr]||[];
      if(glkQtdShouldBreakDataRow(drow,startCol,blockEnd,dr,headerRow+1)) break;
      var name=glkRowVertName(drow,startCol,[]);
      if(!name||/actual|target|achiev/i.test(name)) continue;
        var t={q1:null,q2:null,q3:null,q4:null,apr:null,mayJune:null,ytd:null,ytdTotal:null};
        periodCols.forEach(function(pc){
          var v=glkParseReportNum(drow[pc.col]);
          if(v==null) return;
          if(pc.ph.kind==='quarter'){
            if(pc.ph.quarter===1) t.q1=v;
            else if(pc.ph.quarter===2) t.q2=v;
            else if(pc.ph.quarter===3) t.q3=v;
            else if(pc.ph.quarter===4) t.q4=v;
          }else if(pc.ph.kind==='apr') t.apr=v;
          else if(pc.ph.kind==='mayjune') t.mayJune=v;
          else if(pc.ph.kind==='total'){ t.ytd=v; t.ytdTotal=v; }
        });
        if(t.q2==null) t.q2=num(t.apr)+num(t.mayJune);
        if(t.ytdTotal==null) t.ytdTotal=(t.q1!=null?num(t.q1):0)+num(t.apr)+num(t.mayJune)+num(t.q3)+num(t.q4);
      if(t.ytd==null) t.ytd=t.ytdTotal;
      var entry={name:name,targets:t,target:t.q3,targetYtd:t.ytdTotal||t.ytd,q1Missing:t.q1==null};
      if(/overall|total/i.test(name)){ entry.isOverall=true; overall=entry; }
      else entries[mqNormVertKey(name)]=entry;
    }
    if(!overall&&!Object.keys(entries).length) continue;
    var candidate={overall:overall,byVert:entries,periodCols:periodCols,overallOnly:false};
    var score=glkScoreTargetBlock(candidate,'mobile');
    if(score>bestScore){ bestScore=score; best=candidate; }
  }
  return best;
}
function glkCalcFixedYtdTarget(t,currentMonth){
  if(!t) return 0;
  if(t.ytdTotal!=null&&t.ytdTotal!=='') return num(t.ytdTotal);
  if(t.ytd!=null&&t.ytd!=='') return num(t.ytd);
  return 0;
}
function glkCalcMobileYtdTarget(t){
  if(!t) return 0;
  if(t.ytdTotal!=null&&t.ytdTotal!=='') return num(t.ytdTotal);
  if(t.ytd!=null&&t.ytd!=='') return num(t.ytd);
  return (t.q1!=null?num(t.q1):0)+num(t.apr)+num(t.mayJune)+num(t.q3)+num(t.q4);
}
function glkLookupYtdTarget(targetBlock,name,type,currentMonth){
  if(type==='mobile'){
    if(!targetBlock||!targetBlock.overall||!targetBlock.overall.targets) return null;
    var res=glkComputeYtdTargetForType('mobile',{targetBlock:targetBlock},'GLK Overall',currentMonth);
    return {value:res.value,missing:res.missing,q1Missing:res.missing.some(function(m){return m.key==='q1';}),overallOnly:true};
  }
  if(!targetBlock) return null;
  var key=mqNormVertKey(name);
  var entry=(/overall|glk overall|total/i.test(name)?targetBlock.overall:null)||targetBlock.byVert[key]||null;
  if(!entry||!entry.targets) return null;
  return {value:glkCalcFixedYtdTarget(entry.targets,currentMonth),missing:[],overallOnly:false};
}
function glkLookupQtdTarget(targetBlock,name,type,quarter,liveEntry){
  if(liveEntry&&liveEntry.target!=null) return num(liveEntry.target);
  if(!targetBlock) return 0;
  if(type==='mobile'){
    if(!/overall|glk overall|total/i.test(name)) return num(liveEntry?liveEntry.target:0);
    var ov=targetBlock.overall;
    if(!ov||!ov.targets) return 0;
    return num(ov.targets['q'+quarter]||ov.target||0);
  }
  var key=mqNormVertKey(name);
  var entry=(/overall|glk overall|total/i.test(name)?targetBlock.overall:null)||targetBlock.byVert[key]||null;
  if(!entry||!entry.targets) return 0;
  var tt=entry.targets;
  var qk='q'+quarter;
  if(tt[qk]!=null&&tt[qk]!=='') return num(tt[qk]);
  if(quarter===2&&tt.q2!=null) return num(tt.q2);
  return 0;
}
function glkMergeEntryActuals(refE,liveE,currentMonth,year,quarter){
  var monthValues={};
  var curMi=currentMonth.month;
  var qStart=(quarter-1)*3;
  // YTD actuals: Jan → prior month from reference/history sheet ONLY
  if(refE&&refE.monthValues){
    for(var mi=0;mi<curMi;mi++){
      if(refE.monthValues[mi]!=null) monthValues[mi]=refE.monthValues[mi];
    }
  }
  // Current month from live daily sheet ONLY — never from reference sheet
  if(liveE&&liveE.monthValues&&liveE.monthValues[curMi]!=null){
    monthValues[curMi]=liveE.monthValues[curMi];
  }
  var actualQtd=0,actualYtd=0;
  for(var m3=0;m3<=curMi;m3++){
    if(monthValues[m3]==null) continue;
    actualYtd+=monthValues[m3];
    if(m3>=qStart&&m3<=curMi) actualQtd+=monthValues[m3];
  }
  return {monthValues:monthValues,actualQtd:actualQtd,actualYtd:actualYtd,currentMonthFromLive:!!(liveE&&liveE.monthValues&&liveE.monthValues[curMi]!=null)};
}
function glkBuildYtdOverlay(type,refSheet,liveSheet,currentMonth,targetBlockOverride){
  var refBlock=type==='mobile'?(refSheet&&refSheet.mobileAll):((refSheet&&refSheet.fixedAll));
  var liveBlock=type==='mobile'
    ?((liveSheet&&liveSheet.mobileAll)||(liveSheet&&liveSheet.mobileQtd))
    :((liveSheet&&liveSheet.fixedAll)||(liveSheet&&liveSheet.fixedQtd));
  var targetBlock=targetBlockOverride!=null?targetBlockOverride:(type==='mobile'
    ?((refSheet&&refSheet.mobileTarget)||(liveSheet&&liveSheet.mobileTarget))
    :((refSheet&&refSheet.fixedTarget)||(liveSheet&&liveSheet.fixedTarget)));
  if(!refBlock&&!liveBlock&&!targetBlock) return null;
  if(!refBlock&&!liveBlock){
    return {overall:null,byKey:{},targetBlock:targetBlock,currentMonth:currentMonth};
  }
  var year=(liveBlock&&liveBlock.year)||currentMonth.year;
  var quarter=(liveBlock&&liveBlock.quarter)||Math.floor(currentMonth.month/3)+1;
  var refMap=glkIndexReportEntries(refBlock);
  var liveMap=glkIndexReportEntries(liveBlock);
  var keys={};
  Object.keys(refMap).forEach(function(k){keys[k]=1;});
  Object.keys(liveMap).forEach(function(k){keys[k]=1;});
  function buildYtdEntry(key,srcName){
    var refE=refMap[key]||null,liveE=liveMap[key]||null;
    var merged=glkMergeEntryActuals(refE,liveE,currentMonth,year,quarter);
    var ytdTgt=glkLookupYtdTarget(targetBlock,srcName||key,type,currentMonth);
    return {
      name:srcName||(refE&&refE.name)||(liveE&&liveE.name)||key,
      actualYtd:merged.actualYtd,
      targetYtd:ytdTgt?num(ytdTgt.value):0,
      ytdTargetMeta:ytdTgt
    };
  }
  var overallKey=Object.keys(keys).find(function(k){return /overall|glkoverall|total/.test(k);})||Object.keys(keys)[0];
  var overall=buildYtdEntry(overallKey,'GLK Overall');
  overall.name='GLK Overall';
  var byKey={};
  byKey[mqNormVertKey('GLK Overall')]=overall;
  Object.keys(keys).forEach(function(k){
    if(k===overallKey||/overall|glkoverall|total/.test(k)) return;
    byKey[k]=buildYtdEntry(k,null);
  });
  return {overall:overall,byKey:byKey,targetBlock:targetBlock,currentMonth:currentMonth};
}
function glkOverlayYtdOnQtdReport(qtdReport,ytdOverlay){
  if(!qtdReport) return null;
  if(!ytdOverlay){
    if(qtdReport.overall){ qtdReport.overall.actualYtd=num(qtdReport.overall.actualQtd); qtdReport.overall.targetYtd=num(qtdReport.overall.target); }
    (qtdReport.verticals||[]).forEach(function(v){ v.actualYtd=num(v.actualQtd); v.targetYtd=num(v.target); });
    return qtdReport;
  }
  var ov=ytdOverlay.overall;
  if(qtdReport.overall&&ov){
    qtdReport.overall.actualYtd=ov.actualYtd;
    qtdReport.overall.targetYtd=ov.targetYtd;
  }
  (qtdReport.verticals||[]).forEach(function(v){
    var yv=ytdOverlay.byKey[mqNormVertKey(v.name)]||null;
    if(yv){ v.actualYtd=yv.actualYtd; v.targetYtd=yv.targetYtd; }
    else { v.actualYtd=num(v.actualQtd); v.targetYtd=num(v.target); }
  });
  qtdReport.currentMonth=ytdOverlay.currentMonth;
  qtdReport.targetBlock=ytdOverlay.targetBlock;
  return qtdReport;
}
function glkParseQtdWorkbook(wb){
  if(!wb||!wb.SheetNames||!wb.SheetNames.length) return null;
  var sheetBlocks=[];
  for(var si=0;si<wb.SheetNames.length;si++){
    var rows=glkSheetToRows(wb.Sheets[wb.SheetNames[si]]);
    var blocks={
      sheetName:wb.SheetNames[si],
      mobileQtd:glkParseMobileNetAddsRows(rows,{}),
      fixedQtd:glkParseFixedNetMrcRows(rows,{}),
      mobileAll:glkParseMobileNetAddsRows(rows,{allMonths:true}),
      fixedAll:glkParseFixedNetMrcRows(rows,{allMonths:true}),
      mobileTarget:glkParseMobileTargetBlock(rows),
      fixedTarget:glkParseFixedTargetBlock(rows)
    };
    blocks.isYtdRef=glkSheetIsYtdReference(blocks);
    sheetBlocks.push(blocks);
  }
  var picked=glkPickRefAndLiveSheets(sheetBlocks);
  var ref=picked.ref;
  var live=picked.live;
  var monthRes=glkResolveCurrentMonth(wb,live,ref);
  var currentMonth=monthRes.currentMonth;
  var reportAsOf=monthRes.reportAsOf;
  var mobileQtd=(live&&live.mobileQtd)||(ref&&ref.mobileQtd)||null;
  var fixedQtd=(live&&live.fixedQtd)||(ref&&ref.fixedQtd)||null;
  var bestMobileTarget=glkFindBestTargetBlock(sheetBlocks,'mobile');
  var bestFixedTarget=glkFindBestTargetBlock(sheetBlocks,'fixed');
  if(bestFixedTarget){
    var srcSheet=null;
    for(var sbi=0;sbi<sheetBlocks.length;sbi++){
      if(sheetBlocks[sbi].fixedTarget===bestFixedTarget){ srcSheet=sheetBlocks[sbi].sheetName; break; }
    }
    glkSetFixedYtdTargetsFromBlock(bestFixedTarget,srcSheet);
  }else{
    GLK_FIXED_YTD_TARGETS={overall:null,byVert:{},sourceSheet:null,periodCols:[]};
  }
  var mobile=glkOverlayYtdOnQtdReport(mobileQtd,glkBuildYtdOverlay('mobile',ref,live,currentMonth,bestMobileTarget));
  var fixed=glkOverlayYtdOnQtdReport(fixedQtd,glkBuildYtdOverlay('fixed',ref,live,currentMonth,bestFixedTarget));
  if(mobile) mobile.targetBlock=bestMobileTarget||mobile.targetBlock||null;
  if(fixed){
    fixed.targetBlock=bestFixedTarget||fixed.targetBlock||null;
    if(bestFixedTarget&&bestFixedTarget.overall&&bestFixedTarget.overall.targets&&fixed.overall){
      var ytdTot=bestFixedTarget.overall.targets.ytdTotal;
      if(ytdTot!=null) fixed.overall.targetYtd=num(ytdTot);
    }
  }
  if(!mobile&&!fixed) return null;
  var warnings=[];
  if(live&&!currentMonth){
    warnings.push({type:'no_live_month',message:'Live sheet found but current month could not be detected — check month headers on the daily sheet.'});
  }
  if(!live){
    warnings.push({type:'no_live_sheet',message:'No live daily sheet found — YTD actuals need a live sheet for the current month. Prior months use the history sheet.'});
  }else if(ref){
    warnings.push({type:'ytd_sheet_info',message:'YTD actuals: Jan→prior month from "'+(ref.sheetName||'history')+'" · current month ('+(currentMonth?currentMonth.label:'?')+') from live "'+(live.sheetName||'daily')+'"'});
  }else if(live){
    warnings.push({type:'ytd_sheet_info',message:'YTD actuals from live sheet "'+(live.sheetName||'daily')+'" · current month: '+(currentMonth?currentMonth.label:'—')});
  }
  var parsedForRefresh={mobile:mobile,fixed:fixed,ytdMeta:{currentMonth:currentMonth,hasRef:!!ref,hasLive:!!live,warnings:[]}};
  mqLoadYtdManual();
  mqRefreshAllYtdTargetsAfterParse(parsedForRefresh);
  if(!bestFixedTarget){
    warnings.push({type:'fixed_target_missing',product:'fixed',message:'Fixed Net MRC YTD target block not found — check history sheet has Q1/Q2/Q3/Total under Fixed Net MRC › Target.'});
  }else if(bestFixedTarget.overall&&num(bestFixedTarget.overall.targets&&bestFixedTarget.overall.targets.ytdTotal)<500000){
    warnings.push({type:'fixed_target_suspect',product:'fixed',message:'Fixed YTD target parsed as '+fmtLines(num(bestFixedTarget.overall.targets.ytdTotal))+' — expected millions (Total column). Use glk-fixed-target-debug.html to trace.'});
  }
  if(mobile){
    mqYtdMissingSummaryForType('mobile',mobile).forEach(function(line){
      warnings.push({type:'ytd_target_missing',product:'mobile',message:'YTD target incomplete — '+line+'. Enter the missing value in the panel below (saved in this browser).'});
    });
  }
  GLK_YTD_META={currentMonth:currentMonth,reportAsOf:reportAsOf||null,hasRef:!!ref,hasLive:!!live,refSheet:ref?ref.sheetName:null,liveSheet:live?live.sheetName:null,warnings:warnings};
  var mobileProductPrior=glkParseMobileProductWowWorkbook(wb);
  return {mobile:mobile,fixed:fixed,ytdMeta:GLK_YTD_META,mobileProductPrior:mobileProductPrior};
}
function glkSecHasQtdMonthHeaders(rows,sec){
  var blockEnd=glkFindMobileBlockEnd(rows,sec);
  for(var hr=sec.row;hr<Math.min(sec.row+8,rows.length);hr++){
    var found=0;
    for(var c=sec.col;c<=blockEnd;c++){
      if(glkParseMonthHeader((rows[hr]||[])[c])) found++;
    }
    if(found>=2) return true;
  }
  return false;
}
function glkFindFixedNetMrcCandidates(rows){
  var out=[];
  for(var r=0;r<rows.length;r++){
    var row=rows[r]||[];
    for(var c=0;c<row.length;c++){
      var raw=String(row[c]||'').trim();
      if(!raw) continue;
      var t=glkNormCellTxt(raw);
      var score=0;
      if(/fixed/.test(t)&&/net/.test(t)&&/mrc/.test(t)) score+=35;
      else if(/fixed/.test(t)&&/mrc/.test(t)) score+=22;
      if(/mobile/.test(t)) score-=25;
      if(/lines/.test(t)||/points/.test(t)||/adds/.test(t)) score-=18;
      if(/revenue trend|mrc trend|fixed gross/.test(t)) score-=20;
      if(c>40) score-=12;
      if(score>=20) out.push({row:r,col:c,title:raw,score:score});
    }
  }
  out.sort(function(a,b){
    if(b.score!==a.score) return b.score-a.score;
    if(a.col!==b.col) return a.col-b.col;
    return a.row-b.row;
  });
  return out;
}
function glkFindFixedNetMrcSection(rows){
  var cands=glkFindFixedNetMrcCandidates(rows);
  for(var i=0;i<cands.length;i++){
    if(glkSecHasQtdMonthHeaders(rows,cands[i])) return cands[i];
  }
  return cands.length?cands[0]:null;
}
function glkParseTargetHeader(cell){
  var s=String(cell||'').trim();
  if(!s) return null;
  var tq=s.match(/Q(\d)[\s'’`]*(?:[''])?(\d{4}|\d{2})/i);
  if(tq){
    var quarter=parseInt(tq[1],10), year=parseInt(tq[2],10);
    if(year<100) year+=2000;
    return {quarter:quarter,year:year,label:s};
  }
  if(/target/i.test(s)) return {label:s,targetOnly:true};
  return null;
}
function glkParseMobileReportWorkbook(wb){
  return glkParseQtdWorkbook(wb);
}
function glkParseMobileNetAddsRows(rows,opts){
  opts=opts||{};
  var sec=glkFindMobileNetAddsSection(rows);
  if(!sec) return null;
  var startCol=sec.col, blockEnd=glkFindMobileBlockEnd(rows,sec);
  var headerRow=-1,monthCols=[],targetCol=-1,quarterLabel='',year=null,quarter=null;
  for(var hr=sec.row;hr<Math.min(sec.row+8,rows.length);hr++){
    var row=rows[hr]||[];
    var foundMonths=[],foundTarget=null,foundTargetCol=-1;
    for(var c=startCol;c<=blockEnd;c++){
      var cell=row[c];
      var mo=glkParseMonthHeader(cell);
      if(mo) foundMonths.push({col:c,label:mo.label,month:mo.month,year:mo.year});
      var tg=glkParseTargetHeader(String(cell||'').trim());
      if(tg&&!tg.targetOnly&&!foundTarget){ foundTarget=tg; foundTargetCol=c; }
      else if(/target/i.test(cell)&&foundTargetCol<0) foundTargetCol=c;
    }
    if(foundMonths.length>=1){
      headerRow=hr; monthCols=foundMonths;
      if(foundTarget){ targetCol=foundTargetCol; quarterLabel=foundTarget.label; quarter=foundTarget.quarter; year=foundTarget.year; }
      else if(foundTargetCol>=0) targetCol=foundTargetCol;
      break;
    }
  }
  if(headerRow<0||!monthCols.length) return null;
  if(targetCol<0){
    for(var tc=startCol;tc<=blockEnd;tc++){
      var h=String((rows[headerRow]||[])[tc]||'');
      if(/Q\d/i.test(h)){
        targetCol=tc; quarterLabel=h;
        var tgH=glkParseTargetHeader(h);
        if(tgH&&!tgH.targetOnly){ quarter=tgH.quarter; year=tgH.year; }
        break;
      }
    }
    if(targetCol<0){
      for(var hr2=sec.row;hr2<=headerRow+1;hr2++){
        for(var tc2=startCol;tc2<=blockEnd;tc2++){
          var h2=String((rows[hr2]||[])[tc2]||'');
          if(/target|% achiev/i.test(h2)&&targetCol<0) targetCol=tc2;
          var tg2=glkParseTargetHeader(h2);
          if(tg2&&!tg2.targetOnly){ targetCol=tc2; quarterLabel=tg2.label; quarter=tg2.quarter; year=tg2.year; }
        }
      }
    }
  }
  if(!quarterLabel&&monthCols.length){
    var qm=monthCols[0].month;
    quarter=Math.floor(qm/3)+1;
    year=monthCols[0].year;
    quarterLabel='Q'+quarter+"'"+String(year).slice(-2);
  }
  if(!year&&monthCols.length) year=monthCols[0].year;
  if(!year) year=new Date().getFullYear();
  if(!quarter&&monthCols.length) quarter=Math.floor(monthCols[0].month/3)+1;
  if(!quarter) quarter=Math.floor(new Date().getMonth()/3)+1;
  var qMonths=monthCols.filter(function(m){
    var mq=Math.floor(m.month/3)+1;
    return mq===quarter&&m.year===year;
  });
  if(opts.allMonths) qMonths=monthCols.filter(function(m){return m.year===year;});
  else if(!qMonths.length) qMonths=monthCols;
  var dataStart=headerRow+1;
  if(rows[dataStart]){
    var hdrTxt=glkQtdBlockJoined(rows[dataStart],startCol,blockEnd);
    if(hdrTxt.indexOf('actual')>=0||hdrTxt.indexOf('achiev')>=0) dataStart++;
  }
  var nameCol=monthCols.length?Math.max(0,monthCols[0].col-1):Math.max(0,startCol-1);
  var entries=[],overall=null;
  for(var dr=dataStart;dr<rows.length;dr++){
    var drow=rows[dr]||[];
    if(/^note$/i.test(String(drow[0]||'').trim())) break;
    var blockSlice=drow.slice(startCol,blockEnd+1);
    var blockJoined=glkQtdBlockJoined(drow,startCol,blockEnd);
    if(!blockJoined&&!(blockSlice.some(function(x){return glkParseReportNum(x)!=null;}))) continue;
    if(glkQtdShouldBreakDataRow(drow,startCol,blockEnd,dr,dataStart)) break;
    var name=glkRowVertName(drow,startCol,monthCols);
    if(/^note$/i.test(name)) break;
    var actuals={},actualSum=0,hasNum=false,monthValues={};
    qMonths.forEach(function(m){
      var v=glkParseReportNum(drow[m.col]);
      actuals[m.label]=v;
      if(v!=null){ actualSum+=v; hasNum=true; }
    });
    monthCols.forEach(function(m){
      if(m.year!==year) return;
      var v=glkParseReportNum(drow[m.col]);
      if(v!=null) monthValues[m.month]=v;
    });
    var target=targetCol>=0?glkParseReportNum(drow[targetCol]):null;
    if(!hasNum&&!target&&!name) continue;
    if(/actual|target|achiev|Q\d/i.test(name)&&!hasNum) continue;
    var entry={name:name||'Overall',actuals:actuals,monthValues:monthValues,actualQtd:hasNum?actualSum:0,actualYtd:0,target:target||0,targetYtd:0,isOverall:false};
    if(!overall&&(/total|overall|^mobile$/i.test(name)||(!entries.length&&hasNum))){
      entry.isOverall=true; entry.name='GLK Overall'; overall=entry;
    }else entries.push(entry);
  }
  if(!overall&&entries.length){ overall=entries.shift(); overall.isOverall=true; overall.name='GLK Overall'; }
  if(!overall) return null;
  return {
    blockType:'mobile',metric:'gaLines',title:sec.title,
    quarter:quarter,year:year,quarterLabel:quarterLabel||('Q'+quarter+"'"+String(year).slice(-2)),
    months:qMonths.map(function(m){return m.label;}),
    monthCols:monthCols.filter(function(m){return m.year===year;}),
    overall:overall,
    verticals:entries
  };
}
function glkParseAndSetMobileReport(arrayBuffer,cb){
  try{
    var wb=XLSX.read(arrayBuffer,{type:'array',cellDates:true,cellNF:true,cellStyles:true});
    var parsed=glkParseQtdWorkbook(wb);
    if(!parsed||(!parsed.mobile&&!parsed.fixed))
      return cb(new Error('Could not find Mobile Net Adds or Fixed Net MRC sections. Use the daily GLK Excel template (.xlsx/.xlsm).'));
    GLK_QTD_REPORT={mobile:parsed.mobile||null,fixed:parsed.fixed||null};
    GLK_YTD_META=parsed.ytdMeta||GLK_YTD_META;
    GLK_MOBILE_PRODUCT_PRIOR=null;
    mqRefreshAllYtdTargetsAfterParse(parsed);
    mqRefreshYtdTargetsOnReport(GLK_QTD_REPORT.mobile);
    mqRefreshYtdTargetsOnReport(GLK_QTD_REPORT.fixed);
    mqSyncActiveReport();
    if(!GLK_QTD_REPORT.mobile) console.warn('[GLK] Mobile Net Adds – Lines section not found in report.');
    if(!GLK_QTD_REPORT.fixed) console.warn('[GLK] Fixed Net MRC section not found in report.');
    if(!mqGetActiveReport()){
      var alt=mqProductFamily==='fixed'?'mobile':'fixed';
      if(GLK_QTD_REPORT[alt]) mqProductFamily=alt;
      mqSyncActiveReport();
      el('mqPfMobile')?.classList.toggle('active',mqProductFamily==='mobile');
      el('mqPfFixed')?.classList.toggle('active',mqProductFamily==='fixed');
      mqUpdateProductFamilyUi();
    }
    cb(null,parsed);
  }catch(err){ cb(err); }
}
window.glkMobileReportUpload=function(file){
  if(!file) return;
  if(typeof XLSX==='undefined'){ alert('Excel parser not loaded. Refresh the page.'); return; }
  var reader=new FileReader();
  reader.onload=function(e){
    var buf=e.target.result;
    glkParseAndSetMobileReport(buf,function(err){
      if(err){ alert(err.message); return; }
      var nowIso=new Date().toISOString();
      GLK_MOBILE_REPORT_META=Object.assign({},GLK_MOBILE_REPORT_META||{},{uploadedAt:nowIso,storage:'uploading'});
      glkMobileQtdRefreshUI();
      glkShowLoader('Replacing SharePoint workbook…');
      spUploadMobileReport(buf,file.name,function(err2,meta){
        if(err2){
          console.error('[GLK] SP upload error:',err2);
          mqCacheSaveReport(buf,{filename:SP_MOBILE_REPORT_FILE,originalName:file.name,uploadedAt:new Date().toISOString(),storage:'local-cache',spError:err2.message},function(){
            GLK_MOBILE_REPORT_META={filename:SP_MOBILE_REPORT_FILE,originalName:file.name,uploadedAt:new Date().toISOString(),storage:'local-cache',spError:err2.message};
            glkHideLoader();
            glkMobileQtdRefreshUI();
            renderMobileQtdBridge();
            alert('Report loaded on this browser, but SharePoint replace failed:\n'+err2.message+'\n\nCheck Contribute access to SiteAssets on the GKA site.');
          });
          return;
        }
        meta=Object.assign({},meta||{},{storage:'sharepoint',originalName:file.name,uploadedAt:new Date().toISOString(),filename:SP_MOBILE_REPORT_FILE,spUrl:SP_MOBILE_REPORT_WEB_URL});
        mqCacheSaveReport(buf,meta,function(){
          GLK_MOBILE_REPORT_META=meta;
          glkHideLoader();
          glkMobileQtdRefreshUI();
          renderMobileQtdBridge();
        });
      });
    });
  };
  reader.onerror=function(){ alert('Could not read file.'); };
  reader.readAsArrayBuffer(file);
  var inp=el('mobileReportInp'); if(inp) inp.value='';
};
function mqFmtReportUploadDate(iso){
  if(!iso) return '—';
  try{
    var d=new Date(iso);
    if(isNaN(d.getTime())) return '—';
    return d.toLocaleString('en-GB',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'});
  }catch(e){ return '—'; }
}
function glkMobileQtdRefreshUI(){
  var meta=GLK_MOBILE_REPORT_META;
  var metaEl=el('mobileReportMeta');
  var spLink=el('mobileReportSpLink');
  if(spLink){
    spLink.href=SP_MOBILE_REPORT_WEB_URL;
    spLink.title='Open workbook in SharePoint SiteAssets';
  }
  var uploadIso=meta&&(meta.uploadedAt||meta.cachedAt);
  var uploadTxt=mqFmtReportUploadDate(uploadIso);
  if(metaEl) metaEl.textContent='Last uploaded: '+uploadTxt;
  mqBuildReportLevelFilter();
  mqSyncYtdManualPanel();
}
function mqDefaultDateRule(field){
  return {id:'mq'+(mqRuleSeq++),dateField:field||'expectedActivation',dateMode:'any',from:'',to:'',specific:'',ytdYear:'',years:[],quarters:[],months:[],weeks:[]};
}
function mqGetRuleChecked(ruleId,part){
  var drop=el(mqRulePrefix(ruleId)+'_'+part);
  if(!drop) return [];
  return Array.from(drop.querySelectorAll('input:checked')).map(function(c){return c.value;});
}
function mqUpdateRuleMsText(ruleId,part,label){
  var checked=mqGetRuleChecked(ruleId,part);
  var te=el(mqRulePrefix(ruleId)+'_'+part+'Text'); if(!te) return;
  if(!checked.length){ te.textContent='All '+label; return; }
  if(checked.length===1){
    if(part==='quarter') te.textContent='Q'+checked[0];
    else if(part==='month') te.textContent=MONTH_NAMES[+checked[0]]||checked[0];
    else if(part==='week') te.textContent='W'+checked[0];
    else te.textContent=checked[0];
    return;
  }
  te.textContent=checked.length+' selected';
}
function mqToggleRuleMs(ruleId,part){
  var drop=el(mqRulePrefix(ruleId)+'_'+part),trig=el(mqRulePrefix(ruleId)+'_'+part+'Trig');
  if(!drop||!trig) return;
  var isOpen=drop.classList.contains('open');
  document.querySelectorAll('#mqDateRulesWrap .ms-dropdown.open').forEach(function(d){d.classList.remove('open');if(d.previousElementSibling)d.previousElementSibling.classList.remove('open');});
  if(!isOpen){
    var rect=trig.getBoundingClientRect();
    drop.style.top=(rect.bottom+4)+'px';drop.style.left=rect.left+'px';
    drop.style.width=Math.max(rect.width,180)+'px';
    drop.classList.add('open');trig.classList.add('open');
  }
}
function mqBuildRuleMs(ruleId,part,label,values,selected,labelFn){
  var drop=el(mqRulePrefix(ruleId)+'_'+part); if(!drop) return;
  var selSet={}; (selected||[]).forEach(function(v){selSet[String(v)]=true;});
  drop.innerHTML=values.map(function(val){
    var disp=labelFn?labelFn(val):val;
    var cid=mqRulePrefix(ruleId)+'_'+part+'_'+String(val).replace(/\W/g,'_');
    return '<div class="ms-option" onclick="event.stopPropagation()"><input type="checkbox" id="'+cid+'" value="'+val+'"'+(selSet[String(val)]?' checked':'')+' onchange="mqUpdateRuleMsText(\''+ruleId+'\',\''+part+'\',\''+label+'\');mqOnDateFilterChange()"><label for="'+cid+'">'+disp+'</label></div>';
  }).join('');
  mqUpdateRuleMsText(ruleId,part,label);
}
function mqPopulateRulePeriodDropdowns(rule,items){
  var field=rule.dateField||'expectedActivation';
  var metas=glkCollectDateMetas(items,field);
  var ySel=rule.years||[], qSel=rule.quarters||[], mSel=rule.months||[];
  var years=[],quarters=[],months=[],weeks=[];
  metas.forEach(function(m){ var ys=String(m.year); if(years.indexOf(ys)<0) years.push(ys); });
  years.sort(function(a,b){return parseInt(b,10)-parseInt(a,10);});
  metas.forEach(function(m){
    if(ySel.length&&ySel.indexOf(String(m.year))<0) return;
    var qs=String(m.quarter); if(quarters.indexOf(qs)<0) quarters.push(qs);
  });
  quarters.sort(function(a,b){return parseInt(a,10)-parseInt(b,10);});
  metas.forEach(function(m){
    if(ySel.length&&ySel.indexOf(String(m.year))<0) return;
    if(qSel.length&&qSel.indexOf(String(m.quarter))<0) return;
    var ms=String(m.monthIndex); if(months.indexOf(ms)<0) months.push(ms);
  });
  months.sort(function(a,b){return parseInt(a,10)-parseInt(b,10);});
  metas.forEach(function(m){
    if(ySel.length&&ySel.indexOf(String(m.year))<0) return;
    if(qSel.length&&qSel.indexOf(String(m.quarter))<0) return;
    if(mSel.length&&mSel.indexOf(String(m.monthIndex))<0) return;
    if(m.week!=null){ var ws=String(m.week); if(weeks.indexOf(ws)<0) weeks.push(ws); }
  });
  weeks.sort(function(a,b){return parseInt(a,10)-parseInt(b,10);});
  mqBuildRuleMs(rule.id,'year','Years',years,rule.years);
  mqBuildRuleMs(rule.id,'quarter','Quarters',quarters,rule.quarters,function(v){return 'Q'+v;});
  mqBuildRuleMs(rule.id,'month','Months',months,rule.months,function(v){return MONTH_NAMES[+v]||v;});
  mqBuildRuleMs(rule.id,'week','Weeks',weeks,rule.weeks,function(v){return 'W'+v;});
}
function mqReadDateRuleFromDom(ruleId){
  var p=mqRulePrefix(ruleId);
  return {
    id:ruleId,
    dateField:glkGetSelectVal(p+'Field')||'expectedActivation',
    dateMode:glkGetSelectVal(p+'Mode')||'any',
    from:glkGetSelectVal(p+'From'),to:glkGetSelectVal(p+'To'),specific:glkGetSelectVal(p+'Specific'),
    ytdYear:glkGetSelectVal(p+'YtdYear'),
    years:mqGetRuleChecked(ruleId,'year'),quarters:mqGetRuleChecked(ruleId,'quarter'),
    months:mqGetRuleChecked(ruleId,'month'),weeks:mqGetRuleChecked(ruleId,'week'),
  };
}
function mqReadAllDateRules(){ return mqDateRules.map(function(r){return mqReadDateRuleFromDom(r.id);}); }
function mqSyncRuleModeUI(ruleId){
  var p=mqRulePrefix(ruleId), mode=glkGetSelectVal(p+'Mode')||'any';
  ['Range','Single','Period','Ytd'].forEach(function(suffix){
    var g=el(p+suffix+'Group'); if(g) g.style.display=(mode===suffix.toLowerCase()?'grid':'none');
  });
  var hint=el(p+'Hint'); if(hint) hint.textContent=glkDateModeHint(mode);
}
function mqRenderDateRuleCard(rule,index){
  var p=mqRulePrefix(rule.id), mode=rule.dateMode||'any';
  var fieldOpts=GLK_DATE_FIELD_OPTS.map(function(o){return '<option value="'+o.key+'"'+(rule.dateField===o.key?' selected':'')+'>'+o.label+'</option>';}).join('');
  var modeOpts=[
    {v:'any',l:'Any date'},{v:'ytd',l:'Year to date'},{v:'range',l:'Date range'},
    {v:'single',l:'Specific day'},{v:'period',l:'Year / quarter / month'},
  ].map(function(o){return '<option value="'+o.v+'"'+(mode===o.v?' selected':'')+'>'+o.l+'</option>';}).join('');
  var years=[...new Set(ALL_BIDS.map(function(b){var m=glkDateMeta(glkBidDateValue(b,rule.dateField));return m?String(m.year):null;}).filter(Boolean))].sort(function(a,b){return parseInt(b,10)-parseInt(a,10);});
  var ytdOpts=years.map(function(y){return '<option value="'+y+'"'+(String(rule.ytdYear||new Date().getFullYear())===y?' selected':'')+'>'+y+'</option>';}).join('');
  var ms=function(part,label){
    return '<div class="filter-group"><div class="filter-label">'+label+'</div><div class="ms-wrap"><div class="ms-trigger" id="'+p+'_'+part+'Trig" onclick="event.stopPropagation();mqToggleRuleMs(\''+rule.id+'\',\''+part+'\')"><span id="'+p+'_'+part+'Text">All '+label+'</span><svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></div><div class="ms-dropdown" id="'+p+'_'+part+'"></div></div></div>';
  };
  return '<div class="glk-date-rule" id="'+p+'Card">'+
    '<div class="glk-rule-header"><span class="glk-rule-title">Date criterion '+(index+1)+'</span>'+
      (mqDateRules.length>1?'<button type="button" class="glk-rule-remove" onclick="mqRemoveDateRule(\''+rule.id+'\')">Remove</button>':'')+
    '</div>'+
    '<div class="filter-bar-grid">'+
      '<div class="fb-group"><div class="fb-group-label">Date field</div><select class="fb-select" id="'+p+'Field" onchange="mqOnDateFilterChange()">'+fieldOpts+'</select></div>'+
      '<div class="fb-group"><div class="fb-group-label">Filter by</div><select class="fb-select" id="'+p+'Mode" onchange="mqSyncRuleModeUI(\''+rule.id+'\');mqOnDateFilterChange()">'+modeOpts+'</select></div>'+
    '</div>'+
    '<div class="glk-date-hint" id="'+p+'Hint">'+glkDateModeHint(mode)+'</div>'+
    '<div id="'+p+'RangeGroup" class="filter-bar-grid" style="display:'+(mode==='range'?'grid':'none')+';margin-top:.4rem;">'+
      '<div class="fb-group"><div class="fb-group-label">From</div><input type="date" class="fb-select" id="'+p+'From" value="'+(rule.from||'')+'" onchange="mqOnDateFilterChange()"></div>'+
      '<div class="fb-group"><div class="fb-group-label">To</div><input type="date" class="fb-select" id="'+p+'To" value="'+(rule.to||'')+'" onchange="mqOnDateFilterChange()"></div></div>'+
    '<div id="'+p+'SingleGroup" class="filter-bar-grid" style="display:'+(mode==='single'?'grid':'none')+';margin-top:.4rem;">'+
      '<div class="fb-group"><div class="fb-group-label">Day</div><input type="date" class="fb-select" id="'+p+'Specific" value="'+(rule.specific||'')+'" onchange="mqOnDateFilterChange()"></div></div>'+
    '<div id="'+p+'YtdGroup" class="filter-bar-grid" style="display:'+(mode==='ytd'?'grid':'none')+';margin-top:.4rem;">'+
      '<div class="fb-group"><div class="fb-group-label">YTD year</div><select class="fb-select" id="'+p+'YtdYear" onchange="mqOnDateFilterChange()">'+ytdOpts+'</select></div></div>'+
    '<div id="'+p+'PeriodGroup" class="filter-bar-grid" style="display:'+(mode==='period'?'grid':'none')+';margin-top:.4rem;">'+
      ms('year','Years')+ms('quarter','Quarters')+ms('month','Months')+ms('week','Weeks')+'</div></div>';
}
function mqBuildDateFilters(){
  if(!mqDateRules.length) mqDateRules=[mqDefaultDateRule('expectedActivation')];
  var wrap=el('mqDateRulesWrap'); if(!wrap) return;
  wrap.innerHTML=mqDateRules.map(function(r,i){return mqRenderDateRuleCard(r,i);}).join('');
  mqDateRules.forEach(function(r){
    mqSyncRuleModeUI(r.id);
    mqPopulateRulePeriodDropdowns(mqReadDateRuleFromDom(r.id),ALL_BIDS);
  });
}
window.mqAddDateRule=function(){ mqDateRules.push(mqDefaultDateRule('expectedActivation')); mqBuildDateFilters(); };
window.mqRemoveDateRule=function(ruleId){
  mqDateRules=mqDateRules.filter(function(r){return r.id!==ruleId;});
  if(!mqDateRules.length) mqDateRules=[mqDefaultDateRule('expectedActivation')];
  mqBuildDateFilters(); mqOnDateFilterChange();
};
window.mqOnDateFilterChange=function(){
  mqDateRules=mqReadAllDateRules();
  mqDateRules.forEach(function(r){mqPopulateRulePeriodDropdowns(r,ALL_BIDS);});
  renderMobileQtdBridge();
};
function mqApplyBridgeBaseFilters(){
  return ALL_BIDS.filter(mqBidMatchesPf);
}
function mqDaysInMonth(y,m){
  return new Date(y,m+1,0).getDate();
}
function mqDateOnly(d){
  return new Date(d.getFullYear(),d.getMonth(),d.getDate());
}
function mqParseBidDate(iso){
  if(!iso) return null;
  if(typeof iso==='string'){
    var s=iso.trim();
    var dm=/\/Date\((-?\d+)\)\//.exec(s);
    if(dm){ var d=new Date(+dm[1]); return isNaN(d)?null:mqDateOnly(d); }
    var slash=/^(\d{1,2})\/(\d{1,2})\/(\d{4})/.exec(s);
    if(slash){
      var p1=+slash[1], p2=+slash[2], y=+slash[3], month, day;
      if(p1>12){ day=p1; month=p2; }
      else if(p2>12){ month=p1; day=p2; }
      else { month=p1; day=p2; }
      var ld=new Date(y,month-1,day);
      return isNaN(ld)?null:mqDateOnly(ld);
    }
  }
  var d=new Date(iso);
  return isNaN(d)?null:mqDateOnly(d);
}
/** Bridge drill-down date — same parser as activation filters (avoids UTC vs local mismatch). */
function mqFmtBidDate(iso){
  var d=mqParseBidDate(iso);
  if(!d) return '—';
  return d.toLocaleDateString('en-GB');
}
function mqActivationMonthLabel(iso){
  var d=mqParseBidDate(iso);
  if(!d) return '—';
  return MONTH_NAMES[d.getMonth()]+' '+d.getFullYear();
}
function mqFractionalMonthsBetween(startDate,endDate){
  if(!startDate||!endDate) return 0;
  var s=mqDateOnly(startDate), e=mqDateOnly(endDate);
  if(e<s) return 0;
  if(s.getTime()===e.getTime()) return 1/mqDaysInMonth(s.getFullYear(),s.getMonth());
  var total=0, y=s.getFullYear(), m=s.getMonth(), ey=e.getFullYear(), em=e.getMonth();
  while(y<ey||(y===ey&&m<=em)){
    var dim=mqDaysInMonth(y,m);
    var ms=new Date(y,m,1), me=new Date(y,m,dim);
    var rs=s>ms?s:ms, re=e<me?e:me;
    if(re>=rs){
      var days=Math.round((re-rs)/86400000)+1;
      total+=days/dim;
    }
    m++; if(m>11){m=0;y++;}
  }
  return total;
}
/** Inclusive calendar days from start through end. */
function mqInclusiveDaysBetween(startDate,endDate){
  var s=mqDateOnly(startDate), e=mqDateOnly(endDate);
  if(e<s) return 0;
  return Math.round((e-s)/86400000)+1;
}
/** Aggregated Revenue MRC: (days activation→period-end ÷ days in activation month) × MRC */
function mqAggregatedRevenueMrc(actDate,endDate,mrcVal){
  if(!actDate||!endDate) return 0;
  if(mqDateOnly(actDate)>mqDateOnly(endDate)) return 0;
  var mrc=num(mrcVal);
  if(mrc<=0) return 0;
  var days=mqInclusiveDaysBetween(actDate,endDate);
  if(days<=0) days=1;
  var dim=mqDaysInMonth(actDate.getFullYear(),actDate.getMonth());
  return (days/dim)*mrc;
}
function mqQuarterEndDate(year,quarter){
  return new Date(year,quarter*3,0);
}
function mqYearEndDate(year){
  return new Date(year,11,31);
}
function mqBidQtgMrc(bid,year,quarter){
  if(!mqActivationQtdForward(bid)) return 0;
  var act=mqParseBidDate(bid.expectedActivation);
  if(!act) return 0;
  var live=mqReportYearQuarter();
  var qEnd=mqQuarterEndDate(live.year,live.quarter);
  if(act>qEnd) return 0;
  return mqAggregatedRevenueMrc(act,qEnd,num(bid.mrc));
}
function mqBidYtgMrc(bid,year){
  var act=mqParseBidDate(bid.expectedActivation);
  if(!act) return 0;
  var yEnd=mqYearEndDate(year);
  if(act>yEnd) return 0;
  return mqAggregatedRevenueMrc(act,yEnd,num(bid.mrc));
}
function mqBidForwardOtc(bid){
  return num(bid.otc);
}
function mqBidQtgValue(bid,year,quarter){
  if(!mqActivationQtdForward(bid)) return 0;
  var act=mqParseBidDate(bid.expectedActivation);
  if(!act) return 0;
  var live=mqReportYearQuarter();
  var qEnd=mqQuarterEndDate(live.year,live.quarter);
  if(act>qEnd) return 0;
  return mqAggregatedRevenueMrc(act,qEnd,num(bid.mrc))+mqBidForwardOtc(bid);
}
function mqBidYtgValue(bid,year){
  if(!mqActivationYtgForward(bid,year)) return 0;
  var act=mqParseBidDate(bid.expectedActivation);
  if(!act) return 0;
  var yEnd=mqYearEndDate(year);
  if(act>yEnd) return 0;
  return mqAggregatedRevenueMrc(act,yEnd,num(bid.mrc))+mqBidForwardOtc(bid);
}
function mqBidBridgeValue(bid){
  var calc=GLK_MQ_CALC_LAST;
  if(!calc||!calc.isForward) return mqBidMetric(bid);
  if(calc.bridgePeriod==='qtg') return mqBidQtgValue(bid,calc.year,calc.quarter);
  if(calc.bridgePeriod==='ytg') return mqBidYtgValue(bid,calc.year);
  return mqBidMetric(bid);
}
function mqBidBridgeValueParts(bid){
  var calc=GLK_MQ_CALC_LAST;
  if(!calc||!calc.isForward){
    var v=mqBidMetric(bid);
    return {mrc:v,otc:0,total:v};
  }
  var act=mqParseBidDate(bid.expectedActivation);
  var endDate=calc.bridgePeriod==='ytg'?mqYearEndDate(calc.year):mqQuarterEndDate(calc.year,calc.quarter);
  var mrcPart=(act&&endDate)?mqAggregatedRevenueMrc(act,endDate,num(bid.mrc)):0;
  var otc=mqBidForwardOtc(bid);
  return {mrc:mrcPart,otc:otc,total:mrcPart+otc};
}
function mqActualsBarLabel(){
  return mqIsYtdBridge()?'Actuals YTD':'Actuals';
}
function mqShowYtdWarnings(calc){
  var wrap=el('mobileQtdSummaryWrap');
  if(!wrap) return;
  var parts=[];
  var meta=GLK_YTD_META||{};
  if(meta.currentMonth){
    parts.push('Live month: <strong>'+meta.currentMonth.label+' '+meta.currentMonth.year+'</strong>');
  }
  if(meta.reportAsOf){
    parts.push('Report as of: <strong>'+(meta.reportAsOf.label||MONTH_NAMES[meta.reportAsOf.month])+' '+meta.reportAsOf.year+'</strong>');
  }
  if(meta.refSheet) parts.push('History: <strong>'+meta.refSheet+'</strong>');
  if(meta.liveSheet) parts.push('Live: <strong>'+meta.liveSheet+'</strong>');
  (meta.warnings||[]).forEach(function(w){
    if((w.type==='ytd_target_missing'||w.type==='mobile_q1_missing')&&mqIsYtdBridge()) parts.push('<span style="color:#f59e0b;">⚠ '+w.message+'</span>');
    else if(w.type==='no_live_sheet'||w.type==='no_live_month') parts.push('<span style="color:#f59e0b;">⚠ '+w.message+'</span>');
    else if(w.type==='ytd_sheet_info'&&mqIsYtdBridge()) parts.push('<span style="color:#64748b;">'+w.message+'</span>');
  });
  if(calc&&calc.isForward) wrap.innerHTML='';
  else if(parts.length) wrap.innerHTML=parts.join(' · ');
  else wrap.innerHTML='';
}
function mqWonBarLabel(calc){
  calc=calc||GLK_MQ_CALC_LAST||{};
  if(calc.isForward) return calc.bridgePeriod==='ytg'?'YTG — Won':'QTG — Won';
  if(calc.bridgePeriod==='ytd') return mqProductFamily==='fixed'?'QTG — Won':'Gross Adds (Won)';
  return mqProductFamily==='fixed'?'Won MRC':'Gross Adds (Won)';
}
function mqPeriodEndLabel(calc){
  calc=calc||GLK_MQ_CALC_LAST||{};
  if(!calc.isForward) return '';
  if(calc.bridgePeriod==='ytg') return '31 Dec '+calc.year;
  var d=mqQuarterEndDate(calc.year,calc.quarter);
  return fmtDate(d);
}
function mqBidCalcBreakdown(bid,opts){
  opts=opts||{};
  var calc=GLK_MQ_CALC_LAST||{};
  var isChurn=!!opts.churn;
  if(!calc.isForward){
    var v=mqBidMetric(bid);
    if(isChurn) v=-Math.abs(v);
    return {
      mode:'qtd',label:isChurn?'QTD Churn':'QTD',total:v,
      lines:[
        'Metric: '+mqMetricUnit()+(isChurn?' (shown as negative churn)':''),
        'Value: <strong>'+fmtLines(Math.abs(v))+'</strong> '+mqMetricShort()+(isChurn?' (churn)':'')
      ]
    };
  }
  var act=mqParseBidDate(bid.expectedActivation);
  var endDate=calc.bridgePeriod==='ytg'?mqYearEndDate(calc.year):mqQuarterEndDate(calc.year,calc.quarter);
  var days=act?mqInclusiveDaysBetween(act,endDate):0;
  if(days<=0&&act) days=1;
  var dim=act?mqDaysInMonth(act.getFullYear(),act.getMonth()):0;
  var mrc=num(bid.mrc);
  var mrcPart=act?mqAggregatedRevenueMrc(act,endDate,mrc):0;
  var otc=isChurn?0:mqBidForwardOtc(bid);
  var total=isChurn?-Math.abs(mrcPart):(mrcPart+otc);
  var periodName=mqPeriodLongName(calc.bridgePeriod);
  var lines=[
    '<strong>'+periodName+(isChurn?' — Churn (MRC only, no OTC)':'')+'</strong> for this row',
    'Activation: <strong>'+mqFmtBidDate(bid.expectedActivation)+'</strong> ('+mqActivationMonthLabel(bid.expectedActivation)+') → Period end: <strong>'+mqPeriodEndLabel(calc)+'</strong>',
    'Days (inclusive): <strong>'+days+'</strong> ÷ Days in activation month: <strong>'+dim+'</strong>',
    'MRC part: ('+days+' ÷ '+dim+') × '+fmtLines(mrc)+' = <strong>'+fmtLines(mrcPart)+'</strong>'
  ];
  if(isChurn) lines.push('Churn total: <strong>−'+fmtLines(mrcPart)+'</strong> (MRC only)');
  else{
    lines.push('OTC (one-time): <strong>'+fmtLines(otc)+'</strong>');
    lines.push('Total: '+fmtLines(mrcPart)+' + '+fmtLines(otc)+' = <strong>'+fmtLines(mrcPart+otc)+'</strong>');
  }
  return {mode:calc.bridgePeriod,label:periodName,total:total,days:days,daysInMonth:dim,mrcPart:mrcPart,otc:otc,lines:lines};
}
function mqBidRowDetailValue(bid,barType){
  var calc=GLK_MQ_CALC_LAST||{};
  if(!calc.isForward) return barType==='decrease'?-Math.abs(mqBidMetric(bid)):mqBidMetric(bid);
  if(barType==='decrease'){
    return calc.bridgePeriod==='ytg'?-Math.abs(mqBidYtgMrc(bid,calc.year)):-Math.abs(mqBidQtgMrc(bid,calc.year,calc.quarter));
  }
  return mqBidBridgeValue(bid);
}
var MQ_BID_DETAIL_FIELDS=[
  {k:'bidRequest',l:'Bid Reference'},
  {k:'myId',l:'My ID'},
  {k:'customerCode',l:'Customer Code'},
  {k:'customerName',l:'Customer'},
  {k:'oppStatus',l:'Opportunity Status'},
  {k:'buildingName',l:'Building / MAPA'},
  {k:'vertical',l:'Vertical'},
  {k:'headDirector',l:'Head Director'},
  {k:'accountDirector',l:'Account Director'},
  {k:'amName',l:'Account Manager'},
  {k:'productFamily',l:'Product Family'},
  {k:'productCategory',l:'Product Category'},
  {k:'services',l:'Services'},
  {k:'typeOfContract',l:'Type of Contract'},
  {k:'typeOfRequest',l:'Type of Request'},
  {k:'status',l:'Status'},
  {k:'closureProb',l:'Closure Prob.'},
  {k:'mrc',l:'MRC',money:true},
  {k:'otc',l:'OTC',money:true},
  {k:'tcv',l:'TCV',money:true},
  {k:'gaLines',l:'GA Lines',money:true},
  {k:'expectedActivation',l:'Expected Activation',date:true},
  {k:'contractSigned',l:'Contract Signed',date:true},
  {k:'proposedDate',l:'Proposed Date',date:true},
  {k:'bidManager',l:'Bid Manager'},
  {k:'solutionManager',l:'Solution Manager'},
  {k:'projectManager',l:'Project Manager'},
  {k:'complexity',l:'Complexity'},
  {k:'duration',l:'Duration'},
  {k:'comments',l:'Comments',html:true}
];
function mqFormatBidField(bid,fd){
  var v=fd.k==='oppStatus'?mqRawOppStatus(bid)||'—':bid[fd.k];
  if(v==null||v==='') return '—';
  if(fd.date) return mqFmtBidDate(v);
  if(fd.money) return fmtLines(v);
  if(fd.html||fd.k==='comments') return mqStripHtml(v)||'—';
  return String(v);
}
function mqBidRowSummaryLine(bid){
  return mqBidRefLine(bid)+' · '+(bid.customerName||'—')+' · '+(bid.buildingName&&bid.buildingName!=='—'?bid.buildingName+' · ':'')+
    (bid.vertical||'—')+' · AM: '+(bid.amName||'—')+' · AD: '+(bid.accountDirector||'—');
}
function mqActivationYtgForward(bid,year){
  var act=mqParseBidDate(bid.expectedActivation);
  if(!act) return false;
  if(act.getFullYear()!==year) return false;
  return act>=mqDateOnly(new Date());
}
function mqNormContractType(v){
  var s=String(v||'').trim().toLowerCase().replace(/\s+/g,' ');
  if(!s||s==='—') return '(blank)';
  if(s==='acquisation') return 'acquisition';
  return s;
}
var MQ_GROSS_CONTRACT_TYPES=['acquisition','cross sell','new','relocation','upgrade','upsell','(blank)'];
var MQ_CHURN_CONTRACT_TYPES=['churn','downgrade'];
function mqContractInList(bid,list){
  return list.indexOf(mqNormContractType(bid.typeOfContract))>=0;
}
function mqLiveYearQuarter(){
  var now=new Date();
  return {year:now.getFullYear(),quarter:Math.floor(now.getMonth()/3)+1};
}
/** Expected activation in live calendar quarter, current month through quarter-end. */
function mqActivationQtdForward(bid){
  return !mqActivationRejectReason(bid);
}
function mqActivationRejectReason(bid){
  var act=mqParseBidDate(bid.expectedActivation);
  if(!act) return 'Missing or invalid expected activation date';
  var viewYQ=mqBridgeViewYearQuarter();
  if(act.getFullYear()!==viewYQ.year){
    return 'Activation '+mqActivationMonthLabel(bid.expectedActivation)+' — wrong year (need '+viewYQ.year+')';
  }
  var actQ=Math.floor(act.getMonth()/3)+1;
  if(actQ!==viewYQ.quarter){
    return 'Activation '+mqActivationMonthLabel(bid.expectedActivation)+' — outside Q'+viewYQ.quarter+' '+viewYQ.year+' (other quarters excluded)';
  }
  if(viewYQ.future) return '';
  var liveMonth=mqBridgeLiveMonthIndex(viewYQ);
  if(act.getMonth()<liveMonth){
    return 'Activation '+mqActivationMonthLabel(bid.expectedActivation)+' — earlier month in quarter excluded (need '+MONTH_NAMES[liveMonth]+' → quarter-end)';
  }
  return '';
}
window.mqToggleOverdueActivation=mqToggleOverdueActivation;
window.mqUpdateOverdueButtonCount=mqUpdateOverdueButtonCount;
window.mqToggleBridgeInfo=function(){
  var p=el('mqBridgeInfoPanel'); if(!p) return;
  p.style.display=p.style.display==='none'?'block':'none';
  if(p.style.display==='block'&&GLK_MQ_CALC_LAST){
    if(!GLK_MQ_CALC_LAST.rulesHtml) GLK_MQ_CALC_LAST.rulesHtml=mqBuildRulesHtml(GLK_MQ_CALC_LAST);
    mqRenderBridgeInfoPanel(GLK_MQ_CALC_LAST);
  }
};
function mqRenderBridgeInfoPanel(calc){
  var p=el('mqBridgeInfoPanel'); if(!p||!calc) return;
  p.innerHTML=calc.rulesHtml||'';
}
function mqFindReportScope(report,vertName){
  if(!report) return null;
  if(!vertName) return report.overall||null;
  var vn=mqNormVertKey(vertName);
  var list=report.verticals||[];
  for(var i=0;i<list.length;i++){
    if(mqNormVertKey(list[i].name)===vn) return list[i];
  }
  for(var j=0;j<list.length;j++){
    var n=mqNormVertKey(list[j].name);
    if(!n||!vn||n.length<2||vn.length<2) continue;
    if(n.indexOf(vn)>=0||vn.indexOf(n)>=0) return list[j];
  }
  return null;
}
function mqMatchVerticalName(bidVert,selVert){
  if(!selVert) return true;
  var bv=mqNormVertKey(bidVert);
  var vn=mqNormVertKey(selVert);
  if(!bv||bv==='—') return false;
  if(bv===vn) return true;
  if(bv.length>=2&&vn.length>=2&&(bv.indexOf(vn)>=0||vn.indexOf(bv)>=0)) return true;
  return false;
}
function mqGetSelectedFilterLabels(){
  var out={};
  var rl=mqGetReportLevelsChecked();
  out['Report level']=rl.length?rl.join(', '):'GLK Overall (all verticals)';
  out['Product family']=mqProductFamily==='fixed'?'Fixed':'Mobile';
  out[mqProductFamily==='fixed'?'Net MRC':'Net Add Lines']=mqPeriodLongName(mqPeriod);
  out['Scenario']=mqCaseDisplayName();
  if(mqHeadDirector&&MQ_HEAD_DIRECTORS[mqHeadDirector]) out['Head director']=MQ_HEAD_DIRECTORS[mqHeadDirector].label;
  return out;
}
function mqBuildRulesHtml(calc){
  var f=mqGetSelectedFilterLabels();
  var isFixed=mqProductFamily==='fixed';
  var metric=isFixed?'Fixed Net MRC (+ OTC on forward bridges)':'Mobile Net Add Lines (GA Lines)';
  var grossTypes=MQ_GROSS_CONTRACT_TYPES.map(function(t){return t==='(blank)'?'(blank / empty)':t;}).join(', ');
  var churnTypes=MQ_CHURN_CONTRACT_TYPES.join(', ');
  var ipStatuses=STATUS_IP.join(', ');
  var html='';

  html+='<div class="mq-info-section"><h4>'+(mqIsForwardBridge()?'Aggregated Revenue':(isFixed?'Net MRC':'Net Add Lines'))+' — '+mqPeriodLongName(calc.bridgePeriod)+'</h4>';
  if(calc.bridgePeriod==='qtd'){
    html+='<strong>QTD Bridge</strong> (Quarter to Date) compares <em>current-quarter</em> Excel actuals + target against pipeline still to land this quarter.<br>';
    html+='<strong>Actuals</strong> — sum of month columns in the current quarter from the live daily sheet (e.g. Jul + Aug in Q3).<br>';
    html+='<strong>Target</strong> — current-quarter column from live sheet (e.g. Q3\'2026). Fixed: per vertical. Mobile: per vertical on QTD.<br>';
    html+='<strong>Pipeline window</strong> — expected activation in the <strong>live calendar quarter</strong> (today\'s Q), from <strong>current month → quarter-end</strong>. Past months in the quarter are excluded. Uses today\'s date — not the Excel target quarter.<br>';
    html+='<strong>Example (Q3, September live month):</strong> Actuals = Jul + Aug + Sep from Excel · Target = Q3 column · Won/Churn = deals activating Sep only (not Jul/Aug, not Oct).';
  }else if(calc.bridgePeriod==='ytd'){
    html+='<strong>YTD Bridge</strong> (Year to Date) compares <em>year-to-date</em> Excel actuals against target, with <strong>QTG</strong> pipeline for the rest of the current quarter.<br>';
    html+='<strong>Actuals YTD</strong> — <strong>Jan through prior month</strong> summed from the history/reference sheet + <strong>current month only</strong> from the live daily sheet (never mixed).<br>';
    if(isFixed){
      html+='<strong>Target</strong> — per vertical from Target block: <strong>Q1 + Q2 + Q3</strong> (Total column, e.g. Overall 14,982,111). Loaded from Excel.<br>';
      html+='<strong>Pipeline</strong> — QTG: activation current month → quarter-end; Fixed uses aggregated revenue formula on Won/in-flight/churn.';
    }else{
      html+='<strong>Target</strong> — <strong>Overall row only</strong>: Q1 + Apr + May&amp;June + Q3 from reference sheet. Per-vertical targets are <em>not</em> used. If Q1\'2026 is blank, enter Overall Q1 in the panel below the controls.<br>';
      html+='<strong>Pipeline</strong> — QTG window (current month → quarter-end). Full GA Lines on Won/in-flight/churn.';
    }
    html+='<strong>Example (August):</strong> Actuals YTD = Jan–Jul (history sheet) + Aug (live sheet) · Fixed target = Q1+Q2+Q3 Total (e.g. Overall 14,982,111) · Mobile target = Overall Q1+Apr+May&amp;Jun+Q3 · Pipeline = QTG only.';
  }else if(calc.bridgePeriod==='qtg'){
    html+='<strong>Aggregated Revenue — QTG</strong> — forward-looking <em>Fixed only</em>. No Excel actuals or target bars.<br>';
    html+='Shows aggregated revenue still to come from pipeline activations between <strong>today (or current month) → quarter-end</strong>.<br>';
    html+='<strong>Formula per row:</strong> <code>(days activation → quarter-end ÷ days in activation month) × MRC + OTC</code><br>';
    html+='<strong>Example:</strong> Activation 24 Aug, quarter-end 30 Sep, MRC 10,000, OTC 5,000 → (38÷31)×10,000 + 5,000 = <strong>17,258</strong>.';
  }else if(calc.bridgePeriod==='ytg'){
    html+='<strong>Aggregated Revenue — YTG</strong> — forward-looking <em>Fixed only</em>. No Excel actuals or target bars.<br>';
    html+='Shows aggregated revenue from pipeline activations between <strong>today → 31 December</strong> of the report year.<br>';
    html+='<strong>Formula per row:</strong> same as QTG but period end = <strong>31 Dec</strong> (churn = MRC only, no OTC).<br>';
    html+='<strong>Example:</strong> Activation 24 Aug, year-end 31 Dec, MRC 10,000, OTC 5,000 → (130÷31)×10,000 + 5,000 = <strong>46,935</strong>.';
  }
  html+='</div>';

  html+='<div class="mq-info-section"><h4>Controls</h4>';
  html+='<strong>1 Product family</strong> — Mobile, Fixed, or Revenue (coming soon)<br>';
  html+='<strong>2 '+(isFixed?'Net MRC':'Net Add Lines')+'</strong> — QTD Bridge · YTD Bridge (against Excel actuals and target)<br>';
  html+='<strong>3 Aggregated Revenue</strong> — QTG (activation → quarter-end) · YTG (activation → 31 Dec). Fixed only, no Excel actuals or target<br>';
  html+='<strong>4 Scenario</strong> — Most Likely vs Upside (see pipeline rules below)<br>';
  html+='<strong>5 Head director</strong> — Khaled (AUH, F-NE, HUNT) · Amer (DXB) · Kamil (KEY-A, KEY-B, LE) — auto-selects report level verticals<br>';
  html+='<strong>6 Report level</strong> — filters pipeline rows by GLK Excel vertical (AUH, DXB, KEY-A…). Applies to <em>all</em> bridge types. Excel target on Mobile YTD stays Overall-only.';
  html+='</div>';

  html+='<div class="mq-info-section"><h4>Filters applied to pipeline</h4>';
  html+='· <strong>Product family</strong> — Mobile rows only on Mobile; Fixed rows only on Fixed<br>';
  html+='· <strong>Report level</strong> — when vertical(s) selected, only matching pipeline verticals are included<br>';
  html+='· <strong>Scenario</strong> — Most Likely / Upside changes which in-flight statuses are included (Won bar is the same in both)<br>';
  html+='· Pipeline comes from the main GLK bid grid (live pipeline data loaded in the portal)';
  html+='</div>';

  html+='<div class="mq-info-section"><h4>Bar-by-bar — what goes where</h4>';
  if(!calc.isForward){
    html+='<strong>Green — Actuals</strong> — achieved to date from uploaded GLK Excel (QTD = quarter months; YTD = Jan→current month). Not from pipeline.<br>';
  }
  html+='<strong>Purple — Won</strong> (Gross Adds Won / QTG — Won on forward bridges)<br>';
  html+='&nbsp;&nbsp;· <strong>Product family</strong> — Mobile rows on Mobile bridge; Fixed on Fixed<br>';
  html+='&nbsp;&nbsp;· <strong>Report level</strong> — when vertical(s) selected, row vertical must match<br>';
  html+='&nbsp;&nbsp;· <strong>Opportunity Status</strong> — SharePoint field = <strong>Won</strong> or <strong>Closed Won</strong> (Billed / Proposed / Opportunity excluded; forecast category ignored)<br>';
  html+='&nbsp;&nbsp;· <strong>Expected activation</strong> — required; live calendar quarter, current month → quarter-end<br>';
  html+='&nbsp;&nbsp;· <strong>Type of contract</strong> ∈ <strong>'+grossTypes+'</strong><br>';
  html+='&nbsp;&nbsp;· <strong>Value &gt; 0</strong> — Mobile: GA Lines · Fixed: MRC only<br>';
  html+='&nbsp;&nbsp;· <strong>Not grouped</strong> — each bid row listed separately in drill-down<br>';
  html+='&nbsp;&nbsp;· <strong>Not used:</strong> closure probability, forecast category, derived grid status<br><br>';

  html+='<strong>Blue — Needle Movers (Top 5 + Others)</strong><br>';
  html+='&nbsp;&nbsp;· Type of contract ∈ <strong>'+grossTypes+'</strong><br>';
  html+='&nbsp;&nbsp;· Same activation window as Won for this bridge type<br>';
  html+='&nbsp;&nbsp;· Value &gt; 0<br>';
  html+='&nbsp;&nbsp;· Needle Movers uses raw Opportunity Status — <strong>Proposed</strong>'+(calc.isBest?' / <strong>Opportunity</strong> (Upside)':' (Most Likely)')+' only · Won / Billed never included<br>';
  html+='&nbsp;&nbsp;· <strong>Top 5 + Others</strong> — Others = remaining Proposed'+(calc.isBest?'+Opportunity':'')+' customers not in Top 5 (same pool, both scenarios)<br>';
  html+='&nbsp;&nbsp;· <strong>Grouped by customer name</strong> — all rows for the same customer are summed together<br>';
  html+='&nbsp;&nbsp;· <strong>Top 5</strong> = five largest customers by value (largest → smallest on chart) · <strong>Others</strong> = remaining customers combined<br><br>';

  html+='<strong>Orange — Churn / Downgrade (Top 5 + Others)</strong><br>';
  html+='&nbsp;&nbsp;· Type of contract ∈ <strong>'+churnTypes+'</strong><br>';
  html+='&nbsp;&nbsp;· Same live-calendar activation window as Won (current month → quarter-end) · shown as <strong>negative</strong><br>';
  html+='&nbsp;&nbsp;· Deals activating next quarter (e.g. Oct while still in Sep Q3) are <strong>excluded</strong><br>';
  html+='&nbsp;&nbsp;· Same Most Likely/Upside status rules and <strong>customer grouping</strong> as Needle Movers<br>';
  if(isFixed&&(calc.bridgePeriod==='qtg'||calc.bridgePeriod==='ytg'||calc.bridgePeriod==='ytd')){
    html+='&nbsp;&nbsp;· Fixed forward/YTD churn uses <strong>MRC only</strong> (no OTC), with aggregated revenue formula where applicable<br>';
  }
  html+='<br>';

  if(!calc.isForward){
    html+='<strong>Gray — Target</strong> — from Excel (see bridge type above)<br>';
    html+='<strong>Indigo — Net Forecast</strong> = Actuals + Won + Needle Movers + Churn<br>';
    html+='<strong>Green / Red — Growth / Gap</strong> vs target<br>';
  }else{
    html+='<strong>Indigo — Total Aggregated Revenue</strong> = Won + Needle Movers + Churn (no Excel actuals on this view)';
  }
  html+='</div>';

  if(calc.bridgePeriod==='qtg'||calc.bridgePeriod==='ytg'){
    html+='<div class="mq-info-section"><h4>Aggregated revenue detail</h4>';
    html+='Used on Fixed Won, in-flight, and churn when Quarter/Year to Go formula applies.<br>';
    html+='<code>(inclusive days from expected activation → period end) ÷ (days in activation month) × MRC</code>';
    if(calc.bridgePeriod==='qtg') html+=' + OTC on gross/Won side only.';
    else html+=' + OTC on gross/Won · period end = 31 Dec.';
    html+='</div>';
  }

  html+='<div class="mq-info-section"><h4>Drill-down</h4>';
  html+='① Click any bar → customer / account list (AM, AD, building, contract, calculation breakdown on Fixed forward)<br>';
  html+='② Click an account row → full pipeline row with all fields<br>';
  html+='③ Click the same bar again → close';
  html+='</div>';

  html+='<div class="mq-info-section"><h4>Color key</h4>';
  html+='<span style="color:'+MQ_CLR_ACTUALS+';">■</span> Green — Excel Actuals (QTD or YTD)<br>';
  html+='<span style="color:'+MQ_CLR_WON+';">■</span> Purple — Won (Opp. Status Won + expected activation)<br>';
  html+='<span style="color:'+MQ_CLR_INFLIGHT[0]+';">■</span> Blue — Needle Movers (grouped Top 5 + Others)<br>';
  html+='<span style="color:'+MQ_CLR_CHURN[0]+';">■</span> Orange — Churn / Downgrade (grouped Top 5 + Others)<br>';
  html+='<span style="color:'+MQ_CLR_NET+';">■</span> Indigo — Net Forecast / Total<br>';
  if(!calc.isForward){
    html+='<span style="color:'+MQ_CLR_TARGET+';">■</span> Gray — Target · ';
    html+='<span style="color:'+MQ_CLR_GROWTH+';">■</span> Green — Growth · ';
    html+='<span style="color:'+MQ_CLR_GAP+';">■</span> Red — Gap';
  }
  html+='</div>';

  html+='<div class="mq-info-section"><h4>Current selection</h4>';
  Object.keys(f).forEach(function(k){ html+='· <strong>'+k+':</strong> '+f[k]+'<br>'; });
  html+='· <strong>Scope:</strong> '+calc.vertical+'<br>';
  html+='· <strong>Metric:</strong> '+metric+'<br>';
  html+='· <strong>Scenario:</strong> '+(calc.isBest?'Upside (Proposed + Opportunity in-flight)':'Most Likely (Proposed only in-flight)');
  if(!calc.isForward){
    html+='<br>· <strong>Actuals bar:</strong> '+fmtLines(calc.actualsQtd);
    html+=' · <strong>Target:</strong> '+fmtLines(calc.target);
    html+=' · <strong>Net Forecast:</strong> '+fmtLines(calc.forecast);
  }else{
    html+='<br>· <strong>Total aggregated revenue:</strong> '+fmtLines(calc.forecast);
  }
  html+='</div>';

  if(calc.actualsByVertical&&calc.actualsByVertical.length){
    html+='<div class="mq-info-section"><h4>Excel actuals by vertical</h4>';
    calc.actualsByVertical.forEach(function(v){ html+='· '+v.name+': '+fmtLines(v.actualQtd)+'<br>'; });
    html+='</div>';
  }
  return html;
}
function mqVerticalBreakdown(bids,getVal){
  var m={};
  bids.forEach(function(b){
    var v=b.vertical&&b.vertical!=='—'?b.vertical:'(Blank)';
    m[v]=(m[v]||0)+getVal(b);
  });
  return Object.keys(m).sort().map(function(k){return {name:k,value:m[k]};});
}
function mqBidDetailLines(bids,max){
  var lines=[];
  var isForward=GLK_MQ_CALC_LAST&&GLK_MQ_CALC_LAST.isForward;
  (bids||[]).slice(0,max||12).forEach(function(b,i){
    var val=isForward?mqBidBridgeValue(b):mqBidMetric(b);
    var valLbl=isForward?(calcPeriodBridgeLabel()+' '+fmtLines(val)):fmtLines(val);
    lines.push((i+1)+'. '+(b.customerName||'—')+' · '+valLbl+' '+mqMetricShort().toLowerCase());
    if(isForward){
      var parts=mqBidBridgeValueParts(b);
      lines.push('   Aggregated Rev: '+fmtLines(parts.total)+' (MRC '+fmtLines(parts.mrc)+' + OTC '+fmtLines(parts.otc)+') · Activation: '+fmtDate(b.expectedActivation));
    }
    lines.push('   Vertical: '+(b.vertical||'—')+' · AD: '+(b.accountDirector||'—')+' · AM: '+(b.amName||'—'));
    lines.push('   Status: '+(b.status||'—')+' · Prob: '+(b.closureProb||'—')+' · Contract: '+(b.typeOfContract||'—'));
  });
  if((bids||[]).length>(max||12)) lines.push('… +'+(bids.length-(max||12))+' more');
  return lines;
}
function calcPeriodBridgeLabel(){
  return mqPeriodShortName(GLK_MQ_CALC_LAST&&GLK_MQ_CALC_LAST.bridgePeriod);
}
function mqRawOppStatus(bid){
  if(!bid||bid.oppStatus==null) return '';
  var s=String(bid.oppStatus).trim();
  return (s==='—'||s==='')?'':s;
}
function mqNormOppStatus(bid){
  return mqRawOppStatus(bid)||String(bid&&bid.status?bid.status:'').trim();
}
function mqIsWonOnlyBid(bid){
  var s=mqRawOppStatus(bid).toLowerCase();
  return s==='won'||s==='closed won';
}
function mqIsWonCandidate(bid){
  return mqIsWonOnlyBid(bid);
}
function mqIsBilledBid(bid){
  return mqRawOppStatus(bid).toLowerCase()==='billed';
}
function mqIsInflightGrossStatus(bid,isBest){
  var s=mqRawOppStatus(bid).toLowerCase();
  if(!s) s=String(bid.status||'').trim().toLowerCase();
  if(s==='won'||s==='closed won'||s==='billed'||s==='lost'||s==='cancelled'||s==='no bid') return false;
  if(isBest) return s==='proposed'||s==='opportunity';
  return s==='proposed';
}
function mqInitSpListEditUrl(cb){
  cb=cb||function(){};
  var safeList=SP_LIST.replace(/'/g,"''");
  spGet(SP_SITE+"/_api/web/lists/getbytitle('"+safeList+"')?$select=DefaultEditFormUrl,DefaultDisplayFormUrl",function(err,data){
    try{
      if(!err&&data&&data.d){
        if(data.d.DefaultEditFormUrl) SP_LIST_EDIT_FORM_BASE=String(data.d.DefaultEditFormUrl).split('?')[0];
        if(data.d.DefaultDisplayFormUrl) SP_LIST_VIEW_FORM_BASE=String(data.d.DefaultDisplayFormUrl).split('?')[0];
      }
    }catch(e){}
    cb();
  });
}
function mqBidEditUrl(bid){
  if(!bid||bid.id==null||bid.id==='') return '';
  if(SP_LIST_EDIT_FORM_BASE) return SP_LIST_EDIT_FORM_BASE+'?ID='+encodeURIComponent(bid.id);
  return SP_SITE+'/Lists/'+encodeURIComponent(SP_LIST)+'/EditForm.aspx?ID='+encodeURIComponent(bid.id);
}
function mqBidViewUrl(bid){
  if(!bid||bid.id==null||bid.id==='') return '';
  if(SP_LIST_VIEW_FORM_BASE) return SP_LIST_VIEW_FORM_BASE+'?ID='+encodeURIComponent(bid.id);
  if(SP_LIST_EDIT_FORM_BASE) return SP_LIST_EDIT_FORM_BASE.replace(/EditForm\.aspx/i,'DispForm.aspx')+'?ID='+encodeURIComponent(bid.id);
  return SP_SITE+'/Lists/'+encodeURIComponent(SP_LIST)+'/DispForm.aspx?ID='+encodeURIComponent(bid.id);
}
function mqBuildGklaBidRef(bid){
  if(!bid||bid.id==null||bid.id==='') return '';
  var v=(bid.vertical&&bid.vertical!=='—')?String(bid.vertical).trim().toUpperCase().replace(/[^A-Z0-9-]/g,''):'';
  if(!v) return '';
  var dt=mqParseBidDate(bid.created);
  if(dt){
    var pad=function(n,l){return String(n).padStart(l,'0');};
    var stamp=pad(dt.getDate(),2)+pad(dt.getMonth()+1,2)+dt.getFullYear()+pad(dt.getHours(),2)+pad(dt.getMinutes(),2)+pad(dt.getSeconds(),2);
    return 'GKLA/'+v+'/'+stamp+'/'+bid.id;
  }
  return 'GKLA/'+v+'/'+bid.id;
}
function mqBidRefPrimary(bid){
  if(!bid) return '';
  var ref=bid.bidRequest&&bid.bidRequest!=='—'?String(bid.bidRequest).trim():'';
  return ref;
}
function mqBidRefValue(bid){
  var ref=mqBidRefPrimary(bid);
  if(ref&&/GKLA\//i.test(ref)) return ref;
  var built=mqBuildGklaBidRef(bid);
  if(ref) return ref;
  if(built) return built;
  if(bid.myId&&bid.myId!=='—') return String(bid.myId).trim();
  if(bid.id!=null) return 'SP-'+bid.id;
  return '';
}
function mqSpEditUrl(bid){
  if(!bid||bid.id==null||bid.id==='') return '';
  return mqBidEditUrl(bid)||(SP_SITE+'/Lists/'+encodeURIComponent(SP_LIST)+'/EditForm.aspx?ID='+encodeURIComponent(bid.id));
}
function mqBuildBridgeAccountsHtml(rows,opts){
  opts=opts||{};
  var isChurn=!!opts.isChurn;
  if(!rows||!rows.length) return '<div style="color:var(--t3);font-style:italic;padding:.35rem 0;">No accounts.</div>';
  var sorted=rows.slice().sort(function(a,b){
    var ba=a.bid||a, bb=b.bid||b;
    var va=Math.abs(mqBidRowDetailValue(ba,isChurn?'decrease':'increase'));
    var vb=Math.abs(mqBidRowDetailValue(bb,isChurn?'decrease':'increase'));
    return vb-va;
  });
  var showPlacement=!!opts.showBridgePlacement||(sorted.length&&sorted[0]._placement);
  var h='';
  sorted.forEach(function(row,i){
    var bd=row.bid||row;
    var rowChurn=row._isChurn!=null?!!row._isChurn:isChurn;
    var val=row._value!=null?row._value:mqBidRowDetailValue(bd,rowChurn?'decrease':'increase');
    var spUrl=mqSpEditUrl(bd);
    h+='<div class="mq-acct-card">';
    h+='<div class="mq-acct-card-hdr">';
    h+='<h4>'+(i+1)+'. '+mqEscHtml(bd.customerName||'—')+' · <span style="color:'+(rowChurn?'#ef4444':'var(--acc)')+';">'+fmtLines(Math.abs(val))+' '+mqMetricShort()+'</span></h4>';
    h+=(spUrl?'<a class="mq-detail-open-form" href="'+spUrl+'" target="_blank" rel="noopener">Open in SharePoint ↗</a>':'<span style="color:var(--t3);font-size:.72rem;">No SP link</span>');
    h+='</div>';
    h+='<dl class="mq-acct-kv">';
    h+='<dt>Bid Reference</dt><dd class="mq-acct-ref">'+mqEscHtml(mqBidRefValue(bd)||'—')+'</dd>';
    h+='<dt>Customer Code</dt><dd>'+mqEscHtml(bd.customerCode&&bd.customerCode!=='—'?bd.customerCode:'—')+'</dd>';
    h+='<dt>Head Director</dt><dd>'+mqEscHtml(bd.headDirector&&bd.headDirector!=='(Blank)'?bd.headDirector:'—')+'</dd>';
    h+='<dt>Account Director</dt><dd>'+mqEscHtml(bd.accountDirector||'—')+'</dd>';
    h+='<dt>Account Manager</dt><dd>'+mqEscHtml(bd.amName||'—')+'</dd>';
    h+='<dt>Vertical</dt><dd>'+mqEscHtml(bd.vertical||'—')+'</dd>';
    h+='<dt>Opp Status</dt><dd><strong>'+mqEscHtml(mqRawOppStatus(bd)||'—')+'</strong></dd>';
    h+='<dt>Expected Activation</dt><dd>'+mqFmtBidDate(bd.expectedActivation)+' ('+mqActivationMonthLabel(bd.expectedActivation)+')</dd>';
    h+='<dt>Product</dt><dd>'+mqEscHtml((bd.productFamily||'—')+' · '+(bd.productCategory||'—')+' · '+(bd.services||'—'))+'</dd>';
    h+='<dt>Contract</dt><dd>'+mqEscHtml(bd.typeOfContract||'—')+' · '+mqEscHtml(bd.typeOfRequest||'—')+'</dd>';
    if(opts.showGroup&&row.groupLabel) h+='<dt>Customer Group</dt><dd>'+mqEscHtml(row.groupLabel)+'</dd>';
    if(showPlacement){
      h+='<dt>Bridge Placement</dt><dd><strong>'+mqEscHtml(row._placement||'—')+'</strong>'+(row._reason?('<div style="color:#b45309;font-size:.68rem;margin-top:.15rem;">'+mqEscHtml(row._reason)+'</div>'):'')+'</dd>';
    }
    h+='</dl>';
    h+='<details class="mq-acct-details"><summary>All pipeline fields</summary>';
    h+=mqBidDetailExpandHtml(bd);
    h+='</details></div>';
  });
  return h;
}
function mqBuildFlatBidTableHtml(rows,opts){ return mqBuildBridgeAccountsHtml(rows,opts); }
function mqFlatRowsFromGroups(groups){
  var out=[];
  (groups||[]).forEach(function(g){
    (g.bids||[]).forEach(function(bd){
      out.push({bid:bd,groupLabel:g.solo?null:(g.name||null),_isChurn:!!g._isChurn});
    });
  });
  return out;
}
function mqCollectOverdueActivations(){
  var today=mqDateOnly(new Date());
  var base=mqApplyBridgeBaseFilters();
  var levels=mqGetActiveReportLevels();
  if(levels.length) base=base.filter(function(b){ return mqBidMatchesReportLevels(b,levels); });
  return base.filter(function(b){
    var st=mqRawOppStatus(b).toLowerCase();
    if(st!=='proposed'&&st!=='opportunity') return false;
    if(!pgIsQtgGovernanceBid(b)) return false;
    var act=mqParseBidDate(b.expectedActivation);
    if(!act) return false;
    return act<today;
  }).sort(function(a,b){
    var da=mqParseBidDate(a.expectedActivation), db=mqParseBidDate(b.expectedActivation);
    return (da?da.getTime():0)-(db?db.getTime():0);
  });
}
function mqOverdueGridRows(overdue){
  return (overdue||[]).map(function(b){
    var val=mqBidRowDetailValue(b,'increase');
    return {
      spLink:mqBidEditUrl(b)||'',
      bidRef:mqBidRefValue(b),
      customerName:b.customerName||'—',
      customerCode:(b.customerCode&&b.customerCode!=='—')?b.customerCode:'—',
      headDirector:(b.headDirector&&b.headDirector!=='(Blank)')?b.headDirector:'—',
      accountDirector:b.accountDirector||'—',
      amName:b.amName||'—',
      vertical:b.vertical||'—',
      oppStatus:mqRawOppStatus(b)||'—',
      expectedActivation:mqFmtBidDate(b.expectedActivation),
      expectedMonth:mqActivationMonthLabel(b.expectedActivation),
      bridgeValue:Math.abs(val||0),
      productFamily:b.productFamily||'—',
      productCategory:b.productCategory||'—',
      contract:b.typeOfContract||'—'
    };
  });
}
function mqDestroyOverdueGrid(){
  if(MQ_OVERDUE_GRID_API){ try{ MQ_OVERDUE_GRID_API.destroy(); }catch(e){} MQ_OVERDUE_GRID_API=null; }
}
function mqDestroyBridgeDetailGrid(){
  if(MQ_BRIDGE_DETAIL_GRID_API){ try{ MQ_BRIDGE_DETAIL_GRID_API.destroy(); }catch(e){} MQ_BRIDGE_DETAIL_GRID_API=null; }
  MQ_EXPANDED_ROW_IDS={};
}
function mqDestroySearchGrid(){
  if(MQ_SEARCH_GRID_API){ try{ MQ_SEARCH_GRID_API.destroy(); }catch(e){} MQ_SEARCH_GRID_API=null; }
}
function mqBidDetailExpandHtml(bid){
  if(!bid) return '';
  var h='<div class="mq-grid-detail-expand" style="padding:.75rem .9rem;background:var(--bg-secondary);">';
  h+='<dl style="margin:0;display:grid;grid-template-columns:minmax(150px,24%) 1fr;gap:.35rem .75rem;font-size:.74rem;line-height:1.55;">';
  MQ_BID_DETAIL_FIELDS.forEach(function(fd){
    h+='<dt style="font-weight:800;color:var(--t3);margin:0;">'+mqEscHtml(fd.l)+'</dt>';
    h+='<dd style="margin:0;font-weight:600;color:var(--t1);">'+mqEscHtml(mqFormatBidField(bid,fd))+'</dd>';
  });
  h+='</dl></div>';
  return h;
}
function mqBidToBridgeGridRow(bid,extras){
  extras=extras||{};
  var isChurn=!!extras.isChurn;
  var val=extras.value!=null?extras.value:mqBidRowDetailValue(bid,isChurn?'decrease':'increase');
  return {
    _bid:bid,
    spLink:mqBidEditUrl(bid)||'',
    bidRef:mqBidRefValue(bid)||'—',
    customerName:bid.customerName||'—',
    customerCode:(bid.customerCode&&bid.customerCode!=='—')?bid.customerCode:'—',
    headDirector:(bid.headDirector&&bid.headDirector!=='(Blank)')?bid.headDirector:'—',
    accountDirector:bid.accountDirector||'—',
    amName:bid.amName||'—',
    vertical:bid.vertical||'—',
    oppStatus:mqRawOppStatus(bid)||'—',
    expectedActivation:mqFmtBidDate(bid.expectedActivation),
    expectedMonth:mqActivationMonthLabel(bid.expectedActivation),
    bridgeValue:Math.abs(val||0),
    productFamily:bid.productFamily||'—',
    productCategory:bid.productCategory||'—',
    contract:bid.typeOfContract||'—',
    customerGroup:extras.groupLabel||'—',
    bridgePlacement:extras._placement||'—',
    bridgeReason:extras._reason||''
  };
}
function mqGridRowsWithExpansions(baseRows){
  var out=[];
  (baseRows||[]).forEach(function(r,i){
    if(!r._rowId) r._rowId='r'+i;
    out.push(r);
    if(MQ_EXPANDED_ROW_IDS[r._rowId]){
      out.push({_isDetail:true,_bid:r._bid,_rowId:r._rowId+'_detail'});
    }
  });
  return out;
}
window.mqToggleGridRowExpand=function(rowId){
  if(!rowId) return;
  if(MQ_EXPANDED_ROW_IDS[rowId]) delete MQ_EXPANDED_ROW_IDS[rowId];
  else MQ_EXPANDED_ROW_IDS[rowId]=true;
  var base=window._MQ_DETAIL_GRID_ROWS||[];
  var rowData=mqGridRowsWithExpansions(base);
  if(MQ_BRIDGE_DETAIL_GRID_API) MQ_BRIDGE_DETAIL_GRID_API.setGridOption('rowData',rowData);
  if(MQ_SEARCH_GRID_API) MQ_SEARCH_GRID_API.setGridOption('rowData',rowData);
  if(MQ_OVERDUE_GRID_API) MQ_OVERDUE_GRID_API.setGridOption('rowData',rowData);
};
function mqBridgeDetailGridCols(opts){
  opts=opts||{};
  var cols=[
    {colId:'expand',headerName:'',width:48,pinned:'left',lockPosition:'left',suppressMovable:true,sortable:false,filter:false,cellRenderer:function(p){
      if(p.data&&p.data._isDetail) return '';
      var id=p.data._rowId;
      var open=!!MQ_EXPANDED_ROW_IDS[id];
      return '<button type="button" onclick="event.stopPropagation();mqToggleGridRowExpand(\''+id+'\')" title="Expand full pipeline row" style="border:1px solid var(--border);background:var(--bg-secondary);border-radius:5px;width:26px;height:26px;cursor:pointer;font-weight:800;color:var(--acc);">'+(open?'−':'+')+'</button>';
    }},
    {colId:'spLink',headerName:'SharePoint',width:105,pinned:'left',lockPosition:'left',suppressMovable:true,sortable:false,filter:false,cellRenderer:function(p){
      return p.value?'<a href="'+p.value+'" target="_blank" rel="noopener" style="color:var(--acc);font-weight:800;font-size:.68rem;">Open ↗</a>':'—';
    }},
    glkCol({field:'bidRef',headerName:'Bid Reference',width:210}),
    glkCol({field:'customerName',headerName:'Customer',width:170}),
    glkCol({field:'customerCode',headerName:'Customer Code',width:120}),
    glkCol({field:'headDirector',headerName:'Head Director',width:140}),
    glkCol({field:'accountDirector',headerName:'Account Director',width:140}),
    glkCol({field:'amName',headerName:'Account Manager',width:135}),
    glkCol({field:'vertical',headerName:'Vertical',width:110}),
    glkCol({field:'oppStatus',headerName:'Opp Status',width:120}),
    glkCol({field:'expectedActivation',headerName:'Expected Activation',width:145}),
    glkCol({field:'expectedMonth',headerName:'Activation Month',width:130}),
    glkCol({field:'bridgeValue',headerName:opts.valueLabel||mqMetricShort(),width:115,valueFormatter:function(p){ return fmtLines(p.value); }},'num'),
    glkCol({field:'productFamily',headerName:'Product Family',width:120}),
    glkCol({field:'productCategory',headerName:'Product Category',width:130}),
    glkCol({field:'contract',headerName:'Contract',width:120})
  ];
  if(opts.showGroup) cols.push(glkCol({field:'customerGroup',headerName:'Customer Group',width:150}));
  if(opts.showPlacement){
    cols.push(glkCol({field:'bridgePlacement',headerName:'Bridge Placement',width:160}));
    cols.push(glkCol({field:'bridgeReason',headerName:'Why excluded',width:200}));
  }
  return cols;
}
function mqBridgeGridOptions(rows,opts){
  opts=opts||{};
  window._MQ_DETAIL_GRID_ROWS=(rows||[]).slice();
  MQ_EXPANDED_ROW_IDS={};
  return {
    columnDefs:mqBridgeDetailGridCols(opts),
    rowData:mqGridRowsWithExpansions(window._MQ_DETAIL_GRID_ROWS),
    defaultColDef:{sortable:true,filter:GlkValueListFilter,resizable:true},
    suppressMenuHide:true,
    isFullWidthRow:function(p){ return !!(p.rowNode&&p.rowNode.data&&p.rowNode.data._isDetail); },
    fullWidthCellRenderer:function(p){
      var div=document.createElement('div');
      div.innerHTML=mqBidDetailExpandHtml(p.data._bid);
      return div;
    },
    getRowHeight:function(p){
      if(p.data&&p.data._isDetail) return 320;
      return 44;
    },
    pagination:true,paginationPageSize:50,paginationPageSizeSelector:[25,50,100,250],
    rowHeight:44,headerHeight:48,animateRows:true,enableCellTextSelection:true
  };
}
function mqRenderBridgeDetailGrid(gridEl,rows,opts){
  mqDestroyBridgeDetailGrid();
  if(!gridEl) return;
  if(typeof agGrid==='undefined'){
    gridEl.innerHTML='<div style="padding:1rem;color:var(--t3);">AG Grid not loaded.</div>';
    return;
  }
  if(!rows||!rows.length){
    gridEl.innerHTML='<div style="padding:.65rem;color:var(--t3);font-weight:600;">No accounts match the current filters.</div>';
    return;
  }
  gridEl.innerHTML='';
  gridEl.style.height=(opts&&opts.gridHeight)?opts.gridHeight:'min(55vh,520px)';
  gridEl.className='ag-theme-alpine';
  MQ_BRIDGE_DETAIL_GRID_API=agGrid.createGrid(gridEl,mqBridgeGridOptions(rows,opts));
}
function mqUpdateOverdueButtonCount(){
  var btn=el('mqOverdueToggleBtn');
  if(!btn) return;
  var n=mqCollectOverdueActivations().length;
  btn.textContent=(MQ_OVERDUE_OPEN?'Hide overdue activation':'Show overdue activation')+(n?' ('+n+')':'');
}
function mqToggleOverdueActivation(){
  MQ_OVERDUE_OPEN=!MQ_OVERDUE_OPEN;
  mqRenderOverdueActivationPanel();
}
function mqRenderOverdueActivationPanel(){
  var panel=el('mqOverdueActPanel');
  var btn=el('mqOverdueToggleBtn');
  var wrap=el('mqDetailOverdueWrap');
  var overdue=mqCollectOverdueActivations();
  mqUpdateOverdueButtonCount();
  if(wrap) wrap.style.display=(GLK_MQ_DETAIL_IDX>=0||el('mqBridgeSearchGridWrap')&&el('mqBridgeSearchGridWrap').style.display!=='none')?'block':'none';
  if(!panel) return;
  if(!MQ_OVERDUE_OPEN){
    panel.style.display='none';
    panel.innerHTML='';
    return;
  }
  var live=mqReportYearQuarter();
  var today=mqFmtBidDate(new Date().toISOString());
  var h='<div class="mq-overdue-panel-hdr">';
  h+='<strong>⚠ Overdue activation — Q'+live.quarter+' '+live.year+' · Proposed / Opportunity · expected date before '+today+' ('+overdue.length+')</strong>';
  h+='<span style="font-size:.7rem;color:var(--t3);font-weight:600;">Open SharePoint to update status or expected activation.</span>';
  h+='</div>';
  h+=(!overdue.length?'<div style="padding:.65rem;color:var(--t3);font-weight:600;">No overdue activations in the current bridge filters.</div>':mqBuildBridgeAccountsHtml(overdue.map(function(b){ return {bid:b}; }),{isChurn:false,showGroup:false}));
  panel.innerHTML=h;
  panel.style.display='block';
}
function glkInitBridgeEnterBlock(){
  if(window._GLK_BRIDGE_ENTER_INIT) return;
  window._GLK_BRIDGE_ENTER_INIT=true;
  document.addEventListener('keydown',function(e){
    if(e.key!=='Enter'&&e.keyCode!==13) return;
    var mqView=el('mobile-qtd-view');
    if(!mqView||mqView.style.display==='none') return;
    var t=e.target;
    if(!t||!(t.tagName==='INPUT'||t.tagName==='TEXTAREA'||t.tagName==='SELECT')) return;
    e.preventDefault();
    e.stopPropagation();
    if(t.id==='mqBridgeSearchInp') mqRunBridgeSearch();
    else if(t.id==='mqDetailSearchInp') mqDetailFilterChange();
  },true);
}
function mqBidRefChip(ref,full){
  if(!ref) return '—';
  var base='user-select:all;-webkit-user-select:all;font-family:ui-monospace,monospace;background:var(--bg-secondary);padding:.12rem .4rem;border-radius:4px;border:1px solid var(--border);font-size:.68rem;color:var(--t1);';
  var style=full?(base+'display:block;word-break:break-all;white-space:pre-wrap;margin-top:.15rem;'):base;
  return '<code class="mq-copy-ref" style="'+style+'">'+mqEscHtml(ref)+'</code>';
}
function mqBidRefCopyHtml(bid,full){
  var ref=mqBidRefValue(bid);
  var primary=mqBidRefPrimary(bid);
  var parts=[];
  if(ref){
    var lbl=primary?'Bid Reference':(bid.myId&&bid.myId!=='—'?'Reference (My ID)':'Reference (SharePoint ID)');
    parts.push('<div><span style="font-size:.72rem;color:var(--t3);">'+lbl+':</span>'+mqBidRefChip(ref,!!full)+'</div>');
  }else{
    parts.push('<div><span style="font-size:.72rem;color:var(--t3);">Reference:</span> <span style="color:var(--t3);">—</span></div>');
  }
  if(primary&&bid.myId&&bid.myId!=='—'&&String(bid.myId).trim()!==primary){
    parts.push('<div style="margin-top:.2rem;"><span style="font-size:.72rem;color:var(--t3);">My ID:</span> '+mqBidRefChip(String(bid.myId).trim(),!!full)+'</div>');
  }
  if(bid.id!=null){
    parts.push('<div style="margin-top:.2rem;"><span style="font-size:.72rem;color:var(--t3);">SharePoint record ID:</span> '+mqBidRefChip('SP-'+bid.id,false)+'</div>');
    var viewUrl=mqBidViewUrl(bid);
    if(viewUrl) parts.push('<a class="mq-detail-open-form" href="'+viewUrl+'" target="_blank" rel="noopener" onclick="event.stopPropagation();">Open in SharePoint ↗</a>');
  }
  if(bid.customerCode&&bid.customerCode!=='—'){
    parts.push('<div style="margin-top:.2rem;"><span style="font-size:.72rem;color:var(--t3);">Customer Code:</span> '+mqBidRefChip(String(bid.customerCode).trim(),false)+'</div>');
  }
  return parts.join('');
}
function mqClubbedRefsHtml(bids){
  return (bids||[]).map(function(bd,i){
    var ref=mqBidRefValue(bd);
    return ref?('<span style="margin-right:.35rem;">'+(i+1)+'. '+mqBidRefChip(ref,true)+'</span>'):'';
  }).filter(Boolean).join('');
}
function mqWonRejectReason(bid,year,quarter,getVal,activationFn){
  getVal=getVal||mqBidMetric;
  activationFn=activationFn||mqActivationQtdForward;
  if(!mqIsWonOnlyBid(bid)){
    var raw=mqRawOppStatus(bid);
    return 'Opportunity Status is "'+(raw||'—')+'" (need Won on SharePoint field — forecast category ignored)';
  }
  if(mqIsBilledBid(bid)) return 'Opportunity Status is Billed';
  if(!mqBidHasExpectedActivation(bid)) return 'Missing expected activation date';
  if(!mqContractInList(bid,MQ_GROSS_CONTRACT_TYPES)) return 'Contract type "'+(bid.typeOfContract||'—')+'" not in gross list ('+MQ_GROSS_CONTRACT_TYPES.join(', ')+')';
  if(!activationFn(bid)){
    var actReason=mqActivationRejectReason(bid);
    if(actReason) return actReason;
    var live=mqReportYearQuarter();
    return 'Expected activation outside window — need Q'+live.quarter+' '+live.year+', current month through quarter-end';
  }
  if(getVal(bid)<=0){
    if(mqProductFamily==='mobile'){
      return 'GA Lines is zero or blank (value='+num(bid.gaLines)+')';
    }
    return 'MRC is zero or blank';
  }
  return '';
}
function mqCollectGrossAddsWon(bids,year,quarter,getVal,activationFn){
  getVal=getVal||mqBidMetric;
  activationFn=activationFn||mqActivationQtdForward;
  var matched=[], excluded=[];
  (bids||[]).forEach(function(b){
    if(mqMatchesGrossAddsWon(b,year,quarter,getVal,activationFn)) matched.push(b);
    else if(mqIsWonCandidate(b)) excluded.push({bid:b,reason:mqWonRejectReason(b,year,quarter,getVal,activationFn)||'Excluded'});
  });
  return {matched:matched, excluded:excluded};
}
function mqDetailGroupsFromBar(b,isChurn){
  var getVal=function(bd){return mqBidRowDetailValue(bd,isChurn?'decrease':'increase');};
  if(b.section==='won'){
    var solo=(b.bids||[]).map(function(bd){
      return {name:bd.customerName||'—',value:getVal(bd),bids:[bd],solo:true};
    });
    return mqSortGroupsByValueDesc(solo);
  }
  var groups=mqGroupPoolByCustomer(b.bids||[],getVal);
  groups.forEach(function(g){g.bids=mqSortBidsByValueDesc(g.bids,isChurn);});
  return mqSortGroupsByValueDesc(groups);
}
function mqBidHasExpectedActivation(bid){
  return !!mqParseBidDate(bid.expectedActivation);
}
function mqMatchesGrossAddsWon(bid,year,quarter,getVal,activationFn){
  getVal=getVal||mqBidMetric;
  activationFn=activationFn||mqActivationQtdForward;
  return mqIsWonOnlyBid(bid)&&!mqIsBilledBid(bid)&&mqBidHasExpectedActivation(bid)&&
    mqContractInList(bid,MQ_GROSS_CONTRACT_TYPES)&&activationFn(bid)&&getVal(bid)>0;
}
function mqSortGroupsByValueDesc(groups){
  return groups.slice().sort(function(a,b){return Math.abs(b.value)-Math.abs(a.value);});
}
function mqSortBidsByValueDesc(bids,isChurn){
  return bids.slice().sort(function(a,b){
    var va=Math.abs(mqBidRowDetailValue(a,isChurn?'decrease':'increase'));
    var vb=Math.abs(mqBidRowDetailValue(b,isChurn?'decrease':'increase'));
    return vb-va;
  });
}
function mqBidRefLine(bid){
  var ref=mqBidRefValue(bid);
  var parts=[];
  if(ref) parts.push('Bid Ref: '+ref);
  if(bid.myId&&bid.myId!=='—'&&String(bid.myId).trim()!==ref) parts.push('My ID: '+bid.myId);
  if(bid.customerCode&&bid.customerCode!=='—') parts.push('Cust Code: '+bid.customerCode);
  return parts.length?parts.join(' · '):'—';
}
function mqGrossAdds100Detail(bids,year,quarter){
  var r=mqCollectGrossAddsWon(bids,year,quarter);
  return {
    total:r.matched.reduce(function(s,b){return s+mqBidMetric(b);},0),
    bids:mqSortBidsByValueDesc(r.matched,false),
    excluded:r.excluded
  };
}
function mqGrossAddsForwardDetail(bids,getVal,activationFn){
  var year=GLK_MQ_CALC_LAST?GLK_MQ_CALC_LAST.year:new Date().getFullYear();
  var quarter=GLK_MQ_CALC_LAST?GLK_MQ_CALC_LAST.quarter:Math.floor(new Date().getMonth()/3)+1;
  var r=mqCollectGrossAddsWon(bids,year,quarter,getVal,activationFn);
  return {
    total:r.matched.reduce(function(s,b){return s+getVal(b);},0),
    bids:mqSortBidsByValueDesc(r.matched,false),
    excluded:r.excluded
  };
}
function mqGroupPoolByCustomer(pool,getVal){
  var custMap={};
  (pool||[]).forEach(function(b){
    var k=b.customerName||'Unknown';
    if(!custMap[k]) custMap[k]={name:k,value:0,bids:[]};
    custMap[k].value+=getVal(b);
    custMap[k].bids.push(b);
  });
  return Object.keys(custMap).map(function(k){return custMap[k];});
}
function mqTopNAndOthers(topPool,othersPool,getVal,topN){
  var topGrouped=mqGroupPoolByCustomer(topPool,getVal);
  var ranked=topGrouped.filter(function(p){return p.value!==0;})
    .sort(function(a,b){return Math.abs(b.value)-Math.abs(a.value);}).slice(0,topN);
  var top=ranked.slice().sort(function(a,b){return Math.abs(b.value)-Math.abs(a.value);});
  var topNames={}; top.forEach(function(p){topNames[p.name]=true;});
  var othersGrouped=mqGroupPoolByCustomer(othersPool,getVal).filter(function(p){return !topNames[p.name];});
  var othersBids=[], othersSum=0;
  othersGrouped.forEach(function(g){
    othersSum+=g.value;
    othersBids=othersBids.concat(g.bids);
  });
  var topSum=top.reduce(function(s,p){return s+p.value;},0);
  return {top:top,others:othersSum,othersBids:othersBids,total:topSum+othersSum};
}
function mqInflightGrossPools(base,year,quarter,isBest,getVal,activationFn){
  getVal=getVal||mqBidMetric;
  activationFn=activationFn||mqActivationQtdForward;
  var common=function(b){
    return mqIsInflightGrossStatus(b,isBest)&&mqContractInList(b,MQ_GROSS_CONTRACT_TYPES)&&activationFn(b)&&getVal(b)>0;
  };
  var topPool,othersPool;
  if(isBest){
    topPool=base.filter(function(b){return common(b)&&(mqNormOppStatus(b)==='Proposed'||mqNormOppStatus(b)==='Opportunity');});
    othersPool=topPool.slice();
    return mqTopNAndOthers(topPool,othersPool,getVal,5);
  }
  topPool=base.filter(function(b){return common(b)&&mqNormOppStatus(b)==='Proposed';});
  othersPool=topPool.slice();
  return mqTopNAndOthers(topPool,othersPool,getVal,5);
}
function mqInflightChurnPools(base,year,quarter,isBest,getVal,activationFn){
  getVal=getVal||mqBidMetric;
  activationFn=activationFn||mqActivationQtdForward;
  var churnVal=function(b){
    var v=getVal(b);
    if(v<0) return v;
    if(v>0) return -v;
    return 0;
  };
  var common=function(b){
    return mqIsInflightGrossStatus(b,isBest)&&mqContractInList(b,MQ_CHURN_CONTRACT_TYPES)&&activationFn(b);
  };
  var hasChurn=function(b){ return churnVal(b)!==0; };
  var topPool,othersPool;
  if(isBest){
    topPool=base.filter(function(b){return common(b)&&hasChurn(b)&&(mqNormOppStatus(b)==='Proposed'||mqNormOppStatus(b)==='Opportunity');});
    othersPool=topPool.slice();
    return mqTopNAndOthers(topPool,othersPool,churnVal,5);
  }
  topPool=base.filter(function(b){return common(b)&&hasChurn(b)&&mqNormOppStatus(b)==='Proposed';});
  othersPool=topPool.slice();
  return mqTopNAndOthers(topPool,othersPool,churnVal,5);
}
function mqIsM2mService(bid){
  var s=String(bid&&bid.services||'').trim().toLowerCase();
  return s==='m2m'||/\bm2m\b/.test(s);
}
function mqNormProductCategory(v){
  return String(v||'').trim().toLowerCase();
}
function mqMobileProductBucket(bid){
  if(mqIsM2mService(bid)) return 'm2m';
  var cat=mqNormProductCategory(bid&&bid.productCategory);
  if(cat==='mpr') return 'mpr';
  if(cat==='corporate') return 'corporate';
  return null;
}
function mqProductBucketForBids(bids){
  var totals={mpr:0,corporate:0,m2m:0};
  (bids||[]).forEach(function(bd){
    var k=mqMobileProductBucket(bd);
    if(!k||totals[k]==null) return;
    totals[k]+=Math.abs(mqBidMetric(bd));
  });
  var best=null,bestV=0;
  ['mpr','corporate','m2m'].forEach(function(k){
    if(totals[k]>bestV){ bestV=totals[k]; best=k; }
  });
  return best?mqProductTableRowLabel(best):'';
}
function mqFilterBidsByProductBucket(bids,bucket){
  return (bids||[]).filter(function(b){ return mqMobileProductBucket(b)===bucket; });
}
function mqSumBucketQtg(baseBids,calc,bucket){
  var bids=mqFilterBidsByProductBucket(baseBids,bucket);
  var year=calc.year, quarter=calc.quarter, isBest=!!calc.isBest;
  var getVal=calc.bridgeGetVal||mqBidMetric;
  var getChurnVal=calc.bridgeGetChurnVal||mqBidMetric;
  var activationFn=calc.bridgeActivationFn||mqActivationQtdForward;
  var g100;
  if(calc.bridgePeriod==='qtg'||calc.bridgePeriod==='ytg'){
    g100=mqGrossAddsForwardDetail(bids,getVal,activationFn);
  }else{
    g100=mqGrossAdds100Detail(bids,year,quarter);
  }
  var grossPool=mqInflightGrossPools(bids,year,quarter,isBest,getVal,activationFn);
  var churnPool=mqInflightChurnPools(bids,year,quarter,isBest,getChurnVal,activationFn);
  var gross=(g100.total||0)+(grossPool.total||0);
  var churn=Math.abs(churnPool.total||0);
  return {gross:gross,churn:churn,net:gross-churn,won:g100.total||0,inflightGross:grossPool.total||0};
}
function mqBucketBidsForScope(baseBids,scope,bucket){
  if(bucket==='total'){
    return (baseBids||[]).filter(function(b){ return mqMobileProductBucket(b)!==null; });
  }
  return mqFilterBidsByProductBucket(baseBids,bucket);
}
function mqCollectBucketDetailBids(baseBids,calc,scope,bucket,metric){
  var bids=mqBucketBidsForScope(baseBids,scope,bucket);
  if(scope&&scope.levels&&scope.levels.length){
    bids=bids.filter(function(b){ return mqBidMatchesReportLevels(b,scope.levels); });
  }
  var year=calc.year, quarter=calc.quarter, isBest=!!calc.isBest;
  var getVal=calc.bridgeGetVal||mqBidMetric;
  var getChurnVal=calc.bridgeGetChurnVal||mqBidMetric;
  var activationFn=calc.bridgeActivationFn||mqActivationQtdForward;
  var g100=(calc.bridgePeriod==='qtg'||calc.bridgePeriod==='ytg')
    ?mqGrossAddsForwardDetail(bids,getVal,activationFn)
    :mqGrossAdds100Detail(bids,year,quarter);
  var grossPool=mqInflightGrossPools(bids,year,quarter,isBest,getVal,activationFn);
  var churnPool=mqInflightChurnPools(bids,year,quarter,isBest,getChurnVal,activationFn);
  var grossBids=g100.bids.slice();
  (grossPool.top||[]).forEach(function(p){ grossBids=grossBids.concat(p.bids||[]); });
  if(grossPool.othersBids) grossBids=grossBids.concat(grossPool.othersBids);
  var churnBids=[];
  (churnPool.top||[]).forEach(function(p){ churnBids=churnBids.concat(p.bids||[]); });
  if(churnPool.othersBids) churnBids=churnBids.concat(churnPool.othersBids);
  var seen={}, grossUnique=[], churnUnique=[];
  grossBids.forEach(function(b){
    var k=String(b.myId||'')+'|'+String(b.bidRequest||'');
    if(seen[k]) return;
    seen[k]=1; grossUnique.push(b);
  });
  seen={};
  churnBids.forEach(function(b){
    var k=String(b.myId||'')+'|'+String(b.bidRequest||'');
    if(seen[k]) return;
    seen[k]=1; churnUnique.push(b);
  });
  if(metric==='gross') return {grossBids:grossUnique,churnBids:[],excluded:g100.excluded||[]};
  if(metric==='churn') return {grossBids:[],churnBids:churnUnique,excluded:[]};
  return {grossBids:grossUnique,churnBids:churnUnique,excluded:g100.excluded||[]};
}
function mqProductTableMetricLabel(metric){
  if(metric==='gross') return 'Gross Add Lines QTG';
  if(metric==='churn') return 'Churn (Lines) QTG';
  return 'Net Add Lines QTG';
}
function mqProductTableRowLabel(bucket){
  if(bucket==='mpr') return 'MPR';
  if(bucket==='corporate') return 'Corporate';
  if(bucket==='m2m') return 'M2M';
  return 'Total';
}
function mqBuildDetailToolbarHtml(groups){
  var filtOpts=mqDetailFilterOptions(groups||[]);
  var h='<div class="mq-detail-toolbar">';
  h+='<input type="search" id="mqDetailSearchInp" placeholder="Search account, bid ref, vertical…" value="'+mqEscHtml(GLK_MQ_DETAIL_SEARCH)+'" oninput="mqDetailFilterChange()" style="flex:1;min-width:160px;">';
  h+='<select id="mqDetailStatusFlt" onchange="mqDetailFilterChange()"><option value="">All statuses</option>';
  filtOpts.statuses.forEach(function(s){
    h+='<option value="'+mqEscHtml(s)+'"'+(GLK_MQ_DETAIL_FILTER_STATUS===s?' selected':'')+'>'+mqEscHtml(s)+'</option>';
  });
  h+='</select>';
  h+='<select id="mqDetailVertFlt" onchange="mqDetailFilterChange()"><option value="">All verticals</option>';
  filtOpts.verts.forEach(function(v){
    h+='<option value="'+mqEscHtml(v)+'"'+(GLK_MQ_DETAIL_FILTER_VERT===v?' selected':'')+'>'+mqEscHtml(v)+'</option>';
  });
  h+='</select></div>';
  return h;
}
function mqBuildDetailAccountsListHtml(groups,barIdx,toggleFn,opts){
  opts=opts||{};
  if(!groups||!groups.length){
    return (opts.includeToolbar?mqBuildDetailToolbarHtml([]):'')+'<div style="color:var(--t3);font-style:italic;padding:.35rem 0;">No accounts match the current search/filters.</div>';
  }
  var filtered=mqFilterDetailGroups(groups);
  var totalBids=groups.reduce(function(n,g){return n+(g.bids||[]).length;},0);
  var flatRows=mqFlatRowsFromGroups(filtered);
  var isChurn=!!(groups[0]&&groups[0]._isChurn);
  var h=opts.includeToolbar!==false?mqBuildDetailToolbarHtml(groups):'';
  h+='<div style="margin:.35rem 0 .45rem;font-weight:700;font-size:.82rem;">Accounts ('+flatRows.length+' shown · '+totalBids+' total) — sorted largest to smallest</div>';
  if(!flatRows.length){
    h+='<div style="color:var(--t3);font-style:italic;padding:.35rem 0;">No accounts match the current search/filters.</div>';
    return h;
  }
  h+=mqBuildBridgeAccountsHtml(flatRows,{isChurn:isChurn,showGroup:true});
  return h;
}
function mqBuildProductTableDetailHtml(){
  var d=GLK_MQ_PT_DETAIL;
  if(!d||!GLK_MQ_CALC_LAST) return '';
  var calc=GLK_MQ_CALC_LAST;
  var tableData=d.tableData;
  var mini=mqMiniCalcFromBase(calc,tableData.scenarioKey==='best');
  var scopeMatch=mqGetVisibleProductTableScopes(calc).filter(function(s){return s.key===tableData.scopeKey;})[0];
  var scope={key:tableData.scopeKey,label:tableData.scope,levels:scopeMatch?scopeMatch.levels.slice():[]};
  if(tableData.scopeKey==='glk_overall') scope={key:'glk_overall',label:'GLK Overall',levels:[]};
  else if(!scope.levels.length) scope={key:tableData.scopeKey,label:tableData.scope,levels:[tableData.scope]};
  var base=mqApplyBridgeBaseFilters();
  var collected=mqCollectBucketDetailBids(base,mini,scope,d.bucket,d.metric);
  var title=tableData.scope+' · '+tableData.scenario+' · '+mqProductTableRowLabel(d.bucket)+' · '+mqProductTableMetricLabel(d.metric);
  var h='<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:.75rem;margin-bottom:.45rem;">';
  h+='<strong style="color:var(--acc);font-size:.78rem;">'+mqEscHtml(title)+'</strong>';
  h+='<button type="button" onclick="mqCloseProductTableDetail()" style="border:none;background:transparent;color:var(--t3);cursor:pointer;font-size:.85rem;padding:0 .25rem;">✕</button></div>';
  var allGroups=[];
  function collectGroups(sectionKey,bids,isChurn,sectionTitle){
    if(!bids||!bids.length) return '<div style="color:var(--t3);font-style:italic;margin:.35rem 0;">No '+mqEscHtml(sectionTitle)+' accounts for this row.</div>';
    var fakeBar={section:isChurn?'churn':'gross',type:isChurn?'decrease':'increase',bids:bids,value:bids.reduce(function(s,b){return s+Math.abs(mqBidRowDetailValue(b,isChurn?'decrease':'increase'));},0)};
    var groups=mqDetailGroupsFromBar(fakeBar,isChurn);
    groups.forEach(function(g){ g._isChurn=isChurn; g._sectionKey=sectionKey; });
    allGroups=allGroups.concat(groups);
    return '<div style="font-weight:800;font-size:.78rem;color:var(--t1);margin:.55rem 0 .35rem;">'+mqEscHtml(sectionTitle)+' ('+bids.length+' bids)</div>';
  }
  h+=mqBuildDetailToolbarHtml(allGroups);
  if(d.metric==='gross'){
    h+=collectGroups('gross',collected.grossBids,false,'Gross Adds (Won + Needle Movers)');
    if(collected.excluded&&collected.excluded.length){
      h+='<div class="mq-excluded-toggle" onclick="mqTogglePtWonExcluded()">'+(GLK_MQ_SHOW_WON_EXCLUDED?'▼':'▶')+' Won in pipeline but excluded from gross ('+collected.excluded.length+')</div>';
      h+='<div class="mq-excluded-body'+(GLK_MQ_SHOW_WON_EXCLUDED?' open':'')+'">';
      collected.excluded.forEach(function(x,i){
        h+='<div style="margin-bottom:.45rem;font-size:.78rem;"><strong>'+(i+1)+'. '+mqEscHtml(x.bid.customerName||'—')+'</strong> — '+mqEscHtml(x.reason)+'</div>';
      });
      h+='</div>';
    }
  }else if(d.metric==='churn'){
    h+=collectGroups('churn',collected.churnBids,true,'Churn / Downgrade');
  }else{
    h+=collectGroups('gross',collected.grossBids,false,'Gross Adds (Won + Needle Movers)');
    h+=collectGroups('churn',collected.churnBids,true,'Churn / Downgrade');
  }
  var flatRows=mqFlatRowsFromGroups(mqFilterDetailGroups(allGroups));
  h+='<div style="margin:.35rem 0 .45rem;font-weight:700;font-size:.82rem;">Accounts ('+flatRows.length+' shown)</div>';
  h+=mqBuildBridgeAccountsHtml(flatRows,{isChurn:!!(allGroups[0]&&allGroups[0]._isChurn),showGroup:true});
  h+='<div id="mqDetailOverdueWrap" style="display:block;margin-top:1rem;padding-top:.75rem;border-top:1px solid var(--border);">';
  h+='<button type="button" id="mqOverdueToggleBtn" class="reset-btn" onclick="mqToggleOverdueActivation()" style="font-size:.72rem;padding:.4rem .75rem;margin-bottom:.55rem;">Show overdue activation</button>';
  h+='<div id="mqOverdueActPanel" style="display:none;"></div></div>';
  return h;
}
window.mqTogglePtWonExcluded=function(){
  GLK_MQ_SHOW_WON_EXCLUDED=!GLK_MQ_SHOW_WON_EXCLUDED;
  mqRefreshProductTableDetailPanel();
};
window.mqOpenProductTableDetail=function(tableIdx,bucket,metric){
  var tableData=(GLK_MQ_PT_TABLES_VISIBLE||[])[tableIdx];
  if(!tableData||!bucket) return;
  if(!metric||metric==='wow') metric='net';
  var key=tableIdx+'|'+bucket+'|'+metric;
  if(GLK_MQ_PT_DETAIL&&GLK_MQ_PT_DETAIL.key===key){
    mqCloseProductTableDetail();
    return;
  }
  mqCloseBarDetail();
  GLK_MQ_PT_DETAIL={key:key,tableIdx:tableIdx,tableData:tableData,bucket:bucket,metric:metric};
  GLK_MQ_PT_DETAIL_GROUP_KEY='';
  GLK_MQ_PT_DETAIL_BID_IDX=-1;
  GLK_MQ_DETAIL_SEARCH='';
  GLK_MQ_DETAIL_FILTER_STATUS='';
  GLK_MQ_DETAIL_FILTER_VERT='';
  mqRefreshProductTableDetailPanel();
};
window.mqToggleProductTableDetailBid=function(sectionKey,groupIdx,bidIdx){
  groupIdx=groupIdx==null?0:groupIdx;
  bidIdx=bidIdx==null?-1:bidIdx;
  var gk=String(sectionKey||'main')+'|'+groupIdx;
  if(GLK_MQ_PT_DETAIL_GROUP_KEY!==gk){
    GLK_MQ_PT_DETAIL_GROUP_KEY=gk;
    GLK_MQ_PT_DETAIL_BID_IDX=bidIdx;
  }else if(bidIdx<0){
    GLK_MQ_PT_DETAIL_GROUP_KEY=(GLK_MQ_PT_DETAIL_GROUP_KEY===gk?'':gk);
    GLK_MQ_PT_DETAIL_BID_IDX=-1;
  }else{
    GLK_MQ_PT_DETAIL_BID_IDX=(GLK_MQ_PT_DETAIL_BID_IDX===bidIdx?-1:bidIdx);
  }
  mqRefreshProductTableDetailPanel();
};
function mqRefreshProductTableDetailPanel(){
  var p=el('mqBarDetailPanel');
  if(!p||!GLK_MQ_PT_DETAIL) return;
  p.style.display='block';
  p.innerHTML=mqBuildProductTableDetailHtml();
  mqUpdateOverdueButtonCount();
  if(MQ_OVERDUE_OPEN) mqRenderOverdueActivationPanel();
  mqHighlightProductTableSelection();
  try{ p.scrollIntoView({behavior:'smooth',block:'nearest'}); }catch(e){}
}
window.mqCloseProductTableDetail=function(){
  GLK_MQ_PT_DETAIL=null;
  GLK_MQ_PT_DETAIL_GROUP_KEY='';
  GLK_MQ_PT_DETAIL_BID_IDX=-1;
  mqHighlightProductTableSelection();
  if(GLK_MQ_DETAIL_IDX<0){
    var p=el('mqBarDetailPanel'); if(p) p.style.display='none';
  }
};
function mqHighlightProductTableSelection(){
  document.querySelectorAll('.mq-product-table tr.mq-pt-row-sel').forEach(function(tr){ tr.classList.remove('mq-pt-row-sel'); });
  if(!GLK_MQ_PT_DETAIL) return;
  var d=GLK_MQ_PT_DETAIL;
  var cards=document.querySelectorAll('.mq-product-table-card');
  var card=cards[d.tableIdx];
  if(!card) return;
  var rows=card.querySelectorAll('tbody tr');
  rows.forEach(function(tr){
    var prod=tr.querySelector('td');
    if(!prod) return;
    var label=prod.textContent.trim().toLowerCase();
    var bucket=label.indexOf('total')>=0?'total':label.indexOf('mpr')>=0?'mpr':label.indexOf('corporate')>=0?'corporate':label.indexOf('m2m')>=0?'m2m':'';
    if(bucket===d.bucket) tr.classList.add('mq-pt-row-sel');
  });
}
function mqScenarioKeyFromLabel(lbl){
  var s=String(lbl||'').trim().toLowerCase();
  if(!s) return null;
  if(s.indexOf('upside')>=0) return 'best';
  if(s.indexOf('most likely')>=0||s.indexOf('likely')>=0) return 'worst';
  return null;
}
function mqParseProductTableRows(rows){
  if(!rows||!rows.length) return null;
  var headerRow=-1, colMap={};
  for(var r=0;r<Math.min(rows.length,30);r++){
    var row=rows[r]||[];
    var map={};
    for(var c=0;c<row.length;c++){
      var h=String(row[c]||'').trim().toLowerCase();
      if(!h) continue;
      if(h==='product'||h.indexOf('product')===0) map.product=c;
      if(h.indexOf('gross')>=0&&h.indexOf('qtg')>=0) map.gross=c;
      if(h.indexOf('churn')>=0&&h.indexOf('qtg')>=0) map.churn=c;
      if(h.indexOf('net add')>=0&&h.indexOf('qtg')>=0) map.net=c;
      if(h.indexOf('wow')>=0) map.wow=c;
    }
    if(map.product!=null&&map.net!=null){ headerRow=r; colMap=map; break; }
  }
  if(headerRow<0) return null;
  var out={};
  var keys={mpr:'mpr',corporate:'corporate',m2m:'m2m',total:'total'};
  for(var ri=headerRow+1;ri<rows.length;ri++){
    var row=rows[ri]||[];
    var prod=String(row[colMap.product]||'').trim().toLowerCase();
    if(!prod) continue;
    var key=keys[prod]||(prod.indexOf('total')>=0?'total':null);
    if(!key) continue;
    out[key]={
      gross:colMap.gross!=null?num(row[colMap.gross]):null,
      churn:colMap.churn!=null?num(row[colMap.churn]):null,
      net:colMap.net!=null?num(row[colMap.net]):null,
      wow:colMap.wow!=null?String(row[colMap.wow]||'').trim():null
    };
  }
  return Object.keys(out).length?out:null;
}
function glkParseMobileProductExportInfo(rows){
  if(!rows||!rows.length) return {};
  var info={};
  for(var r=0;r<Math.min(rows.length,40);r++){
    var row=rows[r]||[];
    for(var c=0;c<row.length-1;c++){
      var k=String(row[c]||'').trim().toLowerCase();
      var v=row[c+1];
      if(!k) continue;
      if(k.indexOf('export date')>=0||k.indexOf('snapshot date')>=0) info.snapshotDate=String(v||'').trim();
      if(k.indexOf('scenario')>=0) info.scenario=String(v||'').trim();
      if(k.indexOf('scope')>=0) info.scope=String(v||'').trim();
      if(k.indexOf('period')>=0) info.period=String(v||'').trim();
      if(k.indexOf('quarter')>=0) info.quarter=String(v||'').trim();
    }
  }
  return info;
}
function glkFindWorkbookSheet(wb,patterns){
  if(!wb||!wb.SheetNames) return null;
  var names=wb.SheetNames;
  for(var i=0;i<patterns.length;i++){
    var p=patterns[i];
    if(typeof p==='string'){
      if(wb.Sheets[p]) return {name:p,sheet:wb.Sheets[p]};
      var ex=names.find(function(n){return n.trim()===p.trim();});
      if(ex) return {name:ex,sheet:wb.Sheets[ex]};
    }else if(p instanceof RegExp){
      var fu=names.find(function(n){return p.test(n);});
      if(fu) return {name:fu,sheet:wb.Sheets[fu]};
    }
  }
  return null;
}
function mqNormScopeKey(label){
  var s=String(label||'GLK Overall').trim();
  if(!s||/^glk\s*overall$/i.test(s)) return 'glk_overall';
  return s.toLowerCase().replace(/[^a-z0-9]+/g,'_');
}
function mqWowPriorKey(scopeLabel,scenarioKey){
  return mqNormScopeKey(scopeLabel)+'::'+(scenarioKey==='best'?'best':'worst');
}
function mqLoadWowPriorStore(){
  try{ return JSON.parse(localStorage.getItem(MQ_WOW_PRIOR_LS_KEY)||'{}'); }catch(e){ return {}; }
}
function mqInitWowPriorStore(){
  GLK_MOBILE_PRODUCT_WOW_PRIOR=mqLoadWowPriorStore();
}
function mqSaveWowPriorEntry(scopeLabel,scenarioKey,table,info){
  if(!table) return;
  var store=mqLoadWowPriorStore();
  store[mqWowPriorKey(scopeLabel,scenarioKey)]={
    table:table,
    info:Object.assign({},info||{},{
      scope:scopeLabel||info&&info.scope||'GLK Overall',
      scenario:mqCaseDisplayName(scenarioKey),
      uploadedAt:new Date().toISOString()
    }),
    uploadedAt:new Date().toISOString()
  };
  try{ localStorage.setItem(MQ_WOW_PRIOR_LS_KEY,JSON.stringify(store)); }catch(e){ console.warn('[GLK] WoW prior save failed:',e.message); }
  GLK_MOBILE_PRODUCT_WOW_PRIOR=store;
}
function mqGetWowPrior(scopeLabel,scenarioKey){
  var store=GLK_MOBILE_PRODUCT_WOW_PRIOR||mqLoadWowPriorStore();
  return store[mqWowPriorKey(scopeLabel,scenarioKey)]||null;
}
function glkParseMobileProductWowWorkbook(wb,fallbackScope,fallbackScenario){
  if(!wb) return {};
  var out={};
  function ingestSheet(rows,sn,forcedScope,forcedScenario){
    if(!rows||!rows.length) return;
    var info=glkParseMobileProductExportInfo(rows);
    var table=mqParseProductTableRows(rows);
    if(!table) return;
    var scope=forcedScope||info.scope||info.Scope||'GLK Overall';
    var sk=forcedScenario||mqScenarioKeyFromLabel(info.scenario)||(sn&&sn.toLowerCase().indexOf('upside')>=0?'best':(sn&&sn.toLowerCase().indexOf('likely')>=0?'worst':null));
    if(!sk) sk='worst';
    out[mqWowPriorKey(scope,sk)]={table:table,info:Object.assign({},info,{scope:scope,scenario:mqCaseDisplayName(sk),sheetName:sn||''}),uploadedAt:new Date().toISOString()};
  }
  wb.SheetNames.forEach(function(sn){
    if(/export info/i.test(sn)) return;
    ingestSheet(glkSheetToRows(wb.Sheets[sn]),sn,null,null);
  });
  if(!Object.keys(out).length){
    var any=glkFindWorkbookSheet(wb,[/mobile.*qtg/i,/mobile.*product/i,/.+/]);
    if(any){
      ingestSheet(glkSheetToRows(any.sheet),any.name,fallbackScope||'GLK Overall',fallbackScenario||'worst');
    }
  }
  return out;
}
function mqParseWowPriorFile(arrayBuffer,fallbackScope,fallbackScenario,cb){
  cb=cb||function(){};
  try{
    var wb=XLSX.read(arrayBuffer,{type:'array',cellDates:true,cellNF:true});
    var parsed=glkParseMobileProductWowWorkbook(wb,fallbackScope,fallbackScenario);
    if(!Object.keys(parsed).length) return cb(new Error('Could not find a Mobile Net Add Lines QTG table in that file. Export from this dashboard first.'));
    cb(null,parsed);
  }catch(e){ cb(e); }
}
function mqApplyWowPriorParsed(parsed){
  var store=mqLoadWowPriorStore();
  Object.keys(parsed||{}).forEach(function(k){ store[k]=parsed[k]; });
  try{ localStorage.setItem(MQ_WOW_PRIOR_LS_KEY,JSON.stringify(store)); }catch(e){}
  GLK_MOBILE_PRODUCT_WOW_PRIOR=store;
}
window.mqTriggerWowPriorUpload=function(scopeLabel,scenarioKey){
  var inp=el('mqWowPriorInp'); if(!inp) return;
  inp.onchange=function(){
    var file=inp.files&&inp.files[0];
    inp.value='';
    if(!file) return;
    mqUploadWowPriorFile(file,scopeLabel,scenarioKey);
  };
  inp.click();
};
window.mqTriggerWowPriorBulkUpload=function(){
  var inp=el('mqWowPriorBulkInp'); if(!inp) return;
  inp.onchange=function(){
    var file=inp.files&&inp.files[0];
    inp.value='';
    if(!file) return;
    mqUploadWowPriorFile(file,null,null);
  };
  inp.click();
};
window.mqUploadWowPriorFile=function(file,fallbackScope,fallbackScenario){
  if(!file) return;
  if(typeof XLSX==='undefined'){ alert('Excel parser not loaded. Refresh the page.'); return; }
  var reader=new FileReader();
  reader.onload=function(e){
    mqParseWowPriorFile(e.target.result,fallbackScope,fallbackScenario,function(err,parsed){
      if(err){ alert(err.message); return; }
      mqApplyWowPriorParsed(parsed);
      if(GLK_MQ_CALC_LAST) mqRenderMobileProductTable(GLK_MQ_CALC_LAST);
      var n=Object.keys(parsed).length;
      alert('Prior week loaded for '+n+' table'+(n===1?'':'s')+'. WoW % updated.');
    });
  };
  reader.onerror=function(){ alert('Could not read file.'); };
  reader.readAsArrayBuffer(file);
};
window.mqToggleProductTableInfo=function(){
  var p=el('mqProductTableInfoPanel');
  if(!p) return;
  p.classList.toggle('open');
};
function mqGetProductTableScopes(report){
  var scopes=[{key:'glk_overall',label:'GLK Overall',levels:[]}];
  (report&&report.verticals||[]).forEach(function(v){
    if(!v||!v.name) return;
    scopes.push({key:mqNormScopeKey(v.name),label:v.name,levels:[v.name]});
  });
  return scopes;
}
function mqMiniCalcFromBase(calc,isBest){
  return {
    year:calc.year,quarter:calc.quarter,isBest:!!isBest,isForward:!!calc.isForward,
    bridgePeriod:calc.bridgePeriod,
    bridgeGetVal:calc.bridgeGetVal,bridgeGetChurnVal:calc.bridgeGetChurnVal,bridgeActivationFn:calc.bridgeActivationFn
  };
}
function mqApplyWowToRows(rows,scopeLabel,scenarioKey){
  var priorEntry=mqGetWowPrior(scopeLabel,scenarioKey);
  var priorTable=priorEntry&&priorEntry.table;
  rows.forEach(function(r){
    var p=priorTable&&priorTable[r.key];
    r.priorNet=p&&p.net!=null&&!isNaN(p.net)?num(p.net):null;
    if(r.priorNet!=null&&r.priorNet!==0){
      r.wowPct=((r.net-r.priorNet)/Math.abs(r.priorNet))*100;
    }else{
      r.wowPct=null;
    }
  });
  return priorEntry;
}
function mqCalcMobileProductTableForScope(calc,scope,isBest){
  if(!calc||mqProductFamily!=='mobile') return null;
  var base=mqApplyBridgeBaseFilters();
  if(scope&&scope.levels&&scope.levels.length){
    base=base.filter(function(b){return mqBidMatchesReportLevels(b,scope.levels);});
  }
  var mini=mqMiniCalcFromBase(calc,isBest);
  var rows=['mpr','corporate','m2m'].map(function(key){
    var label=key==='mpr'?'MPR':(key==='corporate'?'Corporate':'M2M');
    var m=mqSumBucketQtg(base,mini,key);
    return {key:key,label:label,gross:m.gross,churn:m.churn,net:m.net};
  });
  var total=rows.reduce(function(acc,r){
    acc.gross+=r.gross; acc.churn+=r.churn; acc.net+=r.net; return acc;
  },{key:'total',label:'Total',gross:0,churn:0,net:0});
  rows.push(total);
  var sk=isBest?'best':'worst';
  var priorEntry=mqApplyWowToRows(rows,scope.label,sk);
  return {
    rows:rows,
    scenario:mqCaseDisplayName(sk),
    scenarioKey:sk,
    period:mqPeriodLongName(calc.bridgePeriod||mqPeriod),
    scope:scope.label,
    scopeKey:scope.key,
    quarter:calc.quarter&&calc.year?('Q'+calc.quarter+' '+calc.year):'',
    priorInfo:priorEntry?priorEntry.info:null,
    priorUploadedAt:priorEntry?priorEntry.uploadedAt:null
  };
}
function mqGetVisibleProductTableScopes(calc){
  var levels=calc&&calc.activeReportLevels&&calc.activeReportLevels.length?calc.activeReportLevels.slice():[];
  if(!levels.length) return [{key:'glk_overall',label:'GLK Overall',levels:[]}];
  if(levels.length===1) return [{key:mqNormScopeKey(levels[0]),label:levels[0],levels:[levels[0]]}];
  var label=(calc&&calc.vertical)?calc.vertical:(levels.length+' verticals');
  return [{key:mqNormScopeKey(label),label:label,levels:levels.slice()}];
}
function mqCalcAllMobileProductTables(calc){
  if(!calc||mqProductFamily!=='mobile'||calc.isForward) return [];
  var report=calc.report||mqGetActiveReport();
  var scopes=mqGetProductTableScopes(report);
  var tables=[];
  scopes.forEach(function(scope){
    tables.push(mqCalcMobileProductTableForScope(calc,scope,false));
    tables.push(mqCalcMobileProductTableForScope(calc,scope,true));
  });
  return tables.filter(function(t){return t&&t.rows&&t.rows.length;});
}
function mqCalcVisibleMobileProductTables(calc){
  if(!calc||mqProductFamily!=='mobile'||calc.isForward) return [];
  var scopes=mqGetVisibleProductTableScopes(calc);
  var isBest=!!calc.isBest;
  return scopes.map(function(scope){
    return mqCalcMobileProductTableForScope(calc,scope,isBest);
  }).filter(function(t){return t&&t.rows&&t.rows.length;});
}
function mqCalcMobileProductTable(calc){
  var visible=mqCalcVisibleMobileProductTables(calc);
  return visible.length?visible[0]:null;
}
function mqFmtProductLines(v){
  if(v==null||isNaN(v)) return '—';
  return fmtLines(Math.round(num(v)));
}
function mqFmtWowCell(row){
  if(row.wowPct==null||isNaN(row.wowPct)) return '<span class="mq-wow-neu">—</span>';
  var cls=row.wowPct>0?'mq-wow-up':row.wowPct<0?'mq-wow-down':'mq-wow-neu';
  var arrow=row.wowPct>0?'▲':row.wowPct<0?'▼':'';
  return '<span class="'+cls+'">'+arrow+' '+Math.abs(row.wowPct).toFixed(0)+'%</span>';
}
function mqFmtWowStatus(data){
  if(data.priorUploadedAt||data.priorInfo){
    var dt=data.priorInfo&&data.priorInfo.snapshotDate?data.priorInfo.snapshotDate:(data.priorUploadedAt?new Date(data.priorUploadedAt).toLocaleDateString('en-GB'):'prior week');
    return {loaded:true,text:'WoW vs '+dt};
  }
  return {loaded:false,text:'No prior week loaded'};
}
function mqRenderProductTableCardHtml(data,tableIdx){
  if(!data||!data.rows||!data.rows.length) return '';
  var wow=mqFmtWowStatus(data);
  var scCls=data.scenarioKey==='best'?'up':'ml';
  var ti=tableIdx==null?0:tableIdx;
  var h='<div class="mq-product-table-card" data-scope="'+mqEscHtml(data.scopeKey||'')+'" data-scenario="'+mqEscHtml(data.scenarioKey||'')+'">';
  h+='<div class="mq-pt-card-head"><span class="mq-pt-scope-badge">'+mqEscHtml(data.scope)+'</span>';
  h+='<span class="mq-pt-scenario '+scCls+'">'+mqEscHtml(data.scenario)+'</span></div>';
  h+='<table class="mq-product-table"><thead><tr>';
  h+='<th class="mq-pt-h-prod">Product</th><th class="mq-pt-h-gross">Gross Add Lines QTG</th><th class="mq-pt-h-churn">Churn (Lines) QTG</th><th class="mq-pt-h-net">Net Add Lines QTG</th><th class="mq-pt-h-wow">WoW</th>';
  h+='</tr></thead><tbody>';
  data.rows.forEach(function(r){
    var trCls=r.key==='total'?' mq-product-total':'';
    var bk=r.key;
    h+='<tr class="'+trCls.trim()+'" data-bucket="'+bk+'">';
    h+='<td class="mq-pt-drill" onclick="mqOpenProductTableDetail('+ti+',\''+bk+'\',\'net\')" title="Click for account breakdown">'+mqEscHtml(r.label)+'</td>';
    h+='<td class="mq-pt-gross mq-pt-drill" onclick="mqOpenProductTableDetail('+ti+',\''+bk+'\',\'gross\')" title="Click for gross accounts">'+mqFmtProductLines(r.gross)+'</td>';
    h+='<td class="mq-pt-churn mq-pt-drill" onclick="mqOpenProductTableDetail('+ti+',\''+bk+'\',\'churn\')" title="Click for churn accounts">'+mqFmtProductLines(r.churn)+'</td>';
    h+='<td class="mq-pt-net mq-pt-drill" onclick="mqOpenProductTableDetail('+ti+',\''+bk+'\',\'net\')" title="Click for full breakdown">'+mqFmtProductLines(r.net)+'</td>';
    h+='<td>'+mqFmtWowCell(r)+'</td></tr>';
  });
  h+='</tbody></table>';
  h+='<div class="mq-pt-card-foot">';
  h+='<span class="mq-pt-wow-status'+(wow.loaded?' loaded':'')+'">'+mqEscHtml(wow.text)+'</span>';
  h+='<button type="button" class="mq-pt-upload-btn" onclick="mqTriggerWowPriorUpload(\''+String(data.scope).replace(/'/g,"\\'")+'\',\''+data.scenarioKey+'\')">↑ Upload prior week</button>';
  h+='</div></div>';
  return h;
}
function mqBuildProductTableInfoHtml(calc){
  var period=calc?mqPeriodLongName(calc.bridgePeriod||mqPeriod):'QTD';
  return '<strong>What you see</strong><br>'+
    'One table for your current <strong>Report level</strong> and <strong>Scenario</strong> (Most Likely / Upside). Change those filters — the table updates.<br><br>'+
    '<strong>Export vs display</strong><br>'+
    '<strong>Export All Tables</strong> always downloads every scope × both scenarios (for WoW archiving). Display only shows what you have filtered.<br><br>'+
    '<strong>WoW (Week-on-Week)</strong><br>'+
    '1. Export All Tables and save the file.<br>'+
    '2. Next week use <strong>Upload prior week</strong> — loads all scopes/scenarios from that file regardless of your current filter.<br>'+
    '3. WoW is independent of the GLK report upload.<br><br>'+
    '<strong>Row rules</strong> · MPR = Product Category MPR (excl. M2M) · Corporate = Corporate (excl. M2M) · M2M = Services M2M · Period: '+mqEscHtml(period)+'<br><br>'+
    '<strong>Drill-down</strong> · Click any product row or Gross / Churn / Net cell — same account list + search as the bridge chart.';
}
function mqRenderMobileProductTable(calc){
  var wrap=el('mqMobileProductTableWrap');
  var xBtn=el('mqProductTableXlsxBtn');
  if(!wrap) return;
  if(mqProductFamily!=='mobile'||!calc||calc.isForward){
    wrap.style.display='none';
    wrap.innerHTML='';
    GLK_MOBILE_PRODUCT_TABLES_ALL=[];
    GLK_MOBILE_PRODUCT_TABLE_LAST=null;
    if(xBtn) xBtn.style.display='none';
    return;
  }
  mqInitWowPriorStore();
  GLK_MOBILE_PRODUCT_TABLES_ALL=mqCalcAllMobileProductTables(calc);
  var visible=mqCalcVisibleMobileProductTables(calc);
  if(!visible.length){
    wrap.style.display='none';
    wrap.innerHTML='';
    GLK_MOBILE_PRODUCT_TABLE_LAST=null;
    if(xBtn) xBtn.style.display='none';
    return;
  }
  GLK_MQ_PT_TABLES_VISIBLE=visible;
  GLK_MOBILE_PRODUCT_TABLE_LAST=visible[0];
  var prevPt=GLK_MQ_PT_DETAIL;
  wrap.style.display='block';
  if(xBtn) xBtn.style.display='inline-flex';
  var scopeLbl=calc.vertical||'GLK Overall';
  var scLbl=mqCaseDisplayName(calc.isBest?'best':'worst');
  var h='<div class="mq-product-tables-section">';
  h+='<div class="mq-pt-section-head">';
  h+='<div><div class="mq-pt-section-title"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>';
  h+='Mobile Net Add Lines QTG <button type="button" class="mq-pt-info-btn" onclick="mqToggleProductTableInfo()" title="Table rules &amp; WoW workflow">i</button></div>';
  h+='<div class="mq-pt-section-sub">'+mqEscHtml(mqPeriodLongName(calc.bridgePeriod||mqPeriod))+(calc.quarter&&calc.year?(' · Q'+calc.quarter+' '+calc.year):'')+' · '+mqEscHtml(scopeLbl)+' · '+mqEscHtml(scLbl)+'</div></div>';
  h+='<div class="mq-pt-section-actions">';
  h+='<button type="button" class="mq-pt-bulk-btn" onclick="mqTriggerWowPriorBulkUpload()">↑ Upload prior week</button>';
  h+='</div></div>';
  h+='<div id="mqProductTableInfoPanel" class="mq-pt-info-panel">'+mqBuildProductTableInfoHtml(calc)+'</div>';
  h+='<div class="mq-product-tables-grid'+(visible.length===1?' mq-product-tables-single':'')+'">';
  visible.forEach(function(data,i){ h+=mqRenderProductTableCardHtml(data,i); });
  h+='</div>';
  h+='</div>';
  wrap.innerHTML=h;
  if(prevPt){
    var still=visible[prevPt.tableIdx];
    if(still&&still.scopeKey===prevPt.tableData.scopeKey&&still.scenarioKey===prevPt.tableData.scenarioKey){
      GLK_MQ_PT_DETAIL=Object.assign({},prevPt,{tableData:still,tableIdx:prevPt.tableIdx});
      mqRefreshProductTableDetailPanel();
    }else{
      mqCloseProductTableDetail();
    }
  }
}
let GLK_MOBILE_PRODUCT_TABLE_LAST=null;
function mqExportFileNameBase(calc){
  calc=calc||GLK_MQ_CALC_LAST||{};
  var scope=String(calc.vertical||'GLK_Overall').replace(/[^\w\s-]+/g,'').trim().replace(/\s+/g,'_')||'GLK_Overall';
  var dt=new Date().toISOString().slice(0,10);
  var sc=mqCaseDisplayName(calc.isBest?'best':'worst').replace(/\s+/g,'');
  return {scope:scope,dt:dt,sc:sc};
}
function mqThemeAccentHex(){
  try{
    var c=getComputedStyle(document.documentElement).getPropertyValue('--acc').trim();
    if(c&&c.charAt(0)==='#') return c.replace('#','');
  }catch(e){}
  return 'A855F7';
}
function mqBuildMobileProductExportSheet(data){
  data=data||GLK_MOBILE_PRODUCT_TABLE_LAST;
  if(!data) return null;
  var filters=mqGetSelectedFilterLabels();
  var aoa=[
    ['Field','Value'],
    ['Export Date',new Date().toISOString().slice(0,10)],
    ['Scenario',data.scenario||mqCaseDisplayName()],
    ['Period',data.period||mqPeriodLongName(mqPeriod)],
    ['Quarter',data.quarter||''],
    ['Scope',data.scope||filters['Report level']||'GLK Overall'],
    ['Head Director',filters['Head director']||'All'],
    ['Product Family','Mobile'],
    ['Metric','GA Lines · Won + Needle Movers · Churn/downgrade'],
    ['MPR rule','Product Category = MPR · exclude M2M service'],
    ['Corporate rule','Product Category = Corporate · exclude M2M service'],
    ['M2M rule','Services = M2M'],
    [],
    ['Product','Gross Add Lines QTG','Churn (Lines) QTG','Net Add Lines QTG','WoW Change']
  ];
  (data.rows||[]).forEach(function(r){
    var wow='—';
    if(r.wowPct!=null&&!isNaN(r.wowPct)) wow=(r.wowPct>=0?'+':'')+r.wowPct.toFixed(1)+'%';
    aoa.push([r.label,Math.round(r.gross),Math.round(r.churn),Math.round(r.net),wow]);
  });
  return aoa;
}
function mqBuildMobileProductExportHtml(data){
  data=data||GLK_MOBILE_PRODUCT_TABLE_LAST;
  if(!data) return null;
  var acc='#'+mqThemeAccentHex();
  var infoRows=[
    ['Export Date',new Date().toISOString().slice(0,10)],
    ['Scenario',data.scenario||mqCaseDisplayName()],
    ['Period',data.period||mqPeriodLongName(mqPeriod)],
    ['Quarter',data.quarter||''],
    ['Scope',data.scope||'GLK Overall']
  ];
  var html='<div style="margin-bottom:28px;page-break-inside:avoid;">';
  html+='<div style="font-size:15px;font-weight:800;color:'+acc+';margin-bottom:2px;">'+mqEscHtml(data.scope)+' · '+mqEscHtml(data.scenario)+'</div>';
  html+='<div style="font-size:10px;color:#64748b;margin-bottom:10px;">'+mqEscHtml(data.period||'')+(data.quarter?(' · '+mqEscHtml(data.quarter)):'')+'</div>';
  html+='<table border="0" cellpadding="5" cellspacing="0" style="margin-bottom:10px;font-size:10px;">';
  infoRows.forEach(function(row,i){
    var bg=i%2===0?'#f9f0ff':'#ffffff';
    html+='<tr><td style="background:'+bg+';padding:5px 8px;font-weight:700;color:#64748b;">'+mqEscHtml(row[0])+'</td>';
    html+='<td style="background:'+bg+';padding:5px 8px;">'+mqEscHtml(String(row[1]))+'</td></tr>';
  });
  html+='</table>';
  html+='<table border="1" cellpadding="7" cellspacing="0" style="border-collapse:collapse;font-size:11px;width:100%;max-width:640px;">';
  html+='<tr><th style="background:#475569;color:#fff;padding:8px;text-align:left;">Product</th>';
  html+='<th style="background:#2563eb;color:#fff;padding:8px;text-align:right;">Gross Add Lines QTG</th>';
  html+='<th style="background:#ea580c;color:#fff;padding:8px;text-align:right;">Churn (Lines) QTG</th>';
  html+='<th style="background:#7c3aed;color:#fff;padding:8px;text-align:right;">Net Add Lines QTG</th>';
  html+='<th style="background:#64748b;color:#fff;padding:8px;text-align:right;">WoW</th></tr>';
  (data.rows||[]).forEach(function(r,i){
    var bg=i%2===0?'#ffffff':'#f9f0ff';
    if(r.key==='total') bg='rgba(168,85,247,.12)';
    var wow='—', wowColor='#64748b';
    if(r.wowPct!=null&&!isNaN(r.wowPct)){
      wow=(r.wowPct>=0?'▲ ':'▼ ')+Math.abs(r.wowPct).toFixed(0)+'%';
      wowColor=r.wowPct>=0?'#16a34a':r.wowPct<0?'#dc2626':'#64748b';
    }
    html+='<tr><td style="background:'+bg+';padding:7px;font-weight:'+(r.key==='total'?'900':'700')+';">'+mqEscHtml(r.label)+'</td>';
    html+='<td style="background:rgba(37,99,235,.08);padding:7px;text-align:right;color:#1d4ed8;font-weight:700;">'+mqFmtProductLines(r.gross)+'</td>';
    html+='<td style="background:rgba(234,88,12,.1);padding:7px;text-align:right;color:#c2410c;font-weight:700;">'+mqFmtProductLines(r.churn)+'</td>';
    html+='<td style="background:rgba(124,58,237,.1);padding:7px;text-align:right;color:#6d28d9;font-weight:900;">'+mqFmtProductLines(r.net)+'</td>';
    html+='<td style="background:'+bg+';padding:7px;text-align:right;color:'+wowColor+';font-weight:800;">'+wow+'</td></tr>';
  });
  html+='</table></div>';
  return html;
}
function mqBuildAllMobileProductExportHtml(tables){
  tables=tables||GLK_MOBILE_PRODUCT_TABLES_ALL;
  if(!tables||!tables.length) return null;
  var acc='#'+mqThemeAccentHex();
  var html='<!DOCTYPE html><html><head><meta charset="utf-8"></head><body style="font-family:Inter,Arial,sans-serif;color:#1e1133;padding:12px;">';
  html+='<div style="font-size:18px;font-weight:900;color:'+acc+';margin-bottom:4px;">GLK Mobile Net Add Lines QTG — All Scopes</div>';
  html+='<div style="font-size:11px;color:#64748b;margin-bottom:18px;">Exported '+new Date().toLocaleString('en-GB')+' · '+tables.length+' tables</div>';
  tables.forEach(function(data,i){
    if(i>0) html+='<div style="page-break-before:always;"></div>';
    html+=mqBuildMobileProductExportHtml(data);
  });
  html+='</body></html>';
  return html;
}
function mqExportSheetName(data){
  var sc=(data.scenarioKey==='best'?'Upside':'ML');
  var scope=String(data.scope||'GLK').replace(/[^\w\s-]+/g,'').trim().replace(/\s+/g,' ').substring(0,18);
  return (scope+' '+sc).substring(0,31);
}
window.mqExportMobileProductTableXlsx=function(){
  if(typeof XLSX==='undefined'){ alert('Excel library not loaded.'); return; }
  var calc=GLK_MQ_CALC_LAST;
  var tables=mqCalcAllMobileProductTables(calc);
  if(!tables||!tables.length){ alert('Mobile product tables are not ready. Open Mobile Performance Bridge first.'); return; }
  var dt=new Date().toISOString().slice(0,10);
  var wb=XLSX.utils.book_new();
  tables.forEach(function(data){
    var aoa=mqBuildMobileProductExportSheet(data);
    if(!aoa) return;
    var ws=XLSX.utils.aoa_to_sheet(aoa);
    ws['!cols']=[{wch:22},{wch:22},{wch:18},{wch:20},{wch:14}];
    XLSX.utils.book_append_sheet(wb,ws,mqExportSheetName(data));
  });
  XLSX.writeFile(wb,'GLK_Mobile_Product_QTG_All_'+dt+'.xlsx');
};
function mqBridgeBidValue(bid,calc,isChurn){
  calc=calc||GLK_MQ_CALC_LAST||{};
  var getVal=isChurn?(calc.bridgeGetChurnVal||mqBidMetric):(calc.bridgeGetVal||mqBidMetric);
  var v=getVal(bid);
  if(isChurn&&v>0) v=-v;
  return v;
}
function mqInflightGrossRejectReason(bid,calc){
  calc=calc||GLK_MQ_CALC_LAST||{};
  var isBest=!!calc.isBest;
  var getVal=calc.bridgeGetVal||mqBidMetric;
  var activationFn=calc.bridgeActivationFn||mqActivationQtdForward;
  if(!mqContractInList(bid,MQ_GROSS_CONTRACT_TYPES)) return 'Contract type "'+(bid.typeOfContract||'—')+'" not in gross list';
  if(!mqIsInflightGrossStatus(bid,isBest)){
    return 'Opportunity Status "'+(mqRawOppStatus(bid)||mqNormOppStatus(bid)||'—')+'" — need Proposed'+(isBest?' or Opportunity (Upside)':' (Most Likely)');
  }
  var actR=mqActivationRejectReason(bid);
  if(actR) return actR;
  if(!activationFn(bid)) return 'Outside activation window';
  if(getVal(bid)<=0) return mqProductFamily==='mobile'?'GA Lines is zero or blank':'MRC is zero or blank';
  return 'Not in Top 5 (ranked below cut) — check Others Needle Movers or excluded by grouping';
}
function mqInflightChurnRejectReason(bid,calc){
  calc=calc||GLK_MQ_CALC_LAST||{};
  var isBest=!!calc.isBest;
  var getVal=calc.bridgeGetChurnVal||mqBidMetric;
  var activationFn=calc.bridgeActivationFn||mqActivationQtdForward;
  if(!mqContractInList(bid,MQ_CHURN_CONTRACT_TYPES)) return 'Contract type "'+(bid.typeOfContract||'—')+'" not Churn/Downgrade';
  if(!mqIsInflightGrossStatus(bid,isBest)){
    return 'Opportunity Status "'+(mqRawOppStatus(bid)||mqNormOppStatus(bid)||'—')+'" — churn needs Proposed'+(isBest?' or Opportunity (Upside)':' (Most Likely)');
  }
  var actR=mqActivationRejectReason(bid);
  if(actR) return actR;
  if(!activationFn(bid)) return 'Outside activation window';
  var v=getVal(bid);
  if(v===0) return mqProductFamily==='mobile'?'GA Lines / churn value is zero':'MRC / churn value is zero';
  return 'Not in Top 5 Churn (ranked below cut) — may be in Others Churn if value is non-zero';
}
function mqBidInPool(bids,bid){
  return (bids||[]).some(function(b){return b.id===bid.id;});
}
function mqClassifyBidForBridge(bid,calc){
  calc=calc||GLK_MQ_CALC_LAST;
  if(!calc) return {bid:bid,placement:'Not included',reason:'Bridge not calculated yet',value:0};
  var out={bid:bid,placement:'Not included',reason:'',value:0,section:'',detail:''};
  if(!mqBidMatchesPf(bid)){
    out.reason='Wrong product family ('+(bid.productFamily||'—')+') — switch to '+(mqProductFamily==='fixed'?'Fixed':'Mobile');
    return out;
  }
  var levels=calc.activeReportLevels||[];
  if(levels.length&&!mqBidMatchesReportLevels(bid,levels)){
    out.reason='Vertical "'+(bid.vertical||'—')+'" not in selected report level ('+levels.join(', ')+')';
    return out;
  }
  if(mqBidInPool(calc.gross100Bids,bid)){
    out.placement='Gross Adds (Won)'; out.section='won';
    out.value=mqBridgeBidValue(bid,calc,false);
    out.detail='Opp Status: '+(mqRawOppStatus(bid)||'—')+' · Act: '+mqFmtBidDate(bid.expectedActivation);
    return out;
  }
  var exW=(calc.wonExcluded||[]).find(function(x){return x.bid.id===bid.id;});
  if(exW){
    out.placement='Won — excluded'; out.section='won';
    out.reason=exW.reason||'Failed Won filter';
    out.detail='Opp Status: '+(mqRawOppStatus(bid)||'—')+' · Act: '+mqFmtBidDate(bid.expectedActivation);
    return out;
  }
  if(mqIsWonOnlyBid(bid)||mqRawOppStatus(bid).toLowerCase()==='won'){
    out.placement='Won — excluded'; out.section='won';
    out.reason=mqWonRejectReason(bid,calc.year,calc.quarter,calc.bridgeGetVal||mqBidMetric,calc.bridgeActivationFn);
    out.detail='Opp Status: '+(mqRawOppStatus(bid)||'—')+' · Act: '+mqFmtBidDate(bid.expectedActivation);
    return out;
  }
  var cp=calc.churnPool||{};
  var gi, g;
  for(gi=0;gi<(cp.top||[]).length;gi++){
    g=cp.top[gi];
    if(mqBidInPool(g.bids,bid)){
      out.placement='Top 5 Churn'; out.section='churn'; out.detail='#'+(gi+1)+' '+g.name;
      out.value=mqBridgeBidValue(bid,calc,true);
      return out;
    }
  }
  if(mqBidInPool(cp.othersBids,bid)){
    out.placement='Others Churn'; out.section='churn';
    out.value=mqBridgeBidValue(bid,calc,true);
    out.detail='Grouped under Others Churn';
    return out;
  }
  if(mqContractInList(bid,MQ_CHURN_CONTRACT_TYPES)){
    out.placement='Churn — not included'; out.section='churn';
    out.reason=mqInflightChurnRejectReason(bid,calc);
    out.detail='Act: '+mqFmtBidDate(bid.expectedActivation)+' ('+mqActivationMonthLabel(bid.expectedActivation)+') · Opp: '+(mqRawOppStatus(bid)||'—');
    return out;
  }
  var gp=calc.grossPool||{};
  for(gi=0;gi<(gp.top||[]).length;gi++){
    g=gp.top[gi];
    if(mqBidInPool(g.bids,bid)){
      out.placement='Top 5 Opportunities'; out.section='inflight';
      out.detail='#'+(gi+1)+' '+g.name+(g.bids.length>1?' ('+g.bids.length+' bids clubbed)':'');
      out.value=mqBridgeBidValue(bid,calc,false);
      return out;
    }
  }
  if(mqBidInPool(gp.othersBids,bid)){
    out.placement='Others Needle Movers'; out.section='inflight';
    out.value=mqBridgeBidValue(bid,calc,false);
    out.detail='Grouped under Others Needle Movers';
    return out;
  }
  if(mqContractInList(bid,MQ_GROSS_CONTRACT_TYPES)){
    out.placement='Needle Movers — not included'; out.section='inflight';
    out.reason=mqInflightGrossRejectReason(bid,calc);
    out.detail='Act: '+mqFmtBidDate(bid.expectedActivation)+' ('+mqActivationMonthLabel(bid.expectedActivation)+') · Opp: '+(mqRawOppStatus(bid)||'—');
    return out;
  }
  out.reason='Contract type "'+(bid.typeOfContract||'—')+'" is not gross-add or churn/downgrade';
  out.detail='Act: '+mqFmtBidDate(bid.expectedActivation);
  return out;
}
function mqSearchBridgeAccounts(query){
  var q=String(query||'').trim().toLowerCase();
  if(!q||!GLK_MQ_CALC_LAST) return [];
  return ALL_BIDS.filter(function(b){
    return (b.customerName||'').toLowerCase().indexOf(q)>=0||
      mqBidRefValue(b).toLowerCase().indexOf(q)>=0||
      String(b.customerCode||'').toLowerCase().indexOf(q)>=0||
      String(b.myId||'').toLowerCase().indexOf(q)>=0||
      (b.headDirector||'').toLowerCase().indexOf(q)>=0||
      (b.accountDirector||'').toLowerCase().indexOf(q)>=0||
      (b.amName||'').toLowerCase().indexOf(q)>=0||
      (b.vertical||'').toLowerCase().indexOf(q)>=0;
  }).map(function(b){return mqClassifyBidForBridge(b,GLK_MQ_CALC_LAST);});
}
function mqRenderBridgeSearchResults(items){
  var box=el('mqBridgeSearchResults'); if(!box) return;
  var wrap=el('mqBridgeSearchGridWrap');
  if(!items||!items.length){
    box.style.display='block';
    box.innerHTML='<div style="padding:.55rem .65rem;color:var(--t3);font-size:.72rem;">No matching accounts in pipeline.</div>';
    if(wrap){ wrap.style.display='none'; wrap.innerHTML=''; }
    return;
  }
  box.style.display='none';
  box.innerHTML='';
  if(!wrap) return;
  wrap.style.display='block';
  var cardRows=items.map(function(r){
    return {
      bid:r.bid,
      _value:r.value,
      _placement:r.placement,
      _reason:r.reason,
      _isChurn:r.section==='churn'
    };
  });
  wrap.innerHTML='<div style="display:flex;justify-content:space-between;align-items:center;gap:.65rem;margin-bottom:.55rem;flex-wrap:wrap;">'+
    '<strong style="color:var(--acc);font-size:.78rem;">Search results ('+items.length+')</strong>'+
    '<button type="button" onclick="mqClearBridgeSearch()" style="border:none;background:transparent;color:var(--t3);cursor:pointer;font-size:.85rem;">✕ Close</button></div>'+
    mqBuildBridgeAccountsHtml(cardRows,{isChurn:false,showGroup:false,showBridgePlacement:true})+
    '<div id="mqDetailOverdueWrap" style="margin-top:1rem;padding-top:.75rem;border-top:1px solid var(--border);">'+
    '<button type="button" id="mqOverdueToggleBtn" class="reset-btn" onclick="mqToggleOverdueActivation()" style="font-size:.72rem;padding:.4rem .75rem;margin-bottom:.55rem;">Show overdue activation</button>'+
    '<div id="mqOverdueActPanel" style="display:none;"></div></div>';
  mqUpdateOverdueButtonCount();
  if(MQ_OVERDUE_OPEN) mqRenderOverdueActivationPanel();
  wrap.scrollIntoView({behavior:'smooth',block:'nearest'});
}
window.mqRunBridgeSearch=function(){
  var inp=el('mqBridgeSearchInp');
  mqRenderBridgeSearchResults(mqSearchBridgeAccounts(inp?inp.value:''));
};
window.mqClearBridgeSearch=function(){
  var inp=el('mqBridgeSearchInp'); if(inp) inp.value='';
  var box=el('mqBridgeSearchResults'); if(box){ box.style.display='none'; box.innerHTML=''; }
  var wrap=el('mqBridgeSearchGridWrap');
  if(wrap){ wrap.style.display='none'; wrap.innerHTML=''; }
  MQ_OVERDUE_OPEN=false;
};
function glkMobileQtdCalc(){
  var report=mqGetActiveReport();
  var isBest=mqCase==='best';
  var isForward=mqIsForwardBridge();
  var isFutureQuarter=mqIsFutureQuarterBridge();
  var viewYQ=mqBridgeViewYearQuarter();
  var year=isFutureQuarter?viewYQ.year:(report?report.year:viewYQ.year);
  var quarter=isFutureQuarter?viewYQ.quarter:(report?report.quarter:viewYQ.quarter);
  var activeLevels=mqGetActiveReportLevels();
  var scope=mqResolveReportScope(report,activeLevels);
  var skipActualsTarget=isForward||isFutureQuarter;
  var actualsRaw=skipActualsTarget?0:num(scope.actualsQtd);
  var actualsQtd=actualsRaw;
  var target=skipActualsTarget?0:scope.target;
  var actualsByVertical=null;
  if(!isForward&&!activeLevels.length&&report&&report.verticals){
    var useYtd=mqIsYtdBridge();
    actualsByVertical=report.verticals.map(function(v){
      return {
        name:v.name,
        actualQtd:num(useYtd?(v.actualYtd!=null?v.actualYtd:v.actualQtd):v.actualQtd),
        target:mqIsYtdBridge()
          ?(mqProductFamily==='mobile'?mqGetMobileYtdOverallTarget(report):mqGetYtdScopeTarget(report,v.name).value)
          :num(v.target)
      };
    });
  }
  var base=mqApplyBridgeBaseFilters();
  if(activeLevels.length) base=base.filter(function(b){return mqBidMatchesReportLevels(b,activeLevels);});
  var getVal=mqBidMetric;
  var getChurnVal=mqBidMetric;
  var activationFn=mqActivationQtdForward;
  var g100;
  if(mqIsYtdBridge()){
    activationFn=mqActivationQtdForward;
    if(mqProductFamily==='fixed'){
      getVal=function(b){return mqBidQtgValue(b,year,quarter);};
      getChurnVal=function(b){return mqBidQtgMrc(b,year,quarter);};
      g100=mqGrossAddsForwardDetail(base,getVal,activationFn);
    }else{
      getVal=mqBidMetric;
      getChurnVal=mqBidMetric;
      g100=mqGrossAdds100Detail(base,year,quarter);
    }
  }else if(mqPeriod==='qtg'){
    getVal=function(b){return mqBidQtgValue(b,year,quarter);};
    getChurnVal=function(b){return mqBidQtgMrc(b,year,quarter);};
    activationFn=mqActivationQtdForward;
    g100=mqGrossAddsForwardDetail(base,getVal,activationFn);
  }else if(mqPeriod==='ytg'){
    getVal=function(b){return mqBidYtgValue(b,year);};
    getChurnVal=function(b){return mqBidYtgMrc(b,year);};
    activationFn=function(b){return mqActivationYtgForward(b,year);};
    g100=mqGrossAddsForwardDetail(base,getVal,activationFn);
  }else{
    g100=mqGrossAdds100Detail(base,year,quarter);
  }
  var grossPool=mqInflightGrossPools(base,year,quarter,isBest,getVal,activationFn);
  var churnPool=mqInflightChurnPools(base,year,quarter,isBest,getChurnVal,activationFn);
  var inflightGross=grossPool.total;
  var inflightChurn=churnPool.total;
  var hasChurn=churnPool.top.length>0||churnPool.others!==0;
  var forecast=(skipActualsTarget?(g100.total+inflightGross+inflightChurn):(actualsRaw+g100.total+inflightGross+inflightChurn));
  var diff=target-forecast;
  var calc={
    report:report,year:year,quarter:quarter,isBest:isBest,isForward:isForward,isFutureQuarter:isFutureQuarter,
    bridgePeriod:mqPeriod,
    actualsQtd:actualsQtd,actualsRaw:actualsRaw,target:target,actualsByVertical:actualsByVertical,
    gross100:g100.total,gross100Bids:g100.bids,wonExcluded:g100.excluded||[],grossPool:grossPool,churnPool:churnPool,
    bridgeGetVal:getVal,bridgeGetChurnVal:getChurnVal,bridgeActivationFn:activationFn,
    inflightGross:inflightGross,inflightChurn:inflightChurn,hasChurn:hasChurn,
    forecast:forecast,diff:diff,gap:skipActualsTarget?0:(diff>0?diff:0),growth:skipActualsTarget?0:(diff<0?Math.abs(diff):0),
    vertical:isForward?(activeLevels.length?scope.label:'All verticals (pipeline)'):scope.label,
    activeReportLevels:activeLevels.slice(),
    reportScopeMissing:scope.missing.length>0,
    ytdMissing:scope.ytdMissing||[]
  };
  calc.rulesHtml=null;
  GLK_MQ_CALC_LAST=calc;
  var sInp=el('mqBridgeSearchInp');
  if(sInp&&sInp.value.trim()) mqRenderBridgeSearchResults(mqSearchBridgeAccounts(sInp.value));
  return calc;
}
function mqShortXLabel(b,idx,bars){
  return mqAxisLabelLines(b)[0]||'';
}
function mqAxisNameLines(b){
  if(!b) return [''];
  if(b.type==='growth') return ['Growth','(+'+fmtLines(Math.abs(b.value))+')'];
  if(b.type==='gap') return ['Gap','('+fmtLines(Math.abs(b.value))+')'];
  var name=String(b.axisName||b.custName||b.groupLabel||'').trim();
  if(!name) return [''];
  if(name.length<=14) return [name];
  var words=name.split(/\s+/);
  if(words.length>=3){
    var third=Math.ceil(words.length/3);
    var two=Math.ceil(words.length*2/3);
    return [words.slice(0,third).join(' '),words.slice(third,two).join(' '),words.slice(two).join(' ')];
  }
  if(words.length>=2){
    var best=1,bestDiff=999;
    for(var w=1;w<words.length;w++){
      var a=words.slice(0,w).join(' '), bb=words.slice(w).join(' ');
      var diff=Math.abs(a.length-bb.length);
      if(diff<bestDiff){ bestDiff=diff; best=w; }
    }
    return [words.slice(0,best).join(' '), words.slice(best).join(' ')];
  }
  var mid=Math.ceil(name.length/2);
  return [name.slice(0,mid), name.slice(mid)];
}
function mqBarProductTag(b){
  if(!b||mqProductFamily!=='mobile') return '';
  if(!(b.section==='gross'||b.section==='churn')||!b.bracketGroup) return '';
  return String(b.productBucket||'').trim();
}
function mqProductTagClass(tag){
  var t=String(tag||'').toLowerCase();
  if(t==='corporate') return 'corporate';
  if(t==='m2m') return 'm2m';
  return 'mpr';
}
function mqFormatAxisCellHtml(lines,prodTag){
  var html=(lines||[]).map(function(l){ return mqEscHtml(l); }).join('<br>');
  if(prodTag) html+='<br><span class="mq-x-prod '+mqProductTagClass(prodTag)+'">'+mqEscHtml(prodTag)+'</span>';
  return html;
}
function mqAxisLabelLines(b){
  return mqAxisNameLines(b);
}
function mqSyncChartLabels(chart,bars){
  if(!chart) return;
  var meta=chart.getDatasetMeta(0);
  if(!meta||!meta.data||!meta.data.length) return;
  var canvas=chart.canvas;
  var cw=canvas?canvas.clientWidth:0;
  if(!cw) return;
  var brow=el('mqBracketRow');
  if(brow){
    brow.style.width=cw+'px';
    brow.style.minWidth=cw+'px';
    brow.innerHTML='';
    var groups=[];
    bars.forEach(function(b,i){
      if(!b.bracketGroup||!b.bracketLabel) return;
      var g=groups.find(function(x){return x.id===b.bracketGroup;});
      if(!g) groups.push(g={id:b.bracketGroup,label:b.bracketLabel||'',start:i,end:i});
      else g.end=i;
    });
    groups.forEach(function(g){
      var b0=meta.data[g.start], b1=meta.data[g.end];
      if(!b0||!b1) return;
      var cell=document.createElement('div');
      cell.className='mq-bracket-abs'+(g.id==='top5churn'?' mq-bracket-churn':' mq-bracket-gross');
      var x1=b0.x-(b0.width||14)/2-2;
      var w=b1.x+(b1.width||14)/2+2-x1;
      cell.style.left=x1+'px';
      cell.style.width=Math.max(w,24)+'px';
      cell.innerHTML='<span class="mq-bracket-label">'+mqEscHtml(g.label)+'</span><span class="mq-bracket-line"></span>';
      brow.appendChild(cell);
    });
  }
  var strip=el('mqXAxisStrip');
  var overlay=el('mqVertOnChart');
  if(overlay){
    overlay.style.display='block';
    overlay.style.width=cw+'px';
    overlay.style.height=(canvas.clientHeight||0)+'px';
    overlay.innerHTML='';
  }
  if(strip){
    strip.style.width=cw+'px';
    strip.style.minWidth=cw+'px';
    strip.innerHTML='';
    var maxLines=1;
    bars.forEach(function(b){
      var n=mqAxisNameLines(b).length+(mqBarProductTag(b)?1:0);
      maxLines=Math.max(maxLines,n);
    });
    strip.style.height=Math.max(56,maxLines*16+10)+'px';
    strip.style.minHeight=strip.style.height;
  }
  meta.data.forEach(function(bar,i){
    var b=bars[i]; if(!b) return;
    var nameLines=mqAxisNameLines(b);
    var prodTag=mqBarProductTag(b);
    if(overlay){
      if(b.verticalHint){
        var letters=mqVerticalLetters(b.verticalHint);
        if(letters.length){
          var bot=Math.max(bar.y,bar.base);
          var blockH=letters.length*12+8;
          var limit=(canvas.clientHeight||340)-blockH-4;
          var vcell=document.createElement('div');
          vcell.className='mq-v-onbar'+(GLK_MQ_DETAIL_IDX===i?' sel':'');
          vcell.style.left=bar.x+'px';
          vcell.style.top=Math.min(bot+7,limit)+'px';
          var hd=mqVertHdGroup((b.bids&&b.bids[0]&&b.bids[0].vertical)||b.verticalHint);
          vcell.innerHTML=mqVerticalStackBlock(b.verticalHint);
          var stack=vcell.querySelector('.mq-v-stack');
          if(stack) stack.style.borderLeft='3px solid '+(MQ_HD_COLORS[hd]||MQ_HD_COLORS.other);
          vcell.title=b.verticalHint;
          vcell.onclick=function(){mqClickAxisCell(i);};
          overlay.appendChild(vcell);
        }
      }
    }
    if(strip){
      var cell=document.createElement('div');
      var extra=b.type==='growth'?' growth-lbl':(b.type==='gap'?' gap-lbl':'');
      cell.className='mq-x-abs'+(GLK_MQ_DETAIL_IDX===i?' sel':'')+extra;
      cell.style.left=bar.x+'px';
      cell.style.transform='translateX(-50%)';
      var slotW=GLK_MQ_LAST_BAR_SLOT||72;
      cell.style.maxWidth=Math.max(62,slotW-2)+'px';
      cell.style.minWidth=Math.max(58,Math.min(slotW,slotW-4))+'px';
      cell.innerHTML=mqFormatAxisCellHtml(nameLines,prodTag);
      cell.title=(b.custName||nameLines.join(' '))+(prodTag?' · '+prodTag:'');
      cell.onclick=function(){mqClickAxisCell(i);};
      strip.appendChild(cell);
    }
  });
}
function mqEscHtml(s){
  return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
}
function mqCalcAxisBottomPad(bars){
  return 8;
}
window.mqClickAxisCell=function(idx){
  if(!GLK_MQ_LAST_BARS) return;
  mqToggleBarDetail(idx,GLK_MQ_LAST_BARS,GLK_MQ_LAST_BAR_META||[]);
};
function mqRenderBridgeLegend(calc){
  var leg=el('mqBridgeLegend'); if(!leg) return;
  calc=calc||GLK_MQ_CALC_LAST||{};
  var chips=[];
  if(!calc.isForward&&!calc.isFutureQuarter){
    chips.push({c:MQ_CLR_ACTUALS,l:mqActualsBarLabel()});
  }
  chips.push({c:MQ_CLR_WON,l:mqWonBarLabel(calc)});
  chips.push({c:MQ_CLR_INFLIGHT[0],l:'Needle Movers'});
  chips.push({c:MQ_CLR_CHURN[0],l:'Churn / Downgrade'});
  chips.push({c:MQ_CLR_NET,l:calc.isForward?('Total Aggregated Revenue'):(calc.isFutureQuarter?'Pipeline forecast':'Net Forecast')});
  if(!calc.isForward&&!calc.isFutureQuarter){
    chips.push({c:MQ_CLR_TARGET,l:'Target'});
    chips.push({c:MQ_CLR_GROWTH,l:'Growth vs Target'});
    chips.push({c:MQ_CLR_GAP,l:'Gap to Target'});
  }
  leg.innerHTML=chips.map(function(x){
    return '<span class="mq-leg-chip"><span class="mq-leg-dot" style="background:'+x.c+';"></span>'+x.l+'</span>';
  }).join('');
}
function glkMobileQtdSectionPlugin(bars){
  return {id:'mqSections',beforeDatasetsDraw:function(chart){
    var meta=chart.getDatasetMeta(0), ctx=chart.ctx, area=chart.chartArea;
    if(!meta||!meta.data||!meta.data.length) return;
    var spans=[], cur=null;
    bars.forEach(function(b,i){
      var sec=b.section||'gross';
      if(!cur||cur.key!==sec){ if(cur) spans.push(cur); cur={key:sec,start:i,end:i}; }
      else cur.end=i;
    });
    if(cur) spans.push(cur);
    ctx.save();
    spans.forEach(function(sp){
      var b0=meta.data[sp.start], b1=meta.data[sp.end];
      if(!b0||!b1) return;
      var x1=b0.x-(b0.width||14)/2-6, x2=b1.x+(b1.width||14)/2+6;
      ctx.fillStyle=MQ_SECTION_FILLS[sp.key]||MQ_SECTION_FILLS.gross;
      ctx.fillRect(x1,area.top,x2-x1,area.bottom-area.top);
    });
    ctx.restore();
  }};
}
function glkMobileQtdFlowPlugin(bars){
  return {id:'mqFlow',beforeDatasetsDraw:function(chart){
    var meta=chart.getDatasetMeta(0), ctx=chart.ctx, area=chart.chartArea;
    if(!meta||!meta.data) return;
    ctx.save();
    ctx.strokeStyle='rgba(100,116,139,.35)';
    ctx.lineWidth=1;
    ctx.setLineDash([3,4]);
    for(var i=0;i<bars.length-1;i++){
      var b=bars[i], n=bars[i+1];
      if(b.type==='total'||b.type==='target'||b.type==='gap'||b.type==='growth') continue;
      if(n.type==='total') continue;
      var bar=meta.data[i], y=Math.min(bar.y,bar.base);
      var barN=meta.data[i+1];
      if(!barN) continue;
      var yN=Math.max(barN.y,barN.base);
      if(Math.abs(y-yN)<2) continue;
      ctx.beginPath();
      ctx.moveTo(bar.x+((bar.width||14)/2)+2,y);
      ctx.lineTo(barN.x-((barN.width||14)/2)-2,y);
      ctx.stroke();
    }
    ctx.restore();
  }};
}
function glkMobileQtdAxisPlugin(bars,bottomPad){
  return {id:'mqAxis',afterDraw:function(chart){
    var meta=chart.getDatasetMeta(0), ctx=chart.ctx, area=chart.chartArea;
    if(!meta||!meta.data) return;
    ctx.save();
    ctx.fillStyle=chart.options.scales.x.ticks.color||'#64748b';
    ctx.font='600 9px Inter';
    ctx.textAlign='center';
    ctx.textBaseline='top';
    meta.data.forEach(function(bar,i){
      var b=bars[i]; if(!b) return;
      var lines=mqAxisLabelLines(b);
      var x=bar.x, y=area.bottom+10+(b.bracketGroup?18:0);
      var isSel=GLK_MQ_DETAIL_IDX===i;
      if(isSel){
        ctx.fillStyle=chart.options.scales.x.ticks.color||'#64748b';
        ctx.font='700 9px Inter';
      }
      lines.forEach(function(line,li){
        if(!line) return;
        var txt=line.length>22?line.slice(0,20)+'…':line;
        ctx.fillText(txt,x,y+li*11);
      });
      if(isSel){
        ctx.strokeStyle='rgba(99,102,241,.85)';
        ctx.lineWidth=2;
        var w=(bar.width||14)+8;
        ctx.strokeRect(bar.x-w/2,area.bottom+6,w,bottomPad-10);
      }
      ctx.font='600 9px Inter';
    });
    ctx.restore();
  }};
}
window.mqToggleWonExcluded=function(){
  GLK_MQ_SHOW_WON_EXCLUDED=!GLK_MQ_SHOW_WON_EXCLUDED;
  mqRefreshBarDetailPanel();
};
window.mqDetailFilterChange=function(){
  var s=el('mqDetailSearchInp'); if(s) GLK_MQ_DETAIL_SEARCH=s.value||'';
  var st=el('mqDetailStatusFlt'); if(st) GLK_MQ_DETAIL_FILTER_STATUS=st.value||'';
  var vt=el('mqDetailVertFlt'); if(vt) GLK_MQ_DETAIL_FILTER_VERT=vt.value||'';
  if(GLK_MQ_PT_DETAIL) mqRefreshProductTableDetailPanel();
  else mqRefreshBarDetailPanel();
};
function mqFilterDetailGroups(groups){
  var q=(GLK_MQ_DETAIL_SEARCH||'').trim().toLowerCase();
  var st=(GLK_MQ_DETAIL_FILTER_STATUS||'').toLowerCase();
  var vt=(GLK_MQ_DETAIL_FILTER_VERT||'').toLowerCase();
  return (groups||[]).map(function(grp){
    var isChurn=!!grp._isChurn;
    var bids=(grp.bids||[]).filter(function(bd){
      if(st&&mqRawOppStatus(bd).toLowerCase().indexOf(st)<0) return false;
      if(vt&&String(bd.vertical||'').toLowerCase().indexOf(vt)<0) return false;
      if(!q) return true;
      return String(bd.customerName||'').toLowerCase().indexOf(q)>=0||
        mqBidRefValue(bd).toLowerCase().indexOf(q)>=0||
        String(bd.myId||'').toLowerCase().indexOf(q)>=0||
        String(bd.vertical||'').toLowerCase().indexOf(q)>=0;
    });
    if(!bids.length) return null;
    var val=bids.reduce(function(s,b){return s+Math.abs(mqBidRowDetailValue(b,isChurn?'decrease':'increase'));},0);
    return Object.assign({},grp,{bids:bids,value:val});
  }).filter(Boolean);
}
function mqDetailFilterOptions(groups){
  var statuses={}, verts={};
  (groups||[]).forEach(function(g){
    (g.bids||[]).forEach(function(bd){
      var s=mqRawOppStatus(bd); if(s) statuses[s]=1;
      var v=bd.vertical; if(v&&v!=='—') verts[v]=1;
    });
  });
  return {statuses:Object.keys(statuses).sort(),verts:Object.keys(verts).sort()};
}
function mqBuildForecastBreakdownHtml(calc){
  if(!calc||calc.isForward) return '';
  var h='<div class="mq-calc-box" style="margin:.2rem 0 .55rem;">';
  h+='<div style="font-weight:800;font-size:.82rem;margin-bottom:.4rem;color:var(--acc);">Net Forecast breakdown</div>';
  var rows=[];
  rows.push({label:mqActualsBarLabel(),val:calc.actualsRaw});
  rows.push({label:mqWonBarLabel(calc),val:calc.gross100||0});
  var grossN=(calc.grossPool&&calc.grossPool.top||[]).filter(function(p){return p.value;}).length;
  var churnN=(calc.churnPool&&calc.churnPool.top||[]).filter(function(p){return p.value;}).length;
  var grossLbl=mqInflightTop5Label(grossN);
  var churnLbl=mqChurnTopLabel(churnN);
  (calc.grossPool&&calc.grossPool.top||[]).forEach(function(p){
    if(p.value) rows.push({label:grossLbl+' · '+p.name,val:p.value});
  });
  if(calc.grossPool&&calc.grossPool.others) rows.push({label:mqInflightOthersLabel(),val:calc.grossPool.others});
  (calc.churnPool&&calc.churnPool.top||[]).forEach(function(p){
    if(p.value) rows.push({label:churnLbl+' · '+p.name,val:p.value});
  });
  if(calc.churnPool&&calc.churnPool.others) rows.push({label:'Others Churn',val:calc.churnPool.others});
  var sum=0;
  rows.forEach(function(r){
    var v=num(r.val);
    sum+=v;
    var sign=v<0?'−':'+';
    h+='<div style="display:flex;justify-content:space-between;gap:.5rem;padding:.18rem 0;font-size:.78rem;">';
    h+='<span>'+sign+' '+mqEscHtml(r.label)+'</span>';
    h+='<strong>'+(v<0?'−':'')+fmtLines(Math.abs(v))+'</strong></div>';
  });
  h+='<div style="display:flex;justify-content:space-between;gap:.5rem;margin-top:.35rem;padding-top:.4rem;border-top:2px solid var(--border);font-weight:800;font-size:.84rem;">';
  h+='<span>= Net Forecast</span><span style="color:var(--acc);">'+fmtLines(calc.forecast)+'</span></div>';
  if(Math.abs(sum-num(calc.forecast))>0.5){
    h+='<div style="font-size:.66rem;color:var(--t3);margin-top:.25rem;">Components sum '+fmtLines(sum)+' · rounded display '+fmtLines(calc.forecast)+'</div>';
  }
  if(calc.target>0){
    h+='<div style="margin-top:.35rem;font-size:.74rem;color:var(--t3);">Target: <strong>'+fmtLines(calc.target)+'</strong>';
    if(calc.gap>0) h+=' · Gap: <strong style="color:'+MQ_CLR_GAP+';">'+fmtLines(calc.gap)+'</strong>';
    else if(calc.growth>0) h+=' · Ahead: <strong style="color:'+MQ_CLR_GROWTH+';">+'+fmtLines(calc.growth)+'</strong>';
    h+='</div>';
  }
  h+='</div>';
  return h;
}
function mqBuildBarDetailHtml(b,metaLabel,barIdx){
  if(!b) return '';
  var calc=GLK_MQ_CALC_LAST||{};
  if((b.type==='total'||b.forecastBreakdown)&&calc&&!calc.isForward){
    var h='<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:.75rem;margin-bottom:.45rem;">';
    h+='<strong style="color:var(--acc);font-size:.78rem;">'+(metaLabel||'Net Forecast')+'</strong>';
    h+='<button type="button" onclick="mqCloseBarDetail()" style="border:none;background:transparent;color:var(--t3);cursor:pointer;font-size:.85rem;padding:0 .25rem;">✕</button></div>';
    h+=mqBuildForecastBreakdownHtml(calc);
    return h;
  }
  var isChurn=b.type==='decrease';
  var h='<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:.75rem;margin-bottom:.45rem;">';
  h+='<strong style="color:var(--acc);font-size:.78rem;">'+(metaLabel||b.custName||b.groupLabel||'Bar')+'</strong>';
  h+='<button type="button" onclick="mqCloseBarDetail()" style="border:none;background:transparent;color:var(--t3);cursor:pointer;font-size:.85rem;padding:0 .25rem;">✕</button></div>';
  h+='<div style="margin-bottom:.35rem;">Bar total: <strong>'+fmtLines(Math.abs(b.value))+'</strong>';
  if(b.type==='decrease') h+=' <span style="color:#ef4444;">(churn)</span>';
  h+='</div>';
  if(b.groupLabel) h+='<div style="margin-bottom:.35rem;color:var(--t3);">Group: '+mqEscHtml(b.groupLabel)+'</div>';
  if(b.vertBreakdown&&b.vertBreakdown.length){
    h+='<div style="margin:.35rem 0 .2rem;font-weight:600;">Vertical split</div><ul style="margin:0 0 .45rem 1rem;padding:0;">';
    b.vertBreakdown.slice().sort(function(a,bv){return Math.abs(bv.value)-Math.abs(a.value);}).forEach(function(v){
      h+='<li>'+mqEscHtml(v.name)+': '+fmtLines(v.value)+'</li>';
    });
    h+='</ul>';
  }
  if(b.bids&&b.bids.length){
    var groups=mqDetailGroupsFromBar(b,isChurn);
    groups.forEach(function(g){ g._isChurn=isChurn; });
    var filtOpts=mqDetailFilterOptions(groups);
    var filtered=mqFilterDetailGroups(groups);
    var totalBids=b.bids.length;
    h+='<div class="mq-detail-toolbar">';
    h+='<input type="search" id="mqDetailSearchInp" placeholder="Search account, bid ref, vertical…" value="'+mqEscHtml(GLK_MQ_DETAIL_SEARCH)+'" oninput="mqDetailFilterChange()" style="flex:1;min-width:160px;">';
    h+='<select id="mqDetailStatusFlt" onchange="mqDetailFilterChange()"><option value="">All statuses</option>';
    filtOpts.statuses.forEach(function(s){
      h+='<option value="'+mqEscHtml(s)+'"'+(GLK_MQ_DETAIL_FILTER_STATUS===s?' selected':'')+'>'+mqEscHtml(s)+'</option>';
    });
    h+='</select>';
    h+='<select id="mqDetailVertFlt" onchange="mqDetailFilterChange()"><option value="">All verticals</option>';
    filtOpts.verts.forEach(function(v){
      h+='<option value="'+mqEscHtml(v)+'"'+(GLK_MQ_DETAIL_FILTER_VERT===v?' selected':'')+'>'+mqEscHtml(v)+'</option>';
    });
    h+='</select></div>';
    var flatRows=mqFlatRowsFromGroups(filtered);
    h+='<div style="margin:.35rem 0 .45rem;font-weight:700;font-size:.82rem;">Accounts ('+flatRows.length+' shown · '+totalBids+' total)'+(b.section==='won'?' · <span style="color:var(--t3);font-weight:600;">each bid listed separately on Won bar</span>':'')+'</div>';
    h+=mqBuildBridgeAccountsHtml(flatRows,{isChurn:isChurn,showGroup:true});
    h+='<div id="mqDetailOverdueWrap" style="display:block;margin-top:1rem;padding-top:.75rem;border-top:1px solid var(--border);">';
    h+='<button type="button" id="mqOverdueToggleBtn" class="reset-btn" onclick="mqToggleOverdueActivation()" style="font-size:.72rem;padding:.4rem .75rem;margin-bottom:.55rem;">Show overdue activation</button>';
    h+='<div id="mqOverdueActPanel" style="display:none;"></div></div>';
  }else if(!b.vertBreakdown||!b.vertBreakdown.length){
    h+='<div style="color:var(--t3);font-style:italic;">No account-level detail for this bar.</div>';
  }
  if(b.section==='won'&&calc.wonExcluded&&calc.wonExcluded.length){
    h+='<div class="mq-excluded-toggle" onclick="mqToggleWonExcluded()">'+(GLK_MQ_SHOW_WON_EXCLUDED?'▼':'▶')+' Won in pipeline but excluded from this bar ('+calc.wonExcluded.length+') — click to '+(GLK_MQ_SHOW_WON_EXCLUDED?'hide':'show')+'</div>';
    h+='<div class="mq-excluded-body'+(GLK_MQ_SHOW_WON_EXCLUDED?' open':'')+'">';
    h+='<div style="font-size:.74rem;color:#92400e;margin-bottom:.45rem;">These rows look like Won but failed a filter — expand to see why accounts are missing.</div>';
    calc.wonExcluded.slice().sort(function(a,b){
      return Math.abs(mqBidMetric(b.bid))-Math.abs(mqBidMetric(a.bid));
    }).forEach(function(x,i){
      h+='<div style="margin-bottom:.55rem;padding-bottom:.5rem;border-bottom:1px solid rgba(245,158,11,.25);">';
      h+='<div style="font-weight:700;font-size:.82rem;">'+(i+1)+'. '+mqEscHtml(x.bid.customerName||'—')+' · '+fmtLines(mqBidMetric(x.bid))+' lines</div>';
      h+=mqBidRefCopyHtml(x.bid,true);
      h+='<div style="margin-top:.3rem;color:#b45309;font-weight:600;font-size:.78rem;">Why excluded: '+mqEscHtml(x.reason)+'</div>';
      h+='</div>';
    });
    h+='</div>';
  }
  return h;
}
window.mqToggleBarDetailBid=function(barIdx,groupIdx,bidIdx){
  groupIdx=groupIdx==null?0:groupIdx;
  bidIdx=bidIdx==null?-1:bidIdx;
  if(GLK_MQ_DETAIL_IDX!==barIdx){
    GLK_MQ_DETAIL_IDX=barIdx;
    GLK_MQ_DETAIL_GROUP_IDX=groupIdx;
    GLK_MQ_DETAIL_BID_IDX=bidIdx;
  }else if(GLK_MQ_DETAIL_GROUP_IDX!==groupIdx){
    GLK_MQ_DETAIL_GROUP_IDX=groupIdx;
    GLK_MQ_DETAIL_BID_IDX=bidIdx;
  }else if(bidIdx<0){
    GLK_MQ_DETAIL_GROUP_IDX=(GLK_MQ_DETAIL_GROUP_IDX===groupIdx?-1:groupIdx);
    GLK_MQ_DETAIL_BID_IDX=-1;
  }else{
    GLK_MQ_DETAIL_BID_IDX=(GLK_MQ_DETAIL_BID_IDX===bidIdx?-1:bidIdx);
  }
  mqRefreshBarDetailPanel();
};
function mqRefreshBarDetailPanel(){
  var p=el('mqBarDetailPanel');
  if(!p||GLK_MQ_DETAIL_IDX<0||!GLK_MQ_LAST_BARS) return;
  var b=GLK_MQ_LAST_BARS[GLK_MQ_DETAIL_IDX];
  var m=(GLK_MQ_LAST_BAR_META||[])[GLK_MQ_DETAIL_IDX];
  p.style.display='block';
  p.innerHTML=mqBuildBarDetailHtml(b,m?m.label:'',GLK_MQ_DETAIL_IDX);
  mqUpdateOverdueButtonCount();
  if(MQ_OVERDUE_OPEN) mqRenderOverdueActivationPanel();
  mqSyncChartLabels(CHARTS.mobileQtd,GLK_MQ_LAST_BARS);
  if(CHARTS.mobileQtd) CHARTS.mobileQtd.update('none');
}
window.mqCloseBarDetail=function(){
  GLK_MQ_DETAIL_IDX=-1;
  GLK_MQ_DETAIL_GROUP_IDX=-1;
  GLK_MQ_DETAIL_BID_IDX=-1;
  MQ_OVERDUE_OPEN=false;
  if(!GLK_MQ_PT_DETAIL){
    var p=el('mqBarDetailPanel'); if(p){ p.style.display='none'; p.innerHTML=''; }
  }
  if(GLK_MQ_LAST_BARS) mqSyncChartLabels(CHARTS.mobileQtd,GLK_MQ_LAST_BARS);
  if(CHARTS.mobileQtd) CHARTS.mobileQtd.update('none');
};
function mqToggleBarDetail(idx,bars,barMeta){
  var p=el('mqBarDetailPanel'); if(!p) return;
  if(GLK_MQ_DETAIL_IDX===idx){ mqCloseBarDetail(); return; }
  mqCloseProductTableDetail();
  GLK_MQ_DETAIL_IDX=idx;
  GLK_MQ_DETAIL_GROUP_IDX=-1;
  GLK_MQ_DETAIL_BID_IDX=-1;
  GLK_MQ_SHOW_WON_EXCLUDED=false;
  GLK_MQ_DETAIL_SEARCH='';
  GLK_MQ_DETAIL_FILTER_STATUS='';
  GLK_MQ_DETAIL_FILTER_VERT='';
  GLK_MQ_LAST_BARS=bars;
  GLK_MQ_LAST_BAR_META=barMeta;
  mqRefreshBarDetailPanel();
  p.scrollIntoView({behavior:'smooth',block:'nearest'});
}
function glkMobileQtdFloatBar(b){ return [b.displayStart,b.displayEnd]; }
function glkMobileQtdMinPxPlugin(bars,minPx){
  minPx=minPx||24;
  return {id:'mqMinPx',afterLayout:function(chart){
    var meta=chart.getDatasetMeta(0);
    if(!meta||!meta.data) return;
    meta.data.forEach(function(bar,i){
      var b=bars[i];
      if(!b) return;
      if(b.section!=='won'&&b.section!=='gross'&&b.type!=='increase'&&b.type!=='decrease') return;
      if(b.type==='base'||b.type==='total'||b.type==='target'||b.type==='empty') return;
      if(bar.base==null||bar.y==null||isNaN(bar.base)||isNaN(bar.y)) return;
      var h=Math.abs(bar.base-bar.y);
      if(h>=minPx) return;
      if(b.type==='decrease') bar.y=bar.base+minPx;
      else bar.y=bar.base-minPx;
    });
  }};
}
function mqSignedBarValue(b){
  if(b&&b.signedValue!=null&&b.signedValue!=='') return num(b.signedValue);
  return num(b&&b.value);
}
function mqFormatBridgeBarLabel(b){
  var val=mqSignedBarValue(b);
  if(b.isPlaceholder&&val===0) return '+0';
  if(b.type==='decrease') return '-'+fmtLines(Math.abs(val));
  if(b.type==='increase'||b.type==='base') return (val<0?'-':'+')+fmtLines(Math.abs(val));
  if(b.type==='total'||b.type==='target'||b.type==='gap'||b.type==='growth') return (val<0?'-':'')+fmtLines(Math.abs(val));
  return fmtLines(val);
}
function mqBarTooltipLines(b){
  var val=mqSignedBarValue(b);
  var sign=val<0?'-':'';
  var lines=['Value: '+sign+fmtLines(Math.abs(val))+(b.type==='decrease'?' (churn)':'')];
  if(b.bids&&b.bids.length) lines.push(b.bids.length+' account(s) · click bar for details');
  else if(b.vertBreakdown&&b.vertBreakdown.length) lines.push('Click bar for vertical split');
  return lines;
}
function glkMobileQtdBracketPlugin(bars){
  return {id:'mqBrackets',afterDatasetsDraw:function(chart){
    var meta=chart.getDatasetMeta(0), ctx=chart.ctx, area=chart.chartArea;
    if(!meta||!meta.data) return;
    var groups=[];
    bars.forEach(function(b,i){
      if(!b.bracketGroup) return;
      var g=groups.find(function(x){return x.id===b.bracketGroup;});
      if(!g) groups.push(g={id:b.bracketGroup,label:b.bracketLabel||b.bracketGroup,start:i,end:i});
      else g.end=i;
    });
    groups.forEach(function(g){
      var b0=meta.data[g.start], b1=meta.data[g.end];
      if(!b0||!b1) return;
      var x1=b0.x-(b0.width||16)/2-4, x2=b1.x+(b1.width||16)/2+4;
      var y=area.bottom+2;
      ctx.save(); ctx.strokeStyle='rgba(100,116,139,.6)'; ctx.lineWidth=1.2; ctx.fillStyle='#64748b';
      ctx.font='700 8px Inter'; ctx.textAlign='center';
      ctx.beginPath(); ctx.moveTo(x1,y); ctx.lineTo(x1,y+5); ctx.lineTo(x2,y+5); ctx.lineTo(x2,y); ctx.stroke();
      ctx.fillText(g.label,(x1+x2)/2,y+14);
      ctx.restore();
    });
  }};
}
function glkMobileQtdLabelPlugin(bars){
  return {id:'mqLabels',afterDatasetsDraw:function(chart){
    var ctx=chart.ctx,meta=chart.getDatasetMeta(0), area=chart.chartArea;
    if(!meta||!meta.data||!area) return;
    meta.data.forEach(function(bar,i){
      var b=bars[i]; if(!b) return;
      var val=mqSignedBarValue(b), top=Math.min(bar.y,bar.base), bot=Math.max(bar.y,bar.base), h=bot-top;
      ctx.save();
      var lbl=mqFormatBridgeBarLabel(b);
      if(b.type==='empty'){
        ctx.fillStyle='#64748b';
        ctx.font='bold 11px Inter';
        ctx.textBaseline='bottom';
        ctx.fillText('0',bar.x,top-4);
        ctx.restore(); return;
      }
      ctx.font='bold 12px Inter';
      ctx.textAlign='center';
      ctx.textBaseline='bottom';
      var tw=ctx.measureText(lbl).width+10;
      var th=18;
      var lx=bar.x, ly=top-6;
      if(ly-th<area.top+2) ly=area.top+2+th;
      var pillColor=b.color||MQ_CLR_INFLIGHT[0];
      if(b.type==='base') pillColor=MQ_CLR_ACTUALS;
      else if(b.section==='won') pillColor=MQ_CLR_WON;
      else if(b.type==='total') pillColor=MQ_CLR_NET;
      else if(b.type==='target') pillColor=MQ_CLR_TARGET;
      ctx.fillStyle='rgba(255,255,255,.96)';
      ctx.strokeStyle=pillColor;
      ctx.lineWidth=1.5;
      ctx.beginPath();
      if(ctx.roundRect) ctx.roundRect(lx-tw/2,ly-th,tw,th,4);
      else ctx.rect(lx-tw/2,ly-th,tw,th);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle=pillColor;
      ctx.fillText(lbl,lx,ly-3);
      if(GLK_MQ_DETAIL_IDX===i){
        ctx.strokeStyle='rgba(99,102,241,.9)'; ctx.lineWidth=2.5;
        ctx.strokeRect(bar.x-(bar.width||14)/2-3,top-3,(bar.width||14)+6,h+6);
      }
      ctx.restore();
    });
  }};
}
function glkMobileQtdSepPlugin(churnSepIdx,c){
  return {id:'mqSep',afterDraw:function(chart){
    if(churnSepIdx<0) return;
    var meta=chart.getDatasetMeta(0);
    if(!meta||!meta.data[churnSepIdx]) return;
    var bar=meta.data[churnSepIdx], ctx=chart.ctx, area=chart.chartArea;
    var x=bar.x-(bar.width||20)*0.55;
    ctx.save(); ctx.strokeStyle='rgba(100,116,139,.55)'; ctx.lineWidth=1.5; ctx.setLineDash([5,5]);
    ctx.beginPath(); ctx.moveTo(x,area.top); ctx.lineTo(x,area.bottom+8); ctx.stroke();
    ctx.restore();
  }};
}
function renderMobileQtdBridge(){
  destroyChart('mobileQtd');
  mqCloseBarDetail();
  mqSyncYtdManualPanel();
  var c=getChartColors();
  var calc=glkMobileQtdCalc();
  var isForward=calc.isForward;
  var isFutureQuarter=calc.isFutureQuarter;
  var skipActualsTarget=isForward||isFutureQuarter;
  var periodLbl=mqPeriodShortName(calc.bridgePeriod);
  var periodLong=mqPeriodLongName(calc.bridgePeriod);
  var badge=el('mqTargetBadge');
  if(badge){
    if(isForward){
      badge.textContent='Fixed · '+periodLong+' · MRC + OTC · '+calc.vertical;
    }else if(isFutureQuarter){
      var scopeF=calc.vertical==='GLK Overall'?'GLK Overall':'Vertical: '+calc.vertical;
      badge.textContent=scopeF+' · Q'+calc.quarter+' '+calc.year+' pipeline preview · actuals & target N/A';
    }else{
      var scope=calc.vertical==='GLK Overall'?'GLK Overall':'Vertical: '+calc.vertical;
      var actLbl=mqActualsBarLabel();
      badge.textContent=scope+' · '+actLbl+' '+fmtLines(calc.actualsQtd)+' · Target '+fmtLines(calc.target);
    }
  }
  var sub=el('mqBridgeSubtitle');
  if(sub){
    if(isForward){
      sub.textContent=mqCaseDisplayName(calc.isBest?'best':'worst')+' · '+(calc.isBest?'Proposed + Opportunity':'Proposed only')+' · '+periodLong+' · Won + Needle Movers · (days÷month days)×MRC + OTC';
    }else if(isFutureQuarter){
      sub.textContent=mqCaseDisplayName(calc.isBest?'best':'worst')+' · '+(calc.isBest?'Proposed + Opportunity':'Proposed only')+
        ' · Q'+calc.quarter+' '+calc.year+' · Full-quarter pipeline · Won + Needle Movers + Churn · No actuals or target yet';
    }else{
      var ytdNote=mqIsYtdBridge()?' · YTD Jan–'+((GLK_YTD_META.currentMonth&&GLK_YTD_META.currentMonth.label)||'current month'):'';
      sub.textContent=mqCaseDisplayName(calc.isBest?'best':'worst')+' · '+(calc.isBest?'Proposed + Opportunity':'Proposed only')+
        (mqIsYtdBridge()?(' · YTD '+calc.year+ytdNote+' · Pipeline = QTG (current month → quarter-end)'):(' · Q'+calc.quarter+' '+calc.year))+
        (mqIsYtdBridge()?'':' · '+mqMetricUnit()+' · Act: current month → quarter-end');
    }
  }
  if(!isForward&&!mqGetActiveReport()){
    var wrap=el('mobileQtdSummaryWrap');
    var chartWrap=el('mqChartWrap');
    var msg='No '+(mqProductFamily==='fixed'?'Fixed Net MRC':'Mobile Net Adds – Lines')+' section in the uploaded GLK report.';
    if(wrap) wrap.innerHTML='<span style="color:#f59e0b;">'+msg+' Re-upload the daily GLK Excel or switch product family.</span>';
    if(chartWrap) chartWrap.innerHTML='<div style="display:flex;align-items:center;justify-content:center;height:340px;color:var(--t3);font-size:.82rem;text-align:center;padding:1rem;">'+msg+'</div>';
    if(badge) badge.textContent='Target: —';
    mqRenderMobileProductTable(null);
    return;
  }
  var chartWrapReset=el('mqChartWrap');
  if(chartWrapReset&&!chartWrapReset.querySelector('canvas')) chartWrapReset.innerHTML='<canvas id="chartMobileQtd"></canvas><div id="mqVertOnChart"></div>';
  var bars=[],barMeta=[],churnSepIdx=-1;
  var trueCum=0,dispTop=0;
  var scaleMax=Math.max(calc.target,Math.abs(calc.actualsQtd),Math.abs(calc.forecast),1);
  var minTileH=Math.max(scaleMax*0.025,2);
  function dispH(v,isPlaceholder,exact){
    var n=num(v);
    var a=Math.abs(n);
    if(isPlaceholder) return Math.max(scaleMax*0.014,28);
    if(exact) return n;
    if(a>0) return Math.max(a,minTileH);
    return minTileH;
  }
  function dispDelta(v,isPlaceholder){
    var n=num(v);
    if(n>=0) return dispH(n,isPlaceholder,false);
    return -dispH(n,isPlaceholder,false);
  }
  function pushBar(b,meta){
    bars.push(b); barMeta.push({label:meta||'',bar:b});
  }
  if(!skipActualsTarget){
    var actualsLbl=mqActualsBarLabel();
    var actualsVert=(!calc.activeReportLevels.length&&calc.actualsByVertical)?calc.actualsByVertical.map(function(v){return {name:v.name,value:v.actualQtd};}):null;
    var actVal=calc.actualsRaw;
    trueCum=actVal; dispTop=actVal;
    pushBar({
      value:actVal,signedValue:actVal,trueCum:trueCum,displayStart:0,displayEnd:dispH(actVal,actVal===0,true),
      color:MQ_CLR_ACTUALS,type:'base',custName:actualsLbl,section:'actuals',bids:[],
      vertBreakdown:actualsVert
    },actualsLbl+' · '+mqFormatBridgeBarLabel({type:'base',signedValue:actVal,value:actVal})+(calc.reportScopeMissing?' (vertical not in report!)':''));
    dispTop=dispH(actVal,actVal===0,true);
    var wonLbl=mqWonBarLabel(calc);
    var wonVal=calc.gross100||0;
    var wonBids=calc.gross100Bids||[];
    var wonPlaceholder=wonVal===0&&!wonBids.length;
    trueCum+=wonVal;
    var g0s=dispTop,g0e=dispTop+dispDelta(wonVal,wonPlaceholder); dispTop=g0e;
    pushBar({
      value:wonVal,trueCum:trueCum,displayStart:g0s,displayEnd:g0e,color:MQ_CLR_WON,type:'increase',
      custName:wonLbl,section:wonPlaceholder?'actuals':'won',bids:wonBids,minPx:true,isPlaceholder:wonPlaceholder,
      vertBreakdown:(calc.activeReportLevels&&calc.activeReportLevels.length)?null:mqVerticalBreakdown(wonBids||[],mqBidMetric)
    },wonLbl+' · '+fmtLines(wonVal)+(wonPlaceholder?' (none)':''));
  }else{
    trueCum=0; dispTop=0;
    var wonLblF=mqWonBarLabel(calc);
    var wonValF=calc.gross100||0;
    var wonBidsF=calc.gross100Bids||[];
    trueCum+=wonValF;
    var g0sF=dispTop,g0eF=dispTop+dispDelta(wonValF,wonValF===0&&!wonBidsF.length); dispTop=g0eF;
    pushBar({
      value:wonValF,trueCum:trueCum,displayStart:g0sF,displayEnd:g0eF,color:MQ_CLR_WON,type:'increase',
      custName:wonLblF,section:'won',bids:wonBidsF||[],minPx:true,isPlaceholder:wonValF===0&&!wonBidsF.length,
      vertBreakdown:null
    },wonLblF+' · '+fmtLines(wonValF)+(wonValF===0&&!wonBidsF.length?' (none)':''));
  }
  var grossTopItems=calc.grossPool.top.filter(function(p){return p.value;});
  var grossTopLbl=mqInflightTop5Label(grossTopItems.length);
  calc.grossPool.top.forEach(function(p,i){
    if(!p.value) return;
    trueCum+=p.value;
    var ds=dispTop,de=dispTop+dispDelta(p.value); dispTop=de;
    var vHint=mqBridgeShowsVertical(calc)?mqVerticalDisplayHint(p.bids):'';
    pushBar({
      value:p.value,trueCum:trueCum,displayStart:ds,displayEnd:de,
      color:mqInflightBarColor(i),type:'increase',
      custName:p.name,section:'gross',bids:p.bids||[],
      bracketGroup:grossTopItems.length?'top5gross':null,bracketLabel:grossTopLbl,groupLabel:grossTopLbl,
      productBucket:mqProductFamily==='mobile'?mqProductBucketForBids(p.bids):'',
      verticalHint:vHint
    },'Top · '+p.name+' · '+fmtLines(p.value));
  });
  if(calc.grossPool.others!==0){
    trueCum+=calc.grossPool.others;
    var gs=dispTop,ge=dispTop+dispDelta(calc.grossPool.others); dispTop=ge;
    var othersLbl=mqInflightOthersLabel();
    pushBar({
      value:calc.grossPool.others,trueCum:trueCum,displayStart:gs,displayEnd:ge,color:MQ_CLR_INFLIGHT_OTHERS,type:'increase',
      custName:othersLbl,section:'gross',bids:calc.grossPool.othersBids||[],groupLabel:othersLbl
    },othersLbl+' · '+fmtLines(calc.grossPool.others));
  }
  churnSepIdx=bars.length;
  if(!calc.hasChurn){
    pushBar({
      value:0,trueCum:trueCum,displayStart:dispTop,displayEnd:dispTop+dispH(0,true),
      color:MQ_CLR_EMPTY,type:'empty',
      custName:'No Churn',section:'empty',bids:[],groupLabel:'Churn'
    },'No Churn in pipeline');
  }else{
    var churnTopItems=calc.churnPool.top.filter(function(p){return p.value;});
    var churnTopLbl=mqChurnTopLabel(churnTopItems.length);
    calc.churnPool.top.forEach(function(p,i){
      if(!p.value) return;
      trueCum+=p.value;
      var cs=dispTop,ce=dispTop+dispDelta(p.value); dispTop=ce;
      var vHintC=mqBridgeShowsVertical(calc)?mqVerticalDisplayHint(p.bids):'';
      pushBar({
        value:p.value,trueCum:trueCum,displayStart:cs,displayEnd:ce,color:mqChurnBarColor(i),type:'decrease',
        custName:p.name,section:'churn',bids:p.bids||[],
        bracketGroup:churnTopItems.length?'top5churn':null,bracketLabel:churnTopLbl,groupLabel:churnTopLbl,
        productBucket:mqProductFamily==='mobile'?mqProductBucketForBids(p.bids):'',
        verticalHint:vHintC
      },'Top Churn · '+p.name+' · '+fmtLines(p.value));
    });
    if(calc.churnPool.others!==0){
      trueCum+=calc.churnPool.others;
      var os=dispTop,oe=dispTop+dispDelta(calc.churnPool.others); dispTop=oe;
      pushBar({
        value:calc.churnPool.others,trueCum:trueCum,displayStart:os,displayEnd:oe,color:MQ_CLR_CHURN_OTHERS,type:'decrease',
        custName:'Others Churn',section:'churn',bids:calc.churnPool.othersBids||[],groupLabel:'Others Churn'
      },'Others Churn · '+fmtLines(calc.churnPool.others));
    }
  }
  var fc=num(calc.forecast);
  var netLbl=isForward?('Total '+periodLong):(isFutureQuarter?('Pipeline forecast Q'+calc.quarter):'Net Forecast');
  var netMinH=Math.max(minTileH*2,scaleMax*0.04);
  var netStart=fc>=0?0:Math.min(fc,-netMinH);
  var netEnd=fc>=0?Math.max(fc,netMinH):0;
  pushBar({value:fc,trueCum:fc,displayStart:netStart,displayEnd:netEnd,color:MQ_CLR_NET,type:'total',custName:netLbl,section:'outcome',minLabel:true,forecastBreakdown:true},netLbl+' · '+fmtLines(fc));
  if(!skipActualsTarget){
    var tgtDisp=calc.target;
    pushBar({value:calc.target,trueCum:calc.target,displayStart:0,displayEnd:tgtDisp,color:MQ_CLR_TARGET,type:'target',custName:'Target',section:'outcome'},'Target · '+fmtLines(calc.target));
    if(calc.target>0){
      if(calc.gap>0){
        var fPos=Math.max(0,fc);
        var gs2=Math.min(fPos,tgtDisp),ge2=Math.max(fPos,tgtDisp);
        if(ge2===gs2) ge2=gs2+dispH(calc.gap,false,true);
        pushBar({value:calc.gap,trueCum:calc.target,displayStart:gs2,displayEnd:ge2,color:MQ_CLR_GAP,type:'gap',custName:'Gap to Target',section:'outcome'},'Gap · '+fmtLines(calc.gap));
      }else if(calc.growth>0){
        var gs3=tgtDisp,ge3=tgtDisp+dispH(calc.growth,false,true);
        pushBar({value:calc.growth,trueCum:calc.target,displayStart:gs3,displayEnd:ge3,color:MQ_CLR_GROWTH,type:'growth',custName:'Growth vs Target',section:'outcome'},'Growth · +'+fmtLines(calc.growth));
      }
    }
  }
  var yMin=0,yMax=Math.max(Math.abs(calc.forecast),skipActualsTarget?0:calc.target,skipActualsTarget?0:Math.abs(calc.actualsQtd),1);
  bars.forEach(function(b){
    yMin=Math.min(yMin,b.displayStart,b.displayEnd,num(b.trueCum),num(b.value));
    yMax=Math.max(yMax,b.displayStart,b.displayEnd,Math.abs(b.trueCum||0),Math.abs(b.value));
  });
  if(yMin>0) yMin=0;
  yMin*=1.08;
  yMax*=1.08;
  var maxNameLen=0;
  bars.forEach(function(b){ maxNameLen=Math.max(maxNameLen,String(b.custName||'').length); });
  var scrollWrap=el('mqBridgeScroll');
  var parentW=scrollWrap?scrollWrap.clientWidth:900;
  var idealSlot=Math.floor((parentW-28)/Math.max(bars.length,1));
  var barSlot=Math.max(52,Math.min(78,idealSlot));
  if(maxNameLen>16) barSlot=Math.max(barSlot,Math.min(86,maxNameLen*4.2));
  var contentW=bars.length*barSlot+28;
  var minChartW=contentW>parentW?contentW:parentW;
  var axisPad=8;
  var chartOuter=el('mqChartOuter');
  var chartWrap=el('mqChartWrap');
  if(chartOuter) chartOuter.style.minWidth=minChartW+'px';
  GLK_MQ_LAST_BAR_SLOT=barSlot;
  GLK_MQ_LAST_CHART_W=minChartW;
  var canvas=el('chartMobileQtd');
  if(!canvas) return;
  canvas.style.cursor='pointer';
  var plugins=[
    glkMobileQtdSectionPlugin(bars),
    glkMobileQtdFlowPlugin(bars),
    glkMobileQtdMinPxPlugin(bars,26),
    glkMobileQtdLabelPlugin(bars),
    glkMobileQtdSepPlugin(churnSepIdx,c)
  ];
  if(typeof Chart!=='undefined') Chart.defaults.devicePixelRatio=Math.min(window.devicePixelRatio||1,2.5);
  try{
    CHARTS.mobileQtd=new Chart(canvas,{
      type:'bar', plugins:plugins,
      data:{labels:bars.map(function(b){return b.custName||'';}),datasets:[{
        data:bars.map(glkMobileQtdFloatBar),
        backgroundColor:bars.map(function(b){return b.isPlaceholder?MQ_CLR_EMPTY+'99':b.color;}),
        borderColor:bars.map(function(b){
          if(b.type==='total') return '#4338ca';
          if(b.type==='target') return '#155e75';
          if(b.type==='growth') return '#15803d';
          if(b.type==='gap') return '#b91c1c';
          return 'transparent';
        }),
        borderWidth:bars.map(function(b){return (b.type==='total'||b.type==='target'||b.type==='growth'||b.type==='gap')?2:0;}),
        borderRadius:6,borderSkipped:false,
        barPercentage:.88,categoryPercentage:.92,minBarLength:0,maxBarThickness:52
      }]},
      options:{responsive:true,maintainAspectRatio:false,
        layout:{padding:{bottom:axisPad,top:28,left:4,right:8}},
        animation:{duration:0},
        onClick:function(evt,elements){
          if(!elements.length){ mqCloseBarDetail(); return; }
          mqToggleBarDetail(elements[0].index,bars,barMeta);
        },
        interaction:{mode:'index',intersect:false},
        plugins:{legend:{display:false},tooltip:{
          backgroundColor:'rgba(15,10,30,.92)',padding:12,cornerRadius:10,titleFont:{size:12,weight:'700'},bodyFont:{size:11},
          callbacks:{
            title:function(items){var m=barMeta[items[0].dataIndex]; return m?m.label:'';},
            label:function(ctx){return null;},
            afterBody:function(items){
              var b=bars[items[0].dataIndex];
              return b?mqBarTooltipLines(b):[];
            }
          }}},
        scales:{
          x:{ticks:{display:false,color:c.text,font:{size:9,weight:'600'}},grid:{display:false},
            border:{display:true,color:c.grid}},
          y:{min:yMin,max:yMax,ticks:{color:c.text,font:{size:12,weight:'600'},callback:function(v){return fmtLines(v);}},grid:{color:c.grid},
            title:{display:true,text:(isForward?('Aggregated Revenue (MRC + OTC)'):mqMetricUnit())+' · '+mqCaseDisplayName(calc.isBest?'best':'worst'),color:c.text,font:{size:11,weight:'700'}}}
        }
      }
    });
  }catch(err){ console.error('[GLK] Mobile QTD chart error:',err); }
  GLK_MQ_LAST_BARS=bars;
  GLK_MQ_LAST_BAR_META=barMeta;
  mqSyncChartLabels(CHARTS.mobileQtd,bars);
  mqRenderBridgeLegend();
  var sum=el('mobileQtdSummaryWrap');
  if(sum){
    if(isForward){
      var wonLblS=mqWonBarLabel(calc);
      sum.innerHTML='<strong>'+mqCaseDisplayName(calc.isBest?'best':'worst')+' · '+periodLong+'</strong> · '+wonLblS+' '+fmtLines(calc.gross100)+
        ' · Needle Movers '+fmtLines(calc.inflightGross)+
        ' · Churn '+fmtLines(calc.inflightChurn)+
        ' · Total '+fmtLines(calc.forecast)+' · (days÷month days)×MRC + OTC';
    }else{
      var gapTxt=calc.gap>0
        ?'<span style="color:'+MQ_CLR_GAP+';">'+fmtLines(calc.gap)+' short of target</span>'
        :'<span style="color:'+MQ_CLR_GROWTH+';">+'+fmtLines(calc.growth)+' ahead of target</span>';
      var actLbl2=mqActualsBarLabel();
      var ytdWarn='';
      (GLK_YTD_META.warnings||[]).forEach(function(w){
        if(w.type==='no_live_sheet') ytdWarn+=' · <span style="color:#f59e0b;">⚠ '+w.message+'</span>';
        if((w.type==='ytd_target_missing'||w.type==='mobile_q1_missing')&&(!w.product||w.product===mqProductFamily)){
          ytdWarn+=' · <span style="color:#f59e0b;">⚠ '+w.message+'</span>';
        }
      });
      if(mqIsYtdBridge()&&mqProductFamily==='mobile'&&calc.ytdMissing&&calc.ytdMissing.length){
        ytdWarn+=' · <span style="color:#f59e0b;">⚠ Missing: '+calc.ytdMissing.join(', ')+' — enter below</span>';
      }
      if(mqIsYtdBridge()&&mqProductFamily==='mobile'&&calc.activeReportLevels&&calc.activeReportLevels.length){
        ytdWarn+=' · <span style="color:#92400e;">Per-vertical targets: update Net Add Lines › Target in the Excel file</span>';
      }
      if(mqIsYtdBridge()&&mqProductFamily==='fixed'&&calc.target>0&&calc.target<500000){
        ytdWarn+=' · <span style="color:#f59e0b;">⚠ Fixed YTD target looks wrong — reload Excel (expect Total from history sheet, e.g. 14,982,111)</span>';
      }
      var cm=GLK_YTD_META.currentMonth;
      var cmTxt=cm?(' · Live month: '+cm.label+' '+cm.year):'';
      sum.innerHTML='<strong>'+mqCaseDisplayName(calc.isBest?'best':'worst')+'</strong> · '+actLbl2+' '+fmtLines(calc.actualsQtd)+
        ' · Gross Won '+fmtLines(calc.gross100)+
        ' · Needle Movers '+fmtLines(calc.inflightGross)+
        ' · Churn '+fmtLines(calc.inflightChurn)+
        ' · Net Forecast '+fmtLines(calc.forecast)+
        ' · Target '+fmtLines(calc.target)+' · '+gapTxt+cmTxt+ytdWarn;
    }
  }
  mqRenderMobileProductTable(calc);
  mqUpdateOverdueButtonCount();
}
function glkMobileQtdInit(skipSpLoad){
  glkInitBridgeEnterBlock();
  mqUpdateOverdueButtonCount();
  mqLoadMobileYtdManual();
  mqInitControlsPanel();
  mqSyncBridgeControlsUi();
  if(skipSpLoad) return;
  glkMobileReportRefreshFromSharePoint();
}
function glkEnsureTrendsLoaded(forcePaint){
  var metaEl=el('rrReportMeta');
  function finish(err){
    window._glkTrendsLoading=false;
    window._GLK_TRENDS_SP_LOADED=true;
    if(err) console.warn('[GLK] Trends SharePoint load:',err.message);
    if(forcePaint||GLK_ACTIVE_NAV==='navRevenueRec') glkPaintTrends();
    else rrRefreshMeta();
  }
  if(RR_PARSED&&Object.keys(RR_PARSED).length){
    rrBuildChartTabs();
    if(forcePaint||GLK_ACTIVE_NAV==='navRevenueRec') glkPaintTrends();
  }else if(metaEl&&(forcePaint||GLK_ACTIVE_NAV==='navRevenueRec')){
    metaEl.textContent='Loading from SharePoint…';
  }
  if(window._glkTrendsLoading) return;
  if(window._GLK_TRENDS_SP_LOADED&&RR_PARSED&&Object.keys(RR_PARSED).length) return;
  window._glkTrendsLoading=true;
  rrTryLoadFromSharePoint(function(err){
    if(err){
      rrTryLoadBundledWorkbook(function(loadErr){ finish(loadErr||err); });
      return;
    }
    finish(null);
  });
}
function mqStripHtml(s){
  var d=document.createElement('div');
  d.innerHTML=s||'';
  return (d.textContent||d.innerText||'').trim();
}
function mqCaptureBridgeForExport(cb){
  var scroll=el('mqBridgeScroll');
  var outer=el('mqChartOuter');
  var chart=CHARTS.mobileQtd;
  if(!scroll||!outer||!chart){
    return cb(new Error('Chart not ready. Open Performance Bridge after the report loads.'));
  }
  if(typeof html2canvas==='undefined'){
    try{ return cb(null,chart.toBase64Image('image/png',2)); }
    catch(e){ return cb(new Error('Capture libraries not loaded')); }
  }
  var prevOverflow=scroll.style.overflow;
  var prevScroll=scroll.scrollLeft;
  var prevOuterMin=outer.style.minWidth;
  var prevOuterW=outer.style.width;
  scroll.style.overflow='visible';
  scroll.scrollLeft=0;
  var fullW=Math.max(outer.scrollWidth,outer.offsetWidth,scroll.scrollWidth);
  outer.style.minWidth=fullW+'px';
  outer.style.width=fullW+'px';
  if(CHARTS.mobileQtd) CHARTS.mobileQtd.resize();
  mqSyncChartLabels(CHARTS.mobileQtd,GLK_MQ_LAST_BARS||[]);
  setTimeout(function(){
    html2canvas(scroll,{
      scale:1.75,
      backgroundColor:'#ffffff',
      useCORS:true,
      allowTaint:true,
      logging:false,
      scrollX:0,
      scrollY:-window.scrollY,
      width:fullW,
      windowWidth:fullW+80,
      foreignObjectRendering:false
    }).then(function(canvas){
      scroll.style.overflow=prevOverflow;
      scroll.scrollLeft=prevScroll;
      outer.style.minWidth=prevOuterMin;
      outer.style.width=prevOuterW;
      if(CHARTS.mobileQtd) CHARTS.mobileQtd.resize();
      mqSyncChartLabels(CHARTS.mobileQtd,GLK_MQ_LAST_BARS||[]);
      cb(null,canvas.toDataURL('image/png'));
    }).catch(function(err){
      scroll.style.overflow=prevOverflow;
      scroll.scrollLeft=prevScroll;
      outer.style.minWidth=prevOuterMin;
      outer.style.width=prevOuterW;
      if(CHARTS.mobileQtd) CHARTS.mobileQtd.resize();
      try{ cb(null,chart.toBase64Image('image/png',2)); }
      catch(e2){ cb(err||e2); }
    });
  },120);
}
function mqGetPptxCtor(){
  if(typeof PptxGenJS!=='undefined') return PptxGenJS;
  if(typeof pptxgen!=='undefined') return pptxgen;
  if(window.PptxGenJS) return window.PptxGenJS;
  return null;
}
function mqBuildPptProductTableRows(ptData,accHex){
  accHex=accHex||mqThemeAccentHex();
  var tblRows=[[
    {text:'Product',options:{bold:true,color:'FFFFFF',fill:'475569',fontSize:9,align:'left'}},
    {text:'Gross Add Lines QTG',options:{bold:true,color:'FFFFFF',fill:'2563EB',fontSize:9,align:'right'}},
    {text:'Churn (Lines) QTG',options:{bold:true,color:'FFFFFF',fill:'EA580C',fontSize:9,align:'right'}},
    {text:'Net Add Lines QTG',options:{bold:true,color:'FFFFFF',fill:'7C3AED',fontSize:9,align:'right'}},
    {text:'WoW',options:{bold:true,color:'FFFFFF',fill:accHex,fontSize:9,align:'right'}}
  ]];
  ptData.rows.forEach(function(r,idx){
    var rowFill=idx%2===0?'FFFFFF':'F9F0FF';
    if(r.key==='total') rowFill='F3E8FF';
    var wowTxt='—', wowColor='64748B';
    if(r.wowPct!=null&&!isNaN(r.wowPct)){
      wowTxt=(r.wowPct>=0?'▲ ':'▼ ')+Math.abs(r.wowPct).toFixed(0)+'%';
      wowColor=r.wowPct>=0?'16A34A':'DC2626';
    }
    tblRows.push([
      {text:String(r.label||''),options:{bold:r.key==='total',fontSize:9,fill:rowFill,align:'left'}},
      {text:String(mqFmtProductLines(r.gross)),options:{fontSize:9,align:'right',color:'1D4ED8',fill:'EFF6FF',bold:r.key==='total'}},
      {text:String(mqFmtProductLines(r.churn)),options:{fontSize:9,align:'right',color:'C2410C',fill:'FFF7ED',bold:r.key==='total'}},
      {text:String(mqFmtProductLines(r.net)),options:{fontSize:9,align:'right',color:'6D28D9',fill:'F5F3FF',bold:r.key==='total'}},
      {text:wowTxt,options:{fontSize:9,align:'right',color:wowColor,fill:rowFill,bold:r.key==='total'}}
    ]);
  });
  return tblRows;
}
window.mqExportBridgePpt=function(){
  var PptxCtor=mqGetPptxCtor();
  if(!PptxCtor){
    alert('PowerPoint library still loading. Wait a few seconds and try again.');
    return;
  }
  if(!CHARTS.mobileQtd||!mqGetActiveReport()){
    alert('Upload the GLK report and wait for the bridge chart to render before exporting.');
    return;
  }
  glkShowLoader('Building PowerPoint…');
  mqCaptureBridgeForExport(function(err,imgData){
    if(err||!imgData){
      glkHideLoader();
      alert('Could not capture chart: '+(err?err.message:'unknown error'));
      return;
    }
    try{
      var calc=GLK_MQ_CALC_LAST||{};
      var bridgePer=calc.bridgePeriod||mqPeriod;
      var bridgeTitle=mqProductFamily==='fixed'
        ?('Fixed '+((bridgePer==='qtg'||bridgePer==='ytg')?mqPeriodLongName(bridgePer):('Net MRC — '+mqPeriodLongName(bridgePer))))
        :('Mobile Net Add Lines — '+mqPeriodLongName(bridgePer));
      var pptx=new PptxCtor();
      pptx.layout='LAYOUT_WIDE';
      pptx.author='Sales Excellence & Governance Portal';
      pptx.title=bridgeTitle;
      pptx.subject=mqPeriodLongName(calc.bridgePeriod||mqPeriod)+' Export';
      var slide=pptx.addSlide();
      var accHex=mqThemeAccentHex();
      slide.background={color:'FFFFFF'};
      slide.addText(bridgeTitle,{
        x:0.35,y:0.12,w:12.5,h:0.42,fontSize:22,bold:true,color:'1E1133',fontFace:'Arial'
      });
      var caseLbl=mqCaseDisplayName(calc.isBest?'best':'worst');
      var qLbl=calc.quarter&&calc.year?('Q'+calc.quarter+' '+calc.year):'';
      var scopeLbl=calc.vertical||'GLK Overall';
      slide.addText(caseLbl+(qLbl?(' · '+qLbl):'')+' · '+scopeLbl,{
        x:0.35,y:0.52,w:12.5,h:0.28,fontSize:11,color:'64748B',fontFace:'Arial'
      });
      var badge=el('mqTargetBadge');
      if(badge&&badge.textContent){
        slide.addText(badge.textContent,{x:0.35,y:0.78,w:12.5,h:0.22,fontSize:10,bold:true,color:accHex,fontFace:'Arial'});
      }
      var sumEl=el('mobileQtdSummaryWrap');
      var sumTxt=sumEl?mqStripHtml(sumEl.innerHTML):'';
      var metaY=0.98;
      if(sumTxt){
        slide.addText(sumTxt,{x:0.35,y:metaY,w:12.5,h:0.22,fontSize:9,color:'475569',fontFace:'Arial'});
        metaY+=0.24;
      }
      var imgY=Math.max(1.05,metaY+0.08);
      slide.addImage({data:imgData,x:0.2,y:imgY,w:12.9,h:5.85});
      var legEl=el('mqBridgeLegend');
      if(legEl&&legEl.textContent){
        slide.addText(legEl.textContent,{x:0.35,y:7.05,w:12.5,h:0.28,fontSize:8,color:'64748B',fontFace:'Arial'});
      }
      if(mqProductFamily==='mobile'&&!calc.isForward){
        var allPt=mqCalcVisibleMobileProductTables(calc);
        var byScope={};
        (allPt||[]).forEach(function(t){
          if(!byScope[t.scopeKey]) byScope[t.scopeKey]={label:t.scope,tables:[]};
          byScope[t.scopeKey].tables.push(t);
        });
        Object.keys(byScope).forEach(function(sk){
          var grp=byScope[sk];
          var slide2=pptx.addSlide();
          slide2.background={color:'FFFFFF'};
          slide2.addText(grp.label+' · Mobile Net Add Lines QTG',{
            x:0.35,y:0.15,w:12.5,h:0.35,fontSize:18,bold:true,color:'1E1133',fontFace:'Arial'
          });
          slide2.addText((qLbl?qLbl+' · ':'')+mqPeriodLongName(calc.bridgePeriod||mqPeriod),{
            x:0.35,y:0.48,w:12.5,h:0.22,fontSize:10,color:'64748B',fontFace:'Arial'
          });
          grp.tables.forEach(function(ptData,idx){
            var xPos=idx===0?0.35:6.75;
            slide2.addText(String(ptData.scenario||''),{
              x:xPos,y:0.78,w:5.8,h:0.2,fontSize:10,bold:true,color:ptData.scenarioKey==='best'?'16A34A':'4F46E5',fontFace:'Arial'
            });
            slide2.addTable(mqBuildPptProductTableRows(ptData,accHex),{
              x:xPos,y:1.02,w:6.0,
              colW:[0.95,1.35,1.15,1.35,0.85],
              fontSize:8,border:{type:'solid',pt:0.5,color:'E9D5FF'},align:'left',fontFace:'Arial'
            });
          });
        });
      }
      var dt=new Date().toISOString().slice(0,10);
      var fnScope=String(scopeLbl).replace(/[^\w\s-]+/g,'').trim().replace(/\s+/g,'_')||'GLK';
      var fileName='GLK_Mobile_QTD_Bridge_'+fnScope+'_'+dt+'.pptx';
      var writeResult=pptx.writeFile({fileName:fileName});
      if(writeResult&&typeof writeResult.then==='function'){
        writeResult.then(function(){ glkHideLoader(); }).catch(function(e){
          glkHideLoader();
          console.error('[GLK] PPT write error:',e);
          alert('PowerPoint export failed: '+(e&&e.message?e.message:String(e)));
        });
      }else{
        glkHideLoader();
      }
    }catch(e){
      glkHideLoader();
      console.error('[GLK] PPT export error:',e);
      alert('PowerPoint export failed: '+e.message);
    }
  });
};

// ══════════════════════════════════════════════════════════════════
//  TRENDS — Excel-driven trend charts (3 sheets only)
// ══════════════════════════════════════════════════════════════════
const RR_IDB_NAME='GLKRevenueRecCache';
const RR_IDB_STORE='workbook';
const RR_LS_META_KEY='glk_revenue_rec_meta';
const RR_LS_DATA_KEY='glk_revenue_rec_b64';
const RR_LS_MAX_B64=1800000;
const RR_CHART_DEFS=[
  {
    id:'revRecTrend',
    title:'Rev Rec 2026 vs 2025 Trend',
    subtitle:'Sheet: Rev Rec 2026 vs 2025 Trend · Columns B (Month), C (2025 Revenue), D (2026 Revenue)',
    sheetName:'Rev Rec 2026 vs 2025 Trend',
    valueFmt:'currency',
    yLabel:'Revenue (AED)'
  },
  {
    id:'netAddLines',
    title:'GLK Net Add Lines Trend',
    subtitle:'Sheet: GLK Net Add Lines Trend · Columns B (Month), C/D/E (Actual + Forecasts)',
    sheetName:'GLK Net Add Lines Trend',
    valueFmt:'lines',
    yLabel:'Net Add Lines'
  },
  {
    id:'fixedMrc',
    title:'GLK Fixed Net MRC Trend',
    subtitle:'Sheet: GLK Fixed Net MRC Trend · Columns A (Month), B/C/D/E (YoY + Forecasts)',
    sheetName:'GLK Fixed Net MRC Trend',
    valueFmt:'currency',
    yLabel:'Fixed Net MRC (AED)'
  }
];
const RR_SERIES_HELP={
  revRecTrend:{
    '2025 Revenue':'<strong>Column C — 2025 Revenue</strong> · Monthly revenue recognition actuals for calendar year 2025. Solid blue line in Excel.',
    '2026 Revenue':'<strong>Column D — 2026 Revenue</strong> · Monthly revenue recognition actuals for 2026. Stops where Excel cell is blank (months not yet reported).'
  },
  netAddLines:{
    'GLK Net Add Lines':'<strong>GLK Net Add Lines</strong> · Actual net add lines reported each month (includes negatives e.g. Mar).',
    'Forecast - Most Likely':'<strong>Most Likely</strong> · Month = actual to date + current addition. Quarter = quarter to date + forecast to quarter-end.',
    'Forecast - Upside':'<strong>Upside</strong> · Month = actual to date + current addition. Quarter = quarter to date + forecast to quarter-end.'
  },
  fixedMrc:{
    '2025 Fixed Net MRC':'<strong>Column B — 2025 Fixed Net MRC</strong> · Prior-year monthly fixed net MRC actuals (reference baseline).',
    '2026 Fixed Net MRC':'<strong>Column C — 2026 Fixed Net MRC</strong> · Current-year fixed net MRC actuals month by month.',
    'Forecast - Most Likely':'<strong>Column D — Forecast Most Likely</strong> · Excel add-on for current/forward month. Chart = Col C actual + Col D (already calculated in Excel).',
    'Forecast - Upside':'<strong>Column E — Forecast Upside</strong> · Excel add-on for current/forward month. Chart = Col C actual + Col E (already calculated in Excel).'
  }
};
const RR_SERIES_STYLE={
  '2025 Revenue':{color:'#1d4ed8',dash:[],fill:true,kind:'prior',lw:3.5,pt:6},
  '2026 Revenue':{color:'#ea580c',dash:[],fill:true,kind:'actual',lw:4,pt:7},
  'GLK Net Add Lines':{color:'#2563eb',dash:[],fill:true,kind:'actual',lw:4,pt:7},
  'Forecast - Most Likely':{color:'#7c3aed',dash:[10,5],fill:false,kind:'forecast',lw:3,pt:5},
  'Forecast - Upside':{color:'#059669',dash:[10,5],fill:false,kind:'forecast-up',lw:3,pt:5},
  '2025 Fixed Net MRC':{color:'#0284c7',dash:[8,4],fill:false,kind:'prior',lw:3.5,pt:6},
  '2026 Fixed Net MRC':{color:'#ea580c',dash:[],fill:true,kind:'actual',lw:4,pt:7}
};
function rrSeriesKindFor(s,chartId){
  if((chartId==='fixedMrc'||chartId==='netAddLines')&&s&&s.col){
    if(s.col==='D') return 'forecast';
    if(s.col==='E') return 'forecast-up';
    if(s.col==='C') return 'actual';
    if(s.col==='B') return chartId==='fixedMrc'?'prior':'actual';
  }
  return rrClassifySeries(s&&s.label);
}
function rrKindLineColor(kind,chartId){
  if(kind==='forecast') return '#7c3aed';
  if(kind==='forecast-up') return '#16a34a';
  if(kind==='prior') return chartId==='fixedMrc'?'#0284c7':'#6366f1';
  if(kind==='actual') return chartId==='fixedMrc'?'#ea580c':(chartId==='netAddLines'?'#2563eb':'#ea580c');
  return '#6366f1';
}
function rrSeriesStyleForChart(label,idx,chartId,col){
  var kind=rrSeriesKindFor({label:label,col:col},chartId);
  if(chartId==='fixedMrc'){
    if(kind==='prior') return {color:'#0284c7',dash:[8,4],fill:false,kind:'prior',lw:3.5,pt:6};
    if(kind==='actual') return {color:'#ea580c',dash:[],fill:true,kind:'actual',lw:4,pt:7};
    if(kind==='forecast') return {color:'#7c3aed',dash:[10,5],fill:false,kind:'forecast',lw:3,pt:5};
    if(kind==='forecast-up') return {color:'#16a34a',dash:[10,5],fill:false,kind:'forecast-up',lw:3,pt:5};
  }
  if(chartId==='netAddLines'){
    if(kind==='actual') return Object.assign({},rrSeriesStyle(label,idx),{color:'#2563eb',lw:4,pt:7,kind:'actual'});
    if(kind==='forecast') return {color:'#7c3aed',dash:[10,5],fill:false,kind:'forecast',lw:3,pt:5};
    if(kind==='forecast-up') return {color:'#16a34a',dash:[10,5],fill:false,kind:'forecast-up',lw:3,pt:5};
  }
  return rrSeriesStyle(label,idx);
}
function rrClassifySeries(label){
  var l=String(label||'').toLowerCase();
  if(l.indexOf('upside')>=0) return 'forecast-up';
  if(l.indexOf('forecast')>=0||l.indexOf('most likely')>=0) return 'forecast';
  if(l.indexOf('2025')>=0) return 'prior';
  return 'actual';
}
function rrFixedMrcSeries(data){
  var series=(data&&data.series)||[];
  return {
    prior:series.find(function(s){return s.col==='B'||rrClassifySeries(s.label)==='prior';}),
    actual:series.find(function(s){return s.col==='C';})||series.find(function(s){return rrClassifySeries(s.label)==='actual';}),
    fcMl:series.find(function(s){return s.col==='D';})||series.find(function(s){return rrClassifySeries(s.label)==='forecast';}),
    fcUp:series.find(function(s){return s.col==='E';})||series.find(function(s){return rrClassifySeries(s.label)==='forecast-up';})
  };
}
function rrTrendSignPrefix(n){
  n=num(n);
  if(isNaN(n)||n===0) return '';
  return n<0?'−':'';
}
function rrFmtPoint(v,fmt){
  if(v==null||isNaN(v)) return '';
  var n=num(v), sign=rrTrendSignPrefix(n), a=Math.abs(n);
  if(fmt==='lines') return sign+Math.round(a).toLocaleString('en-US');
  if(a>=1e9) return sign+(a/1e9).toFixed(2)+'B';
  if(a>=1e6) return sign+(a/1e6).toFixed(1)+'M';
  if(a>=1e3) return sign+(a/1e3).toFixed(1)+'K';
  return sign+a.toFixed(0);
}
function rrFmtFull(v,fmt){
  if(v==null||isNaN(v)) return '—';
  var n=num(v), sign=rrTrendSignPrefix(n), a=Math.abs(n);
  if(fmt==='lines'){
    if(a>=1e6) return sign+(a/1e6).toFixed(2)+'M lines';
    if(a>=1e3) return sign+(a/1e3).toFixed(1)+'K lines';
    return sign+Math.round(a).toLocaleString('en-US')+' lines';
  }
  if(a>=1e9) return 'AED '+sign+(a/1e9).toFixed(2)+'B';
  if(a>=1e6) return 'AED '+sign+(a/1e6).toFixed(2)+'M';
  if(a>=1e3) return 'AED '+sign+(a/1e3).toFixed(1)+'K';
  return 'AED '+sign+a.toLocaleString('en-US',{maximumFractionDigits:0});
}
function rrFmtAxis(v,fmt){
  if(v==null||isNaN(v)) return '';
  var n=num(v), sign=rrTrendSignPrefix(n), a=Math.abs(n);
  if(fmt==='lines'){
    if(a>=1000) return sign+(a/1000).toFixed(0)+'K';
    return sign+Math.round(a).toLocaleString('en-US');
  }
  if(a>=1e9) return sign+(a/1e9).toFixed(1)+'B';
  if(a>=1e6) return sign+(a/1e6).toFixed(0)+'M';
  if(a>=1e3) return sign+(a/1e3).toFixed(0)+'K';
  return sign+a.toFixed(0);
}
function rrSeriesStyle(label,idx){
  var st=RR_SERIES_STYLE[label];
  if(st) return Object.assign({kind:rrClassifySeries(label)},st);
  var palette=['#6366f1','#8b5cf6','#ec4899','#f97316','#22c55e','#0ea5e9'];
  var col=palette[idx%palette.length];
  return {color:col,dash:[],fill:col+'22',kind:rrClassifySeries(label),lw:2.5,pt:4};
}
function rrLastActualIdx(seriesList){
  var maxIdx=-1;
  (seriesList||[]).forEach(function(s){
    var kind=rrClassifySeries(s.label);
    if(kind==='forecast'||kind==='forecast-up') return;
    (s.data||[]).forEach(function(v,i){ if(v!=null&&!isNaN(v)) maxIdx=Math.max(maxIdx,i); });
  });
  return maxIdx;
}
function rrProjectionStartIdx(seriesList){
  var start=Infinity;
  (seriesList||[]).forEach(function(s){
    if(rrClassifySeries(s.label)!=='forecast'&&rrClassifySeries(s.label)!=='forecast-up') return;
    (s.data||[]).forEach(function(v,i){ if(v!=null&&!isNaN(v)&&i<start) start=i; });
  });
  return start===Infinity?-1:start;
}
function rrCloneChartData(data){
  if(!data) return null;
  return {
    labels:(data.labels||[]).slice(),
    sheetRef:data.sheetRef,
    monthCol:data.monthCol,
    headerRow:data.headerRow,
    sheetName:data.sheetName,
    series:(data.series||[]).map(function(s){
      return {label:s.label,col:s.col,fmt:s.fmt,data:(s.data||[]).slice()};
    })
  };
}
function rrValuesEqual(a,b){
  if(a==null||b==null||isNaN(a)||isNaN(b)) return false;
  return num(a)===num(b);
}
function rrSanitizeCascadeForecasts(data,chartId){
  if(!data||!data.series) return data;
  if(chartId!=='netAddLines'&&chartId!=='fixedMrc') return data;
  var actual=data.series.find(function(s){return rrClassifySeries(s.label)==='actual';});
  var fcMl=data.series.find(function(s){return rrClassifySeries(s.label)==='forecast';});
  var fcUp=data.series.find(function(s){return rrClassifySeries(s.label)==='forecast-up';});
  if(!actual||(!fcMl&&!fcUp)) return data;
  (actual.data||[]).forEach(function(act,i){
    if(act==null||isNaN(act)||act<=0) return;
    var ml=fcMl?fcMl.data[i]:null;
    var up=fcUp?fcUp.data[i]:null;
    var mlMatch=fcMl&&ml!=null&&!isNaN(ml)&&rrValuesEqual(ml,act);
    var upMatch=fcUp&&up!=null&&!isNaN(up)&&rrValuesEqual(up,act);
    if(mlMatch&&upMatch){
      fcMl.data[i]=null;
      fcUp.data[i]=null;
    }
  });
  return data;
}
function rrTrendPipelineChurn(chartId,isBest){
  if(typeof ALL_BIDS==='undefined'||!ALL_BIDS||!ALL_BIDS.length) return 0;
  var savedPf=mqProductFamily;
  mqProductFamily=chartId==='fixedMrc'?'fixed':'mobile';
  var report=GLK_QTD_REPORT&&GLK_QTD_REPORT[mqProductFamily];
  var year=report?report.year:new Date().getFullYear();
  var quarter=report?report.quarter:Math.floor(new Date().getMonth()/3)+1;
  var base=mqApplyBridgeBaseFilters();
  var getChurnVal=mqBidMetric;
  var activationFn=mqActivationQtdForward;
  if(mqProductFamily==='fixed'&&mqIsYtdBridge()){
    getChurnVal=function(b){return mqBidQtgMrc(b,year,quarter);};
  }
  var pool=mqInflightChurnPools(base,year,quarter,!!isBest,getChurnVal,activationFn);
  mqProductFamily=savedPf;
  return num(pool.total)||0;
}
function rrTrendExcelSeries(data,chartId){
  var series=(data&&data.series)||[];
  if(chartId==='fixedMrc') return rrFixedMrcSeries(data);
  return {
    actual:series.find(function(s){return s.col==='C';})||series.find(function(s){return rrClassifySeries(s.label)==='actual';}),
    fcMl:series.find(function(s){return s.col==='D';})||series.find(function(s){return rrClassifySeries(s.label)==='forecast';}),
    fcUp:series.find(function(s){return s.col==='E';})||series.find(function(s){return rrClassifySeries(s.label)==='forecast-up';})
  };
}
function rrApplyTrendExcelProjections(data,chartId){
  if(!data||!data.series) return data;
  var ts=rrTrendExcelSeries(data,chartId);
  var actual=ts.actual, fcMl=ts.fcMl, fcUp=ts.fcUp;
  if(!actual) return data;
  var lastActIdx=rrLastActualOnSeries(actual).idx;
  if(lastActIdx<0) return data;
  var calQ=rrCurrentCalendarQuarter();
  var qStart=calQ*3, qEnd=Math.min(qStart+3,(data.labels||[]).length);
  data._projByMonth={};
  var hasCurProj=false;
  for(var i=qStart;i<qEnd;i++){
    if(lastActIdx>=0&&i<lastActIdx) continue;
    var curAct=actual.data[i]!=null&&!isNaN(actual.data[i])?num(actual.data[i]):null;
    var rawMl=fcMl&&fcMl.data[i]!=null&&!isNaN(fcMl.data[i])?num(fcMl.data[i]):null;
    var rawUp=fcUp&&fcUp.data[i]!=null&&!isNaN(fcUp.data[i])?num(fcUp.data[i]):null;
    if(rawMl==null&&rawUp==null) continue;
    if(i===lastActIdx){
      hasCurProj=true;
      if(curAct!=null&&rawMl!=null&&fcMl){
        var projMl=curAct+rawMl;
        fcMl.data[i]=projMl;
        data._projByMonth[i]={curAct:curAct,forwardMl:rawMl,projMl:projMl,excelOnly:true};
      }
      if(curAct!=null&&rawUp!=null&&fcUp){
        var projUp=curAct+rawUp;
        fcUp.data[i]=projUp;
        if(!data._projByMonth[i]) data._projByMonth[i]={curAct:curAct,excelOnly:true};
        data._projByMonth[i].forwardUp=rawUp;
        data._projByMonth[i].projUp=projUp;
      }
    }else if(i>lastActIdx){
      if(rawMl!=null&&fcMl) fcMl.data[i]=rawMl;
      if(rawUp!=null&&fcUp) fcUp.data[i]=rawUp;
      data._projByMonth[i]={excelOnly:true,forwardMl:rawMl,forwardUp:rawUp,projMl:rawMl,projUp:rawUp};
    }
  }
  if(hasCurProj){
    data._truncateActualIdx=lastActIdx;
    actual.data[lastActIdx]=null;
  }
  data._excelProjectionsOnly=true;
  return data;
}
function rrApplyFixedMrcExcelProjections(data){
  return rrApplyTrendExcelProjections(data,'fixedMrc');
}
function rrBridgeForecastData(data,chartId){
  chartId=chartId||'';
  var labels=data.labels||[];
  var actualS=(data.series||[]).find(function(x){return rrClassifySeries(x.label)==='actual';});
  var bridged=(data.series||[]).map(function(s,i){
    var st=rrSeriesStyleForChart(s.label,i,chartId,s.col);
    var vals=(s.data||[]).slice();
    if(st.kind==='forecast'||st.kind==='forecast-up'){
      var firstIdx=vals.findIndex(function(v){return v!=null&&!isNaN(v);});
      if(actualS&&firstIdx>0){
        var prev=actualS.data[firstIdx-1];
        if(prev!=null&&!isNaN(prev)) vals[firstIdx-1]=num(prev);
      }
    }
    if(st.kind==='actual'&&data._truncateActualIdx!=null){
      vals=vals.slice();
    }
    return Object.assign({},s,{bridged:vals,style:st});
  });
  return {labels:labels,series:bridged,_truncateActualIdx:data._truncateActualIdx};
}
function rrCalcYRange(chartId,seriesList,fmt){
  var vals=[];
  (seriesList||[]).forEach(function(s){
    (s.bridged||s.data||[]).forEach(function(v){ if(v!=null&&!isNaN(v)) vals.push(v); });
  });
  if(!vals.length) return {min:0,max:100,floor:null};
  var mn=Math.min.apply(null,vals), mx=Math.max.apply(null,vals);
  var span=mx-mn||Math.abs(mx)||1;
  var pad=span*0.08;
  if(chartId==='revRecTrend'){
    var step=2e6;
    var floor=190e6;
    var ceil=Math.ceil((mx+pad)/step)*step;
    if(ceil<=floor) ceil=floor+step*4;
    return {min:floor,max:ceil,floor:floor,step:step};
  }
  if(chartId==='fixedMrc'){
    var step=500000;
    var fl=Math.floor((mn-pad)/step)*step;
    var ceil=Math.ceil((mx+pad)/step)*step;
    if(ceil<=fl) ceil=fl+step;
    if(mn>=0&&fl<0) fl=0;
    return {min:fl,max:ceil,floor:fl>0?fl:null,step:step};
  }
  if(chartId==='netAddLines'){
    var padL=Math.max(span*0.12,Math.abs(mx)*0.05);
    return {min:mn-padL,max:mx+padL,floor:null};
  }
  return {min:Math.max(0,mn-pad),max:mx+pad,floor:null};
}
function rrFmtPointLabel(v,fmt,chartId){
  if(v==null||isNaN(v)) return '';
  var n=num(v), sign=rrTrendSignPrefix(n), a=Math.abs(n);
  if(fmt==='lines'){
    if(a>=1e6) return sign+(a/1e6).toFixed(2)+'M';
    if(a>=1e3) return sign+(a/1e3).toFixed(1)+'K';
    return sign+Math.round(a).toString();
  }
  if(chartId==='revRecTrend'||chartId==='fixedMrc') return sign+(a/1e6).toFixed(2)+'M';
  if(a>=1e9) return sign+(a/1e9).toFixed(2)+'B';
  if(a>=1e6) return sign+(a/1e6).toFixed(2)+'M';
  if(a>=1e3) return sign+(a/1e3).toFixed(1)+'K';
  return sign+a.toFixed(0);
}
function rrShouldLabelPoint(kind,dataIndex,projIdx,lastActIdx,truncateIdx,isCumulative,anchorIdx){
  if(isCumulative&&kind==='prior') return false;
  if(isCumulative&&kind==='actual'){
    if(anchorIdx>=0&&dataIndex>anchorIdx) return false;
    return true;
  }
  if(isCumulative&&(kind==='forecast'||kind==='forecast-up')){
    if(anchorIdx>=0&&dataIndex<anchorIdx) return false;
    return true;
  }
  if(kind==='forecast'||kind==='forecast-up'){
    if(projIdx<0||dataIndex<projIdx) return false;
    if(truncateIdx!=null&&dataIndex===truncateIdx) return true;
    if(lastActIdx>=0&&dataIndex<=lastActIdx) return false;
    return true;
  }
  if(kind==='actual'&&truncateIdx!=null&&dataIndex===truncateIdx) return false;
  if(kind==='actual'&&projIdx>=0&&lastActIdx>=0&&dataIndex>lastActIdx) return false;
  return true;
}
function rrLabelKindOffset(kind,labelAbove){
  if(labelAbove===true) return -52;
  if(labelAbove===false) return 52;
  if(kind==='prior') return -34;
  if(kind==='actual') return 34;
  if(kind==='forecast') return -52;
  if(kind==='forecast-up') return 52;
  return -34;
}
function rrAssignForecastLabelSlots(candidates){
  var byIdx={};
  candidates.forEach(function(c){
    if(c.kind!=='forecast'&&c.kind!=='forecast-up') return;
    if(!byIdx[c.i]) byIdx[c.i]=[];
    byIdx[c.i].push(c);
  });
  Object.keys(byIdx).forEach(function(key){
    var group=byIdx[key];
    if(group.length<2) return;
    group.sort(function(a,b){ return num(b.v)-num(a.v); });
    group.forEach(function(c,idx){ c.labelAbove=idx===0; });
  });
}
function rrLabelPreferSide(chartId,fmt,value){
  return chartId==='fixedMrc'&&fmt==='currency'&&value!=null&&!isNaN(value)&&Math.abs(num(value))<1e6;
}
function rrLabelSlotCandidates(x,y,tw,th,kind,sidePreferred,labelAbove){
  if(sidePreferred){
    var pad=10;
    return [
      {bx:x+pad,by:y-th/2},
      {bx:x-tw-pad,by:y-th/2},
      {bx:x-tw/2,by:y-th-pad},
      {bx:x-tw/2,by:y+pad}
    ];
  }
  var baseDy=rrLabelKindOffset(kind,labelAbove);
  var slots=[
    {dx:0,dy:baseDy},
    {dx:0,dy:-baseDy},
    {dx:0,dy:baseDy+(baseDy>0?16:-16)},
    {dx:-38,dy:baseDy},
    {dx:38,dy:baseDy},
    {dx:-38,dy:-baseDy},
    {dx:38,dy:-baseDy}
  ];
  return slots.map(function(s){
    return {bx:x-tw/2+s.dx,by:y+s.dy-(s.dy<0?th:0)};
  });
}
function rrRectsOverlap(a,b){
  return !(a.x+a.w<b.x||b.x+b.w<a.x||a.y+a.h<b.y||b.y+b.h<a.y);
}
function rrFmtAxisTick(v,fmt,chartId){
  if(v==null||isNaN(v)) return '';
  var n=num(v), sign=rrTrendSignPrefix(n), a=Math.abs(n);
  if(fmt==='lines'){
    if(a>=1000) return sign+(a/1000).toFixed(0)+'K';
    return sign+Math.round(a).toLocaleString('en-US');
  }
  if(chartId==='revRecTrend'||chartId==='fixedMrc') return sign+(a/1e6).toFixed(1)+'M';
  if(a>=1e9) return sign+(a/1e9).toFixed(1)+'B';
  if(a>=1e6) return sign+(a/1e6).toFixed(1)+'M';
  if(a>=1e3) return sign+(a/1e3).toFixed(0)+'K';
  return sign+a.toFixed(0);
}
function rrGradientFill(chart,colorTop,colorBottom){
  var area=chart.chartArea;
  if(!area) return colorTop;
  var g=chart.ctx.createLinearGradient(0,area.top,0,area.bottom);
  g.addColorStop(0,colorTop);
  g.addColorStop(1,colorBottom);
  return g;
}
function rrDataLabelPlugin(metaList,fmt,chartId,projIdx,lastActIdx,projByMonth,truncateIdx,isCumulative,anchorIdx){
  projByMonth=projByMonth||{};
  return {id:'rrDataLabels',afterDatasetsDraw:function(chart){
    var ctx=chart.ctx, area=chart.chartArea;
    if(!area) return;
    var isDark=document.body.getAttribute('data-theme')==='dark'||document.body.getAttribute('data-theme')==='duralux-dark';
    var placed=[];
    var candidates=[];
    chart.data.datasets.forEach(function(ds,di){
      var meta=metaList[di]||{};
      var kind=meta.kind||'actual';
      var labelColor=meta.color||rrKindLineColor(kind,chartId)||ds._rrColor||ds.borderColor;
      var m=chart.getDatasetMeta(di);
      if(!m||m.hidden) return;
      m.data.forEach(function(pt,i){
        var v=ds.data[i];
        if(v==null||isNaN(v)) return;
        if(!rrShouldLabelPoint(kind,i,projIdx,lastActIdx,truncateIdx,isCumulative,anchorIdx)) return;
        var lbl=rrFmtPointLabel(v,fmt,chartId);
        if(!lbl) return;
        if(isCumulative&&(kind==='forecast'||kind==='forecast-up')){
          lbl=(kind==='forecast-up'?'Up ':'ML ')+lbl;
        }else if(projByMonth[i]&&(kind==='forecast'||kind==='forecast-up')&&!projByMonth[i].excelOnly){
          lbl+=' net';
        }
        candidates.push({di:di,i:i,pt:pt,v:v,kind:kind,lbl:lbl,color:labelColor});
      });
    });
    rrAssignForecastLabelSlots(candidates);
    var pri={prior:0,actual:1,forecast:2,'forecast-up':3};
    candidates.sort(function(a,b){
      if(a.i!==b.i) return a.i-b.i;
      return (pri[a.kind]||1)-(pri[b.kind]||1);
    });
    var seenKey={};
    candidates.forEach(function(c){
      var dedupeKey=c.i+'|'+c.di+'|'+c.lbl;
      if(seenKey[dedupeKey]) return;
      seenKey[dedupeKey]=1;
      var x=c.pt.x, y=c.pt.y;
      var sidePreferred=rrLabelPreferSide(chartId,fmt,c.v);
      ctx.font='800 11px Inter';
      var tw=ctx.measureText(c.lbl).width+12;
      var th=20;
      var slotRects=rrLabelSlotCandidates(x,y,tw,th,c.kind,sidePreferred,c.labelAbove);
      var placedOk=false, bx, by;
      for(var si=0;si<slotRects.length;si++){
        bx=slotRects[si].bx;
        by=slotRects[si].by;
        if(by<area.top+4) by=area.top+4;
        if(by+th>area.bottom-4) by=area.bottom-th-4;
        if(bx<area.left+2) bx=area.left+2;
        if(bx+tw>area.right-2) bx=area.right-tw-2;
        var rect={x:bx,y:by,w:tw,h:th};
        var hit=false;
        for(var pi=0;pi<placed.length;pi++){
          if(rrRectsOverlap(rect,placed[pi])){ hit=true; break; }
        }
        if(!hit){ placed.push(rect); placedOk=true; break; }
      }
      if(!placedOk){
        if(sidePreferred){
          bx=x+10;
          by=Math.max(area.top+4,Math.min(y-th/2,area.bottom-th-4));
        }else{
          var baseDy=rrLabelKindOffset(c.kind,c.labelAbove);
          bx=x-tw/2;
          by=baseDy<0?y-24-th:y+24;
        }
        if(bx+tw>area.right-2) bx=area.right-tw-2;
        if(bx<area.left+2) bx=area.left+2;
        placed.push({x:bx,y:by,w:tw,h:th});
      }
      ctx.save();
      ctx.font='800 11px Inter';
      ctx.fillStyle=isDark?'rgba(8,6,20,.97)':'rgba(255,255,255,.99)';
      ctx.strokeStyle=c.color;
      ctx.lineWidth=2;
      ctx.beginPath();
      if(ctx.roundRect) ctx.roundRect(bx,by,tw,th,4);
      else ctx.rect(bx,by,tw,th);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle=c.color;
      ctx.textAlign='center';
      ctx.textBaseline='middle';
      ctx.fillText(c.lbl,bx+tw/2,by+th/2);
      ctx.restore();
    });
  }};
}
function rrAxisFloorPlugin(floorVal,fmt,chartId){
  return {id:'rrAxisFloor',afterDraw:function(chart){
    if(!floorVal||floorVal<=0) return;
    var yScale=chart.scales.y, area=chart.chartArea;
    if(!yScale||!area) return;
    var ctx=chart.ctx;
    var py=yScale.getPixelForValue(floorVal);
    ctx.save();
    ctx.strokeStyle='rgba(234,88,12,.55)';
    ctx.lineWidth=2;
    ctx.setLineDash([6,4]);
    ctx.beginPath();
    ctx.moveTo(area.left,py);
    ctx.lineTo(area.right,py);
    ctx.stroke();
    ctx.fillStyle='rgba(234,88,12,.9)';
    ctx.font='800 10px Inter';
    ctx.textAlign='right';
    ctx.textBaseline='bottom';
    ctx.fillText('Floor · '+rrFmtAxisTick(floorVal,fmt,chartId),area.right-6,py-4);
    ctx.restore();
  }};
}
function rrMoMDeltaPlugin(seriesList,fmt,chartId){
  return {id:'rrMoMDelta',afterDatasetsDraw:function(chart){
    if(chartId!=='revRecTrend'||!seriesList||!seriesList.length) return;
    var di=-1, target=null;
    seriesList.forEach(function(s,i){
      if(s.label&&s.label.indexOf('2026')>=0){ di=i; target=s; }
    });
    if(di<0||!target) return;
    var vals=target.bridged||target.data||[];
    var meta=chart.getDatasetMeta(di);
    if(!meta) return;
    var ctx=chart.ctx;
    ctx.save();
    ctx.font='800 9px Inter';
    ctx.textAlign='center';
    for(var i=1;i<vals.length;i++){
      var prev=vals[i-1], cur=vals[i];
      if(prev==null||cur==null||isNaN(prev)||isNaN(cur)) continue;
      var d=cur-prev, pct=prev?((d/prev)*100):0;
      var pt=meta.data[i];
      if(!pt) continue;
      var sign=d>=0?'+':'';
      var txt=sign+pct.toFixed(1)+'% MoM';
      ctx.fillStyle=d>=0?'#15803d':'#b91c1c';
      ctx.strokeStyle='rgba(255,255,255,.8)';
      ctx.lineWidth=3;
      ctx.strokeText(txt,pt.x,pt.y-36);
      ctx.fillText(txt,pt.x,pt.y-36);
    }
    ctx.restore();
  }};
}
function rrYoYBandPlugin(seriesList,chartId){
  return {id:'rrYoYBand',beforeDatasetsDraw:function(chart){
    if(chartId!=='revRecTrend'||!seriesList||seriesList.length<2) return;
    var s25=seriesList.find(function(s){return s.label&&s.label.indexOf('2025')>=0;});
    var s26=seriesList.find(function(s){return s.label&&s.label.indexOf('2026')>=0;});
    if(!s25||!s26) return;
    var m25=chart.getDatasetMeta(seriesList.indexOf(s25));
    var m26=chart.getDatasetMeta(seriesList.indexOf(s26));
    if(!m25||!m26) return;
    var ctx=chart.ctx;
    ctx.save();
    ctx.beginPath();
    var started=false;
    for(var i=0;i<m25.data.length;i++){
      var v25=s25.bridged? s25.bridged[i]:s25.data[i];
      var v26=s26.bridged? s26.bridged[i]:s26.data[i];
      if(v25==null||v26==null||isNaN(v25)||isNaN(v26)) continue;
      var p25=m25.data[i], p26=m26.data[i];
      if(!p25||!p26) continue;
      if(!started){ ctx.moveTo(p25.x,p25.y); started=true; }
      else ctx.lineTo(p25.x,p25.y);
    }
    for(var j=m26.data.length-1;j>=0;j--){
      var v26b=s26.bridged? s26.bridged[j]:s26.data[j];
      var v25b=s25.bridged? s25.bridged[j]:s25.data[j];
      if(v25b==null||v26b==null) continue;
      var p26b=m26.data[j];
      if(p26b) ctx.lineTo(p26b.x,p26b.y);
    }
    ctx.closePath();
    ctx.fillStyle='rgba(234,88,12,.08)';
    ctx.fill();
    ctx.restore();
  }};
}
function rrLatestBadgePlugin(seriesList,fmt,chartId){
  return {id:'rrLatestBadge',afterDatasetsDraw:function(chart){
    var area=chart.chartArea, ctx=chart.ctx;
    if(!area||!seriesList) return;
    seriesList.forEach(function(s,di){
      var kind=(s.style||rrSeriesStyle(s.label,di)).kind;
      if(kind==='forecast'||kind==='forecast-up') return;
      if(chartId==='revRecTrend'&&s.label.indexOf('2026')<0) return;
      var vals=s.bridged||s.data||[];
      var lastIdx=-1, lastVal=null;
      for(var i=vals.length-1;i>=0;i--){
        if(vals[i]!=null&&!isNaN(vals[i])){ lastIdx=i; lastVal=vals[i]; break; }
      }
      if(lastIdx<0) return;
      var meta=chart.getDatasetMeta(di);
      if(!meta||meta.hidden) return;
      var pt=meta.data[lastIdx];
      if(!pt) return;
      var lbl=rrFmtPointLabel(lastVal,fmt,chartId);
      var st=s.style||rrSeriesStyle(s.label,di);
      ctx.save();
      ctx.font='900 11px Inter';
      var tag='Latest';
      var tw=Math.max(ctx.measureText(lbl).width,ctx.measureText(tag).width)+20;
      var bx=Math.min(pt.x+12,area.right-tw-4);
      var by=pt.y-38;
      if(by<area.top+4) by=pt.y+14;
      ctx.fillStyle=st.color;
      ctx.shadowColor='rgba(0,0,0,.3)';
      ctx.shadowBlur=6;
      if(ctx.roundRect) ctx.roundRect(bx,by,tw,34,8);
      else ctx.rect(bx,by,tw,34);
      ctx.fill();
      ctx.shadowBlur=0;
      ctx.fillStyle='#fff';
      ctx.textAlign='center';
      ctx.font='700 8px Inter';
      ctx.fillText(tag,bx+tw/2,by+11);
      ctx.font='900 12px Inter';
      ctx.fillText(lbl,bx+tw/2,by+26);
      ctx.restore();
    });
  }};
}
function rrLineShadowPlugin(){
  return {id:'rrLineShadow',beforeDatasetsDraw:function(chart){
    var ctx=chart.ctx;
    chart.data.datasets.forEach(function(ds,di){
      var meta=chart.getDatasetMeta(di);
      if(!meta||meta.hidden||!meta.dataset) return;
      ctx.save();
      ctx.shadowColor=ds.borderColor+'88';
      ctx.shadowBlur=12;
      ctx.shadowOffsetY=4;
      meta.dataset.draw(ctx);
      ctx.restore();
    });
  }};
}
function rrPointHaloPlugin(){
  return {id:'rrPointHalo',afterDatasetsDraw:function(chart){
    var ctx=chart.ctx;
    chart.data.datasets.forEach(function(ds,di){
      var meta=chart.getDatasetMeta(di);
      if(!meta||meta.hidden) return;
      var isFc=ds.borderDash&&ds.borderDash.length;
      meta.data.forEach(function(pt,i){
        if(ds.data[i]==null||isNaN(ds.data[i])) return;
        ctx.save();
        ctx.beginPath();
        ctx.arc(pt.x,pt.y,(ds.pointRadius||5)+(isFc?3:4),0,Math.PI*2);
        ctx.fillStyle=ds.borderColor+(isFc?'18':'28');
        ctx.fill();
        ctx.restore();
      });
    });
  }};
}
function rrProjectionZonePlugin(projIdx,c){
  return {id:'rrProjZone',beforeDatasetsDraw:function(chart){
    if(projIdx<1) return;
    var xScale=chart.scales.x, area=chart.chartArea;
    if(!xScale||!area) return;
    var cx=xScale.getPixelForValue(projIdx-0.48);
    var ctx=chart.ctx;
    ctx.save();
    var g=ctx.createLinearGradient(cx,area.top,area.right,area.top);
    g.addColorStop(0,'rgba(251,191,36,.12)');
    g.addColorStop(1,'rgba(251,191,36,.02)');
    ctx.fillStyle=g;
    ctx.fillRect(cx,area.top,area.right-cx,area.bottom-area.top);
    ctx.strokeStyle='rgba(251,191,36,.55)';
    ctx.lineWidth=2;
    ctx.setLineDash([6,4]);
    ctx.beginPath();
    ctx.moveTo(cx,area.top);
    ctx.lineTo(cx,area.bottom);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle='#b45309';
    ctx.font='800 9px Inter';
    ctx.textAlign='right';
    ctx.fillText('PROJECTION →',area.right-8,area.top+14);
    ctx.restore();
  }};
}
function rrGridBandPlugin(c){
  return {id:'rrGridBands',beforeDatasetsDraw:function(chart){
    var yScale=chart.scales.y, area=chart.chartArea;
    if(!yScale||!area) return;
    var ctx=chart.ctx;
    var ticks=yScale.ticks||[];
    ctx.save();
    for(var i=0;i<ticks.length;i+=2){
      var y1=yScale.getPixelForValue(ticks[i].value);
      var y2=i+1<ticks.length?yScale.getPixelForValue(ticks[i+1].value):area.top;
      ctx.fillStyle='rgba(148,163,184,.04)';
      ctx.fillRect(area.left,Math.min(y1,y2),area.right-area.left,Math.abs(y2-y1));
    }
    ctx.restore();
  }};
}
function rrCrosshairPlugin(){
  return {id:'rrCrosshair',afterDraw:function(chart){
    var active=chart.tooltip&&chart.tooltip.getActiveElements();
    if(!active||!active.length) return;
    var pt=active[0], x=pt.element.x, area=chart.chartArea, ctx=chart.ctx;
    ctx.save();
    ctx.strokeStyle='rgba(100,116,139,.35)';
    ctx.lineWidth=1;
    ctx.setLineDash([3,3]);
    ctx.beginPath();
    ctx.moveTo(x,area.top);
    ctx.lineTo(x,area.bottom);
    ctx.stroke();
    ctx.restore();
  }};
}
function rrSumQuarter(vals,q){
  var sum=0, n=0, start=q*3, end=Math.min(start+3,(vals||[]).length);
  for(var i=start;i<end;i++){
    if(vals[i]!=null&&!isNaN(vals[i])){ sum+=vals[i]; n++; }
  }
  return n?sum:null;
}
function rrSumQuarterActual(vals,q,lastActIdx){
  var sum=0, n=0, start=q*3, end=Math.min(start+3,(vals||[]).length);
  for(var i=start;i<end;i++){
    if(lastActIdx>=0&&i>lastActIdx) continue;
    if(vals[i]!=null&&!isNaN(vals[i])){ sum+=vals[i]; n++; }
  }
  return n?sum:null;
}
function rrPctChange(cur,prev){
  if(cur==null||prev==null||isNaN(cur)||isNaN(prev)||!prev) return null;
  return ((cur-prev)/Math.abs(prev))*100;
}
function rrFmtPctChip(pct,label){
  if(pct==null||isNaN(pct)) return '';
  var cls=pct>0?'rr-kpi-up':pct<0?'rr-kpi-down':'rr-kpi-neu';
  var txt=(pct>=0?'+':'')+pct.toFixed(1)+'%';
  return '<span class="rr-kpi-chip '+cls+'">'+txt+(label?' '+label:'')+'</span>';
}
function rrFmtShort(v,fmt){
  if(v==null||isNaN(v)) return '—';
  var n=num(v), sign=rrTrendSignPrefix(n), a=Math.abs(n);
  if(fmt==='lines'){
    if(a>=1e6) return sign+(a/1e6).toFixed(2)+'M';
    if(a>=1e3) return sign+(a/1e3).toFixed(1)+'K';
    return sign+Math.round(a).toLocaleString('en-US');
  }
  if(a>=1e9) return sign+(a/1e9).toFixed(2)+'B';
  if(a>=1e6) return sign+(a/1e6).toFixed(2)+'M';
  if(a>=1e3) return sign+(a/1e3).toFixed(1)+'K';
  return sign+a.toLocaleString('en-US',{maximumFractionDigits:0});
}
function rrLastActualOnSeries(series){
  if(!series||!series.data) return {idx:-1,val:null};
  var idx=-1, val=null;
  (series.data||[]).forEach(function(v,i){
    if(v!=null&&!isNaN(v)){ idx=i; val=v; }
  });
  return {idx:idx,val:val};
}
function rrSumQuarterFcRemainder(fcVals,q,lastActIdx){
  var sum=0, n=0, start=q*3, end=Math.min(start+3,(fcVals||[]).length);
  for(var i=start;i<end;i++){
    if(lastActIdx>=0&&i<=lastActIdx) continue;
    if(fcVals[i]!=null&&!isNaN(fcVals[i])){ sum+=fcVals[i]; n++; }
  }
  return n?sum:null;
}
function rrCurrentCalendarQuarter(){
  return Math.floor(new Date().getMonth()/3);
}
function rrTrendRawData(chartId){
  if(!RR_PARSED||!RR_PARSED[chartId]) return null;
  var copy=rrCloneChartData(RR_PARSED[chartId]);
  rrSanitizeCascadeForecasts(copy,chartId);
  return copy;
}
function rrQuarterForecastFromLastAct(fcVals,calQ,lastActIdx){
  if(!fcVals||lastActIdx<0) return null;
  var sum=0,n=0,start=calQ*3,end=Math.min(start+3,fcVals.length);
  if(lastActIdx>=start&&lastActIdx<end&&fcVals[lastActIdx]!=null&&!isNaN(fcVals[lastActIdx])){
    sum+=num(fcVals[lastActIdx]); n++;
  }
  for(var i=lastActIdx+1;i<end;i++){
    if(fcVals[i]!=null&&!isNaN(fcVals[i])){ sum+=num(fcVals[i]); n++; }
  }
  return n?sum:null;
}
function rrTrendProjectionParts(chartId){
  var data=rrTrendRawData(chartId);
  if(!data) return null;
  var actual=data.series.find(function(s){return rrClassifySeries(s.label)==='actual';});
  var fcMl=data.series.find(function(s){return rrClassifySeries(s.label)==='forecast';});
  var fcUp=data.series.find(function(s){return rrClassifySeries(s.label)==='forecast-up';});
  if(!actual) return null;
  var vals=actual.data||[];
  var lastActIdx=rrLastActualOnSeries(actual).idx;
  var calQ=rrCurrentCalendarQuarter();
  var fmt=chartId==='fixedMrc'?'currency':'lines';
  var monthLbl=(data.labels&&lastActIdx>=0&&data.labels[lastActIdx])||'';
  if(chartId==='fixedMrc'||chartId==='netAddLines'){
    var ts=rrTrendExcelSeries(data,chartId);
    actual=ts.actual||actual;
    fcMl=ts.fcMl||fcMl;
    fcUp=ts.fcUp||fcUp;
    vals=(actual&&actual.data)||[];
    lastActIdx=actual?rrLastActualOnSeries(actual).idx:-1;
    monthLbl=(data.labels&&lastActIdx>=0&&data.labels[lastActIdx])||'';
    var curAct=lastActIdx>=0&&vals[lastActIdx]!=null&&!isNaN(vals[lastActIdx])?num(vals[lastActIdx]):null;
    var mlAddon=fcMl&&lastActIdx>=0&&fcMl.data[lastActIdx]!=null&&!isNaN(fcMl.data[lastActIdx])?num(fcMl.data[lastActIdx]):null;
    var upAddon=fcUp&&lastActIdx>=0&&fcUp.data[lastActIdx]!=null&&!isNaN(fcUp.data[lastActIdx])?num(fcUp.data[lastActIdx]):null;
    var qActFull=rrSumQuarterActual(vals,calQ,lastActIdx);
    var qMlAddon=fcMl?rrQuarterForecastFromLastAct(fcMl.data||[],calQ,lastActIdx):null;
    var qUpAddon=fcUp?rrQuarterForecastFromLastAct(fcUp.data||[],calQ,lastActIdx):null;
    return {
      calQ:calQ,
      qLabel:['Q1','Q2','Q3','Q4'][calQ],
      monthLbl:monthLbl,
      curAct:curAct,
      qActFull:qActFull,
      mlAddon:mlAddon,
      upAddon:upAddon,
      qMlAddon:qMlAddon,
      qUpAddon:qUpAddon,
      monthMl:(curAct!=null&&mlAddon!=null)?curAct+mlAddon:null,
      monthUp:(curAct!=null&&upAddon!=null)?curAct+upAddon:null,
      quarterMl:(qActFull!=null&&qMlAddon!=null)?qActFull+qMlAddon:null,
      quarterUp:(qActFull!=null&&qUpAddon!=null)?qActFull+qUpAddon:null,
      fmt:fmt,
      excelOnly:true
    };
  }
  var churnMl=rrTrendPipelineChurn(chartId,false);
  var churnUp=rrTrendPipelineChurn(chartId,true);
  var qActFull=rrSumQuarterActual(vals,calQ,lastActIdx);
  var forwardMl=fcMl?rrQuarterForecastFromLastAct(fcMl.data||[],calQ,lastActIdx):null;
  if(forwardMl==null&&fcMl) forwardMl=rrSumQuarterFcRemainder(fcMl.data||[],calQ,lastActIdx);
  var forwardUp=fcUp?rrQuarterForecastFromLastAct(fcUp.data||[],calQ,lastActIdx):null;
  if(forwardUp==null&&fcUp) forwardUp=rrSumQuarterFcRemainder(fcUp.data||[],calQ,lastActIdx);
  var inQ=lastActIdx>=calQ*3&&lastActIdx<(calQ+1)*3;
  var hasCurMl=fcMl&&fcMl.data[lastActIdx]!=null&&!isNaN(fcMl.data[lastActIdx]);
  var hasCurUp=fcUp&&fcUp.data[lastActIdx]!=null&&!isNaN(fcUp.data[lastActIdx]);
  var hasCurFc=hasCurMl||hasCurUp;
  var totalMl=(qActFull!=null&&forwardMl!=null)?qActFull+forwardMl+churnMl:null;
  var totalUp=(qActFull!=null&&forwardUp!=null)?qActFull+forwardUp+churnUp:null;
  if(inQ&&hasCurMl&&totalMl!=null&&totalMl<0) totalMl=null;
  if(inQ&&hasCurUp&&totalUp!=null&&totalUp<0) totalUp=null;
  return {
    calQ:calQ,
    qLabel:['Q1','Q2','Q3','Q4'][calQ],
    qAct:qActFull,
    forwardMl:forwardMl,
    forwardUp:forwardUp,
    churnMl:churnMl,
    churnUp:churnUp,
    totalMl:totalMl,
    totalUp:totalUp,
    fmt:fmt,
    actLabel:'Actual (quarter to date)',
    fwdLabel:(inQ&&hasCurFc)?'Most Likely / Upside add-on (Excel)':'Forward (remaining months in quarter)',
    hasCurFc:!!(inQ&&hasCurFc)
  };
}
function rrKpiCalcRow(label,val,fmt,prefix){
  if(val==null||isNaN(val)) return '';
  var unit=fmt==='lines'?' lines':'';
  var n=num(val);
  var disp=rrFmtShort(n,fmt)+unit;
  if(prefix==='plus'&&n>0) disp='+'+disp.replace(/^−/,'');
  var cls=(prefix==='minus'||n<0)?' rr-kpi-calc-minus':'';
  return '<div class="rr-kpi-calc-row'+cls+'"><span>'+label+'</span><span>'+disp+'</span></div>';
}
function rrKpiFixedExcelProj(title,cls,monthLbl,qLbl,parts,addonKey,qAddonKey,totalKey,fmt,isCumulative){
  var unit=fmt==='lines'?' lines':'';
  var addon=parts[addonKey];
  var qAddon=parts[qAddonKey];
  var monthTotal=parts[addonKey==='mlAddon'?'monthMl':'monthUp'];
  var qTotal=parts[totalKey];
  var h='<div class="rr-kpi-proj rr-kpi-proj-'+cls+'"><div class="rr-kpi-proj-title">'+title+'</div>';
  if(monthTotal!=null){
    h+='<div class="rr-kpi-proj-hdr">'+(isCumulative?'YTD month-end':'Month')+(monthLbl?' · '+monthLbl:'')+'</div>';
    h+=rrKpiCalcRow(isCumulative?'YTD actual to date':'Actual to date',parts.curAct,fmt,'plain');
    h+=rrKpiCalcRow('Current addition',addon,fmt,'plus');
    h+='<div class="rr-kpi-calc-eq"><span>'+(isCumulative?'YTD month-end':'Month total')+'</span><span>'+rrFmtShort(monthTotal,fmt)+unit+'</span></div>';
  }
  if(qTotal!=null){
    h+='<div class="rr-kpi-proj-hdr">'+(isCumulative?'YTD quarter-end':'Quarter')+' · '+qLbl+'</div>';
    h+=rrKpiCalcRow(isCumulative?'YTD actual to date':'Actual to date',parts.qActFull,fmt,'plain');
    h+=rrKpiCalcRow('Forecast to quarter-end',qAddon,fmt,'plus');
    h+='<div class="rr-kpi-calc-eq"><span>'+(isCumulative?'YTD quarter-end':'Quarter total')+'</span><span>'+rrFmtShort(qTotal,fmt)+unit+'</span></div>';
  }
  h+='</div>';
  return h;
}
function rrKpiProjBlock(title,cls,parts,fmt){
  var unit=fmt==='lines'?' lines':'';
  var actLbl=parts.actLabel||'Actual (quarter to date)';
  var fwdLbl=parts.fwdLabel||(cls==='up'&&parts.fwdLabelUp?parts.fwdLabelUp:(cls==='ml'&&parts.fwdLabelMl?parts.fwdLabelMl:'Forward (remaining months in quarter)'));
  var h='<div class="rr-kpi-proj rr-kpi-proj-'+cls+'"><div class="rr-kpi-proj-title">'+title+'</div>';
  h+=rrKpiCalcRow(actLbl,parts.qAct,fmt,'plain');
  if(parts.forward!=null) h+=rrKpiCalcRow(fwdLbl,parts.forward,fmt,'plus');
  if(!parts.excelOnly&&parts.churn!=null) h+=rrKpiCalcRow('Churn / downgrade (live pipeline)',parts.churn,fmt,'minus');
  h+='<div class="rr-kpi-calc-eq"><span>= '+title+'</span><span>'+rrFmtShort(parts.total,fmt)+unit+'</span></div>';
  if(parts.excelOnly) h+='<div style="font-size:.64rem;color:var(--t3);margin-top:.35rem;">Direct from Excel — no pipeline adjustment applied</div>';
  h+='</div>';
  return h;
}
function rrCumulativeAtMonth(vals,idx){
  if(!vals||idx<0) return null;
  var cum=rrCumulativeSeries(vals);
  return cum[idx]!=null&&!isNaN(cum[idx])?num(cum[idx]):null;
}
function rrCeoTrendKpis(def,data,isCumulative){
  if(!data||!data.series) return [];
  var fmt=def.valueFmt;
  var unit=fmt==='lines'?' lines':'';
  var actual=data.series.find(function(s){return rrClassifySeries(s.label)==='actual';});
  var prior=data.series.find(function(s){return rrClassifySeries(s.label)==='prior';});
  if(!actual) return [];
  var vals=actual.data||[];
  var lastAct=rrLastActualOnSeries(actual);
  var lastActIdx=lastAct.idx;
  var calQ=rrCurrentCalendarQuarter();
  var parts=rrTrendProjectionParts(def.id);
  var rawData=rrTrendRawData(def.id)||data;
  var tsExcel=(def.id==='fixedMrc'||def.id==='netAddLines')?rrTrendExcelSeries(rawData,def.id):null;
  var fcMl=tsExcel?tsExcel.fcMl:rawData.series.find(function(s){return rrClassifySeries(s.label)==='forecast';});
  var fcUp=tsExcel?tsExcel.fcUp:rawData.series.find(function(s){return rrClassifySeries(s.label)==='forecast-up';});
  var lines=[];
  var prevActual=null;
  for(var q=0;q<=calQ;q++){
    var isCurrent=(q===calQ);
    var qEnd=Math.min((q+1)*3-1,vals.length-1);
    if(isCurrent&&lastActIdx>=0&&lastActIdx<q*3) continue;
    if(isCurrent&&lastActIdx>=0) qEnd=lastActIdx;
    var qAct=isCumulative?rrCumulativeAtMonth(vals,qEnd):((isCurrent?rrSumQuarterActual(vals,q,lastActIdx):rrSumQuarter(vals,q)));
    if(qAct==null) continue;
    var chip=prevActual!=null?rrFmtPctChip(rrPctChange(qAct,prevActual),(isCumulative?'vs prior milestone':'vs Q'+q)):'';
    var yoyExtra='';
    if(isCurrent&&prior&&!isCumulative){
      var qPrior=rrSumQuarter(prior.data||[],q);
      if(qPrior!=null){
        var yoy=rrPctChange(qAct,qPrior);
        if(yoy!=null) yoyExtra=' · YoY '+((yoy>=0?'+':'')+yoy.toFixed(1)+'%');
      }
    }
    var qLbl='Q'+(q+1)+(isCurrent?' <span class="rr-kpi-curr">'+(isCumulative?'YTD live':'Current quarter')+'</span>':'');
    var qNote=isCumulative?(isCurrent?'running total':'YTD at quarter-end'):(isCurrent?'actual to date':'actual');
    lines.push('<div class="rr-kpi-line"><span class="rr-kpi-q">'+qLbl+'</span><span class="rr-kpi-amt">'+rrFmtShort(qAct,fmt)+unit+'</span><span class="rr-kpi-note">'+qNote+'</span>'+chip+(yoyExtra?'<span class="rr-kpi-note">'+yoyExtra+'</span>':'')+'</div>');
    prevActual=qAct;
  }
  var projTile=null;
  if(parts&&parts.excelOnly&&(def.id==='fixedMrc'||def.id==='netAddLines')){
    var qLblProj=parts.qLabel||('Q'+(parts.calQ+1));
    var projParts=parts;
    if(isCumulative){
      projParts=Object.assign({},parts);
      var cumNow=rrCumulativeAtMonth(vals,lastActIdx);
      var qStartIdx=calQ*3;
      var cumQStart=qStartIdx>0?rrCumulativeAtMonth(vals,qStartIdx-1):0;
      if(cumNow!=null){
        projParts.curAct=cumNow;
        projParts.qActFull=cumNow;
        if(projParts.mlAddon!=null) projParts.monthMl=cumNow+projParts.mlAddon;
        if(projParts.upAddon!=null) projParts.monthUp=cumNow+projParts.upAddon;
      }
      if(cumQStart!=null){
        if(projParts.quarterMl!=null) projParts.quarterMl=cumQStart+projParts.quarterMl;
        if(projParts.quarterUp!=null) projParts.quarterUp=cumQStart+projParts.quarterUp;
      }
    }
    var projHtml='';
    if(projParts.monthMl!=null||projParts.quarterMl!=null){
      projHtml+=rrKpiFixedExcelProj('Most Likely','ml',projParts.monthLbl,qLblProj,projParts,'mlAddon','qMlAddon','quarterMl',fmt,isCumulative);
    }
    if(projParts.monthUp!=null||parts.quarterUp!=null){
      projHtml+=rrKpiFixedExcelProj('Upside','up',projParts.monthLbl,qLblProj,projParts,'upAddon','qUpAddon','quarterUp',fmt,isCumulative);
    }
    if(projHtml) projTile={kind:'proj-grid',html:'<div class="rr-kpi-proj-grid">'+projHtml+'</div>'};
  }else if(parts&&parts.qAct!=null){
    if(parts.totalMl!=null){
      lines.push(rrKpiProjBlock('Most Likely Projection','ml',{qAct:parts.qAct,forward:parts.forwardMl,churn:parts.churnMl,total:parts.totalMl,actLabel:parts.actLabel,fwdLabel:parts.fwdLabelMl||parts.fwdLabel,excelOnly:parts.excelOnly},fmt));
    }
    if(parts.totalUp!=null){
      lines.push(rrKpiProjBlock('Upside Projection','up',{qAct:parts.qAct,forward:parts.forwardUp,churn:parts.churnUp,total:parts.totalUp,actLabel:parts.actLabel,fwdLabel:parts.fwdLabelUp||parts.fwdLabel,excelOnly:parts.excelOnly},fmt));
    }
  }
  var heroLbl=isCumulative
    ?('YTD Running Total · '+((data.labels&&lastActIdx>=0&&data.labels[lastActIdx])||['Q1','Q2','Q3','Q4'][calQ])+' live')
    :('Quarterly Snapshot · '+['Q1','Q2','Q3','Q4'][calQ]+' live');
  var tiles=[{kind:'hero',html:'<div class="rr-kpi-label">'+heroLbl+'</div><div class="rr-kpi-lines">'+lines.join('')+'</div>'}];
  if(projTile) tiles.push(projTile);
  if(lastActIdx>=0&&lastAct.val!=null){
    var monthLbl=(data.labels&&data.labels[lastActIdx])||('Month '+(lastActIdx+1));
    var displayVal=isCumulative?rrCumulativeAtMonth(vals,lastActIdx):lastAct.val;
    var prevVal=isCumulative?(lastActIdx>0?rrCumulativeAtMonth(vals,lastActIdx-1):null):(lastActIdx>0?vals[lastActIdx-1]:null);
    var momChip=prevVal!=null&&displayVal!=null?rrFmtPctChip(rrPctChange(displayVal,prevVal),(isCumulative?'vs prior month YTD':'MoM')):'';
    var mlMonth='';
    if(parts&&parts.excelOnly&&(def.id==='fixedMrc'||def.id==='netAddLines')){
      var cumNow=displayVal;
      var mlYtd=(isCumulative&&cumNow!=null&&parts.mlAddon!=null)?cumNow+parts.mlAddon:parts.monthMl;
      var upYtd=(isCumulative&&cumNow!=null&&parts.upAddon!=null)?cumNow+parts.upAddon:parts.monthUp;
      if(mlYtd!=null) mlMonth+=' · ML'+(isCumulative?' YTD':'')+': <strong style="color:#7c3aed">'+rrFmtShort(mlYtd,fmt)+'</strong>';
      if(upYtd!=null) mlMonth+=' · Upside'+(isCumulative?' YTD':'')+': <strong style="color:#16a34a">'+rrFmtShort(upYtd,fmt)+'</strong>';
      if(parts.quarterMl!=null||parts.quarterUp!=null){
        var qStartIdx=calQ*3;
        var cumQStart=qStartIdx>0?rrCumulativeAtMonth(vals,qStartIdx-1):0;
        var qMlYtd=(isCumulative&&cumQStart!=null&&parts.quarterMl!=null)?cumQStart+parts.quarterMl:parts.quarterMl;
        var qUpYtd=(isCumulative&&cumQStart!=null&&parts.quarterUp!=null)?cumQStart+parts.quarterUp:parts.quarterUp;
        mlMonth+='<div style="font-size:.68rem;margin-top:.25rem;color:var(--t2);">';
        if(qMlYtd!=null) mlMonth+=(isCumulative?'YTD Q-end ML':'Q proj ML')+': <strong style="color:#7c3aed">'+rrFmtShort(qMlYtd,fmt)+'</strong> ';
        if(qUpYtd!=null) mlMonth+='Upside: <strong style="color:#16a34a">'+rrFmtShort(qUpYtd,fmt)+'</strong>';
        mlMonth+='</div>';
      }
    }else if(def.id==='fixedMrc'&&fcMl&&fcMl.data[lastActIdx]!=null&&lastAct.val!=null){
      var mlAdd=num(fcMl.data[lastActIdx]);
      mlMonth=' · ML proj: <strong style="color:#7c3aed">'+rrFmtShort(lastAct.val+mlAdd,fmt)+'</strong> <span style="color:var(--t3);font-size:.68rem;">(actual + current addition)</span>';
    }else if(fcMl&&fcMl.data[lastActIdx]!=null&&fcMl.data[lastActIdx]!==lastAct.val){
      mlMonth=' · ML: <strong style="color:#7c3aed">'+rrFmtShort(fcMl.data[lastActIdx],fmt)+unit+'</strong>';
    }
    var latestLbl=isCumulative?('YTD Through · '+monthLbl):('Latest Month · '+monthLbl);
    var latestSub=isCumulative?'Running total'+(momChip?' · '+momChip:'')+mlMonth:'Actual'+(momChip?' · '+momChip:'')+mlMonth;
    tiles.push({
      kind:'compact',
      html:'<div class="rr-kpi-label">'+latestLbl+'</div>'+
        '<div class="rr-kpi-val">'+rrFmtShort(displayVal,fmt)+unit+'</div>'+
        '<div class="rr-kpi-sub">'+latestSub+'</div>'
    });
  }
  return tiles;
}
function rrComputeKpis(def,data,isCumulative){
  var kpis=[];
  if(!data||!data.series) return kpis;
  if(def.id==='netAddLines'||def.id==='fixedMrc'){
    return rrCeoTrendKpis(def,data,!!isCumulative);
  }
  if(def.id==='revRecTrend'){
    var s25=data.series.find(function(s){return s.label.indexOf('2025')>=0;});
    var s26=data.series.find(function(s){return s.label.indexOf('2026')>=0;});
    if(s25){
      var nums=(s25.data||[]).filter(function(v){return v!=null;});
      var ytd=nums.reduce(function(a,b){return a+b;},0);
      kpis.push({label:'2025 YTD Total',val:rrFmtFull(ytd,'currency'),sub:nums.length+' months · 2025 actuals'});
    }
    if(s26){
      var nums26=(s26.data||[]).filter(function(v){return v!=null;});
      var ytd26=nums26.reduce(function(a,b){return a+b;},0);
      var last=nums26[nums26.length-1];
      kpis.push({label:'2026 YTD Total',val:rrFmtFull(ytd26,'currency'),sub:nums26.length+' months · 2026 actuals'});
      kpis.push({label:'Latest 2026 Month',val:rrFmtFull(last,'currency'),sub:'Last reported actual'});
    }
    if(s25&&s26){
      var mi=Math.min((s25.data||[]).length,(s26.data||[]).length)-1;
      for(var i=mi;i>=0;i--){
        if(s25.data[i]!=null&&s26.data[i]!=null){
          var d=s26.data[i]-s25.data[i];
          var pct=s25.data[i]?((d/s25.data[i])*100).toFixed(1):'—';
          kpis.push({label:'YoY Same Month',val:(d>=0?'+':'')+rrFmtPoint(d,'currency'),sub:pct+'% vs 2025 · '+data.labels[i]});
          break;
        }
      }
    }
  }else{
    var actual=data.series.find(function(s){return rrClassifySeries(s.label)==='actual';});
    if(actual){
      var actNums=(actual.data||[]).filter(function(v){return v!=null;});
      var actSum=actNums.reduce(function(a,b){return a+b;},0);
      var actLast=actNums[actNums.length-1];
      kpis.push({label:'Actual YTD',val:rrFmtFull(actSum,def.valueFmt),sub:actNums.length+' months · col '+actual.col});
      kpis.push({label:'Latest Actual',val:rrFmtFull(actLast,def.valueFmt),sub:data.labels[actual.data.lastIndexOf(actLast)]||''});
    }
    ['forecast','forecast-up'].forEach(function(k){
      var fc=data.series.find(function(s){return rrClassifySeries(s.label)===k;});
      if(!fc) return;
      var fcNums=(fc.data||[]).filter(function(v){return v!=null;});
      if(!fcNums.length) return;
      var fcLast=fcNums[fcNums.length-1];
      kpis.push({label:k==='forecast'?'Most Likely Proj.':'Upside Proj.',val:rrFmtFull(fcLast,def.valueFmt),sub:'Latest forecast · col '+fc.col});
    });
  }
  return kpis;
}
function rrRenderKpis(def,data,isCumulative){
  var row=el('rrKpiRow');
  if(!row) return;
  var kpis=rrComputeKpis(def,data,isCumulative);
  if(!kpis.length){ row.innerHTML=''; row.className='rr-kpi-row'; return; }
  var isCeo=def.id==='netAddLines'||def.id==='fixedMrc';
  row.className='rr-kpi-row'+(isCeo?' rr-kpi-row-ceo':'');
  row.innerHTML=kpis.map(function(k){
    if(k.kind==='hero') return '<div class="rr-kpi rr-kpi-hero">'+k.html+'</div>';
    if(k.kind==='proj-grid') return '<div class="rr-kpi-proj-wrap">'+k.html+'</div>';
    if(k.kind==='compact') return '<div class="rr-kpi rr-kpi-compact">'+k.html+'</div>';
    return '<div class="rr-kpi"><div class="rr-kpi-label">'+k.label+'</div><div class="rr-kpi-val">'+k.val+'</div>'+(k.sub?'<div class="rr-kpi-sub">'+k.sub+'</div>':'')+'</div>';
  }).join('');
}
let RR_PARSED=null;
let RR_TREND_PARSE_HINT='';
let RR_META=null;
let RR_ACTIVE_CHART='revRecTrend';
let RR_TREND_CUMULATIVE=false;
function rrTrendHasCumulativeToggle(chartId){
  return chartId==='netAddLines'||chartId==='fixedMrc';
}
function rrCumulativeSeries(vals){
  var out=[], sum=0;
  (vals||[]).forEach(function(v){
    if(v==null||isNaN(v)) out.push(null);
    else { sum+=num(v); out.push(sum); }
  });
  return out;
}
function rrLastIdxWithValue(arr){
  for(var i=(arr||[]).length-1;i>=0;i--){ if(arr[i]!=null&&!isNaN(arr[i])) return i; }
  return -1;
}
window.rrToggleTrendCumulative=function(){
  RR_TREND_CUMULATIVE=!!(el('rrTrendCumulative')&&el('rrTrendCumulative').checked);
  rrRenderActiveChart();
};
window.rrToggleNetAddCumulative=window.rrToggleTrendCumulative;
function rrApplyCumulativeChartData(data,rawProj,rawMonthly){
  if(!data||!data.series) return data;
  rawProj=rawProj||data;
  rawMonthly=rawMonthly||rawProj;
  var copy=rrCloneChartData(data);
  var truncateIdx=rawProj._truncateActualIdx!=null?rawProj._truncateActualIdx:-1;
  var rawActual=(rawMonthly.series||[]).find(function(s){return s.col==='C';});
  if(!rawActual) rawActual=(rawMonthly.series||[]).find(function(s){return rrClassifySeries(s.label)==='actual';});
  var rawActData=(rawActual&&rawActual.data)||[];
  var cumAct=rrCumulativeSeries(rawActData);
  var lastActIdx=rrLastIdxWithValue(cumAct);
  var anchorIdx=lastActIdx;
  var baseCum=anchorIdx>=0&&cumAct[anchorIdx]!=null?num(cumAct[anchorIdx]):0;
  var projStart=truncateIdx>=0?truncateIdx:(anchorIdx>=0?anchorIdx+1:0);

  copy.series.forEach(function(s){
    var kind=rrSeriesKindFor(s,'');
    var bridged=(s.bridged||s.data||[]).slice();
    var out=bridged.map(function(){return null;});

    if(kind==='prior'){
      out=rrCumulativeSeries(bridged);
    }else if(kind==='actual'){
      for(var i=0;i<=lastActIdx&&i<cumAct.length;i++){
        if(cumAct[i]!=null) out[i]=cumAct[i];
      }
    }else if(kind==='forecast'||kind==='forecast-up'){
      if(anchorIdx>0&&cumAct[anchorIdx-1]!=null) out[anchorIdx-1]=num(cumAct[anchorIdx-1]);
      if(anchorIdx>=0&&projStart>anchorIdx) out[anchorIdx]=baseCum;
      var run=baseCum;
      for(var j=projStart;j<bridged.length;j++){
        if(bridged[j]==null||isNaN(bridged[j])) continue;
        var increment=num(bridged[j]);
        if(truncateIdx>=0&&j===truncateIdx&&rawActData[j]!=null&&!isNaN(rawActData[j])){
          increment=Math.max(0,num(bridged[j])-num(rawActData[j]));
        }
        run+=increment;
        out[j]=run;
      }
    }else{
      out=rrCumulativeSeries(bridged);
    }
    s.data=out;
    s.bridged=out;
  });
  copy._cumulative=true;
  copy._cumAnchorIdx=anchorIdx;
  return copy;
}
function rrFmtMonth(v){
  if(v==null||v==='') return '';
  var s=String(v).trim();
  if(!s||s.toLowerCase()==='month') return '';
  if(/^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)/i.test(s)) return s;
  if(v instanceof Date&&!isNaN(v.getTime())){
    var months=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return months[v.getMonth()]+'-'+String(v.getFullYear()).slice(-2);
  }
  if(typeof v==='number'&&v>40000&&v<60000){
    var d=new Date(Math.round((v-25569)*86400*1000));
    if(!isNaN(d.getTime())){
      var months=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      return months[d.getUTCMonth()]+'-'+String(d.getUTCFullYear()).slice(-2);
    }
  }
  return s;
}
function rrNum(v){
  if(v==null||v===''||v===' ') return null;
  if(typeof v==='number'&&!isNaN(v)) return v;
  var s=String(v).trim();
  if(!s||s.charAt(0)==='#') return null;
  var n=parseFloat(s.replace(/,/g,''));
  return isNaN(n)?null:n;
}
function rrSheetCell(sheet,r,c){
  if(typeof XLSX==='undefined'||!sheet) return null;
  var addr=XLSX.utils.encode_cell({r:r,c:c});
  var cell=sheet[addr];
  if(!cell||cell.v==null||cell.v==='') return null;
  if(cell.w&&typeof cell.w==='string'){
    var w=cell.w.trim();
    if(/^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)/i.test(w)) return w;
  }
  if(cell.t==='d'&&cell.v instanceof Date){
    if(cell.z&&typeof XLSX!=='undefined'&&XLSX.SSF){
      try{ var fw=XLSX.SSF.format(cell.z,cell.v); if(fw&&fw.trim()) return fw.trim(); }catch(e){}
    }
    return cell.v;
  }
  return cell.v;
}
function rrFindMonthHeader(sheet){
  if(!sheet||!sheet['!ref']) return null;
  var range=XLSX.utils.decode_range(sheet['!ref']);
  for(var r=range.s.r;r<=Math.min(range.e.r,10);r++){
    for(var c=range.s.c;c<=range.e.c;c++){
      var v=rrSheetCell(sheet,r,c);
      if(v!=null&&String(v).trim().toLowerCase()==='month'){
        return {headerRow:r,monthCol:c,range:range};
      }
    }
  }
  return null;
}
function rrParseTrendSheetFromHeaders(sheet,valueFmt){
  var hdr=rrFindMonthHeader(sheet);
  if(!hdr) return null;
  var seriesCols=[];
  for(var c=hdr.monthCol+1;c<=hdr.range.e.c;c++){
    var h=rrSheetCell(sheet,hdr.headerRow,c);
    if(h==null||String(h).trim()==='') continue;
    seriesCols.push({col:c,label:String(h).trim(),colLetter:XLSX.utils.encode_col(c)});
  }
  if(!seriesCols.length) return null;
  var labels=[],dataMap=seriesCols.map(function(){return [];});
  for(var r=hdr.headerRow+1;r<=hdr.range.e.r;r++){
    var month=rrSheetCell(sheet,r,hdr.monthCol);
    if(month==null||month==='') continue;
    var lbl=rrFmtMonth(month);
    if(!lbl) continue;
    labels.push(lbl);
    seriesCols.forEach(function(sc,i){
      dataMap[i].push(rrNum(rrSheetCell(sheet,r,sc.col)));
    });
  }
  if(!labels.length) return null;
  return {
    labels:labels,
    sheetRef:sheet['!ref']||'',
    monthCol:XLSX.utils.encode_col(hdr.monthCol),
    headerRow:hdr.headerRow+1,
    series:seriesCols.map(function(sc,i){
      return {label:sc.label,col:sc.colLetter,data:dataMap[i],fmt:valueFmt||'number'};
    })
  };
}
function rrFindSheet(wb,name){
  if(!wb||!wb.Sheets) return null;
  if(wb.Sheets[name]) return wb.Sheets[name];
  var keys=Object.keys(wb.Sheets);
  var exact=keys.find(function(k){return k.trim()===name.trim();});
  if(exact) return wb.Sheets[exact];
  var fuzzy=keys.find(function(k){return k.toLowerCase().indexOf(name.toLowerCase())>=0;});
  return fuzzy?wb.Sheets[fuzzy]:null;
}
function rrParseWorkbook(wb){
  var out={};
  RR_CHART_DEFS.forEach(function(def){
    var ws=rrFindSheet(wb,def.sheetName);
    if(!ws) return;
    var parsed=rrParseTrendSheetFromHeaders(ws,def.valueFmt);
    if(parsed){
      parsed.sheetName=def.sheetName;
      out[def.id]=parsed;
    }
  });
  return out;
}
function rrTrendWorkbookHint(wb,parsed){
  if(parsed&&Object.keys(parsed).length) return '';
  if(!wb||!wb.SheetNames||!wb.SheetNames.length) return 'Workbook has no sheets.';
  var hasGlk=wb.SheetNames.some(function(n){return /^glk$/i.test(String(n||'').trim());});
  if(hasGlk){
    return 'This file is the Work Cell / Performance Bridge workbook (GLK tab). Trends needs a separate file — Copy of dummy.xlsx — with tabs: Rev Rec 2026 vs 2025 Trend, GLK Net Add Lines Trend, GLK Fixed Net MRC Trend. Do not replace the Trends SharePoint file with dummy work oct.xlsx.';
  }
  return 'No trend sheets found. Upload Copy of dummy.xlsx (not the daily Work Cell GLK file).';
}
function rrIdbOpen(cb){
  if(typeof indexedDB==='undefined') return cb(new Error('IndexedDB unavailable'));
  var req=indexedDB.open(RR_IDB_NAME,1);
  req.onerror=function(){ cb(req.error||new Error('IndexedDB open failed')); };
  req.onupgradeneeded=function(e){
    var db=e.target.result;
    if(!db.objectStoreNames.contains(RR_IDB_STORE)) db.createObjectStore(RR_IDB_STORE);
  };
  req.onsuccess=function(){ cb(null,req.result); };
}
function rrCacheSave(arrayBuffer,meta,cb){
  cb=cb||function(){};
  var metaOut=Object.assign({},meta||{},{cachedAt:new Date().toISOString(),storage:'local'});
  var bufCopy=mqArrayBufferCopy(arrayBuffer);
  try{ localStorage.setItem(RR_LS_META_KEY,JSON.stringify(metaOut)); }catch(e){}
  try{
    if(bufCopy&&bufCopy.byteLength<=RR_LS_MAX_B64) localStorage.setItem(RR_LS_DATA_KEY,mqBufToB64(bufCopy));
    else localStorage.removeItem(RR_LS_DATA_KEY);
  }catch(e2){ try{ localStorage.removeItem(RR_LS_DATA_KEY); }catch(e3){} }
  rrIdbOpen(function(err,db){
    if(err) return cb(null,metaOut);
    var tx=db.transaction(RR_IDB_STORE,'readwrite');
    tx.objectStore(RR_IDB_STORE).put({buffer:bufCopy,meta:metaOut},'latest');
    tx.oncomplete=function(){ cb(null,metaOut); };
    tx.onerror=function(){ cb(null,metaOut); };
  });
}
function rrCacheLoad(cb){
  var meta=null;
  try{ meta=JSON.parse(localStorage.getItem(RR_LS_META_KEY)||'null'); }catch(e){}
  function tryLs(){
    try{
      var b64=localStorage.getItem(RR_LS_DATA_KEY);
      if(b64&&b64.length>20) return cb(null,mqB64ToBuf(b64),meta);
    }catch(e){}
    return cb(new Error('No cached Trends workbook'),null,null);
  }
  rrIdbOpen(function(err,db){
    if(err) return tryLs();
    var tx=db.transaction(RR_IDB_STORE,'readonly');
    var req=tx.objectStore(RR_IDB_STORE).get('latest');
    req.onsuccess=function(){
      if(!req.result||!req.result.buffer) return tryLs();
      cb(null,mqArrayBufferCopy(req.result.buffer),req.result.meta||meta);
    };
    req.onerror=function(){ tryLs(); };
  });
}
function rrSetParsed(parsed,meta){
  RR_PARSED=parsed;
  RR_META=meta||null;
  rrRefreshMeta();
  rrBuildChartTabs();
  rrRenderActiveChart();
}
function rrRefreshMeta(){
  var m=el('rrReportMeta');
  var spLink=el('rrReportSpLink');
  if(spLink) spLink.href=SP_TRENDS_REPORT_WEB_URL;
  if(!m) return;
  var uploadIso=RR_META&&(RR_META.uploadedAt||RR_META.cachedAt);
  m.textContent='Last uploaded: '+mqFmtReportUploadDate(uploadIso);
}
function rrTryLoadFromSharePoint(cb){
  cb=cb||function(){};
  var finished=false;
  function done(err){ if(finished) return; finished=true; cb(err); }
  setTimeout(function(){ done(new Error('Trends SharePoint load timed out')); },50000);
  spDownloadTrendsReport(function(err,buffer){
    if(err||!buffer||!buffer.byteLength) return done(err||new Error('Trends file not on SharePoint yet — upload Copy of dummy.xlsx once'));
    spGetTrendsReportMeta(function(err2,meta){
      var m=Object.assign({filename:SP_TRENDS_REPORT_FILE,storage:'sharepoint'},meta||{});
      rrCacheSave(buffer,m,function(){
        rrParseBuffer(buffer,m,function(e){ done(e); });
      });
    });
  });
}
function rrTryLoadFromSharePointBackground(){
  glkEnsureTrendsLoaded(false);
}
window.rrRefreshFromSharePoint=function(){
  var metaEl=el('rrReportMeta');
  if(metaEl) metaEl.textContent='Refreshing from SharePoint…';
  glkShowLoader('Loading trends workbook from SharePoint…');
  var hideTimer=setTimeout(function(){ glkHideLoader(); },55000);
  rrTryLoadFromSharePoint(function(err){
    clearTimeout(hideTimer);
    glkHideLoader();
    if(err) alert('Could not load trends from SharePoint:\n'+err.message+'\n\nUpload Copy of dummy.xlsx to SiteAssets once, or use browser cache.');
  });
};
function rrSetControlsPanelCollapsed(collapsed){
  var panel=el('rrControlsPanel');
  var lbl=el('rrControlsToggleLabel');
  var btn=el('rrControlsToggleBtn');
  if(!panel) return;
  panel.classList.toggle('collapsed',!!collapsed);
  if(lbl) lbl.textContent=collapsed?'Show controls':'Hide controls';
  if(btn) btn.classList.toggle('collapsed',!!collapsed);
  try{ localStorage.setItem('glk_rr_controls_collapsed',collapsed?'1':'0'); }catch(e){}
  if(!collapsed){
    setTimeout(function(){
      if(CHARTS.revenueRec) CHARTS.revenueRec.resize();
    },260);
  }
}
window.rrToggleControlsPanel=function(){
  var panel=el('rrControlsPanel');
  if(!panel) return;
  rrSetControlsPanelCollapsed(!panel.classList.contains('collapsed'));
};
function rrInitControlsPanel(){
  var collapsed=false;
  try{ collapsed=localStorage.getItem('glk_rr_controls_collapsed')==='1'; }catch(e){}
  rrSetControlsPanelCollapsed(collapsed);
}
function rrBuildChartTabs(){
  var wrap=el('rrChartTabs');
  if(!wrap) return;
  wrap.innerHTML=RR_CHART_DEFS.map(function(d){
    var ok=RR_PARSED&&RR_PARSED[d.id]&&RR_PARSED[d.id].labels&&RR_PARSED[d.id].labels.length;
    return '<button type="button" class="rr-chart-tab'+(RR_ACTIVE_CHART===d.id?' active':'')+'" onclick="rrSetActiveChart(\''+d.id+'\')">'+
      d.title+(ok?'':' <span style="opacity:.55;">⚠</span>')+'</button>';
  }).join('');
}
window.rrSetActiveChart=function(id){
  RR_ACTIVE_CHART=id;
  rrBuildChartTabs();
  rrRenderActiveChart();
};
function rrFmtVal(v,fmt){ return rrFmtFull(v,fmt); }
function rrChartDataFor(id){
  if(!RR_PARSED||!RR_PARSED[id]||!RR_PARSED[id].labels||!RR_PARSED[id].labels.length) return null;
  if(id!=='netAddLines'&&id!=='fixedMrc') return RR_PARSED[id];
  var copy=rrCloneChartData(RR_PARSED[id]);
  rrSanitizeCascadeForecasts(copy,id);
  if(id==='fixedMrc'||id==='netAddLines') rrApplyTrendExcelProjections(copy,id);
  return copy;
}
function rrRenderLineExplain(def,data){
  var box=el('rrLineExplain');
  if(!box) return;
  if(!data||!data.series||!data.series.length){
    box.innerHTML='<span style="color:#f59e0b;">No data parsed for this sheet. Re-upload the Excel file — columns are read from the <strong>Month</strong> header row.</span>';
    return;
  }
  var help=RR_SERIES_HELP[def.id]||{};
  var html='<div style="font-weight:700;color:var(--acc);margin-bottom:.35rem;">What each line represents</div>';
  data.series.forEach(function(s,i){
    var st=rrSeriesStyleForChart(s.label,i,def.id,s.col);
    var dash=st.dash&&st.dash.length?' (dashed)':' (solid)';
    var txt=help[s.label]||('<strong>Column '+s.col+' — '+s.label+'</strong> · Values read directly from Excel column '+s.col+'.');
    html+='<div style="display:flex;gap:.45rem;margin-bottom:.3rem;align-items:flex-start;">'+
      '<span style="width:22px;height:3px;margin-top:.45rem;flex-shrink:0;background:'+st.color+';'+(st.dash.length?'background:repeating-linear-gradient(90deg,'+st.color+' 0 5px,transparent 5px 9px)':'')+'"></span>'+
      '<span>'+txt+dash+'</span></div>';
  });
  html+='<div style="margin-top:.4rem;color:var(--t3);font-size:.66rem;">Source: sheet <strong>'+(data.sheetName||def.sheetName)+'</strong> · Month column <strong>'+data.monthCol+'</strong> · '+data.labels.length+' data points</div>';
  box.innerHTML=html;
}
function rrRenderActiveChart(){
  var def=RR_CHART_DEFS.find(function(d){return d.id===RR_ACTIVE_CHART;})||RR_CHART_DEFS[0];
  var raw=rrChartDataFor(def.id);
  var toggleWrap=el('rrTrendCumulativeWrap')||el('rrNetAddToggleWrap');
  var toggleCb=el('rrTrendCumulative')||el('rrNetAddCumulative');
  if(toggleWrap) toggleWrap.style.display=rrTrendHasCumulativeToggle(def.id)?'flex':'none';
  if(toggleCb) toggleCb.checked=RR_TREND_CUMULATIVE;
  var titleEl=el('rrChartTitle'), subEl=el('rrChartSubtitle'), noteEl=el('rrChartNote'), legEl=el('rrChartLegend'), projBadge=el('rrProjBadge');
  if(titleEl) titleEl.textContent=def.title+(rrTrendHasCumulativeToggle(def.id)&&RR_TREND_CUMULATIVE?' · Accumulated':'');
  if(subEl){
    if(rrTrendHasCumulativeToggle(def.id)&&RR_TREND_CUMULATIVE){
      subEl.textContent='Running total — actuals accumulate month by month; Most Likely / Upside continue from the last actual month into the projection zone.';
    }else{
      subEl.textContent=def.subtitle;
    }
  }
  rrRenderLineExplain(def,raw);
  rrRenderKpis(def,rrTrendRawData(def.id)||raw,rrTrendHasCumulativeToggle(def.id)&&RR_TREND_CUMULATIVE);
  if(noteEl){
    var churnNote='';
    if(raw&&raw._excelProjectionsOnly){
      if(def.id==='fixedMrc') churnNote=' · Fixed MRC: actual + forecast from Excel. Current month projects from prior month on chart.';
      else if(def.id==='netAddLines') churnNote=' · Net Add Lines: actual + Most Likely / Upside from Excel. No pipeline churn applied.';
    }
    noteEl.textContent=raw
      ?('Excel '+raw.sheetRef+' · Header row '+raw.headerRow+' · Hover points for value breakdown'+churnNote)
      :(RR_TREND_PARSE_HINT||'Upload Copy of dummy.xlsx to load all 3 trend sheets.');
  }
  destroyChart('revenueRec');
  var canvas=el('chartRevenueRec');
  if(!canvas) return;
  if(!raw||!raw.labels||!raw.labels.length){
    if(legEl) legEl.innerHTML='';
    if(projBadge) projBadge.style.display='none';
    var ctx=canvas.getContext('2d');
    if(ctx) ctx.clearRect(0,0,canvas.width,canvas.height);
    return;
  }
  var data=rrBridgeForecastData(raw,def.id);
  if(rrTrendHasCumulativeToggle(def.id)&&RR_TREND_CUMULATIVE){
    data=rrApplyCumulativeChartData(data,raw,rrTrendRawData(def.id)||raw);
  }
  var projByMonth=raw._projByMonth||{};
  var truncateIdx=raw._truncateActualIdx!=null?raw._truncateActualIdx:null;
  var c=getChartColors();
  var isCumulative=!!data._cumulative;
  var projIdx=rrProjectionStartIdx(data.series);
  var lastAct=rrLastActualIdx(data.series);
  var anchorIdx=isCumulative?(data._cumAnchorIdx!=null?data._cumAnchorIdx:lastAct):-1;
  if(projBadge) projBadge.style.display=(projIdx>=0&&projIdx>lastAct)?'inline-block':'none';
  var chartSeries=(data.series||[]);
  if(isCumulative&&def.id==='fixedMrc'){
    chartSeries=chartSeries.filter(function(s){return rrSeriesKindFor(s,def.id)!=='prior';});
  }
  var yRange=rrCalcYRange(def.id,chartSeries,def.valueFmt);
  var chartId=def.id;
  var dsMeta=[];
  var colorFills={
    '2025 Revenue':['rgba(37,99,235,.35)','rgba(37,99,235,.02)'],
    '2026 Revenue':['rgba(234,88,12,.35)','rgba(234,88,12,.02)'],
    'GLK Net Add Lines':['rgba(37,99,235,.28)','rgba(37,99,235,.02)'],
    '2025 Fixed Net MRC':['rgba(29,78,216,.22)','rgba(29,78,216,.02)'],
    '2026 Fixed Net MRC':['rgba(234,88,12,.28)','rgba(234,88,12,.02)']
  };
  var datasets=chartSeries.map(function(s,i){
    var st=rrSeriesStyleForChart(s.label,i,chartId,s.col);
    var kind=rrSeriesKindFor(s,chartId);
    var isFc=st.kind==='forecast'||st.kind==='forecast-up';
    dsMeta.push({kind:kind,fmt:s.fmt,label:s.label,color:st.color,col:s.col});
    var fillTop=(colorFills[s.label]||['rgba(99,102,241,.2)','rgba(99,102,241,.01)'])[0];
    var fillBot=(colorFills[s.label]||['rgba(99,102,241,.2)','rgba(99,102,241,.01)'])[1];
    return {
      label:s.label,
      data:s.bridged||s.data,
      borderColor:st.color,
      backgroundColor:function(ctx){
        if(isFc||!st.fill) return 'transparent';
        return rrGradientFill(ctx.chart,fillTop,fillBot);
      },
      borderWidth:isFc?2.5:(st.lw||3.5),
      borderDash:st.dash||[],
      tension:isFc?0.2:0.42,
      fill:!isFc&&!!st.fill?'start':false,
      pointRadius:isFc?5:(st.pt||6),
      pointHoverRadius:isFc?8:9,
      pointBackgroundColor:'#fff',
      pointBorderColor:st.color,
      pointBorderWidth:3,
      pointHoverBorderWidth:3,
      spanGaps:isFc,
      clip:false,
      _rrColor:st.color
    };
  });
  if(legEl){
    var legSeries=chartSeries;
    var legExtra=isCumulative&&def.id==='fixedMrc'?'<span style="color:var(--t3);font-size:.66rem;margin-left:.35rem;">2025 baseline hidden in accumulated view</span>':'';
    legEl.innerHTML=legSeries.map(function(s,i){
      var st=rrSeriesStyleForChart(s.label,i,chartId,s.col);
      var isFc=st.kind==='forecast'||st.kind==='forecast-up';
      var isPrior=st.kind==='prior';
      var icon=isFc
        ?'<span class="rr-legend-line" style="background:repeating-linear-gradient(90deg,'+st.color+' 0 5px,transparent 5px 8px);"></span>'
        :'<span class="rr-legend-dot" style="background:'+st.color+';"></span>';
      var tag=isFc?' <span class="rr-proj-badge" style="font-size:.58rem;padding:.1rem .3rem;">Proj</span>':(isPrior?' <span style="color:var(--t3);font-size:.6rem;">Prior yr</span>':'');
      var colTag=(chartId==='netAddLines'||chartId==='fixedMrc')?'':' <span style="color:var(--t3);font-weight:500;">('+s.col+')</span>';
      return '<span class="rr-legend-chip">'+icon+s.label+colTag+tag+'</span>';
    }).join('')+legExtra;
  }
  try{
    if(typeof Chart!=='undefined') Chart.defaults.devicePixelRatio=Math.min(window.devicePixelRatio||1,2.5);
    CHARTS.revenueRec=new Chart(canvas,{
      type:'line',
      data:{labels:data.labels,datasets:datasets},
      plugins:[
        rrGridBandPlugin(c),
        rrProjectionZonePlugin(projIdx,c),
        rrYoYBandPlugin(data.series,chartId),
        rrLineShadowPlugin(),
        rrPointHaloPlugin(),
        rrAxisFloorPlugin(yRange.floor,def.valueFmt,chartId),
        rrDataLabelPlugin(dsMeta,def.valueFmt,chartId,projIdx,lastAct,projByMonth,truncateIdx,isCumulative,anchorIdx),
        rrCrosshairPlugin()
      ],
      options:{
        responsive:true,maintainAspectRatio:false,
        layout:{padding:{top:28,right:18,left:10,bottom:8}},
        interaction:{mode:'index',intersect:false},
        animation:{duration:600,easing:'easeOutQuart'},
        plugins:{
          legend:{display:false},
          tooltip:{
            enabled:true,
            backgroundColor:'rgba(15,10,30,.96)',padding:16,cornerRadius:12,
            titleFont:{size:14,weight:'800'},bodyFont:{size:13,weight:'600'},
            footerFont:{size:11},displayColors:true,
            callbacks:{
              title:function(items){return items[0]?data.labels[items[0].dataIndex]:'';},
              label:function(ctx){
                var s=data.series[ctx.datasetIndex];
                if(!s||ctx.parsed.y==null) return null;
                var kind=(dsMeta[ctx.datasetIndex]&&dsMeta[ctx.datasetIndex].kind)||'';
                var idx=ctx.dataIndex;
                var p=projByMonth[idx];
                if(p&&(kind==='forecast'||kind==='forecast-up')){
                  if(p.excelOnly){
                    if(kind==='forecast'&&p.projMl!=null){
                      return [' Projection: '+rrFmtFull(p.projMl,s.fmt||def.valueFmt),
                        '   Actual to date: '+rrFmtFull(p.curAct,s.fmt||def.valueFmt),
                        '   + Current addition: '+rrFmtFull(p.forwardMl,s.fmt||def.valueFmt)];
                    }
                    if(kind==='forecast-up'&&p.projUp!=null){
                      return [' Projection: '+rrFmtFull(p.projUp,s.fmt||def.valueFmt),
                        '   Actual to date: '+rrFmtFull(p.curAct,s.fmt||def.valueFmt),
                        '   + Current addition: '+rrFmtFull(p.forwardUp,s.fmt||def.valueFmt)];
                    }
                  }
                  if(kind==='forecast'&&p.netMl!=null){
                    var mlLines=[' Projected total: '+rrFmtFull(p.netMl,s.fmt||def.valueFmt)];
                    if(p.curAct!=null&&p.forwardMl!=null){
                      mlLines.push('   Month actual: '+rrFmtFull(p.curAct,s.fmt||def.valueFmt));
                      mlLines.push('   + ML add-on (Excel): '+rrFmtFull(p.forwardMl,s.fmt||def.valueFmt));
                    }else if(p.forwardMl!=null){
                      mlLines.push('   Excel forward: '+rrFmtFull(p.forwardMl,s.fmt||def.valueFmt));
                    }
                    if(p.churnMl) mlLines.push('   Churn share: '+rrFmtFull(p.churnMl,s.fmt||def.valueFmt));
                    return mlLines;
                  }
                  if(kind==='forecast-up'&&p.netUp!=null){
                    var upLines=[' Projected total: '+rrFmtFull(p.netUp,s.fmt||def.valueFmt)];
                    if(p.curAct!=null&&p.forwardUp!=null){
                      upLines.push('   Month actual: '+rrFmtFull(p.curAct,s.fmt||def.valueFmt));
                      upLines.push('   + Upside add-on (Excel): '+rrFmtFull(p.forwardUp,s.fmt||def.valueFmt));
                    }else if(p.forwardUp!=null){
                      upLines.push('   Excel forward: '+rrFmtFull(p.forwardUp,s.fmt||def.valueFmt));
                    }
                    if(p.churnUp) upLines.push('   Churn share: '+rrFmtFull(p.churnUp,s.fmt||def.valueFmt));
                    return upLines;
                  }
                }
                return ' '+s.label+': '+rrFmtFull(ctx.parsed.y,s.fmt||def.valueFmt);
              },
              labelColor:function(ctx){
                var col=ctx.dataset.borderColor||ctx.dataset._rrColor||'#6366f1';
                return {borderColor:col,backgroundColor:col};
              },
              footer:function(items){
                if(!items.length) return '';
                var lines=[];
                var idx=items[0].dataIndex;
                if(projIdx>=0&&idx>=projIdx) lines.push('▲ Projection / forecast period');
                if(chartId==='revRecTrend'&&idx>0){
                  var s26=data.series.find(function(s){return s.label&&s.label.indexOf('2026')>=0;});
                  if(s26){
                    var vals=s26.bridged||s26.data||[];
                    var prev=vals[idx-1], cur=vals[idx];
                    if(prev!=null&&cur!=null&&!isNaN(prev)&&!isNaN(cur)&&prev){
                      var pct=((cur-prev)/prev*100).toFixed(1);
                      lines.push('2026 MoM: '+(cur>=prev?'+':'')+pct+'%');
                    }
                  }
                }
                return lines.join('\n');
              }
            }
          }
        },
        scales:{
          x:{
            ticks:{color:c.text,font:{size:11,weight:'700'},maxRotation:45,minRotation:0,padding:8},
            grid:{color:'rgba(148,163,184,.12)',drawBorder:false},
            border:{color:'rgba(148,163,184,.25)'},
            title:{display:true,text:'Month',color:c.text,font:{size:11,weight:'800'},padding:{top:6}}
          },
          y:{
            min:yRange.min,max:yRange.max,
            beginAtZero:false,
            grace:0,
            ticks:{
              color:c.text,font:{size:11,weight:'700'},
              callback:function(v){return rrFmtAxisTick(v,def.valueFmt,chartId);},
              maxTicksLimit:chartId==='revRecTrend'?24:(chartId==='fixedMrc'?14:8),
              stepSize:chartId==='fixedMrc'?500000:(chartId==='revRecTrend'?2000000:undefined),
              padding:10
            },
            grid:{color:'rgba(148,163,184,.18)',drawBorder:false,lineWidth:1},
            border:{color:'rgba(148,163,184,.3)',dash:[4,4]},
            title:{
              display:true,
              text:def.yLabel+(chartId==='revRecTrend'?' · zoomed '+rrFmtAxisTick(yRange.min,def.valueFmt,chartId)+'–'+rrFmtAxisTick(yRange.max,def.valueFmt,chartId):''),
              color:c.text,font:{size:11,weight:'800'},padding:{bottom:8}
            }
          }
        }
      }
    });
  }catch(err){ console.error('[GLK] Trends chart error:',err); }
}
function rrParseBuffer(arrayBuffer,meta,cb){
  cb=cb||function(){};
  if(typeof XLSX==='undefined'){ alert('Excel parser not loaded.'); return cb(new Error('XLSX missing')); }
  try{
    var wb=XLSX.read(arrayBuffer,{type:'array',cellDates:true,cellNF:true});
    var parsed=rrParseWorkbook(wb);
    var count=Object.keys(parsed).length;
    if(!count){
      RR_TREND_PARSE_HINT=rrTrendWorkbookHint(wb,parsed);
      return cb(new Error(RR_TREND_PARSE_HINT||'No trend sheets found. Expected sheets:\n• Rev Rec 2026 vs 2025 Trend\n• GLK Net Add Lines Trend\n• GLK Fixed Net MRC Trend'));
    }
    RR_TREND_PARSE_HINT='';
    RR_META=meta||null;
    RR_PARSED=parsed;
    rrRefreshMeta();
    rrBuildChartTabs();
    if(!RR_PARSED[RR_ACTIVE_CHART]) RR_ACTIVE_CHART=Object.keys(RR_PARSED)[0]||'revRecTrend';
    rrRenderActiveChart();
    if(count<3) console.warn('[GLK] Trends: only '+count+'/3 sheets parsed',Object.keys(parsed));
    cb(null,parsed);
  }catch(e){ cb(e); }
}
window.rrReportUpload=function(file){
  if(!file) return;
  if(typeof XLSX==='undefined'){ alert('Excel parser not loaded. Refresh the page.'); return; }
  var reader=new FileReader();
  reader.onload=function(){
    glkShowLoader('Publishing trends workbook to SharePoint…');
    var buf=reader.result;
    spUploadTrendsReport(buf,file.name,function(spErr,spMeta){
      var meta=Object.assign({},spMeta||{},{filename:SP_TRENDS_REPORT_FILE,originalName:file.name,size:file.size,uploadedAt:new Date().toISOString(),storage:spErr?'local-cache':'sharepoint',spError:spErr?spErr.message:null});
      rrCacheSave(buf,meta,function(){
        rrParseBuffer(buf,meta,function(err){
          glkHideLoader();
          if(err) alert('Could not parse workbook:\n'+err.message);
          else if(spErr) alert('Loaded locally but SharePoint upload failed:\n'+spErr.message);
        });
      });
    });
  };
  reader.onerror=function(){ alert('Could not read file.'); };
  reader.readAsArrayBuffer(file);
};
window.rrReloadFromCache=function(){
  rrCacheLoad(function(err,buffer,meta){
    if(err||!buffer){
      alert('No cached trends file. Upload Copy of dummy.xlsx once.');
      return;
    }
    glkShowLoader('Loading cached trends…');
    rrParseBuffer(buffer,meta,function(e){
      glkHideLoader();
      if(e) alert('Cache load failed: '+e.message);
    });
  });
};
function rrInitView(deferRender){
  rrInitControlsPanel();
  if(RR_PARSED&&Object.keys(RR_PARSED).length){
    rrBuildChartTabs();
    if(!deferRender) rrRenderActiveChart();
    rrTryLoadFromSharePointBackground();
    return;
  }
  rrCacheLoad(function(err,buffer,meta){
    if(!err&&buffer&&buffer.byteLength){
      rrParseBuffer(buffer,meta,function(){
        rrTryLoadFromSharePointBackground();
      });
      return;
    }
    rrTryLoadFromSharePoint(function(spErr){
      if(!spErr) return;
      rrTryLoadBundledWorkbook(function(loadErr){
        if(!loadErr){
          if(!deferRender) rrRenderActiveChart();
          return;
        }
        RR_PARSED=null;
        RR_META=null;
        rrRefreshMeta();
        rrBuildChartTabs();
        if(!deferRender) rrRenderActiveChart();
      });
    });
  });
}
function rrTryLoadBundledWorkbook(cb){
  cb=cb||function(){};
  if(typeof fetch==='undefined') return cb(new Error('no fetch'));
  var names=['Copy of dummy.xlsx','Copy%20of%20dummy.xlsx'];
  var idx=0;
  function tryNext(){
    if(idx>=names.length) return cb(new Error('bundled workbook not found'));
    fetch(names[idx]).then(function(r){
      if(!r.ok){ idx++; return tryNext(); }
      return r.arrayBuffer();
    }).then(function(buf){
      if(!buf||!buf.byteLength){ idx++; return tryNext(); }
      var meta={filename:'Copy of dummy.xlsx',storage:'bundled',size:buf.byteLength};
      rrCacheSave(buf,meta,function(){
        rrParseBuffer(buf,meta,function(e){ cb(e||null); });
      });
    }).catch(function(){ idx++; tryNext(); });
  }
  tryNext();
}

// ══════════════════════════════════════════════════════════════════
//  PIPELINE GOVERNANCE — SharePoint version history
// ══════════════════════════════════════════════════════════════════
const PG_VERSION_CACHE_LS='glk_pg_version_cache_v9';
const PG_OPP_FIELD='Opportunity_x0020_Status';
let PG_DEBUG=null;
let PG_TAB='stale';
let PG_ANALYSIS=[];
let PG_LOADING=false;
let PG_GRID_API=null;
let PG_SEL_TILE=null;
let PG_DRILL_HD=null;
let PG_DRILL_AD=null;
let PG_DRILL_AM=null;
let PG_FLIP_FILTER='all';
let PG_STALE_DAYS=1;
let PG_FLIP_FROM_ISO='';
let PG_FLIP_TO_ISO='';
let PG_LOAD_STATS={fetched:0,cached:0,fallback:0,hardErrors:0,totalFlips:0,dealsWithFlips:0,aspxReads:0,detailReads:0,aspxParseHits:0};
function pgTodayIso(){
  var d=new Date();
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}
function pgQuarterStartIso(){
  var live=mqLiveYearQuarter();
  var d=new Date(live.year,(live.quarter-1)*3,1);
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}
function pgIsoFromDate(dt){
  if(!dt) return '';
  return dt.getFullYear()+'-'+String(dt.getMonth()+1).padStart(2,'0')+'-'+String(dt.getDate()).padStart(2,'0');
}
function pgParseIsoDate(s){
  if(!s) return null;
  var p=String(s).split('-');
  if(p.length!==3) return null;
  var dt=new Date(+p[0],+p[1]-1,+p[2],0,0,0,0);
  return isNaN(dt)?null:dt;
}
function pgEndOfIsoDay(d){
  if(!d) return null;
  return new Date(d.getFullYear(),d.getMonth(),d.getDate(),23,59,59,999);
}
function pgFlipInDateRange(flip,fromDay,toDay){
  if(!fromDay&&!toDay) return true;
  var w=pgParseSpDateTime(flip.when);
  if(!w) return true;
  var day=new Date(w.getFullYear(),w.getMonth(),w.getDate());
  if(fromDay&&day<fromDay) return false;
  if(toDay&&day>toDay) return false;
  return true;
}
function pgStaleBucketLabel(days){
  if(days>=21) return '21+ days';
  if(days>=15) return '15+ days';
  if(days>=7) return '7+ days';
  if(days>=1) return '1+ days';
  return '<1 day';
}
function pgNormStatus(s){
  s=String(s||'').trim();
  return (s==='—'||!s)?'':s;
}
function pgStatusClass(s){
  var l=String(s||'').toLowerCase();
  if(l==='opportunity') return 'opp';
  if(l==='proposed') return 'prop';
  if(l==='billed') return 'billed';
  if(l==='won'||l==='closed won') return 'won';
  return '';
}
function pgIsQtgGovernanceBid(bid){
  if(mqActivationRejectReason(bid)) return false;
  var s=mqRawOppStatus(bid).toLowerCase();
  if(!s||s==='—') return false;
  if(s==='lost'||s==='cancelled'||s==='no bid') return false;
  return true;
}
function pgGetQtgCandidates(){
  return (ALL_BIDS||[]).filter(pgIsQtgGovernanceBid);
}
function pgLoadVersionCache(){
  try{ return JSON.parse(localStorage.getItem(PG_VERSION_CACHE_LS)||'{}')||{}; }
  catch(e){ return {}; }
}
function pgSaveVersionCacheEntry(itemId,entry){
  try{
    var store=pgLoadVersionCache();
    store[String(itemId)]=entry;
    var keys=Object.keys(store);
    if(keys.length>800){
      keys.sort(function(a,b){ return (store[a].savedAt||0)-(store[b].savedAt||0); });
      keys.slice(0,keys.length-600).forEach(function(k){ delete store[k]; });
    }
    localStorage.setItem(PG_VERSION_CACHE_LS,JSON.stringify(store));
  }catch(e){}
}
function pgGetCachedVersions(bid){
  var store=pgLoadVersionCache();
  var e=store[String(bid.id)];
  if(!e||!e.versions||!e.versions.length) return null;
  if(bid.modified&&e.modified&&String(bid.modified)!==String(e.modified)) return null;
  return e.versions;
}
function pgEditorFromRow(d){
  if(!d) return '—';
  try{
    if(typeof d.Editor==='string'&&d.Editor.trim()) return d.Editor.trim();
    if(d.Editor&&d.Editor.Title) return d.Editor.Title;
    if(typeof d.Author==='string'&&d.Author.trim()) return d.Author.trim();
    if(d.CreatedBy&&d.CreatedBy.Title) return d.CreatedBy.Title;
    if(d.Author&&d.Author.Title) return d.Author.Title;
  }catch(e){}
  return '—';
}
function pgFallbackVersions(bid){
  return [{versionId:1,versionLabel:'current',created:bid.modified||bid.created,oppStatus:pgNormStatus(bid.oppStatus),editor:bid.userName||'—'}];
}
function pgStatusKey(s){
  return String(s||'').trim().toLowerCase();
}
function pgStripHtml(html){
  var tmp=document.createElement('div');
  tmp.innerHTML=html||'';
  return (tmp.textContent||tmp.innerText||'').replace(/\s+/g,' ').trim();
}
function pgCleanFieldVal(v){
  if(v==null||v===undefined) return '';
  if(typeof v==='object'&&v.Title) return pgNormStatus(v.Title);
  return pgNormStatus(pgStripHtml(String(v)));
}
function pgExtractOppFromVersionPayload(d){
  if(!d) return '';
  var opp=pgCleanFieldVal(d[PG_OPP_FIELD]);
  if(opp) return opp;
  var fvt=d.FieldValuesAsText;
  if(fvt&&typeof fvt==='object'){
    opp=pgCleanFieldVal(fvt['Opportunity Status']||fvt[PG_OPP_FIELD]||fvt.Opportunity_x0020_Status);
    if(opp) return opp;
    try{
      Object.keys(fvt).forEach(function(k){
        if(opp) return;
        if(/opportunity/i.test(k)&&/status/i.test(k)) opp=pgCleanFieldVal(fvt[k]);
      });
    }catch(e){}
  }
  try{
    Object.keys(d).forEach(function(k){
      if(opp) return;
      if(k==='__metadata'||k==='Editor'||k==='Author'||k==='CreatedBy'||k==='Modified'||k==='Created'||k==='VersionLabel') return;
      if(/opportunity/i.test(k)&&/status/i.test(k)) opp=pgCleanFieldVal(d[k]);
    });
  }catch(e2){}
  return opp||'';
}
function pgVersionSortKey(row){
  var lbl=parseFloat(row.VersionLabel);
  if(!isNaN(lbl)) return lbl;
  var vid=parseFloat(row.VersionId);
  if(!isNaN(vid)) return vid;
  var t=pgParseSpDateTime(row.Modified||row.Created);
  return t?t.getTime():0;
}
function pgVersionId(rowMeta){
  if(rowMeta==null) return null;
  if(rowMeta.ID!=null) return rowMeta.ID;
  if(rowMeta.Id!=null) return rowMeta.Id;
  if(rowMeta.VersionId!=null) return rowMeta.VersionId;
  return null;
}
function pgVersionFetchUrls(itemId,rowMeta){
  var safeList=SP_LIST.replace(/'/g,"''");
  var base=SP_SITE+"/_api/web/lists/getbytitle('"+safeList+"')/items("+itemId+")/versions";
  var vid=pgVersionId(rowMeta);
  var vl=rowMeta.VersionLabel!=null?String(rowMeta.VersionLabel).replace(/'/g,"''"):null;
  var sel=encodeURIComponent(PG_OPP_FIELD+',Modified,Created,VersionLabel');
  var urls=[];
  if(window._PG_LIST_GUID){
    var gbase=SP_SITE+"/_api/web/lists(guid'"+window._PG_LIST_GUID+"')/items("+itemId+")/versions";
    if(vid!=null){
      urls.push(gbase+'('+vid+')/FieldValuesAsText');
      urls.push(gbase+'('+vid+')?$select='+sel);
    }
    if(vl){
      urls.push(gbase+"('"+vl+"')/FieldValuesAsText");
      urls.push(gbase+"('"+vl+"')?$select="+sel);
    }
  }
  if(vid!=null){
    urls.push(base+'('+vid+')/FieldValuesAsText');
    urls.push(base+'('+vid+')?$select='+sel);
  }
  if(vl){
    urls.push(base+"('"+vl+"')/FieldValuesAsText");
    urls.push(base+"('"+vl+"')?$select="+sel);
    if(String(vl)!==String(vid)) urls.push(base+'('+vl+')/FieldValuesAsText');
  }
  return urls;
}
function pgFetchVersionFieldSet(itemId,rowMeta,cb){
  var urls=pgVersionFetchUrls(itemId,rowMeta);
  var listOpp=pgCleanFieldVal(rowMeta[PG_OPP_FIELD]);
  var ci=0, bestFields=null;
  function finish(fields,ok){
    var opp=pgExtractOppFromVersionPayload(fields)||listOpp;
    cb({
      versionId:pgVersionId(rowMeta),
      versionLabel:rowMeta.VersionLabel||String(pgVersionId(rowMeta)||''),
      created:rowMeta.Modified||rowMeta.Created,
      oppStatus:opp,
      rawFields:fields||{},
      editor:pgEditorFromRow(fields)||pgEditorFromRow(rowMeta),
      fetched:!!ok,
      listOpp:listOpp
    });
  }
  function tryNext(){
    if(ci>=urls.length) return finish(bestFields||{},!!bestFields);
    spGet(urls[ci++],function(err,data){
      if(!err&&data&&data.d){
        bestFields=data.d;
        var opp=pgExtractOppFromVersionPayload(data.d)||listOpp;
        if(opp) return finish(data.d,true);
      }
      tryNext();
    });
  }
  tryNext();
}
function pgFetchItemVersionHistory(bid,cb,skipCache){
  if(!skipCache){
    var cached=pgGetCachedVersions(bid);
    if(cached){ PG_LOAD_STATS.cached++; return cb(null,cached,false,pgAnalyzeVersionHistory(bid,cached)); }
  }
  pgFetchVersionsAspxFlips(bid,function(aspxFlips,parsed){
    var versions=(parsed&&parsed.versions&&parsed.versions.length)?parsed.versions:pgFallbackVersions(bid);
    if(!(parsed&&parsed.versions&&parsed.versions.length)) PG_LOAD_STATS.fallback++;
    else PG_LOAD_STATS.fetched++;
    var analysis=pgAnalyzeVersionHistory(bid,versions);
    if(aspxFlips&&aspxFlips.length){
      analysis=pgApplyFlipsToAnalysis(bid,versions,aspxFlips,analysis);
    }
    pgSaveVersionCacheEntry(bid.id,{modified:bid.modified,savedAt:Date.now(),versions:versions,analysisFlips:(analysis.flips||[]).length});
    cb(null,versions,!(aspxFlips&&aspxFlips.length),analysis);
  });
}
function pgContinueVersionRows(bid,rows,cb){
  rows=rows||[];
  rows.sort(function(a,b){ return pgVersionSortKey(a)-pgVersionSortKey(b); });
  var out=rows.map(function(rowMeta){
    return {
      versionId:pgVersionId(rowMeta),
      versionLabel:rowMeta.VersionLabel||String(pgVersionId(rowMeta)||''),
      created:rowMeta.Modified||rowMeta.Created,
      oppStatus:pgCleanFieldVal(rowMeta[PG_OPP_FIELD]),
      editor:pgEditorFromRow(rowMeta),
      fetched:true
    };
  });
  if(!out.length){
    out=pgFallbackVersions(bid);
    PG_LOAD_STATS.fallback++;
  }else PG_LOAD_STATS.fetched++;
  pgFinishVersionHistory(bid,out,function(err2,finalOut,analysis,isPartial){
    pgSaveVersionCacheEntry(bid.id,{modified:bid.modified,savedAt:Date.now(),versions:finalOut,analysisFlips:(analysis.flips||[]).length});
    cb(null,finalOut,isPartial,analysis);
  });
}
function pgDiffOppBetweenVersions(prevVer,curVer){
  var oldSt=pgNormStatus(prevVer&&prevVer.oppStatus);
  var newSt=pgNormStatus(curVer&&curVer.oppStatus);
  if(!oldSt||!newSt||pgStatusKey(oldSt)===pgStatusKey(newSt)) return null;
  return {from:oldSt,to:newSt};
}
function pgDiffOppFromRawFields(prevFields,curFields){
  var oldSt=pgExtractOppFromVersionPayload(prevFields);
  var newSt=pgExtractOppFromVersionPayload(curFields);
  if(!oldSt||!newSt||pgStatusKey(oldSt)===pgStatusKey(newSt)) return null;
  return {from:oldSt,to:newSt};
}
function pgListGuidRaw(){
  if(!window._PG_LIST_GUID) return '';
  return String(window._PG_LIST_GUID).replace(/[{}]/g,'');
}
function pgListGuidBrace(){
  var g=pgListGuidRaw();
  return g?'{'+g+'}':'';
}
function pgFetchHtml(url,cb){
  var done=false;
  function finish(err,html){
    if(done) return;
    done=true;
    cb(err,html);
  }
  var xhr=new XMLHttpRequest();
  xhr.open('GET',url,true);
  xhr.timeout=8000;
  xhr.withCredentials=true;
  xhr.onreadystatechange=function(){
    if(xhr.readyState!==4) return;
    if(xhr.status>=200&&xhr.status<300) finish(null,xhr.responseText);
    else finish(new Error('HTTP '+xhr.status),null);
  };
  xhr.onerror=function(){ finish(new Error('Network error'),null); };
  xhr.ontimeout=function(){ finish(new Error('timed out'),null); };
  xhr.send();
}
function pgTryHtmlUrls(urls,cb){
  var i=0;
  function next(){
    if(i>=urls.length) return cb(null,'');
    pgFetchHtml(urls[i++],function(err,html){
      if(!err&&html&&html.length>200) cb(null,html);
      else next();
    });
  }
  next();
}
function pgMatchOppStatusValue(raw){
  var k=pgStatusKey(raw);
  if(!k) return '';
  var pairs=[
    ['closed won','Won'],['no bid','No Bid'],['opportunity','Opportunity'],
    ['proposed','Proposed'],['billed','Billed'],['cancelled','Cancelled'],
    ['won','Won'],['lost','Lost'],['lead','Lead']
  ];
  for(var i=0;i<pairs.length;i++){
    if(k===pairs[i][0]||k.indexOf(pairs[i][0])===0) return pairs[i][1];
  }
  return '';
}
function pgExtractOppChangeFromText(text){
  text=pgStripHtml(text);
  if(!/opportunity/i.test(text)||!/status/i.test(text)) return null;
  var wasNow=text.match(/Opportunity\s+Status\s+was\s+(.+?)\s+now\s+(.+?)(?:\.|$)/i);
  if(wasNow){
    var f=pgMatchOppStatusValue(wasNow[1]), t=pgMatchOppStatusValue(wasNow[2]);
    if(t) return {from:f||pgCleanFieldVal(wasNow[1]),to:t};
  }
  var setTo=text.match(/Opportunity(?:\s+|_x0020_)?Status\s+Set\s+to\s+(.+?)(?:\.|$|;|\n)/i);
  if(setTo){
    var t2=pgMatchOppStatusValue(setTo[1]);
    if(t2) return {to:t2};
  }
  var chFrom=text.match(/Opportunity(?:\s+|_x0020_)?Status[^.]{0,120}?(?:from|changed from)\s+(.+?)\s+to\s+(.+?)(?:\.|$)/i);
  if(chFrom){
    var t3=pgMatchOppStatusValue(chFrom[2]);
    if(t3) return {from:pgMatchOppStatusValue(chFrom[1])||pgCleanFieldVal(chFrom[1]),to:t3};
  }
  var plain=text.match(/Opportunity\s+Status\s+([A-Za-z][A-Za-z ]{0,24})/i);
  if(plain){
    var t4=pgMatchOppStatusValue(plain[1]);
    if(t4) return {to:t4};
  }
  return null;
}
function pgBuildFlipsFromVersionEntries(entries){
  entries.sort(function(a,b){ return parseFloat(a.versionLabel)-parseFloat(b.versionLabel); });
  var flips=[], lastSt=null;
  entries.forEach(function(e){
    var to=e.oppTo?pgNormStatus(e.oppTo):null;
    if(!to) return;
    var from=e.oppFrom?pgNormStatus(e.oppFrom):lastSt;
    if(!from||pgStatusKey(from)!==pgStatusKey(to)){
      flips.push({
        from:from||'—',to:to,
        flipKind:pgFlipKind(to),
        when:e.created,editor:e.editor||'—',
        versionLabel:e.versionLabel||'',
        source:'versions_aspx'
      });
    }
    lastSt=to;
  });
  return flips;
}
function pgParseVersionsAspxOppFlips(html){
  if(!html) return {flips:[],versions:[],entries:[]};
  var doc=new DOMParser().parseFromString(html,'text/html');
  var entries=[], cur=null;
  var rows=doc.querySelectorAll('tr');
  for(var i=0;i<rows.length;i++){
    var row=rows[i];
    var cells=row.cells;
    if(cells&&cells.length>=2){
      var first=pgStripHtml(cells[0].innerHTML).replace(/\s*View\s*$/i,'').replace(/\s*Restore\s*/ig,' ').replace(/\s*Delete\s*/ig,' ').trim();
      var vm=first.match(/^(\d+\.\d+)/);
      if(vm&&!/^no\.?$/i.test(first)){
        cur={versionLabel:vm[1],created:pgStripHtml(cells[1]?cells[1].innerHTML:''),editor:pgStripHtml(cells[2]?cells[2].innerHTML:'')||'—',oppFrom:null,oppTo:null};
        entries.push(cur);
      }
      var lbl=pgStripHtml(cells[0].innerHTML);
      if(/opportunity/i.test(lbl)&&/status/i.test(lbl)&&!/opportunity\s+status\s+\S/i.test(lbl)){
        var val=pgMatchOppStatusValue(pgStripHtml(cells[1].innerHTML));
        if(val&&cur) cur.oppTo=val;
      }
    }
    if(!cur) continue;
    var change=pgExtractOppChangeFromText(row.innerHTML);
    if(change){
      if(change.from) cur.oppFrom=change.from;
      if(change.to) cur.oppTo=change.to;
    }
  }
  if(!entries.some(function(e){ return e.oppTo; })){
    var plain=pgStripHtml(html);
    var blockRe=/(\d+\.\d+)\s+(\d{1,2}\/\d{1,2}\/\d{4}(?:\s+\d{1,2}:\d{2}(?::\d{2})?\s*(?:AM|PM)?)?)\s+([\s\S]*?)(?=(?:\d+\.\d+)\s+\d{1,2}\/|$)/gi;
    var bm, textEntries=[];
    while((bm=blockRe.exec(plain))){
      var ch=pgExtractOppChangeFromText(bm[0]);
      textEntries.push({
        versionLabel:bm[1],
        created:bm[2],
        editor:(bm[3]||'').split(/Opportunity/i)[0].replace(/\s+/g,' ').trim()||'—',
        oppFrom:ch&&ch.from||null,
        oppTo:ch&&ch.to||null
      });
    }
    if(textEntries.length) entries=textEntries;
  }
  var flips=pgBuildFlipsFromVersionEntries(entries);
  var versions=entries.map(function(e){
    return {
      versionId:parseFloat(e.versionLabel)||0,
      versionLabel:e.versionLabel,
      created:e.created,
      oppStatus:e.oppTo||'',
      editor:e.editor||'—',
      fetched:true
    };
  });
  if(flips.length) PG_LOAD_STATS.aspxParseHits++;
  if(!PG_DEBUG||((PG_DEBUG.flips||0)===0&&(flips.length||entries.length>(PG_DEBUG.versionRows||0)))){
    PG_DEBUG={
      htmlLen:html.length,
      hasOppStatus:/opportunity\s+status/i.test(pgStripHtml(html)),
      versionRows:entries.length,
      statusRows:entries.filter(function(e){ return e.oppTo; }).length,
      flips:flips.length,
      sample:(pgStripHtml(html)||'').slice(0,280)
    };
  }
  return {flips:flips,versions:versions,entries:entries};
}
function pgVersionsAspxUrls(bid){
  var br=pgListGuidBrace(), id=bid.id;
  var urls=[];
  if(br){
    urls.push(SP_SITE+'/_layouts/15/Versions.aspx?list='+encodeURIComponent(br)+'&ID='+id);
    urls.push(SP_SITE+'/_layouts/15/Versions.aspx?list='+encodeURIComponent(br)+'&ID='+id+'&IsDlg=1');
  }
  return urls;
}
function pgFetchVersionsAspxFlips(bid,cb){
  var urls=pgVersionsAspxUrls(bid);
  if(!urls.length){
    if(!PG_DEBUG) PG_DEBUG={err:'No list GUID — cannot open Versions.aspx'};
    return cb([],null);
  }
  pgTryHtmlUrls(urls,function(err,html){
    PG_LOAD_STATS.aspxReads++;
    if(!html){
      if(!PG_DEBUG) PG_DEBUG={err:'Versions.aspx empty/failed',url:urls[0]};
      return cb([],null);
    }
    var parsed=pgParseVersionsAspxOppFlips(html);
    cb(parsed.flips||[],parsed);
  });
}
function pgParseVersionDetailOpp(html,verMeta){
  if(!html) return null;
  var change=pgExtractOppChangeFromText(html);
  if(change){
    return {
      versionLabel:verMeta.versionLabel||'',
      created:verMeta.created,editor:verMeta.editor||'—',
      oppFrom:change.from||null,oppTo:change.to||null
    };
  }
  var doc=new DOMParser().parseFromString(html,'text/html');
  var rows=doc.querySelectorAll('tr');
  for(var i=0;i<rows.length;i++){
    var cells=rows[i].cells;
    if(!cells||cells.length<2) continue;
    var lbl=pgStripHtml(cells[0].innerHTML);
    if(!/opportunity/i.test(lbl)||!/status/i.test(lbl)) continue;
    if(cells.length>=3){
      var from=pgCleanFieldVal(cells[1].innerHTML);
      var to=pgCleanFieldVal(cells[2].innerHTML);
      if(from&&to&&pgStatusKey(from)!==pgStatusKey(to)){
        return {versionLabel:verMeta.versionLabel,created:verMeta.created,editor:verMeta.editor,oppFrom:from,oppTo:to};
      }
    }
    var val=pgStripHtml(cells[1].innerHTML);
    var sm=val.match(/set\s+to\s+(.+)/i);
    if(sm) return {versionLabel:verMeta.versionLabel,created:verMeta.created,editor:verMeta.editor,oppTo:pgCleanFieldVal(sm[1])};
  }
  return null;
}
function pgVersionDetailUrls(bid,versionLabel){
  var br=pgListGuidBrace(), raw=pgListGuidRaw();
  var vl=encodeURIComponent(versionLabel||'');
  var urls=[];
  [br,raw].forEach(function(g){
    if(!g) return;
    urls.push(SP_SITE+'/_layouts/15/versiondetail.aspx?List='+encodeURIComponent(g)+'&ID='+bid.id+'&Version='+vl);
    urls.push(SP_SITE+'/_layouts/15/VersionDetail.aspx?List='+encodeURIComponent(g)+'&ID='+bid.id+'&Version='+vl);
  });
  return urls;
}
function pgFetchFlipsFromVersionDetails(bid,versions,cb){
  if(!versions||!versions.length) return cb([]);
  var entries=new Array(versions.length), pending=versions.length;
  versions.forEach(function(v,idx){
    var urls=pgVersionDetailUrls(bid,v.versionLabel);
    pgTryHtmlUrls(urls,function(err,html){
      PG_LOAD_STATS.detailReads++;
      entries[idx]=pgParseVersionDetailOpp(html,v);
      pending--;
      if(!pending){
        var mapped=entries.filter(Boolean).map(function(e){
          return {versionLabel:e.versionLabel,created:e.created,editor:e.editor,oppFrom:e.oppFrom,oppTo:e.oppTo};
        });
        cb(pgBuildFlipsFromVersionEntries(mapped));
      }
    });
  });
}
function pgApplyFlipsToAnalysis(bid,out,flips,baseAnalysis){
  var analysis=Object.assign({},baseAnalysis,{flips:flips});
  if(!flips.length) return analysis;
  var last=flips[flips.length-1];
  analysis.currentStatus=last.to||analysis.currentStatus;
  var sinceDt=pgParseSpDateTime(last.when);
  if(sinceDt){
    analysis.statusSince=last.when;
    analysis.daysStale=mqInclusiveDaysBetween(sinceDt,new Date());
  }
  var segments=[], lastStatus=null;
  flips.forEach(function(fl){
    if(fl.from&&fl.from!=='—'&&pgStatusKey(fl.from)!==pgStatusKey(lastStatus)){
      segments.push({status:fl.from,from:fl.when,editor:fl.editor,versionLabel:fl.versionLabel});
      lastStatus=fl.from;
    }
    segments.push({status:fl.to,from:fl.when,editor:fl.editor,versionLabel:fl.versionLabel});
    lastStatus=fl.to;
  });
  if(segments.length) analysis.segments=segments;
  analysis.historyReadable=true;
  return analysis;
}
function pgFinishVersionHistory(bid,out,cb){
  var restAnalysis=pgAnalyzeVersionHistory(bid,out);
  cb(null,out,restAnalysis,!(restAnalysis.flips&&restAnalysis.flips.length));
}
function pgFlipKind(toStatus){
  var l=String(toStatus||'').trim().toLowerCase();
  if(l==='opportunity') return 'to_opportunity';
  if(l==='proposed') return 'to_proposed';
  if(l==='billed') return 'to_billed';
  if(l==='won'||l==='closed won') return 'to_won';
  return 'other';
}
function pgFlipKindLabel(kind){
  if(kind==='to_opportunity') return '→ Opportunity';
  if(kind==='to_proposed') return '→ Proposed';
  if(kind==='to_billed') return '→ Billed';
  if(kind==='to_won') return '→ Won';
  return '→ Other';
}
function pgAnalyzeVersionHistory(bid,versions){
  versions=(versions||[]).slice().sort(function(a,b){
    return pgVersionSortKey({VersionLabel:a.versionLabel,VersionId:a.versionId,Created:a.created,Modified:a.created})-
      pgVersionSortKey({VersionLabel:b.versionLabel,VersionId:b.versionId,Created:b.created,Modified:b.created});
  });
  var flips=[], segments=[];
  for(var i=0;i<versions.length;i++){
    var v=versions[i];
    if(!v) continue;
    if(!v.oppStatus&&v.rawFields) v.oppStatus=pgExtractOppFromVersionPayload(v.rawFields);
    if(!v.oppStatus&&v.listOpp) v.oppStatus=v.listOpp;
  }
  for(var j=1;j<versions.length;j++){
    var prev=versions[j-1], cur=versions[j];
    if(!prev||!cur) continue;
    var diff=pgDiffOppBetweenVersions(prev,cur);
    if(!diff&&prev.rawFields&&cur.rawFields) diff=pgDiffOppFromRawFields(prev.rawFields,cur.rawFields);
    if(!diff) continue;
    flips.push({
      from:diff.from,to:diff.to,
      flipKind:pgFlipKind(diff.to),
      when:cur.created,editor:cur.editor||'—',
      versionLabel:cur.versionLabel||'',
      source:'version_history'
    });
  }
  var lastStatus=null;
  versions.forEach(function(v){
    if(!v) return;
    var st=pgNormStatus(v.oppStatus);
    if(!st) return;
    if(lastStatus===null||pgStatusKey(st)!==pgStatusKey(lastStatus)){
      segments.push({status:st,from:v.created,editor:v.editor||'—',versionLabel:v.versionLabel||''});
      lastStatus=st;
    }
  });
  if(!segments.length){
    var cur0=pgNormStatus(bid.oppStatus);
    if(cur0) segments.push({status:cur0,from:bid.created||bid.modified,editor:'—',versionLabel:'current'});
  }
  for(var k=0;k<segments.length;k++){
    var startDt=pgParseSpDateTime(segments[k].from);
    var endDt=k<segments.length-1?pgParseSpDateTime(segments[k+1].from):new Date();
    segments[k].daysInStatus=(startDt&&endDt)?mqInclusiveDaysBetween(startDt,endDt):0;
  }
  var current=segments[segments.length-1];
  var daysStale=0, statusSince=null;
  if(current&&current.from){
    statusSince=current.from;
    var sinceDt=pgParseSpDateTime(current.from);
    if(sinceDt) daysStale=mqInclusiveDaysBetween(sinceDt,new Date());
  }
  return {
    segments:segments,versionCount:versions.length,
    daysStale:daysStale,statusSince:statusSince,
    flips:flips,currentStatus:pgNormStatus(bid.oppStatus)||(current?current.status:''),
    lastEditor:current?current.editor:'—',
    historyReadable:versions.some(function(v){ return v&&v.oppStatus; }),
    uniqueStatuses:[...new Set(versions.map(function(v){ return pgNormStatus(v&&v.oppStatus); }).filter(Boolean))]
  };
}
function pgParseSpDateTime(iso){
  if(!iso) return null;
  if(iso instanceof Date) return isNaN(iso.getTime())?null:iso;
  if(typeof iso==='string'){
    var dm=/\/Date\((-?\d+)\)\//.exec(iso);
    if(dm){ var d0=new Date(+dm[1]); return isNaN(d0)?null:d0; }
    var s=iso.trim();
    var us=/^(\d{1,2})\/(\d{1,2})\/(\d{4})(?:\s+(\d{1,2}):(\d{2})(?::(\d{2}))?\s*(AM|PM)?)?/i.exec(s);
    if(us){
      var mo=+us[1], day=+us[2], yr=+us[3];
      var h=us[4]?+us[4]:0, mi=us[5]?+us[5]:0;
      var ap=(us[7]||'').toUpperCase();
      if(mo>12){ var tmp=mo; mo=day; day=tmp; }
      if(ap==='PM'&&h<12) h+=12;
      if(ap==='AM'&&h===12) h=0;
      var d1=new Date(yr,mo-1,day,h,mi,0,0);
      return isNaN(d1)?null:d1;
    }
  }
  var d=new Date(iso);
  return isNaN(d)?null:d;
}
function pgFmtDateTime(iso){
  var d=pgParseSpDateTime(iso);
  if(!d) return '—';
  return d.toLocaleString('en-GB',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'});
}
function pgEnsureFlipDates(){
  if(!PG_FLIP_FROM_ISO&&!PG_FLIP_TO_ISO){
    PG_FLIP_FROM_ISO=pgQuarterStartIso();
    PG_FLIP_TO_ISO=pgTodayIso();
  }
}
function pgOnFlipDateChange(){
  var from=el('pgFlipDateFrom'), to=el('pgFlipDateTo');
  PG_FLIP_FROM_ISO=from?from.value:'';
  PG_FLIP_TO_ISO=to?to.value:'';
  pgRender();
}
function pgSetTab(tab){
  PG_TAB=tab==='flips'?'flips':'stale';
  el('pgTabStale')?.classList.toggle('active',PG_TAB==='stale');
  el('pgTabFlips')?.classList.toggle('active',PG_TAB==='flips');
  var sf=el('pgStaleFilters'), ff=el('pgFlipFilters');
  if(sf) sf.style.display=PG_TAB==='stale'?'flex':'none';
  if(ff) ff.style.display=PG_TAB==='flips'?'flex':'none';
  if(PG_TAB==='flips') pgEnsureFlipDates();
  PG_SEL_TILE=null;
  pgRender();
}
function pgSetFlipFilter(kind){
  PG_FLIP_FILTER=kind||'all';
  pgRender();
}
function pgSetStaleDays(days){
  PG_STALE_DAYS=Math.max(1,parseInt(days,10)||1);
  PG_SEL_TILE='stale_'+PG_STALE_DAYS;
  pgRender();
}
function pgSetFlipDatePreset(preset){
  var today=pgTodayIso();
  if(preset==='quarter'){
    PG_FLIP_FROM_ISO=pgQuarterStartIso();
    PG_FLIP_TO_ISO=today;
  }else if(preset==='today'){
    PG_FLIP_FROM_ISO=today;
    PG_FLIP_TO_ISO=today;
  }else if(preset==='7d'){
    var d7=new Date();
    d7.setDate(d7.getDate()-6);
    PG_FLIP_FROM_ISO=d7.getFullYear()+'-'+String(d7.getMonth()+1).padStart(2,'0')+'-'+String(d7.getDate()).padStart(2,'0');
    PG_FLIP_TO_ISO=today;
  }else if(preset==='30d'){
    var d30=new Date();
    d30.setDate(d30.getDate()-29);
    PG_FLIP_FROM_ISO=d30.getFullYear()+'-'+String(d30.getMonth()+1).padStart(2,'0')+'-'+String(d30.getDate()).padStart(2,'0');
    PG_FLIP_TO_ISO=today;
  }else if(preset==='all'){
    PG_FLIP_FROM_ISO='';
    PG_FLIP_TO_ISO='';
  }
  pgRender();
}
function pgRenderStaleFilters(){
  var wrap=el('pgStaleFilters');
  if(!wrap) return;
  var buckets=[1,7,15,21];
  var h='<span class="pg-tab-filters-label">Unchanged for</span>';
  buckets.forEach(function(d){
    h+='<button type="button" class="pg-stale-chip'+(PG_STALE_DAYS===d?' active':'')+'" onclick="pgSetStaleDays('+d+')">'+d+'+ days</button>';
  });
  h+='<span style="font-size:.72rem;color:var(--t3);font-weight:600;margin-left:.35rem">Grid shows deals on the same Opp Status ≥ selected threshold</span>';
  wrap.innerHTML=h;
}
function pgRenderFlipFilters(){
  var wrap=el('pgFlipFilters');
  if(!wrap) return;
  pgEnsureFlipDates();
  var chips=[
    {id:'all',label:'All types'},
    {id:'to_opportunity',label:'→ Opportunity'},
    {id:'to_proposed',label:'→ Proposed'},
    {id:'to_billed',label:'→ Billed'},
    {id:'to_won',label:'→ Won'}
  ];
  var h='<div class="pg-flip-date-row">';
  h+='<span class="pg-tab-filters-label">Flip date</span>';
  h+='<button type="button" class="pg-flip-chip preset" onclick="pgSetFlipDatePreset(\'quarter\')">This quarter</button>';
  h+='<button type="button" class="pg-flip-chip preset" onclick="pgSetFlipDatePreset(\'today\')">Today</button>';
  h+='<button type="button" class="pg-flip-chip preset" onclick="pgSetFlipDatePreset(\'7d\')">Last 7 days</button>';
  h+='<button type="button" class="pg-flip-chip preset" onclick="pgSetFlipDatePreset(\'30d\')">Last 30 days</button>';
  h+='<button type="button" class="pg-flip-chip preset" onclick="pgSetFlipDatePreset(\'all\')">All time</button>';
  h+='<input type="date" id="pgFlipDateFrom" value="'+PG_FLIP_FROM_ISO+'" onchange="pgOnFlipDateChange()" title="From date">';
  h+='<span style="font-size:.72rem;color:var(--t3);font-weight:700">to</span>';
  h+='<input type="date" id="pgFlipDateTo" value="'+PG_FLIP_TO_ISO+'" onchange="pgOnFlipDateChange()" title="To date">';
  h+='</div><div class="pg-flip-filters"><span class="pg-tab-filters-label">Flip type</span>';
  h+=chips.map(function(c){
    return '<button type="button" class="pg-flip-chip'+(PG_FLIP_FILTER===c.id?' active':'')+'" onclick="pgSetFlipFilter(\''+c.id+'\')">'+c.label+'</button>';
  }).join('');
  h+='</div>';
  wrap.innerHTML=h;
}
function pgAmKey(bid){
  return (bid.amEmail&&bid.amEmail!=='—'?bid.amEmail:(bid.amName||'—'));
}
function pgRebuildCascadeFilters(){
  var hdSel=el('pgHdFilter'), adSel=el('pgAdFilter'), amSel=el('pgAmFilter');
  if(!hdSel||!adSel||!amSel) return;
  var base=pgGetQtgCandidates();
  var hdVal=hdSel.value, adVal=adSel.value;
  var hds={}, ads={}, ams={};
  base.forEach(function(b){
    var hd=b.headDirector&&b.headDirector!=='(Blank)'?b.headDirector:'';
    if(hd) hds[hd]=1;
    if(hdVal&&b.headDirector!==hdVal) return;
    var ad=b.accountDirector&&b.accountDirector!=='—'?b.accountDirector:'';
    if(ad) ads[ad]=1;
    if(adVal&&b.accountDirector!==adVal) return;
    var am=pgAmKey(b);
    if(am&&am!=='—') ams[am]=1;
  });
  function fill(sel,vals,keep){
    var cur=keep?sel.value:'';
    sel.innerHTML='<option value="">All</option>';
    vals.sort().forEach(function(v){
      var o=document.createElement('option');
      o.value=v; o.textContent=v;
      sel.appendChild(o);
    });
    if(cur&&vals.indexOf(cur)>=0) sel.value=cur; else sel.value='';
  }
  fill(hdSel,Object.keys(hds),true);
  fill(adSel,Object.keys(ads),true);
  fill(amSel,Object.keys(ams),true);
}
function pgOnHdFilterChange(){
  var hd=el('pgHdFilter')?el('pgHdFilter').value:'';
  var adSel=el('pgAdFilter'), amSel=el('pgAmFilter');
  if(adSel) adSel.value='';
  if(amSel) amSel.value='';
  PG_DRILL_HD=hd||null;
  PG_DRILL_AD=null;
  PG_DRILL_AM=null;
  pgRebuildCascadeFilters();
  pgRender();
}
function pgOnAdFilterChange(){
  var ad=el('pgAdFilter')?el('pgAdFilter').value:'';
  var amSel=el('pgAmFilter');
  if(amSel) amSel.value='';
  PG_DRILL_AD=ad||null;
  PG_DRILL_AM=null;
  pgRebuildCascadeFilters();
  pgRender();
}
function pgOnAmFilterChange(){
  var am=el('pgAmFilter')?el('pgAmFilter').value:'';
  PG_DRILL_AM=am||null;
  pgRender();
}
function pgGetFilterVals(){
  pgEnsureFlipDates();
  return {
    hd:el('pgHdFilter')?el('pgHdFilter').value:'',
    ad:el('pgAdFilter')?el('pgAdFilter').value:'',
    am:el('pgAmFilter')?el('pgAmFilter').value:'',
    pf:el('pgPfFilter')?el('pgPfFilter').value:'',
    staleDays:PG_STALE_DAYS||1,
    flipFrom:PG_FLIP_FROM_ISO?pgParseIsoDate(PG_FLIP_FROM_ISO):null,
    flipTo:PG_FLIP_TO_ISO?pgParseIsoDate(PG_FLIP_TO_ISO):null,
    search:(el('pgSearchInp')&&el('pgSearchInp').value||'').trim().toLowerCase()
  };
}
function pgCountFlipsInRange(rows,f){
  var n=0;
  rows.forEach(function(row){
    (row.analysis.flips||[]).forEach(function(fl){
      if(PG_FLIP_FILTER!=='all'&&fl.flipKind!==PG_FLIP_FILTER) return;
      if(!pgFlipInDateRange(fl,f.flipFrom,f.flipTo)) return;
      n++;
    });
  });
  return n;
}
function pgCountStale(rows,minDays){
  return rows.filter(function(r){ return (r.analysis.daysStale||0)>=minDays; }).length;
}
function pgRowMatchesFilters(row,f){
  var b=row.bid;
  if(f.pf&&String(b.productFamily||'').trim()!==f.pf) return false;
  var hd=f.hd||PG_DRILL_HD;
  var ad=f.ad||PG_DRILL_AD;
  var am=f.am||PG_DRILL_AM;
  if(hd&&String(b.headDirector||'').trim()!==hd) return false;
  if(ad&&String(b.accountDirector||'').trim()!==ad) return false;
  if(am){
    var key=pgAmKey(b);
    if(key!==am&&String(b.amName||'')!==am) return false;
  }
  if(f.search){
    var hay=[b.customerName,b.bidRequest,b.myId,b.accountDirector,b.headDirector,b.amName,b.vertical,b.productFamily,b.productCategory,b.services,mqBidRefValue(b),row.analysis.currentStatus].join(' ').toLowerCase();
    if(hay.indexOf(f.search)<0) return false;
  }
  return true;
}
function pgStaleThreshold(f){
  if(PG_SEL_TILE&&String(PG_SEL_TILE).indexOf('stale_')===0) return parseInt(PG_SEL_TILE.replace('stale_',''),10)||f.staleDays;
  return f.staleDays||1;
}
function pgRefreshBidFromSp(bid,cb){
  var safeList=SP_LIST.replace(/'/g,"''");
  var url=SP_SITE+"/_api/web/lists/getbytitle('"+safeList+"')/items("+bid.id+")?$select=Id,Modified,"+PG_OPP_FIELD;
  spGet(url,function(err,data){
    if(!err&&data&&data.d){
      bid.modified=data.d.Modified||bid.modified;
      bid.oppStatus=pgNormStatus(data.d[PG_OPP_FIELD])||bid.oppStatus;
    }
    cb();
  });
}
function pgGetScopedRows(){
  var f=pgGetFilterVals();
  return PG_ANALYSIS.filter(function(row){ return pgRowMatchesFilters(row,f); });
}
function pgSelectTile(key){
  if(key==='flips'||key==='flips_today'){
    if(key==='flips_today'){
      pgSetFlipDatePreset('today');
    }
    pgSetTab('flips');
    PG_SEL_TILE=key;
    pgRender();
    return;
  }
  if(String(key).indexOf('stale_')===0){
    PG_STALE_DAYS=parseInt(key.replace('stale_',''),10)||1;
    PG_TAB='stale';
    el('pgTabStale')?.classList.add('active');
    el('pgTabFlips')?.classList.remove('active');
    var sf=el('pgStaleFilters'), ff=el('pgFlipFilters');
    if(sf) sf.style.display='flex';
    if(ff) ff.style.display='none';
  }
  PG_SEL_TILE=PG_SEL_TILE===key?null:key;
  pgRender();
}
function pgResetAll(clearCache){
  PG_SEL_TILE=null;
  PG_DRILL_HD=null;
  PG_DRILL_AD=null;
  PG_DRILL_AM=null;
  PG_FLIP_FILTER='all';
  PG_STALE_DAYS=1;
  PG_TAB='stale';
  var ids=['pgHdFilter','pgAdFilter','pgAmFilter','pgPfFilter','pgSearchInp'];
  ids.forEach(function(id){ var n=el(id); if(!n) return; if(n.tagName==='SELECT') n.selectedIndex=0; else n.value=''; });
  PG_FLIP_FROM_ISO='';
  PG_FLIP_TO_ISO='';
  if(clearCache){ try{ localStorage.removeItem(PG_VERSION_CACHE_LS); }catch(e){} }
  pgSetTab('stale');
  pgRebuildCascadeFilters();
  pgRender();
}
function pgHidePgAd(){ var s=el('pgAdSection'); if(s) s.style.display='none'; PG_DRILL_AD=null; }
function pgHidePgAm(){ var s=el('pgAmSection'); if(s) s.style.display='none'; PG_DRILL_AM=null; }
function pgSelectPgHd(hd){
  if(PG_DRILL_HD===hd){ PG_DRILL_HD=null; PG_DRILL_AD=null; PG_DRILL_AM=null; pgHidePgAd(); pgHidePgAm(); var h=el('pgHdFilter'); if(h) h.value=''; }
  else{ PG_DRILL_HD=hd; PG_DRILL_AD=null; PG_DRILL_AM=null; var hf=el('pgHdFilter'); if(hf) hf.value=hd; pgHidePgAm(); }
  pgRebuildCascadeFilters();
  pgRender();
}
function pgSelectPgAd(ad){
  if(PG_DRILL_AD===ad){ PG_DRILL_AD=null; PG_DRILL_AM=null; pgHidePgAm(); var a=el('pgAdFilter'); if(a) a.value=''; }
  else{ PG_DRILL_AD=ad; PG_DRILL_AM=null; var af=el('pgAdFilter'); if(af) af.value=ad; }
  pgRebuildCascadeFilters();
  pgRender();
}
function pgSelectPgAm(amKey){
  if(PG_DRILL_AM===amKey){ PG_DRILL_AM=null; var m=el('pgAmFilter'); if(m) m.value=''; }
  else{ PG_DRILL_AM=amKey; var mf=el('pgAmFilter'); if(mf) mf.value=amKey; }
  pgRebuildCascadeFilters();
  pgRender();
}
function pgRenderKpiTiles(rows,f){
  var wrap=el('pgKpiRow');
  if(!wrap) return;
  var live=mqLiveYearQuarter();
  var defs;
  if(PG_TAB==='flips'){
    var today=pgParseIsoDate(pgTodayIso());
    var flipsToday=0, flipsRange=pgCountFlipsInRange(rows,f);
    rows.forEach(function(row){
      (row.analysis.flips||[]).forEach(function(fl){
        if(PG_FLIP_FILTER!=='all'&&fl.flipKind!==PG_FLIP_FILTER) return;
        if(pgFlipInDateRange(fl,today,today)) flipsToday++;
      });
    });
    var rangeLabel=f.flipFrom&&f.flipTo
      ?pgIsoFromDate(f.flipFrom)+' – '+pgIsoFromDate(f.flipTo)
      :'All time';
    defs=[
      {key:'flips_today',label:'Flips today',value:flipsToday,sub:'Opp Status changed today',color:'#16a34a'},
      {key:'flips',label:'Flips in selected dates',value:flipsRange,sub:rangeLabel,color:'#7c3aed'}
    ];
  }else{
    var d=PG_STALE_DAYS||1;
    var staleColors={1:'#ca8a04',7:'#ea580c',15:'#dc2626',21:'#991b1b'};
    defs=[
      {key:'stale_'+d,label:'Unchanged ≥'+d+' days',value:pgCountStale(rows,d),sub:'Same Opp Status for '+d+'+ days · Q'+live.quarter+' pipeline',color:staleColors[d]||'#ea580c'}
    ];
  }
  wrap.innerHTML='';
  defs.forEach(function(td){
    var card=document.createElement('div');
    var active=PG_SEL_TILE===td.key&&td.key;
    var dim=PG_SEL_TILE&&td.key&&PG_SEL_TILE!==td.key;
    card.className='stat-card pg-kpi-card'+(active?' tile-active':'')+(dim?' tile-dimmed':'');
    if(td.key) card.onclick=function(){ pgSelectTile(td.key); };
    card.innerHTML='<div class="stat-label">'+td.label+'</div><div class="stat-value" style="color:'+td.color+'">'+td.value+'</div><div class="stat-subtitle">'+td.sub+'</div>';
    wrap.appendChild(card);
  });
}
function pgAggregateGroup(rows,staleDays,groupFn){
  var map={};
  rows.forEach(function(row){
    var key=groupFn(row);
    if(!key||key==='—'||key==='(Blank)') key='(Unassigned)';
    if(!map[key]) map[key]={key:key,total:0,stale:0,stale7:0,flips:0,ga:0};
    var g=map[key];
    g.total++;
    g.ga+=num(row.bid.gaLines);
    if((row.analysis.daysStale||0)>=staleDays) g.stale++;
    if((row.analysis.daysStale||0)>=7) g.stale7++;
    g.flips+=row.analysis.flips.length;
  });
  return Object.keys(map).map(function(k){ return map[k]; }).sort(function(a,b){ return b.stale-a.stale; });
}
function pgStatsForRows(rows,staleDays){
  staleDays=staleDays||PG_STALE_DAYS||1;
  var stale=0,stale7=0,flips=0,ga=0;
  rows.forEach(function(row){
    if((row.analysis.daysStale||0)>=staleDays) stale++;
    if((row.analysis.daysStale||0)>=7) stale7++;
    flips+=row.analysis.flips.length;
    ga+=num(row.bid.gaLines);
  });
  return {total:rows.length,stale:stale,stale7:stale7,flips:flips,ga:ga,healthy:rows.length-stale};
}
function pgBuildLmTileHtml(name,role,stats,verticals,selected){
  return '<div class="lm-tile'+(selected?' selected':'')+'">'+
    '<div class="lm-header" style="flex-direction:row;justify-content:space-between;align-items:flex-start">'+
      '<div><h3>'+mqEscHtml(name)+'</h3><div class="lm-meta">'+mqEscHtml(role)+'</div></div>'+
      '<div style="font-size:.65rem;font-weight:700;color:var(--acc);background:var(--nab);border:1px solid var(--nab2);padding:2px 7px;border-radius:20px;white-space:nowrap;max-width:110px;overflow:hidden;text-overflow:ellipsis">'+mqEscHtml(verticals||'—')+'</div>'+
    '</div>'+
    '<div class="lm-stats-grid">'+
      '<div class="lm-stat-box"><div class="lm-stat-label">QTG deals</div><div class="lm-stat-value">'+stats.total+'</div></div>'+
      '<div class="lm-stat-box"><div class="lm-stat-label">Stale ('+(PG_STALE_DAYS||1)+'+d)</div><div class="lm-stat-value" style="color:#ea580c">'+stats.stale+'</div></div>'+
    '</div>'+
    '<div class="lm-revenue">'+
      '<div class="lm-revenue-label">Fresh / 7+d stale / Flips</div>'+
      '<div class="lm-revenue-count">'+stats.healthy+' / '+stats.stale7+' / '+stats.flips+'</div>'+
      '<div class="lm-revenue-breakdown">'+
        '<div class="lm-revenue-item"><div class="lm-revenue-item-label">GA Lines</div><div class="lm-revenue-item-value">'+mqFmtProductLines(stats.ga)+'</div></div>'+
      '</div>'+
    '</div>'+
  '</div>';
}
function pgRenderPgHdTiles(){
  var grid=el('pgHdGrid'), badge=el('pgHdBadge');
  if(!grid) return;
  var f=pgGetFilterVals();
  var rows=PG_ANALYSIS.filter(function(row){ return pgRowMatchesFilters(row,{hd:'',ad:'',am:'',pf:f.pf,search:f.search}); });
  var hds=[...new Set(rows.map(function(r){ return r.bid.headDirector; }).filter(function(v){ return v&&v!=='—'&&v!=='(Blank)'; }))].sort();
  if(badge) badge.textContent=hds.length;
  grid.innerHTML='';
  if(!hds.length){ grid.innerHTML='<div class="pg-empty">No head directors in scope.</div>'; return; }
  hds.forEach(function(hd){
    var hdRows=rows.filter(function(r){ return r.bid.headDirector===hd; });
    var stats=pgStatsForRows(hdRows,f.staleDays);
    var verts=[...new Set(hdRows.map(function(r){ return r.bid.vertical; }).filter(Boolean))].join(', ');
    var tile=document.createElement('div');
    tile.innerHTML=pgBuildLmTileHtml(hd,'Head Director',stats,verts,PG_DRILL_HD===hd);
    tile.firstChild.onclick=function(){ pgSelectPgHd(hd); };
    grid.appendChild(tile.firstChild);
  });
}
function pgRenderPgAdTiles(hd){
  var sec=el('pgAdSection'), grid=el('pgAdGrid'), badge=el('pgAdBadge'), ctx=el('pgAdContext');
  if(!sec||!grid||!hd){ if(sec) sec.style.display='none'; return; }
  sec.style.display='block';
  if(ctx) ctx.textContent='← '+hd;
  var f=pgGetFilterVals();
  var rows=PG_ANALYSIS.filter(function(r){
    return r.bid.headDirector===hd&&pgRowMatchesFilters(r,{hd:'',ad:'',am:'',pf:f.pf,search:f.search});
  });
  var ads=[...new Set(rows.map(function(r){ return r.bid.accountDirector; }).filter(function(v){ return v&&v!=='—'; }))].sort();
  if(badge) badge.textContent=ads.length;
  grid.innerHTML='';
  if(!ads.length){ grid.innerHTML='<div class="pg-empty">No account directors.</div>'; return; }
  ads.forEach(function(ad){
    var adRows=rows.filter(function(r){ return r.bid.accountDirector===ad; });
    var stats=pgStatsForRows(adRows,f.staleDays);
    var verts=[...new Set(adRows.map(function(r){ return r.bid.vertical; }).filter(Boolean))].join(', ');
    var tile=document.createElement('div');
    tile.innerHTML=pgBuildLmTileHtml(ad,'Account Director',stats,verts,PG_DRILL_AD===ad);
    tile.firstChild.onclick=function(){ pgSelectPgAd(ad); };
    grid.appendChild(tile.firstChild);
  });
}
function pgRenderPgAmRows(ad){
  var sec=el('pgAmSection'), list=el('pgAmList'), badge=el('pgAmBadge'), ctx=el('pgAmContext');
  if(!sec||!list||!ad||!PG_DRILL_HD){ if(sec) sec.style.display='none'; return; }
  sec.style.display='block';
  if(ctx) ctx.textContent='← '+PG_DRILL_HD+' · '+ad;
  var f=pgGetFilterVals();
  var rows=PG_ANALYSIS.filter(function(r){
    return r.bid.headDirector===PG_DRILL_HD&&r.bid.accountDirector===ad&&pgRowMatchesFilters(r,{hd:'',ad:'',am:'',pf:f.pf,search:f.search});
  });
  var amMap={};
  rows.forEach(function(r){
    var k=pgAmKey(r.bid);
    if(!amMap[k]) amMap[k]={key:k,name:r.bid.amName||k,rows:[]};
    amMap[k].rows.push(r);
  });
  var ams=Object.keys(amMap).map(function(k){ return amMap[k]; }).sort(function(a,b){ return b.rows.length-a.rows.length; });
  if(badge) badge.textContent=ams.length;
  list.innerHTML='';
  if(!ams.length){ list.innerHTML='<div class="pg-empty">No account managers.</div>'; return; }
  ams.forEach(function(am,i){
    var stats=pgStatsForRows(am.rows,f.staleDays);
    var row=document.createElement('div');
    row.className='manager-row'+(PG_DRILL_AM===am.key?' selected':'');
    row.innerHTML=
      '<div class="rank-badge rank-'+(i<3?i+1:'other')+'">'+(i+1)+'</div>'+
      '<div class="manager-name-col"><div class="manager-name">'+mqEscHtml(am.name)+'</div><div class="manager-meta">Account Manager</div></div>'+
      '<div class="manager-stat"><div class="manager-stat-label">Deals</div><div class="manager-stat-value">'+stats.total+'</div></div>'+
      '<div class="manager-stat"><div class="manager-stat-label">Stale</div><div class="manager-stat-value" style="color:#ea580c">'+stats.stale+'</div></div>'+
      '<div class="manager-stat"><div class="manager-stat-label">7+d</div><div class="manager-stat-value" style="color:#dc2626">'+stats.stale7+'</div></div>'+
      '<div class="manager-stat"><div class="manager-stat-label">Flips</div><div class="manager-stat-value" style="color:#7c3aed">'+stats.flips+'</div></div>';
    row.onclick=function(){ pgSelectPgAm(am.key); };
    list.appendChild(row);
  });
}
function pgRenderDrillSections(rows,f){
  pgRenderPgHdTiles();
  if(PG_DRILL_HD) pgRenderPgAdTiles(PG_DRILL_HD);
  else pgHidePgAd();
  if(PG_DRILL_HD&&PG_DRILL_AD) pgRenderPgAmRows(PG_DRILL_AD);
  else pgHidePgAm();
}
function pgRenderGridData(){
  var f=pgGetFilterVals();
  var rows=pgGetScopedRows();
  var gridRows=PG_TAB==='flips'?pgBuildFlipGridRows(rows,f):pgBuildStaleGridRows(rows,f);
  var gridTitle=el('pgGridTitle'), gridCount=el('pgGridCount');
  if(gridTitle){
    if(PG_TAB==='flips'){
      var dl=f.flipFrom&&f.flipTo?(f.flipFrom.getTime()===f.flipTo.getTime()?el('pgFlipDateFrom')?.value||'selected day':el('pgFlipDateFrom')?.value+' → '+el('pgFlipDateTo')?.value):'all time';
      gridTitle.textContent='Status flips · '+dl;
    }else{
      gridTitle.textContent='Stale queue · same Opp Status for '+pgStaleThreshold(f)+'+ days';
    }
  }
  if(gridCount) gridCount.textContent=gridRows.length+' row'+(gridRows.length===1?'':'s');
  pgRenderGrid(gridRows);
}
function pgStatusRenderer(params){
  var s=params.value||'—';
  return '<span class="pg-status-chip '+pgStatusClass(s)+'">'+mqEscHtml(String(s))+'</span>';
}
function pgBuildStaleGridRows(rows,f){
  var threshold=pgStaleThreshold(f);
  if(PG_SEL_TILE&&String(PG_SEL_TILE).indexOf('stale_')===0) threshold=parseInt(PG_SEL_TILE.replace('stale_',''),10)||threshold;
  var out=[];
  rows.forEach(function(row){
    var b=row.bid, a=row.analysis;
    var days=a.daysStale||0;
    if(days<threshold) return;
    var segs=a.segments||[];
    var prevStatus=segs.length>1?segs[segs.length-2].status:'—';
    out.push({
      headDirector:b.headDirector||'—',
      accountDirector:b.accountDirector||'—',
      amName:b.amName||'—',
      customerName:b.customerName||'—',
      bidRef:mqBidRefValue(b)||'—',
      vertical:b.vertical||'—',
      productFamily:b.productFamily||'—',
      productCategory:b.productCategory||'—',
      services:b.services||'—',
      currentStatus:a.currentStatus||'—',
      previousStatus:prevStatus,
      statusChanges:(a.flips||[]).length,
      daysUnchanged:days,
      staleBucket:pgStaleBucketLabel(days),
      statusSince:pgFmtDateTime(a.statusSince),
      lastChangedBy:a.lastEditor||'—',
      gaLines:num(b.gaLines),
      mrc:num(b.mrc),
      expectedActivation:mqFmtBidDate(b.expectedActivation),
      proposedDate:mqFmtBidDate(b.proposedDate),
      modified:mqFmtBidDate(b.modified),
      versionCount:a.versionCount||0,
      spLink:mqBidEditUrl(b)||''
    });
  });
  out.sort(function(a,b){ return b.daysUnchanged-a.daysUnchanged; });
  return out;
}
function pgBuildFlipGridRows(rows,f){
  var out=[];
  var today=pgParseIsoDate(pgTodayIso());
  var onlyToday=PG_SEL_TILE==='flips_today';
  rows.forEach(function(row){
    row.analysis.flips.forEach(function(fl){
      if(PG_FLIP_FILTER!=='all'&&fl.flipKind!==PG_FLIP_FILTER) return;
      if(onlyToday){
        if(!pgFlipInDateRange(fl,today,today)) return;
      }else if(!pgFlipInDateRange(fl,f.flipFrom,f.flipTo)) return;
      var b=row.bid;
      var w=pgParseSpDateTime(fl.when);
      var daysAgo=w?mqInclusiveDaysBetween(w,new Date()):null;
      out.push({
        headDirector:b.headDirector||'—',
        accountDirector:b.accountDirector||'—',
        amName:b.amName||'—',
        customerName:b.customerName||'—',
        bidRef:mqBidRefValue(b)||'—',
        fromStatus:fl.from,
        toStatus:fl.to,
        flipType:pgFlipKindLabel(fl.flipKind),
        flipKind:fl.flipKind,
        when:pgFmtDateTime(fl.when),
        daysAgo:daysAgo,
        changedBy:fl.editor||'—',
        version:fl.versionLabel||'—',
        flipSource:'SharePoint version history',
        gaLines:num(b.gaLines),
        mrc:num(b.mrc),
        vertical:b.vertical||'—',
        productFamily:b.productFamily||'—',
        daysInCurrent:row.analysis.daysStale,
        spLink:mqBidEditUrl(b)||'',
        _sortWhen:w?w.getTime():0
      });
    });
  });
  out.sort(function(a,b){ return b._sortWhen-a._sortWhen; });
  return out;
}
function pgRenderGrid(data){
  if(typeof agGrid==='undefined'){
    el('pgGrid').innerHTML='<div class="pg-empty">AG Grid not loaded.</div>';
    return;
  }
  var spCol={colId:'spLink',headerName:'SharePoint',width:100,pinned:'left',lockPosition:'left',suppressMovable:true,cellRenderer:function(p){
    return p.value?'<a href="'+p.value+'" target="_blank" rel="noopener" style="color:var(--acc);font-weight:800;font-size:.68rem;">Open ↗</a>':'—';
  },valueGetter:function(p){ return p.data&&p.data.spLink; },sortable:false,filter:false};
  var cols;
  if(PG_TAB==='flips'){
    cols=[
      spCol,
      glkCol({field:'headDirector',headerName:'Head Director',width:140}),
      glkCol({field:'accountDirector',headerName:'Account Director',width:140}),
      glkCol({field:'amName',headerName:'Account Manager',width:135}),
      glkCol({field:'customerName',headerName:'Customer',width:170}),
      glkCol({field:'bidRef',headerName:'Bid Reference',width:175}),
      glkCol({field:'fromStatus',headerName:'From Status',width:115,cellRenderer:pgStatusRenderer}),
      glkCol({field:'toStatus',headerName:'To Status',width:115,cellRenderer:pgStatusRenderer}),
      glkCol({field:'flipType',headerName:'Flip type',width:120}),
      glkCol({field:'when',headerName:'Changed on',width:145}),
      glkCol({field:'daysAgo',headerName:'Days ago',width:90},'num'),
      glkCol({field:'flipSource',headerName:'Detected via',width:130}),
      glkCol({field:'changedBy',headerName:'Changed by',width:130}),
      glkCol({field:'version',headerName:'Version',width:80}),
      glkCol({field:'vertical',headerName:'Vertical',width:100}),
      glkCol({field:'productFamily',headerName:'Product Family',width:115}),
      glkCol({field:'gaLines',headerName:'GA Lines',width:90},'num'),
      glkCol({field:'mrc',headerName:'MRC',width:100,valueFormatter:function(p){ return fmt(p.value); }},'money'),
      glkCol({field:'daysInCurrent',headerName:'Days in current status',width:155},'num')
    ];
  }else{
    cols=[
      spCol,
      glkCol({field:'headDirector',headerName:'Head Director',width:140}),
      glkCol({field:'accountDirector',headerName:'Account Director',width:140}),
      glkCol({field:'amName',headerName:'Account Manager',width:135}),
      glkCol({field:'customerName',headerName:'Customer',width:170}),
      glkCol({field:'bidRef',headerName:'Bid Reference',width:175}),
      glkCol({field:'vertical',headerName:'Vertical',width:100}),
      glkCol({field:'productFamily',headerName:'Product Family',width:115}),
      glkCol({field:'productCategory',headerName:'Product Category',width:130}),
      glkCol({field:'services',headerName:'Services',width:120}),
      glkCol({field:'currentStatus',headerName:'Current Opp Status',width:130,cellRenderer:pgStatusRenderer}),
      glkCol({field:'previousStatus',headerName:'Previous Status',width:120,cellRenderer:pgStatusRenderer}),
      glkCol({field:'statusChanges',headerName:'Status changes',width:120},'num'),
      glkCol({field:'daysUnchanged',headerName:'Days unchanged',width:120,cellStyle:function(p){
        if(p.value>=21) return {color:'#991b1b',fontWeight:'900'};
        if(p.value>=15) return {color:'#dc2626',fontWeight:'900'};
        if(p.value>=7) return {color:'#ea580c',fontWeight:'900'};
        return {fontWeight:'800'};
      }},'num'),
      glkCol({field:'staleBucket',headerName:'Stale bucket',width:105}),
      glkCol({field:'statusSince',headerName:'In this status since',width:145}),
      glkCol({field:'lastChangedBy',headerName:'Last changed by',width:130}),
      glkCol({field:'gaLines',headerName:'GA Lines',width:90},'num'),
      glkCol({field:'mrc',headerName:'MRC',width:100,valueFormatter:function(p){ return fmt(p.value); }},'money'),
      glkCol({field:'expectedActivation',headerName:'Expected Activation',width:145}),
      glkCol({field:'proposedDate',headerName:'Proposed Date',width:120}),
      glkCol({field:'modified',headerName:'Modified',width:120}),
      glkCol({field:'versionCount',headerName:'Versions',width:85},'num')
    ];
  }
  var opts={
    columnDefs:cols,rowData:data,
    defaultColDef:{sortable:true,filter:GlkValueListFilter,resizable:true},
    suppressMenuHide:true,
    pagination:true,paginationPageSize:50,paginationPageSizeSelector:[25,50,100,250],
    rowHeight:44,headerHeight:48,animateRows:true,enableCellTextSelection:true,
    onGridReady:function(p){ PG_GRID_API=p.api; }
  };
  if(PG_GRID_API){ try{ PG_GRID_API.destroy(); }catch(e){} PG_GRID_API=null; }
  el('pgGrid').innerHTML='';
  agGrid.createGrid(el('pgGrid'),opts);
}
function pgRender(){
  pgRebuildCascadeFilters();
  pgRenderStaleFilters();
  pgRenderFlipFilters();
  var sf=el('pgStaleFilters'), ff=el('pgFlipFilters');
  if(sf) sf.style.display=PG_TAB==='stale'?'flex':'none';
  if(ff) ff.style.display=PG_TAB==='flips'?'flex':'none';
  var f=pgGetFilterVals();
  var foot=el('pgFootnote'), gridTitle=el('pgGridTitle'), gridCount=el('pgGridCount');
  if(PG_LOADING){
    var loaded=PG_ANALYSIS.length, total=window._PG_LOAD_TOTAL||loaded||0;
    var pct=total?Math.round((loaded/total)*100):0;
    if(gridTitle) gridTitle.textContent='Loading version history · '+loaded+' / '+total+' ('+pct+'%)';
    if(gridCount) gridCount.textContent=(PG_LOAD_STATS.totalFlips||0)+' flips found so far';
    el('pgGrid').innerHTML='<div class="pg-empty">Reading SharePoint Version History · <strong>'+loaded+' / '+total+'</strong> deals · <strong>'+(PG_LOAD_STATS.totalFlips||0)+'</strong> status flips found…</div>';
    return;
  }
  if(!PG_ANALYSIS.length){
    el('pgKpiRow').innerHTML='';
    var pgHdGrid=el('pgHdGrid'); if(pgHdGrid) pgHdGrid.innerHTML='';
    pgHidePgAd(); pgHidePgAm();
    el('pgGrid').innerHTML='<div class="pg-empty">'+(window._PG_AUTO_LOAD_PENDING||!ALL_BIDS||!ALL_BIDS.length?'Waiting for pipeline data, then loading version history automatically…':'Loading SharePoint version history for QTG in-flight deals…')+'</div>';
    if(!PG_LOADING&&ALL_BIDS&&ALL_BIDS.length&&!PG_ANALYSIS.length) pgEnsureVersionHistoryLoaded(false);
    if(foot) foot.textContent='';
    return;
  }
  var rows=pgGetScopedRows();
  pgRenderKpiTiles(rows,f);
  pgRenderDrillSections(rows,f);
  pgRenderGridData();
  if(foot){
    var live=mqLiveYearQuarter();
    var errNote=PG_LOAD_STATS.hardErrors?(' <span class="pg-error-note">'+PG_LOAD_STATS.hardErrors+' records could not reach SharePoint.</span>'):'';
    var dbg='';
    if(PG_DEBUG){
      dbg=' · debug: '+(PG_DEBUG.err||('html '+ (PG_DEBUG.htmlLen||0)+' · OppStatus in page '+(PG_DEBUG.hasOppStatus?'yes':'no')+' · version rows '+(PG_DEBUG.versionRows||0)+' · status rows '+(PG_DEBUG.statusRows||0)+' · parsed flips '+(PG_DEBUG.flips||0)));
    }
    foot.innerHTML=(PG_TAB==='flips'
      ?'<strong>Status flips</strong> = Opp Status changes from the same Version History page you open in SharePoint (e.g. Proposed → Won → Opportunity → Billed)'
      :'<strong>Stale queue</strong> = days sitting on the current Opp Status since the last status change in version history')
      +errNote+' · Q'+live.quarter+' pipeline '+PG_ANALYSIS.length+' · Versions.aspx reads '+PG_LOAD_STATS.aspxReads+' · pages with flips '+PG_LOAD_STATS.aspxParseHits+' · <strong>'+PG_LOAD_STATS.totalFlips+' flips</strong> on '+PG_LOAD_STATS.dealsWithFlips+' deals.'+dbg;
  }
}
function pgSetProgress(pct,text){
  var bar=el('pgProgressBar'), fill=el('pgProgressFill'), txt=el('pgProgressText');
  if(bar) bar.style.display='block';
  if(fill) fill.style.width=Math.max(0,Math.min(100,pct))+'%';
  if(txt) txt.textContent=text||'';
}
function pgHideProgress(){
  var bar=el('pgProgressBar');
  if(bar) bar.style.display='none';
}
function pgStartGovernanceLoad(forceRefresh){
  if(PG_LOADING) return;
  if(!ALL_BIDS||!ALL_BIDS.length){
    window._PG_AUTO_LOAD_PENDING=true;
    pgRender();
    return;
  }
  window._PG_AUTO_LOAD_PENDING=false;
  if(!PG_ANALYSIS.length||forceRefresh) pgRefreshFromSharePoint(null,!!forceRefresh);
  else pgRender();
}
function pgEnsureVersionHistoryLoaded(forceRefresh){
  pgStartGovernanceLoad(!!forceRefresh);
}
function pgRefreshFromSharePoint(evt,forceClearCache){
  if(PG_LOADING) return;
  if(!ALL_BIDS||!ALL_BIDS.length){
    window._PG_AUTO_LOAD_PENDING=true;
    pgRender();
    return;
  }
  window._PG_AUTO_LOAD_PENDING=false;
  if(forceClearCache||evt){ try{ localStorage.removeItem(PG_VERSION_CACHE_LS); }catch(e){} }
  var candidates=pgGetQtgCandidates();
  if(!candidates.length){
    alert('No live-quarter pipeline deals found in the current dataset.');
    PG_ANALYSIS=[];
    pgRender();
    return;
  }
  PG_LOADING=true;
  PG_ANALYSIS=[];
  PG_DEBUG=null;
  window._PG_LOAD_TOTAL=candidates.length;
  PG_LOAD_STATS={fetched:0,cached:0,fallback:0,hardErrors:0,totalFlips:0,dealsWithFlips:0,aspxReads:0,detailReads:0,aspxParseHits:0};
  pgRender();
  pgSetProgress(0,'Starting · 0 / '+candidates.length+' deals (0%)');
  function pgLiveProgress(){
    var done=PG_ANALYSIS.length, total=candidates.length;
    var pct=total?Math.round((done/total)*100):0;
    var last=PG_ANALYSIS.length?PG_ANALYSIS[PG_ANALYSIS.length-1]:null;
    var name=last&&last.bid?(last.bid.customerName||''):'';
    pgSetProgress(pct,'Reading Version History · '+done+' / '+total+' ('+pct+'%) · '+(PG_LOAD_STATS.totalFlips||0)+' flips found'+(name?' · last: '+name:''));
    var gridTitle=el('pgGridTitle'), gridCount=el('pgGridCount'), grid=el('pgGrid');
    if(gridTitle) gridTitle.textContent='Loading version history · '+done+' / '+total+' ('+pct+'%)';
    if(gridCount) gridCount.textContent=(PG_LOAD_STATS.totalFlips||0)+' flips found so far';
    if(grid) grid.innerHTML='<div class="pg-empty">Reading SharePoint Version History · <strong>'+done+' / '+total+'</strong> deals ('+pct+'%) · <strong>'+(PG_LOAD_STATS.totalFlips||0)+'</strong> status flips found…</div>';
  }
  function startHistoryPump(){
    pgLiveProgress();
    var idx=0, active=0;
    function pump(){
      while(active<6&&idx<candidates.length){
        (function(bid){
          active++;
          pgFetchItemVersionHistory(bid,function(err,versions,isPartial,prefetchedAnalysis){
            active--;
            if(err&&!versions) PG_LOAD_STATS.hardErrors++;
            var analysis=prefetchedAnalysis||pgAnalyzeVersionHistory(bid,versions||pgFallbackVersions(bid));
            if(analysis.flips&&analysis.flips.length){
              PG_LOAD_STATS.totalFlips+=analysis.flips.length;
              PG_LOAD_STATS.dealsWithFlips++;
            }
            PG_ANALYSIS.push({bid:bid,analysis:analysis,partial:!!isPartial});
            pgLiveProgress();
            if(PG_ANALYSIS.length>=candidates.length){
              PG_LOADING=false;
              pgHideProgress();
              PG_ANALYSIS.sort(function(a,b){ return b.analysis.daysStale-a.analysis.daysStale; });
              pgRender();
            }else pump();
          },true);
        })(candidates[idx++]);
      }
    }
    pump();
  }
  function ensureGuidThenGo(){
    if(window._PG_LIST_GUID){ startHistoryPump(); return; }
    var safeList=SP_LIST.replace(/'/g,"''");
    spGet(SP_SITE+"/_api/web/lists/getbytitle('"+safeList+"')",function(err,gdata){
      var d=gdata&&gdata.d;
      var id=d&&(d.Id||d.GUID||d.guid);
      if(id) window._PG_LIST_GUID=String(id).replace(/[{}]/g,'');
      if(!window._PG_LIST_GUID) PG_DEBUG={err:'Could not read list GUID — Versions.aspx cannot be opened'};
      startHistoryPump();
    });
  }
  ensureGuidThenGo();
}
function pgInitGovernanceDatesOnce(){
  try{
    if(localStorage.getItem('glk_pg_dates_v5')) return;
    PG_FLIP_FROM_ISO=pgQuarterStartIso();
    PG_FLIP_TO_ISO=pgTodayIso();
    localStorage.setItem('glk_pg_dates_v5','1');
  }catch(e){}
}
window.glkShowGovernance=function(){
  glkHideAllMainViews();
  var tn=el('table-nav'); if(tn) tn.style.display='none';
  var gv=el('governance-view'); if(gv) gv.style.display='block';
  var ct=el('content'); if(ct) ct.classList.add('mq-view');
  var dc=el('dashboardContent'); if(dc) dc.classList.add('mq-full');
  glkSetActiveNav('navGovernance');
  pgInitGovernanceDatesOnce();
  window._PG_GOV_MENU_LOADED=true;
  if(PG_LOADING) pgRender();
  else pgStartGovernanceLoad(false);
  requestAnimationFrame(function(){ glkSetActiveNav('navGovernance'); });
  setTimeout(function(){ glkSetActiveNav('navGovernance'); },100);
};
window.pgRefreshFromSharePoint=pgRefreshFromSharePoint;
window.pgSetTab=pgSetTab;
window.pgRender=pgRender;
window.pgResetAll=pgResetAll;
window.pgSetFlipFilter=pgSetFlipFilter;
window.pgSetStaleDays=pgSetStaleDays;
window.pgSetFlipDatePreset=pgSetFlipDatePreset;
window.pgOnFlipDateChange=pgOnFlipDateChange;
window.pgOnHdFilterChange=pgOnHdFilterChange;
window.pgOnAdFilterChange=pgOnAdFilterChange;
window.pgOnAmFilterChange=pgOnAmFilterChange;
window.pgSelectPgHd=pgSelectPgHd;
window.pgSelectPgAd=pgSelectPgAd;
window.pgSelectPgAm=pgSelectPgAm;

// ══════════════════════════════════════════════════════════════════
//  INIT
// ══════════════════════════════════════════════════════════════════
window.addEventListener('load',function(){
  window._glkFullPage=true;
  document.documentElement.classList.add('glk-fullpage');
  el('landingPage').style.display='flex';
  try{
    const bt=localStorage.getItem('glk_base_theme')||'magenta';
    const dm=localStorage.getItem('glk_dark_mode')==='true';
    const sel=el('colorSchemeSelector'); if(sel) sel.value=bt;
    applyTheme(bt,dm);
  }catch(e){}
  mqInitWowPriorStore();
  initAccess();
  glkSyncFullscreenBtn();
  glkEnterFullscreen();
  glkBindFullscreenOnGesture();
});
</script>
</body>
</html>
