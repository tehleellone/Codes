function mqYtdTargetFieldKey(ph){
  if(!ph) return null;
  if(ph.kind==='quarter'&&ph.quarter) return 'q'+ph.quarter;
  if(ph.kind==='apr') return 'apr';
  if(ph.kind==='mayjune') return 'mayJune';
  return null;
}
function mqYtdTargetFieldsForReport(report){
  report=report||mqGetActiveReport();
  var tb=report&&report.targetBlock;
  if(tb&&tb.periodCols&&tb.periodCols.length){
    var out=[];
    tb.periodCols.forEach(function(pc){
      if(!pc.ph||pc.ph.kind==='total') return;
      var key=mqYtdTargetFieldKey(pc.ph);
      if(!key) return;
      out.push({key:key,label:pc.ph.label||key.toUpperCase()});
    });
    if(out.length) return out;
  }
  var y=(report&&report.year)||(GLK_YTD_META.currentMonth&&GLK_YTD_META.currentMonth.year)||new Date().getFullYear();
  return MQ_YTD_TARGET_FIELDS_FALLBACK.map(function(f){
    if(/^q[1-4]$/.test(f.key)) return {key:f.key,label:f.label+"'"+String(y).slice(-2)};
    return {key:f.key,label:f.label};
  });
}
