<!DOCTYPE html>
<html lang="en" class="glk-fullpage">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sales Excellence &amp; Governance Portal</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/ag-grid/32.0.2/ag-grid-community.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/pptxgenjs@3.12.0/dist/pptxgen.bundle.js"></script>
<link rel="stylesheet" href="https://unpkg.com/ag-grid-community@32.0.2/styles/ag-grid.css">
<link rel="stylesheet" href="https://unpkg.com/ag-grid-community@32.0.2/styles/ag-theme-alpine.css">
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

/* ═══════ TOKENS ═══════════════════════════════════════════════════════ */
/* MAGENTA LIGHT — default */
:root {
  --bg-body: linear-gradient(145deg, #f9f0ff, #fce7ff, #f5eeff);
  --bg-card: #ffffff;
  --bg-header: rgba(255,255,255,0.97);
  --bg-sidebar: linear-gradient(180deg,#fdf4ff,#f8ecff);
  --bg-content: #f9f3ff;
  --bg-input: rgba(168,85,247,0.06);
  --bg-secondary: rgba(168,85,247,0.05);
  --bg-hover: rgba(168,85,247,0.07);
  --border: rgba(168,85,247,0.2);
  --border-s: rgba(168,85,247,0.45);
  --t1: #1e1133;
  --t2: #4b3f6b;
  --t3: #8b7aad;
  --acc: #a855f7;
  --acc2: #c724b1;
  --glow: rgba(168,85,247,0.28);
  --grad: linear-gradient(135deg,#9248b9,#c724b1);
  --nab: rgba(168,85,247,0.1);
  --nab2: rgba(168,85,247,0.35);
  --sc: #a855f7;
  --cs: 0 1px 8px rgba(168,85,247,0.12);
  --ch: 0 6px 20px rgba(168,85,247,0.2);
  --chip: rgba(168,85,247,0.08);
}
/* MAGENTA DARK */
body[data-theme="dark"] {
  --bg-body: linear-gradient(145deg,#120820,#1e0d33,#160a28);
  --bg-card: #1f0d38;
  --bg-header: rgba(18,8,32,0.98);
  --bg-sidebar: linear-gradient(180deg,#230f3d,#1a0a2e);
  --bg-content: #160a28;
  --bg-input: rgba(168,85,247,0.12);
  --bg-secondary: rgba(168,85,247,0.08);
  --bg-hover: rgba(168,85,247,0.12);
  --border: rgba(168,85,247,0.2);
  --border-s: rgba(168,85,247,0.5);
  --t1: #f3e8ff;
  --t2: #c4b5fd;
  --t3: #8b5cf6;
  --acc: #c084fc;
  --acc2: #e879f9;
  --glow: rgba(192,132,252,0.35);
  --grad: linear-gradient(135deg,#9248b9,#c724b1);
  --nab: rgba(168,85,247,0.16);
  --nab2: rgba(168,85,247,0.45);
  --sc: #e879f9;
  --cs: 0 2px 16px rgba(0,0,0,0.5);
  --ch: 0 6px 24px rgba(168,85,247,0.25);
  --chip: rgba(168,85,247,0.15);
}
/* DURALUX LIGHT */
body[data-theme="duralux"] {
  --bg-body: linear-gradient(145deg,#f0f4ff,#e8edff,#f4f6ff);
  --bg-card: #ffffff;
  --bg-header: rgba(255,255,255,0.97);
  --bg-sidebar: linear-gradient(180deg,#f0f4ff,#e8edff);
  --bg-content: #f0f4ff;
  --bg-input: rgba(76,111,255,0.06);
  --bg-secondary: rgba(76,111,255,0.05);
  --bg-hover: rgba(76,111,255,0.07);
  --border: rgba(76,111,255,0.2);
  --border-s: rgba(76,111,255,0.45);
  --t1: #0f1a3e;
  --t2: #3d4f8a;
  --t3: #7a8fc4;
  --acc: #4c6fff;
  --acc2: #818cf8;
  --glow: rgba(76,111,255,0.28);
  --grad: linear-gradient(135deg,#4c6fff,#818cf8);
  --nab: rgba(76,111,255,0.1);
  --nab2: rgba(76,111,255,0.35);
  --sc: #4c6fff;
  --cs: 0 1px 8px rgba(76,111,255,0.1);
  --ch: 0 6px 20px rgba(76,111,255,0.18);
  --chip: rgba(76,111,255,0.08);
}
/* DURALUX DARK */
body[data-theme="duralux-dark"] {
  --bg-body: linear-gradient(145deg,#060c1f,#0c1535,#080e25);
  --bg-card: #0e1630;
  --bg-header: rgba(6,12,31,0.98);
  --bg-sidebar: linear-gradient(180deg,#101a38,#0c1430);
  --bg-content: #090f28;
  --bg-input: rgba(76,111,255,0.12);
  --bg-secondary: rgba(76,111,255,0.08);
  --bg-hover: rgba(76,111,255,0.12);
  --border: rgba(76,111,255,0.2);
  --border-s: rgba(76,111,255,0.5);
  --t1: #e2e8f0;
  --t2: #a5b4c8;
  --t3: #637899;
  --acc: #818cf8;
  --acc2: #a5b4fc;
  --glow: rgba(129,140,248,0.35);
  --grad: linear-gradient(135deg,#4c6fff,#818cf8);
  --nab: rgba(76,111,255,0.14);
  --nab2: rgba(76,111,255,0.45);
  --sc: #818cf8;
  --cs: 0 2px 16px rgba(0,0,0,0.55);
  --ch: 0 6px 24px rgba(76,111,255,0.2);
  --chip: rgba(76,111,255,0.15);
}

/* ═══════ RESET ════════════════════════════════════════════════════════ */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
h1,h2,h3,h4,h5,h6{margin:0!important;padding:0!important;font-weight:inherit}
html{scroll-behavior:smooth}
body{
  font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  background:var(--bg-body);
  color:var(--t1);
  min-height:100vh;
  -webkit-font-smoothing:antialiased;
  transition:background .3s,color .3s;
  line-height:1.5;
}
select,input,textarea,button{font-family:inherit}

/* ═══════ PORTAL SHELL ══════════════════════════════════════════════════ */
.portal-shell{
  max-width:1800px;margin:0 auto;min-height:100vh;
  display:flex;flex-direction:column;background:var(--bg-body);
}

/* ═══════ HEADER ════════════════════════════════════════════════════════ */
.header{
  background:var(--bg-header);border-bottom:1px solid var(--border);
  backdrop-filter:blur(16px);padding:0 1.25rem;height:56px;
  display:flex;align-items:center;justify-content:space-between;gap:1rem;
  position:sticky;top:0;z-index:200;flex-shrink:0;
}
.logo-section{display:flex;align-items:center;gap:.65rem;min-width:0}
.logo{
  width:36px;height:36px;border-radius:10px;background:var(--grad);
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 0 14px var(--glow);flex-shrink:0;overflow:hidden;
}
.logo img{width:24px;height:24px;object-fit:contain}
.landing-brand-icon{margin-bottom:.85rem}
.landing-brand-icon img{width:64px;height:64px;object-fit:contain;display:block}
.header-title{
  font-size:.92rem;font-weight:800;line-height:1.25;max-width:min(320px,42vw);
  background:var(--grad);-webkit-background-clip:text;
  -webkit-text-fill-color:transparent;background-clip:text;
}
.header-center{display:flex;align-items:center;gap:.75rem;flex:1;justify-content:flex-start;padding-left:.75rem}
.header-actions{display:flex;align-items:center;gap:.5rem;flex-shrink:0}
.live-badge-pill{
  display:inline-flex;align-items:center;gap:.3rem;padding:.22rem .65rem;
  border-radius:20px;background:rgba(22,163,74,.12);border:1px solid rgba(22,163,74,.28);
  font-size:.73rem;font-weight:700;color:#16a34a;white-space:nowrap;
}
body[data-theme="dark"] .live-badge-pill,
body[data-theme="duralux-dark"] .live-badge-pill{
  background:rgba(34,197,94,.1);border-color:rgba(34,197,94,.25);color:#22c55e;
}
.status-dot{
  width:6px;height:6px;border-radius:50%;background:#16a34a;
  animation:pulseDot 2s infinite;
}
body[data-theme="dark"] .status-dot,body[data-theme="duralux-dark"] .status-dot{background:#22c55e}
@keyframes pulseDot{0%,100%{box-shadow:0 0 0 0 rgba(22,163,74,.4)}50%{box-shadow:0 0 0 5px rgba(22,163,74,0)}}
.date-badge{font-size:.75rem;color:var(--t3);display:flex;align-items:center;gap:.3rem;white-space:nowrap}
.color-scheme-selector{
  padding:.3rem .65rem;background:var(--bg-input);border:1px solid var(--border);
  border-radius:18px;color:var(--t1);font-size:.75rem;cursor:pointer;transition:border-color .2s;
}
.color-scheme-selector:hover{border-color:var(--border-s)}
.theme-toggle{
  width:34px;height:34px;border-radius:50%;background:var(--bg-input);border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--t1);transition:all .2s;
}
.theme-toggle:hover{border-color:var(--border-s)}
.theme-toggle svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2}
.theme-toggle.active-fs{border-color:var(--nab2);background:var(--nab);color:var(--acc)}
#glkLandingFsBtn{position:fixed;top:16px;right:16px;z-index:100002;background:var(--bg-card)}
html.glk-fullpage,html.glk-fullpage body{overflow:hidden!important;height:100%!important;max-height:100vh!important}
html.glk-fullpage #landingPage,
html.glk-fullpage #dashboardContent{
  position:fixed!important;inset:0!important;width:100vw!important;height:100vh!important;
  z-index:2147483000!important;margin:0!important;
}
html.glk-fullpage #dashboardContent{display:flex;flex-direction:column;background:var(--bg-body)}
html.glk-fullpage #glkLoader{z-index:2147483600}
html.glk-fullpage .ms-dropdown,
html.glk-fullpage .stat-detail,
html.glk-fullpage #viewAsPanel,
html.glk-fullpage #glkBidDetailModal,
html.glk-fullpage #dashboardLoadingOverlay,
html.glk-fullpage .glk-row-modal-backdrop,
html.glk-fullpage .ag-popup,
html.glk-fullpage .ag-popup-child,
html.glk-fullpage .ag-menu,
html.glk-fullpage .ag-tooltip,
html:fullscreen .ms-dropdown,
html:fullscreen .stat-detail,
html:fullscreen #viewAsPanel,
html:fullscreen #glkBidDetailModal,
html:fullscreen #dashboardLoadingOverlay,
html:fullscreen .glk-row-modal-backdrop,
html:fullscreen .ag-popup,
html:fullscreen .ag-popup-child,
html:fullscreen .ag-menu,
html:fullscreen .ag-tooltip{
  z-index:2147483640!important;
}
.glk-row-modal-backdrop{
  position:fixed;inset:0;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;padding:1rem;
  z-index:2147483635;
}
#glkBidDetailModal{
  background:var(--bg-card);border:1px solid var(--border-s);border-radius:14px;max-width:920px;width:100%;max-height:90vh;overflow:auto;
  box-shadow:0 20px 60px rgba(0,0,0,.35);padding:1.1rem 1.25rem;
}
.glk-row-modal-hdr{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1rem;padding-bottom:.75rem;border-bottom:1px solid var(--border);}
.glk-row-modal-hdr h3{margin:0;font-size:1rem;font-weight:800;color:var(--t1);}
.glk-row-modal-actions{display:flex;gap:.5rem;flex-shrink:0;}
.glk-row-modal-actions a,.glk-row-modal-actions button{
  padding:.35rem .75rem;border-radius:8px;font-size:.72rem;font-weight:700;cursor:pointer;text-decoration:none;border:1px solid var(--border);
  background:var(--bg-secondary);color:var(--t1);font-family:inherit;
}
.glk-row-modal-actions a:hover,.glk-row-modal-actions button:hover{border-color:var(--border-s);background:var(--bg-hover);}
.glk-row-modal-kv{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:.55rem .85rem;font-size:.76rem;}
.glk-row-modal-kv dt{color:var(--t3);font-weight:700;margin:0;}
.glk-row-modal-kv dd{margin:0;color:var(--t1);font-weight:600;word-break:break-word;}
.glk-grid-actions{display:flex;align-items:center;justify-content:center;height:100%;width:100%;}
.glk-grid-eye{
  width:32px;height:32px;border-radius:8px;border:1px solid var(--border);background:var(--bg-secondary);
  display:inline-flex;align-items:center;justify-content:center;cursor:pointer;color:var(--t2);
}
.glk-grid-eye:hover{border-color:var(--border-s);background:var(--bg-hover);color:var(--acc);}
.glk-grid-eye svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;}
#dashboardContent:fullscreen,#dashboardContent:-webkit-full-screen,
html:fullscreen,html:-webkit-full-screen{
  width:100%;height:100%;background:var(--bg-body);
}

/* ═══════ SIDEBAR ═══════════════════════════════════════════════════════ */
.sidebar-toggle-btn{
  position:absolute;right:-14px;top:20px;z-index:300;width:28px;height:28px;border-radius:50%;
  background:var(--bg-card);border:1px solid var(--border);box-shadow:var(--cs);
  display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--t1);transition:all .2s;
}
.sidebar-toggle-btn:hover{border-color:var(--border-s);background:var(--bg-hover)}
.sidebar-toggle-btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2}
.main-container{display:flex;flex:1;min-height:0;position:relative}
.sidebar{
  width:210px;min-width:210px;background:var(--bg-sidebar);border-right:1px solid var(--border);
  padding:1rem 0;overflow:visible;flex-shrink:0;transition:width .26s ease,min-width .26s ease,opacity .22s,padding .25s;
}
.sidebar.collapsed{width:52px;min-width:52px;padding:1rem 0;border-right:1px solid var(--border);overflow:hidden!important}
.sidebar.collapsed .nav-items{opacity:1;pointer-events:all;}
.sidebar.collapsed .nav-label{display:none;}
.sidebar.collapsed .nav-section-label{display:none;}
.sidebar.collapsed .nav-item{justify-content:center;padding:.55rem 0;}
.sidebar.collapsed .sidebar-toggle-btn{opacity:1!important;pointer-events:all!important;right:-14px;background:var(--bg-card);box-shadow:var(--cs)}
.nav-items{display:flex;flex-direction:column;gap:2px;padding:0 .65rem}
.nav-section-label{
  font-size:.67rem;text-transform:uppercase;letter-spacing:.1em;color:var(--t3);
  padding:.75rem .6rem .3rem;white-space:nowrap;overflow:hidden;
}
.nav-item{
  display:flex;align-items:center;gap:.65rem;padding:.55rem .7rem;border-radius:9px;
  cursor:pointer;color:var(--t2);border:1px solid transparent;transition:all .17s;
  white-space:nowrap;overflow:hidden;font-size:.84rem;font-weight:500;user-select:none;
}
.nav-item .nav-icon{display:flex;align-items:center;flex-shrink:0;width:17px;height:17px}
.nav-item .nav-icon svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:2}
.nav-item .nav-label{font-size:.84rem;font-weight:500}
.nav-item:hover{background:var(--bg-hover);color:var(--t1)}
#sidebar .nav-item.active,
#sidebar .nav-item[aria-current="page"],
#sidebar .nav-item[data-active="true"]{
  background:var(--nab)!important;border-color:var(--nab2)!important;color:var(--t1)!important;font-weight:600!important;
  box-shadow:inset 3px 0 0 var(--acc)
}
#sidebar .nav-item:not(.active):not([data-active="true"]){background:transparent!important;border-color:transparent!important;font-weight:500!important;color:var(--t2)!important;box-shadow:none!important}

/* ═══════ CONTENT ═══════════════════════════════════════════════════════ */
.content{flex:1;overflow-y:auto;min-width:0;background:var(--bg-content);padding:1.1rem 1.25rem;width:100%;box-sizing:border-box}
.content.mq-view{padding:1rem 1.25rem;width:100%;max-width:100%}
.portal-shell.mq-full{max-width:none;width:100%;margin:0}
#dashboard-view{width:100%;max-width:100%;margin:0;box-sizing:border-box}
#mobile-qtd-view{width:100%;max-width:100%;margin:0;padding:0;box-sizing:border-box}
#revenue-rec-view{width:100%;max-width:100%;margin:0;padding:0;box-sizing:border-box}
.rr-chart-tabs{display:flex;gap:.55rem;flex-wrap:wrap;margin-bottom:1rem}
.rr-chart-tab{padding:.55rem 1.15rem;border-radius:10px;font-size:.88rem;font-weight:800;border:1px solid var(--border);background:var(--bg-secondary);color:var(--t2);cursor:pointer;transition:all .15s;line-height:1.25}
.rr-chart-tab:hover{color:var(--t1);border-color:var(--border-s);background:var(--bg-hover)}
.rr-chart-tab.active{background:var(--nab);border-color:var(--nab2);color:var(--acc);box-shadow:0 2px 12px rgba(168,85,247,.22)}
.rr-kpi-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:.4rem;margin-bottom:.55rem}
.rr-kpi-row-ceo{grid-template-columns:minmax(0,1fr) minmax(0,1.35fr) minmax(160px,200px);align-items:start;gap:.4rem}
@media(max-width:960px){.rr-kpi-row-ceo{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.rr-kpi-row-ceo{grid-template-columns:1fr}}
.rr-kpi-label{font-size:.58rem;text-transform:uppercase;letter-spacing:.05em;color:var(--t3);font-weight:700}
.rr-kpi-sub{font-size:.58rem;color:var(--t3);margin-top:.1rem;font-weight:600;line-height:1.35}
.rr-kpi-hero .rr-kpi-label{font-size:.62rem;margin-bottom:.05rem}
.rr-kpi-lines{display:flex;flex-direction:column;gap:.28rem;margin-top:.3rem}
.rr-kpi-line{display:flex;align-items:baseline;flex-wrap:wrap;gap:.25rem .4rem;line-height:1.25}
.rr-kpi-q{font-weight:800;color:var(--t1);font-size:.72rem;min-width:1.5rem}
.rr-kpi-amt{font-weight:900;font-size:.92rem;color:var(--acc);letter-spacing:-.01em}
.rr-kpi-amt-sm{font-weight:800;font-size:.82rem;color:var(--t1)}
.rr-kpi-note{font-size:.62rem;font-weight:600;color:var(--t3)}
.rr-kpi-chip{font-size:.6rem;font-weight:700;padding:.1rem .34rem;border-radius:4px;white-space:nowrap}
.rr-kpi-up{background:rgba(34,197,94,.13);color:#16a34a}
.rr-kpi-down{background:rgba(239,68,68,.13);color:#dc2626}
.rr-kpi-neu{background:rgba(100,116,139,.12);color:var(--t2)}
.rr-kpi-curr{font-size:.54rem;font-weight:800;padding:.08rem .3rem;border-radius:4px;text-transform:uppercase;letter-spacing:.04em;background:rgba(168,85,247,.14);color:var(--acc);vertical-align:middle}
.rr-kpi-compact .rr-kpi-val{font-size:1.05rem;margin-top:.15rem}
.rr-kpi-compact .rr-kpi-sub{margin-top:.2rem;line-height:1.35}
.rr-kpi-divider{height:1px;background:var(--border);margin:.25rem 0 .1rem;opacity:.7}
.rr-kpi-proj-grid{display:grid;grid-template-columns:1fr 1fr;gap:.35rem;height:100%}
@media(max-width:640px){.rr-kpi-proj-grid{grid-template-columns:1fr}}
.rr-kpi-proj-wrap{padding:.45rem .55rem;border-radius:10px;background:linear-gradient(135deg,var(--bg-card) 0%,var(--bg-secondary) 100%);border:1px solid var(--border-s);border-left:4px solid var(--acc);box-shadow:var(--cs),0 2px 8px rgba(0,0,0,.04)}
.rr-kpi-proj{margin-top:0;padding:.32rem .4rem;border-radius:7px;border:1.5px solid var(--border-s)}
.rr-kpi-proj-ml{border-color:#7c3aed;background:linear-gradient(135deg,rgba(124,58,237,.1),rgba(124,58,237,.03))}
.rr-kpi-proj-up{border-color:#16a34a;background:linear-gradient(135deg,rgba(22,163,74,.1),rgba(22,163,74,.03))}
.rr-kpi-proj-title{font-size:.58rem;font-weight:900;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.18rem}
.rr-kpi-proj-ml .rr-kpi-proj-title{color:#7c3aed}
.rr-kpi-proj-up .rr-kpi-proj-title{color:#16a34a}
.rr-kpi-proj-hdr{font-size:.58rem;font-weight:800;color:var(--t2);margin:.15rem 0 .08rem}
.rr-kpi-calc-row{display:flex;justify-content:space-between;align-items:baseline;gap:.5rem;font-size:.64rem;line-height:1.3;padding:.02rem 0}
.rr-kpi-calc-row span:first-child{color:var(--t2);font-weight:600}
.rr-kpi-calc-row span:last-child{font-weight:800;color:var(--t1)}
.rr-kpi-calc-minus span:last-child{color:#dc2626}
.rr-kpi-calc-eq{display:flex;justify-content:space-between;align-items:baseline;margin-top:.15rem;padding-top:.2rem;border-top:1.5px solid rgba(0,0,0,.07);font-size:.72rem;font-weight:900}
.rr-kpi-proj-ml .rr-kpi-calc-eq span:last-child{color:#7c3aed;font-size:.82rem}
.rr-kpi-proj-up .rr-kpi-calc-eq span:last-child{color:#16a34a;font-size:.82rem}
.rr-kpi-proj-foot{font-size:.56rem;color:var(--t3);margin-top:.15rem;line-height:1.25}
.rr-legend-row{display:flex;flex-wrap:wrap;gap:.5rem .75rem;margin-top:.55rem;padding:.55rem .65rem;background:var(--bg-secondary);border-radius:9px;border:1px solid var(--border)}
.rr-legend-chip{display:inline-flex;align-items:center;gap:.35rem;font-size:.72rem;font-weight:700;color:var(--t2)}
.rr-legend-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}
.rr-legend-line{width:22px;height:3px;border-radius:2px;flex-shrink:0}
.rr-proj-badge{font-size:.62rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;padding:.15rem .45rem;border-radius:5px;background:rgba(251,191,36,.15);color:#b45309;border:1px solid rgba(251,191,36,.35)}
#rrChartWrap{position:relative;background:linear-gradient(145deg,rgba(99,102,241,.06) 0%,var(--bg-card) 35%,var(--bg-secondary) 100%);border-radius:14px;padding:.75rem .65rem .35rem;border:1px solid var(--border-s);box-shadow:var(--cs),inset 0 1px 0 rgba(255,255,255,.06)}
#rrChartWrap::before{content:'';position:absolute;inset:0;border-radius:14px;background:radial-gradient(ellipse 80% 50% at 50% 0%,rgba(168,85,247,.08),transparent 70%);pointer-events:none}
#rrChartWrap .chart-container{height:560px;position:relative;z-index:1}
.rr-kpi{padding:.45rem .55rem;border-radius:10px;background:linear-gradient(135deg,var(--bg-card) 0%,var(--bg-secondary) 100%);border:1px solid var(--border-s);border-left:4px solid var(--acc);box-shadow:var(--cs),0 2px 8px rgba(0,0,0,.04)}
.rr-kpi-val{font-size:1rem;font-weight:900;color:var(--acc);margin-top:.12rem;line-height:1.15;letter-spacing:-.01em}
.mq-product-tables-section{margin:1rem 0 0;padding:1rem 1.05rem;background:linear-gradient(165deg,var(--bg-card) 0%,var(--bg-secondary) 100%);border:1px solid var(--border-s);border-radius:14px;box-shadow:var(--cs)}
.mq-pt-section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:.85rem;padding-bottom:.65rem;border-bottom:1px solid var(--border)}
.mq-pt-section-title{display:flex;align-items:center;gap:.45rem;font-size:.88rem;font-weight:900;color:var(--t1);letter-spacing:-.01em}
.mq-pt-section-title svg{width:18px;height:18px;stroke:var(--acc);fill:none;stroke-width:2;flex-shrink:0}
.mq-pt-info-btn{width:22px;height:22px;border-radius:50%;border:1px solid var(--border-s);background:var(--nab);color:var(--acc);font-weight:800;font-size:.72rem;cursor:pointer;line-height:1;padding:0;flex-shrink:0}
.mq-pt-info-btn:hover{background:var(--acc);color:#fff;border-color:var(--acc)}
.mq-pt-section-sub{font-size:.68rem;color:var(--t3);font-weight:600;margin-top:.2rem;line-height:1.45}
.mq-pt-section-actions{display:flex;align-items:center;gap:.45rem;flex-wrap:wrap}
.mq-pt-bulk-btn{display:inline-flex;align-items:center;gap:.35rem;padding:.38rem .72rem;border-radius:8px;border:1px dashed var(--border-s);background:var(--bg-card);color:var(--t2);font-size:.68rem;font-weight:700;cursor:pointer;font-family:inherit;transition:all .15s}
.mq-pt-bulk-btn:hover{border-color:var(--acc);color:var(--acc);background:var(--nab)}
.mq-pt-info-panel{display:none;margin-bottom:.85rem;padding:.75rem .85rem;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;font-size:.7rem;color:var(--t2);line-height:1.65}
.mq-pt-info-panel.open{display:block}
.mq-product-tables-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(460px,1fr));gap:1rem}
.mq-product-tables-single{grid-template-columns:minmax(0,760px);justify-content:center}
.mq-product-table-card{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;overflow:hidden;box-shadow:var(--cs);transition:box-shadow .15s,border-color .15s}
.mq-product-table-card:hover{box-shadow:var(--ch);border-color:var(--border-s)}
.mq-pt-card-head{display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:.55rem .7rem;background:linear-gradient(90deg,var(--nab),transparent);border-bottom:1px solid var(--border)}
.mq-pt-scope-badge{font-size:.74rem;font-weight:900;color:var(--t1);letter-spacing:-.01em}
.mq-pt-scenario{display:inline-flex;align-items:center;padding:.18rem .55rem;border-radius:999px;font-size:.58rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em}
.mq-pt-scenario.ml{background:rgba(99,102,241,.14);color:#4f46e5;border:1px solid rgba(99,102,241,.35)}
.mq-pt-scenario.up{background:rgba(34,197,94,.12);color:#16a34a;border:1px solid rgba(34,197,94,.35)}
.mq-product-table{width:100%;border-collapse:collapse;font-size:.78rem}
.mq-product-table th,.mq-product-table td{padding:.52rem .62rem;border-bottom:1px solid var(--border);text-align:right;white-space:nowrap}
.mq-product-table th:first-child,.mq-product-table td:first-child{text-align:left;font-weight:800;color:var(--t1);min-width:88px}
.mq-product-table thead th{font-size:.64rem;text-transform:uppercase;letter-spacing:.04em;font-weight:800;color:#fff;border-bottom:none}
.mq-product-table thead th.mq-pt-h-prod{background:#475569}
.mq-product-table thead th.mq-pt-h-gross{background:#2563eb}
.mq-product-table thead th.mq-pt-h-churn{background:#ea580c}
.mq-product-table thead th.mq-pt-h-net{background:#7c3aed}
.mq-product-table thead th.mq-pt-h-wow{background:#64748b}
.mq-product-table tbody tr:nth-child(even){background:var(--bg-secondary)}
.mq-product-table td.mq-pt-gross{color:#1d4ed8;font-weight:800;background:rgba(37,99,235,.1);font-size:.8rem}
.mq-product-table td.mq-pt-churn{color:#c2410c;font-weight:800;background:rgba(234,88,12,.1);font-size:.8rem}
.mq-product-table td.mq-pt-net{color:#6d28d9;font-weight:900;background:rgba(124,58,237,.1);font-size:.82rem}
.mq-product-table tr.mq-product-total td{font-weight:900;background:var(--nab);border-top:2px solid var(--nab2);font-size:.82rem}
.mq-pt-card-foot{display:flex;align-items:center;justify-content:space-between;gap:.5rem;flex-wrap:wrap;padding:.5rem .65rem;background:var(--bg-secondary);border-top:1px solid var(--border);font-size:.64rem}
.mq-pt-wow-status{color:var(--t3);font-weight:600;flex:1 1 auto;line-height:1.35}
.mq-pt-wow-status.loaded{color:#16a34a;font-weight:700}
.mq-pt-upload-btn{display:inline-flex;align-items:center;gap:.25rem;padding:.28rem .55rem;border-radius:7px;border:1px solid var(--border-s);background:var(--bg-card);color:var(--t2);font-size:.62rem;font-weight:700;cursor:pointer;font-family:inherit;white-space:nowrap}
.mq-pt-upload-btn:hover{border-color:var(--acc);color:var(--acc);background:var(--nab)}
.mq-wow-up{color:#16a34a;font-weight:900;font-size:.78rem}
.mq-wow-down{color:#dc2626;font-weight:900;font-size:.78rem}
.mq-wow-neu{color:var(--t3);font-weight:700}
.mq-pt-drill{cursor:pointer;transition:background .12s,box-shadow .12s}
.mq-pt-drill:hover{box-shadow:inset 0 0 0 1px var(--nab2)}
.mq-product-table tr.mq-pt-row-sel td{box-shadow:inset 0 0 0 2px var(--acc);background:var(--nab)!important}
.mq-pt-table-hint{font-size:.72rem;color:var(--t3);font-weight:600;margin:.55rem 0 0;line-height:1.45}
.pg-section{padding:.25rem 0 1.5rem}
.pg-header-row{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:.85rem}
.pg-subtitle{font-size:.78rem;color:var(--t3);margin:0 0 1rem;line-height:1.55;max-width:920px}
.pg-progress{margin:0 0 1rem;padding:.75rem 1rem;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;box-shadow:var(--cs)}
.pg-progress-track{height:10px;background:var(--border);border-radius:99px;overflow:hidden;margin-bottom:.5rem}
.pg-progress-fill{height:100%;width:0;background:linear-gradient(90deg,var(--acc),var(--nab2));border-radius:99px;transition:width .25s ease}
.pg-progress-text{font-size:.74rem;font-weight:700;color:var(--t2)}
.pg-filter-panel{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.75rem 1rem;margin-bottom:1rem;padding:1rem 1.1rem;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;box-shadow:var(--cs)}
.pg-control-block{display:flex;flex-direction:column;gap:.35rem;min-width:0}
.pg-control-label{font-size:.62rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--t3)}
.pg-control-block .fb-select,.pg-control-block .search-box{width:100%;min-width:0}
.pg-search-block{grid-column:1/-1}
.pg-kpi-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:.85rem;margin-bottom:1.15rem}
.pg-kpi-card{cursor:pointer}
.pg-kpi-card.tile-active{box-shadow:0 0 0 2px var(--acc),var(--ch)!important}
.pg-kpi-card.tile-dimmed{opacity:.42}
.pg-kpi-card .stat-value{font-size:1.55rem}
.pg-kpi-card .stat-subtitle{font-size:.72rem;color:var(--t3);font-weight:600;margin-top:.15rem}
.pg-tab-row{display:flex;flex-wrap:wrap;gap:.65rem;align-items:center;margin-bottom:1rem}
.pg-tab-filters{display:flex;flex-wrap:wrap;gap:.55rem .75rem;align-items:center;margin-bottom:1rem;padding:.75rem 1rem;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;box-shadow:var(--cs)}
.pg-tab-filters-label{font-size:.62rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--t3);margin-right:.15rem}
.pg-flip-filters,.pg-stale-filters{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;width:100%}
.pg-flip-date-row{display:flex;flex-wrap:wrap;gap:.45rem;align-items:center;width:100%}
.pg-flip-date-row input[type=date]{padding:.35rem .55rem;border-radius:8px;border:1px solid var(--border);background:var(--bg-input);color:var(--t1);font-size:.72rem;font-weight:700;font-family:inherit}
.pg-flip-chip,.pg-stale-chip{padding:.32rem .72rem;border-radius:999px;border:1px solid var(--border);background:var(--bg-secondary);color:var(--t2);font-size:.68rem;font-weight:800;cursor:pointer;font-family:inherit}
.pg-flip-chip.active,.pg-stale-chip.active{background:var(--nab);border-color:var(--nab2);color:var(--acc)}
.pg-flip-chip.preset{background:var(--bg-card)}
.pg-breadcrumb{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem;margin-bottom:.85rem;font-size:.74rem;font-weight:700;color:var(--t3)}
.pg-breadcrumb button{background:none;border:none;padding:0;color:var(--acc);font:inherit;font-weight:800;cursor:pointer}
.pg-breadcrumb button:hover{text-decoration:underline}
.pg-breadcrumb .pg-crumb-sep{opacity:.45}
.pg-drill-section{margin-bottom:1.15rem}
.pg-drill-section .section-title{margin-bottom:.75rem}
.pg-drill-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:.85rem}
.pg-drill-tile{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:.85rem 1rem;cursor:pointer;transition:transform .15s,box-shadow .15s,border-color .15s;box-shadow:var(--cs)}
.pg-drill-tile:hover{transform:translateY(-2px);box-shadow:var(--ch);border-color:var(--nab2)}
.pg-drill-tile.selected{border-color:var(--acc);box-shadow:0 0 0 2px var(--acc),var(--ch)}
.pg-drill-tile h4{margin:0 0 .2rem;font-size:.92rem;font-weight:900;color:var(--t1)}
.pg-drill-tile .pg-drill-meta{font-size:.64rem;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.04em;margin-bottom:.55rem}
.pg-drill-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem}
.pg-drill-metric{background:var(--bg-secondary);border-radius:8px;padding:.45rem .5rem;text-align:center}
.pg-drill-metric .lbl{font-size:.58rem;font-weight:800;color:var(--t3);text-transform:uppercase}
.pg-drill-metric .val{font-size:.95rem;font-weight:900;margin-top:.12rem}
.pg-drill-metric .val.stale{color:#ea580c}
.pg-drill-metric .val.crit{color:#dc2626}
.pg-drill-metric .val.ok{color:#16a34a}
.pg-grid-panel{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:.85rem;box-shadow:var(--cs)}
.pg-grid-head{display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:.65rem}
.pg-grid-title{font-size:.88rem;font-weight:900;color:var(--t1)}
.pg-grid-count{font-size:.72rem;font-weight:700;color:var(--t3)}
.pg-status-chip{display:inline-block;padding:.14rem .48rem;border-radius:999px;font-size:.68rem;font-weight:800;background:rgba(99,102,241,.12);color:#4f46e5;border:1px solid rgba(99,102,241,.25)}
.pg-status-chip.opp{background:rgba(37,99,235,.1);color:#1d4ed8;border-color:rgba(37,99,235,.25)}
.pg-status-chip.prop{background:rgba(124,58,237,.1);color:#6d28d9;border-color:rgba(124,58,237,.25)}
.pg-status-chip.billed{background:rgba(22,163,74,.1);color:#15803d;border-color:rgba(22,163,74,.25)}
.pg-status-chip.won{background:rgba(22,163,74,.12);color:#166534;border-color:rgba(22,163,74,.28)}
.pg-footnote{font-size:.68rem;color:var(--t3);margin-top:.75rem;line-height:1.55;padding:.65rem .75rem;background:var(--bg-secondary);border-radius:8px;border:1px solid var(--border)}
.pg-empty{padding:2.5rem 1rem;text-align:center;color:var(--t3);font-weight:600;font-size:.84rem}
.pg-error-note{color:#dc2626;font-weight:800}
.rr-chart-title{font-size:1.08rem;font-weight:800;color:var(--t1);margin-bottom:.5rem;display:flex;align-items:center;gap:.4rem;line-height:1.3}
.rr-chart-title svg{width:18px;height:18px;stroke:var(--acc);fill:none;stroke-width:2;flex-shrink:0}
.rr-chart-subtitle{font-size:.78rem;font-weight:600;color:var(--t3);margin-bottom:.55rem;line-height:1.45}
#rrControlsPanel{overflow:hidden;transition:max-height .28s ease,opacity .22s ease,margin .22s ease}
#rrControlsPanel.collapsed{max-height:0!important;opacity:0;margin:0!important;pointer-events:none}
#rrControlsPanel:not(.collapsed){max-height:800px;opacity:1}
.dashboard-section{animation:fadeSection .25s ease;padding:.5rem 0}
@keyframes fadeSection{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
#glkLoader{
  display:none;position:fixed;inset:0;z-index:100000;
  background:var(--bg-content,#f9f3ff);backdrop-filter:blur(8px);
  align-items:center;justify-content:center;flex-direction:column;gap:1rem;
}
#glkLoaderText{font-size:.88rem;font-weight:700;color:var(--t2);letter-spacing:.02em}
.glk-spinner{width:52px;height:52px;border-radius:50%;border:4px solid color-mix(in srgb,var(--acc,#c026d3) 16%,transparent);border-top-color:var(--acc,#c026d3);animation:glkSpin .8s linear infinite}
@keyframes glkSpin{to{transform:rotate(360deg)}}
#dashboard-view{position:relative;min-height:280px}
.dashboard-loading-overlay{
  position:absolute;inset:0;z-index:50;
  background:color-mix(in srgb,var(--bg-content,#f9f3ff) 94%,transparent);
  backdrop-filter:blur(6px);
  display:none;flex-direction:column;align-items:center;justify-content:center;gap:1rem;
  border-radius:12px;
}
#dashboardLoadingText{font-size:.88rem;font-weight:700;color:var(--t2);letter-spacing:.02em}

/* ═══════ SECTION TITLE ══════════════════════════════════════════════════ */
.section-title{
  font-size:1rem;font-weight:800;margin:.85rem 0!important;
  display:flex;align-items:center;gap:.45rem;color:var(--acc);
}
.section-title svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2}

/* ═══════ STAT CARDS ════════════════════════════════════════════════════ */
.top-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:.85rem;margin-bottom:1rem}
.stat-card{
  background:var(--bg-card);border:1px solid var(--border);border-radius:12px;
  padding:1rem 1.1rem;box-shadow:var(--cs);position:relative;overflow:hidden;
  transition:transform .18s,box-shadow .18s;
}
.stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--grad)}
.stat-card-blank{background:transparent!important;border-color:transparent!important;box-shadow:none!important;pointer-events:none;min-height:0;padding:0}
.stat-card-blank::before{display:none}
.stat-card-blank:hover{transform:none;box-shadow:none}
.stat-card:hover{transform:translateY(-2px);box-shadow:var(--ch)}
.stat-label{font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--t3);font-weight:700;margin-bottom:.35rem}
.stat-value{font-size:1.9rem;font-weight:900;line-height:1;color:var(--sc);margin-bottom:.25rem}
.stat-subtitle{font-size:.76rem;font-weight:600;color:var(--t2)}
.stat-subtitle .stat-pct{font-size:.74rem;font-weight:700;color:var(--t3)}
.stat-breakdown{margin-top:.65rem;display:flex;flex-wrap:wrap;gap:.75rem 1.35rem}
.breakdown-item{display:inline-flex;align-items:baseline;gap:.35rem;font-size:.92rem;font-weight:700}
.breakdown-label{color:var(--t2);font-weight:700;font-size:.88rem}
.breakdown-value{color:var(--t1);font-size:1.05rem;font-weight:900}
.breakdown-value{font-weight:700;color:var(--t2)}

/* ═══════ FILTERS ════════════════════════════════════════════════════════ */
.filters-section{
  background:var(--bg-card);border:1px solid var(--border);border-radius:12px;
  padding:.9rem 1rem;margin-bottom:1rem;box-shadow:var(--cs);
}
.filters-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.65rem;margin-bottom:.65rem}
.filter-group{display:flex;flex-direction:column;gap:.25rem}
.filter-label{font-size:.68rem;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.05em}

/* Multi-select widget */
.ms-wrap{position:relative;z-index:auto}.ms-trigger{
  padding:.48rem .7rem;border-radius:8px;border:1px solid var(--border);
  background:var(--bg-input);color:var(--t1);font-size:.83rem;
  cursor:pointer;display:flex;align-items:center;justify-content:space-between;
  transition:border-color .18s,box-shadow .18s;user-select:none;
}
.ms-trigger:hover,.ms-trigger.open{border-color:var(--border-s);box-shadow:0 0 0 3px var(--glow)}
.ms-trigger svg{width:14px;height:14px;stroke:var(--t3);fill:none;stroke-width:2;transition:transform .2s;flex-shrink:0}
.ms-trigger.open svg{transform:rotate(180deg)}
.ms-dropdown{position:fixed;background:var(--bg-card);border:1px solid var(--border-s);border-radius:8px;max-height:230px;overflow-y:auto;z-index:99999;box-shadow:0 8px 32px rgba(0,0,0,.28);display:none;min-width:180px;}
.ms-dropdown.open{display:block}
.ms-option{
  padding:8px 14px;display:flex;align-items:center;gap:10px;cursor:pointer;
  font-size:.83rem;transition:background .15s;
}
.ms-option:hover{background:var(--bg-hover)}
.ms-option input[type=checkbox]{width:14px;height:14px;cursor:pointer;accent-color:var(--acc)}
.ms-option label{cursor:pointer;flex:1;color:var(--t1)}
.filter-actions{display:flex;gap:.5rem;justify-content:flex-end}

/* ═══════ BUTTONS ════════════════════════════════════════════════════════ */
.export-btn{
  padding:.5rem 1rem;border-radius:8px;font-size:.82rem;font-weight:700;cursor:pointer;
  display:inline-flex;align-items:center;gap:.35rem;transition:all .2s;border:none;
  background:var(--grad);color:#fff;box-shadow:0 2px 10px var(--glow);white-space:nowrap;
}
.export-btn:hover{box-shadow:0 4px 16px var(--glow);transform:translateY(-1px)}
.export-btn svg{width:14px;height:14px;stroke:#fff;fill:none;stroke-width:2}
.reset-btn{
  padding:.5rem 1rem;border-radius:8px;font-size:.82rem;font-weight:600;cursor:pointer;
  display:inline-flex;align-items:center;gap:.35rem;transition:all .2s;
  background:var(--bg-input);color:var(--t1);border:1px solid var(--border);white-space:nowrap;
}
.reset-btn:hover{border-color:var(--border-s)}
.reset-btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2}

/* ═══════ HD / AD TILES (= LM TILES from SM) ════════════════════════════ */
.hd-section,.ad-section{margin-bottom:1rem}
.hd-grid,.ad-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1rem}
.lm-tile .lm-progress-section{
  border-top: 1px solid var(--border);
  margin-top:.55rem;
  padding-top:.45rem;
}
.lm-tile{
  background:var(--bg-card);border:1px solid var(--border);border-radius:13px;
  padding:1.15rem 1.2rem;min-height:300px;cursor:pointer;transition:all .2s;box-shadow:var(--cs);
  position:relative;overflow:hidden;
}
.lm-tile::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--grad)}
.lm-tile:hover{transform:translateY(-2px);box-shadow:var(--ch);border-color:var(--border-s)}
.lm-tile.selected{border-color:var(--nab2);background:var(--nab)}
.lm-header{display:flex;flex-direction:column;gap:.15rem;margin-bottom:.6rem}
.lm-header h3{font-size:1rem;font-weight:800;color:var(--t1);line-height:1.25}
.lm-meta{font-size:.74rem;color:var(--t3);font-weight:600}
.lm-stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65rem;margin-bottom:.75rem}
.lm-stat-box{background:var(--bg-secondary);border-radius:8px;padding:.65rem .75rem;border:1px solid var(--border)}
.lm-stat-label{font-size:.72rem;text-transform:uppercase;color:var(--t3);margin-bottom:.18rem;font-weight:700}
.lm-stat-value{font-size:1.25rem;font-weight:900;color:var(--sc)}
.lm-revenue{border-radius:10px;padding:.85rem .95rem;background:var(--grad);color:#fff;margin-bottom:.65rem}
.lm-revenue-label{font-size:.72rem;text-transform:uppercase;opacity:.92;font-weight:700;margin-bottom:.2rem}
.lm-revenue-count{font-size:1.15rem;font-weight:900;margin-bottom:.35rem}
.lm-status-grid{display:grid;grid-template-columns:1fr 1fr;gap:.55rem .9rem;font-size:.92rem;margin-bottom:.75rem}
.lm-status-lbl{opacity:.95;font-weight:700;color:#fff}
.lm-status-val{color:#fff;font-size:1.05rem;font-weight:900}
.lm-status-val.won{color:#bbf7d0}
.lm-status-val.lost{color:#fecaca}
.lm-revenue-breakdown{display:flex;flex-direction:column;gap:.35rem;margin-top:.15rem}
.lm-revenue-item{display:flex;justify-content:space-between;align-items:center}
.lm-revenue-item-label{font-size:.82rem;opacity:.95;font-weight:700;color:#fff}
.lm-revenue-item-value{font-size:1rem;font-weight:800;color:#fff}
.lm-progress-section{margin-top:.45rem}
.lm-progress-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:.12rem}
.lm-progress-label,.lm-progress-value{font-size:.76rem;color:var(--t2)}
.lm-progress-value{font-weight:700}
.progress-bar{background:var(--bg-secondary);border-radius:20px;height:5px;overflow:hidden;margin-bottom:.4rem}
.progress-fill{height:100%;border-radius:20px;background:var(--grad);transition:width .5s ease}

/* ═══════ AM ROWS (= SM ROWS from SM) ═══════════════════════════════════ */
.am-section{margin-bottom:1rem}
.manager-list{display:flex;flex-direction:column;gap:.55rem}
.manager-row{
  background:var(--bg-card);border:1px solid var(--border);border-radius:11px;
  padding:.75rem 1rem;display:flex;align-items:center;flex-wrap:wrap;gap:.85rem;
  box-shadow:var(--cs);transition:all .18s;cursor:pointer;
}
.manager-row:hover{border-color:var(--border-s);transform:translateX(2px)}
.manager-row.selected{border-color:var(--nab2);background:var(--nab)}
.rank-badge{
  width:30px;height:30px;border-radius:50%;display:flex;align-items:center;
  justify-content:center;font-weight:900;font-size:.76rem;color:#fff;flex-shrink:0;
}
.rank-badge.rank-1{background:var(--grad);box-shadow:0 0 10px var(--glow)}
.rank-badge.rank-2{background:linear-gradient(135deg,#94a3b8,#64748b)}
.rank-badge.rank-3{background:linear-gradient(135deg,#c2853b,#d97706)}
.rank-badge.rank-other{background:var(--bg-secondary);color:var(--t3);border:1px solid var(--border)}
.manager-name-col{flex:0 0 140px;min-width:0}
.manager-name{font-weight:700;font-size:.86rem;color:var(--t1);margin-bottom:.15rem}
.manager-tag{
  display:inline-block;padding:.15rem .5rem;border-radius:5px;font-size:.65rem;font-weight:700;
  background:var(--chip);color:var(--acc);border:1px solid var(--nab2);
}
.stat-col{display:flex;flex-direction:column;min-width:70px}
.stat-col .stat-label{font-size:.62rem;color:var(--t3);font-weight:600;text-transform:uppercase;letter-spacing:.04em;margin-bottom:.15rem}
.stat-col .stat-value{font-size:.82rem;font-weight:700;color:var(--t1)}
.progress-bar-col{flex:1;min-width:120px;max-width:200px}
.progress-label{font-size:.67rem;color:var(--t3);margin-bottom:.12rem}

/* ═══════ CHARTS ════════════════════════════════════════════════════════ */
.charts-section{display:grid;grid-template-columns:repeat(2,1fr);gap:.85rem;margin-bottom:1rem}
.charts-section.charts-3{grid-template-columns:repeat(3,1fr)}
.chart-card{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:1rem;box-shadow:var(--cs)}
.chart-card.span2{grid-column:span 2}
.chart-title{font-size:.8rem;font-weight:700;color:var(--t2);margin-bottom:.65rem;display:flex;align-items:center;gap:.35rem}
.chart-title svg{width:16px;height:16px;stroke:var(--acc);fill:none;stroke-width:2}
.chart-container{position:relative;height:260px}
.mq-bridge-controls{background:var(--bg-secondary);border:1px solid var(--border);border-radius:12px;padding:.85rem 1rem;margin-bottom:.85rem}
.mq-controls-toolbar{display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:.45rem}
.mq-controls-toolbar .section-title{margin:0;flex:1 1 auto}
.mq-controls-toggle-btn{display:inline-flex;align-items:center;gap:.35rem;padding:.38rem .75rem;border-radius:8px;border:1px solid var(--border);background:var(--bg-card);color:var(--t2);font-size:.72rem;font-weight:700;cursor:pointer;font-family:inherit;transition:background .15s,border-color .15s;flex-shrink:0}
.mq-controls-toggle-btn:hover{background:var(--bg-hover);border-color:var(--border-s);color:var(--t1)}
.mq-controls-toggle-btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.5;transition:transform .2s ease;flex-shrink:0}
.mq-controls-toggle-btn.collapsed svg{transform:rotate(-90deg)}
#mqControlsPanel{overflow:hidden;transition:max-height .28s ease,opacity .22s ease,margin .22s ease}
#mqControlsPanel.collapsed{max-height:0!important;opacity:0;margin:0!important;pointer-events:none}
#mqControlsPanel:not(.collapsed){max-height:3200px;opacity:1}
.mq-bridge-state{display:flex;align-items:center;flex-wrap:wrap;gap:.35rem;margin-bottom:.75rem;padding:.55rem .75rem;background:var(--bg-card);border:1px solid var(--border);border-radius:9px;font-size:.76rem;font-weight:700;color:var(--t2)}
.mq-state-chip{padding:.2rem .55rem;border-radius:6px;background:var(--nab);color:var(--acc);font-weight:800}
.mq-state-sep{color:var(--t3);font-weight:600}
.mq-control-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:.75rem}
.mq-control-block{display:flex;flex-direction:column;gap:.35rem;padding:.65rem .75rem;background:var(--bg-card);border:1px solid var(--border);border-radius:10px}
.mq-control-head{display:flex;align-items:center;gap:.45rem}
.mq-control-step{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;background:var(--grad);color:#fff;font-size:.62rem;font-weight:800;flex-shrink:0}
.mq-control-label{font-size:.72rem;font-weight:800;color:var(--t1);text-transform:uppercase;letter-spacing:.04em;flex:1}
.mq-info-btn{
  width:20px;height:20px;border-radius:50%;border:1px solid var(--border-s);background:var(--nab);
  color:var(--acc);font-size:.62rem;font-weight:800;cursor:pointer;line-height:1;padding:0;flex-shrink:0;
  display:inline-flex;align-items:center;justify-content:center;font-family:inherit;
}
.mq-info-btn:hover{background:var(--bg-hover);border-color:var(--acc)}
.mq-field-info-pop{
  position:fixed;z-index:2147483640;max-width:320px;padding:.65rem .8rem;background:var(--bg-card);
  border:1px solid var(--border-s);border-radius:10px;box-shadow:0 12px 40px rgba(0,0,0,.22);
  font-size:.72rem;line-height:1.55;color:var(--t2);font-weight:600;display:none;
}
.mq-field-info-pop.open{display:block}
.mq-control-tabs{display:flex;gap:.35rem;flex-wrap:wrap}
.mq-control-tabs .pf-tab{flex:1;min-width:88px;text-align:center}
.mq-control-tabs .pf-tab:disabled{opacity:.45;cursor:not-allowed;pointer-events:none}
.mq-soon-tag{display:inline-block;margin-left:.3rem;padding:0 .3rem;border-radius:5px;background:var(--border-s);color:var(--t3);font-size:.56rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em;vertical-align:middle}
.mq-control-hint{font-size:.66rem;color:var(--t3);line-height:1.45;font-weight:600;margin-top:.1rem}
.mq-bridge-scroll{overflow-x:auto;overflow-y:visible;margin:0 -.15rem;padding:0 .15rem .15rem;border-radius:10px}
.mq-bridge-scroll::-webkit-scrollbar{height:8px}
.mq-bridge-scroll::-webkit-scrollbar-thumb{background:var(--border-s);border-radius:4px}
#mqChartOuter{display:flex;flex-direction:column;min-width:100%}
#mqChartWrap{position:relative;height:340px;min-width:100%;flex-shrink:0}
#mqChartWrap canvas{display:block;width:100%!important;height:100%!important}
#mqVertOnChart{position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none;overflow:visible;z-index:3}
.mq-v-onbar{position:absolute;transform:translateX(-50%);pointer-events:auto;cursor:pointer;z-index:4}
.mq-v-onbar .mq-v-stack{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:0;line-height:1;background:#fff;border:1px solid rgba(15,23,42,.35);border-radius:5px;padding:3px 5px;box-shadow:0 1px 4px rgba(15,23,42,.25)}
.mq-v-onbar .mq-v-ch{display:block;font-size:10px;font-weight:800;font-family:Inter,system-ui,-apple-system,sans-serif;color:#0f172a;line-height:1.05;letter-spacing:.04em}
#mqHdLegend{display:none}
#mqBracketRow{position:relative;height:20px;margin-top:2px;min-height:18px;flex-shrink:0}
.mq-bracket-abs{position:absolute;top:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;height:20px;pointer-events:none}
.mq-bracket-line{display:block;width:calc(100% - 4px);height:0;border-top:1.5px solid rgba(100,116,139,.55);margin-top:10px}
.mq-bracket-gross .mq-bracket-label{font-size:10px;font-weight:800;color:#1d4ed8;line-height:1.2;text-align:center;padding:0 3px;white-space:nowrap}
.mq-bracket-churn .mq-bracket-label{font-size:10px;font-weight:800;color:#dc2626;line-height:1.2;text-align:center;padding:0 3px;white-space:nowrap}
.mq-x-prod{
  display:inline-block;margin-top:3px;padding:1px 5px;border-radius:4px;
  font-size:8px;font-weight:800;letter-spacing:.04em;line-height:1.2;text-transform:uppercase;
  background:rgba(99,102,241,.12);color:#4338ca;border:1px solid rgba(99,102,241,.28);
}
.mq-x-prod.corporate{background:rgba(234,88,12,.12);color:#c2410c;border-color:rgba(234,88,12,.32)}
.mq-x-prod.m2m{background:rgba(13,148,136,.12);color:#0f766e;border-color:rgba(13,148,136,.32)}
.mq-prod-onbar{
  position:absolute;transform:translateX(-50%);pointer-events:none;z-index:5;
  font-size:8px;font-weight:800;letter-spacing:.04em;line-height:1;text-transform:uppercase;
  padding:2px 4px;border-radius:4px;background:#fff;box-shadow:0 1px 3px rgba(15,23,42,.2);
  border:1px solid rgba(99,102,241,.35);color:#4338ca;white-space:nowrap;
}
.mq-prod-onbar.corporate{border-color:rgba(234,88,12,.4);color:#c2410c}
.mq-prod-onbar.m2m{border-color:rgba(13,148,136,.4);color:#0f766e}
.mq-bracket-gross .mq-bracket-line{border-top-color:rgba(29,78,216,.65)}
.mq-bracket-churn .mq-bracket-line{border-top-color:rgba(220,38,38,.65)}
#mqXAxisStrip{position:relative;height:52px;margin-top:4px;padding-bottom:2px;min-height:48px;flex-shrink:0}
.mq-x-abs{position:absolute;top:0;text-align:center;font-size:11px;font-weight:600;color:var(--t2);line-height:1.4;padding:0 5px;word-break:break-word;hyphens:auto;cursor:pointer;transition:color .15s,background .15s;box-sizing:border-box}
.mq-v-onbar.sel .mq-v-ch{color:#4338ca}
.mq-v-onbar.sel .mq-v-stack{border-color:rgba(99,102,241,.55);background:rgba(238,242,255,.97)}
.mq-x-abs:hover{color:var(--acc);background:var(--nab)}
.mq-x-abs.sel{color:var(--acc);font-weight:800;background:var(--nab);border:1px solid var(--nab2);border-radius:4px}
.mq-x-abs.growth-lbl{color:#22c55e;font-weight:700}
.mq-x-abs.gap-lbl{color:#ef4444;font-weight:700}
#mqBridgeLegend{display:flex;flex-wrap:wrap;gap:.4rem .75rem;margin-top:.55rem;padding:.55rem .7rem;border-top:1px solid var(--border);background:var(--bg-secondary);border-radius:8px}
.mq-leg-chip{display:inline-flex;align-items:center;gap:.35rem;font-size:.72rem;font-weight:600;color:var(--t2)}
.mq-leg-dot{width:10px;height:10px;border-radius:3px;flex-shrink:0}
#mqBarDetailHint{display:none}
#mobileQtdSummaryWrap{font-size:.84rem;color:var(--t2);font-weight:600;line-height:1.65;margin-top:.55rem;padding:.55rem .75rem;background:var(--bg-secondary);border:1px solid var(--border);border-radius:8px}
#mqBarDetailPanel{max-height:min(70vh,620px)!important;font-size:.82rem!important;line-height:1.65!important;padding:.9rem 1.1rem!important}
.mq-detail-account{cursor:pointer;padding:.7rem .85rem;border:1px solid var(--border);border-radius:9px;margin-bottom:.55rem;background:var(--bg-card);transition:background .15s,border-color .15s}
.mq-detail-account-hdr{display:flex;justify-content:space-between;gap:.65rem;align-items:flex-start;font-size:.84rem;font-weight:700;color:var(--t1);line-height:1.45}
.mq-detail-account-sub{font-size:.78rem;color:var(--t2);font-weight:600;margin-top:.35rem;line-height:1.6}
.mq-calc-box{margin-top:.5rem;padding:.6rem .75rem;background:var(--bg-secondary);border:1px dashed var(--border);border-radius:8px;font-size:.78rem;line-height:1.7;color:var(--t2)}
.mq-full-row{margin-top:.5rem;padding:.65rem .8rem;background:var(--bg-secondary);border-radius:8px;font-size:.76rem;line-height:1.65}
.mq-full-row dt{float:left;clear:left;width:42%;color:var(--t3);font-weight:700;margin:0 0 .28rem;font-size:.74rem}
.mq-full-row dd{margin:0 0 .28rem 44%;color:var(--t1);font-weight:600;font-size:.76rem}
.mq-calc-box strong{color:var(--acc)}
.mq-detail-account:hover{border-color:var(--acc);background:var(--nab)}
.mq-detail-account.open{border-color:var(--acc);box-shadow:0 0 0 1px var(--nab2)}
.mq-detail-toolbar{display:flex;flex-wrap:wrap;gap:.45rem .65rem;align-items:center;margin:.5rem 0 .65rem;padding:.55rem .65rem;background:var(--bg-card);border:1px solid var(--border);border-radius:9px}
.mq-detail-toolbar input,.mq-detail-toolbar select{padding:.35rem .55rem;border-radius:7px;border:1px solid var(--border);background:var(--bg-secondary);color:var(--t1);font-size:.78rem;font-weight:600;min-width:120px}
.mq-detail-open-form{display:inline-flex;align-items:center;gap:.25rem;padding:.28rem .55rem;border-radius:6px;border:1px solid var(--acc);background:var(--nab);color:var(--acc);font-size:.72rem;font-weight:700;text-decoration:none;margin-top:.35rem}
.mq-detail-open-form:hover{background:var(--acc);color:#fff}
.mq-bid-table-wrap{overflow-x:auto;margin:.55rem 0;border:1px solid var(--border);border-radius:9px;background:var(--bg-card)}
.mq-bid-table{width:100%;border-collapse:collapse;font-size:.74rem;min-width:960px}
.mq-bid-table th{font-weight:800;text-align:left;padding:.5rem .6rem;background:var(--bg-secondary);border-bottom:2px solid var(--border-s);white-space:nowrap;color:var(--t1);font-size:.72rem;text-transform:uppercase;letter-spacing:.03em}
.mq-bid-table td{padding:.45rem .6rem;border-bottom:1px solid var(--border);vertical-align:top;color:var(--t1);font-weight:600;line-height:1.45}
.mq-bid-table tbody tr:hover td{background:var(--nab)}
.mq-bid-table .mq-ref-cell{font-family:ui-monospace,monospace;font-size:.68rem;word-break:break-all;max-width:240px;min-width:180px}
.mq-bid-table .mq-sp-link a{color:var(--acc);font-weight:800;text-decoration:none;white-space:nowrap}
.mq-acct-card{border:1px solid var(--border);border-radius:10px;background:var(--bg-card);padding:.75rem .9rem;margin-bottom:.65rem}
.mq-acct-card-hdr{display:flex;justify-content:space-between;align-items:flex-start;gap:.75rem;flex-wrap:wrap;margin-bottom:.55rem}
.mq-acct-card-hdr h4{margin:0;font-size:.84rem;font-weight:800;color:var(--t1)}
.mq-acct-kv{display:grid;grid-template-columns:minmax(130px,22%) 1fr;gap:.28rem .65rem;font-size:.76rem;line-height:1.55;margin-bottom:.45rem}
.mq-acct-kv dt{font-weight:800;color:var(--t3);margin:0}
.mq-acct-kv dd{margin:0;font-weight:600;color:var(--t1);word-break:break-word}
.mq-acct-ref{font-family:ui-monospace,monospace;font-size:.72rem;word-break:break-all;color:var(--t1);font-weight:700}
.mq-acct-details summary{cursor:pointer;font-size:.72rem;font-weight:700;color:var(--acc);margin-top:.35rem}
.mq-overdue-panel-hdr{display:flex;justify-content:space-between;align-items:center;gap:.65rem;flex-wrap:wrap;margin-bottom:.45rem}
.mq-overdue-panel-hdr strong{color:#dc2626;font-size:.82rem}
#mqOverdueGrid{height:440px;width:100%;margin-top:.55rem}
.mq-search-table{margin-top:.35rem}
.mq-excluded-toggle{margin-top:.75rem;padding:.55rem .65rem;border:1px dashed rgba(245,158,11,.55);border-radius:8px;background:rgba(245,158,11,.05);cursor:pointer;font-size:.78rem;font-weight:700;color:#92400e}
.mq-excluded-body{margin-top:.45rem;display:none}
.mq-excluded-body.open{display:block}
.mq-leg-chip{display:inline-flex;align-items:center;gap:.35rem;font-size:.72rem;font-weight:600;color:var(--t2)}
.mq-info-section{margin-bottom:.75rem;padding-bottom:.65rem;border-bottom:1px solid var(--border)}
.mq-info-section:last-child{border-bottom:none;margin-bottom:0;padding-bottom:0}
.mq-info-section h4{margin:0 0 .35rem;font-size:.76rem;color:var(--acc)}

/* ═══════ TABLE SECTION ═════════════════════════════════════════════════ */
.table-section{
  background:var(--bg-card);border:1px solid var(--border);border-radius:12px;
  padding:1rem 1.1rem;margin-bottom:1rem;box-shadow:var(--cs);
}
.table-header{
  display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;
  gap:.65rem;margin-bottom:.85rem;
}
.table-title{font-size:.9rem;font-weight:800;color:var(--t1);display:flex;align-items:center;gap:.35rem;margin:0!important}
.table-title svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2}
.table-actions{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}
.search-box{
  padding:.45rem .75rem;border-radius:8px;border:1px solid var(--border);
  background:var(--bg-input);color:var(--t1);font-size:.82rem;min-width:180px;transition:border-color .18s;
}
.search-box:focus{outline:none;border-color:var(--border-s)}
.search-box::placeholder{color:var(--t3)}

/* ═══════ STATUS BADGES ═════════════════════════════════════════════════ */
.status-badge{
  display:inline-block;padding:.18rem .55rem;border-radius:20px;font-size:.68rem;
  font-weight:700;text-transform:uppercase;letter-spacing:.04em;
}
.badge-success{background:rgba(22,163,74,.12);color:#16a34a;border:1px solid rgba(22,163,74,.28)}
.badge-warning{background:rgba(245,158,11,.12);color:#b45309;border:1px solid rgba(245,158,11,.28)}
.badge-danger{background:rgba(220,38,38,.12);color:#dc2626;border:1px solid rgba(220,38,38,.28)}
.badge-info{background:rgba(37,99,235,.12);color:#2563eb;border:1px solid rgba(37,99,235,.28)}
body[data-theme="dark"] .badge-success,body[data-theme="duralux-dark"] .badge-success{
  background:rgba(34,197,94,.12);color:#22c55e;border-color:rgba(34,197,94,.25)
}
body[data-theme="dark"] .badge-warning,body[data-theme="duralux-dark"] .badge-warning{
  background:rgba(251,191,36,.12);color:#fbbf24;border-color:rgba(251,191,36,.25)
}

/* ═══════ AG GRID ════════════════════════════════════════════════════════ */
.ag-theme-alpine .ag-root-wrapper{background:var(--bg-card)!important;border-color:var(--border)!important;border-radius:10px!important;overflow:hidden!important}
.ag-theme-alpine .ag-header,.ag-theme-alpine .ag-header-row,.ag-theme-alpine .ag-header-viewport,.ag-theme-alpine .ag-pinned-left-header,.ag-theme-alpine .ag-pinned-right-header{background:var(--bg-secondary)!important;border-bottom:2px solid var(--border-s)!important}
.ag-theme-alpine .ag-header-cell{background:var(--bg-secondary)!important;color:var(--t1)!important;font-weight:700!important;font-size:.71rem!important;text-transform:uppercase!important;letter-spacing:.04em!important}
.ag-theme-alpine .ag-header-cell-text,.ag-theme-alpine .ag-header-cell-label{color:var(--t1)!important;font-weight:700!important}
.ag-theme-alpine .ag-icon{color:var(--t3)!important}
.ag-theme-alpine .ag-body-viewport,.ag-theme-alpine .ag-center-cols-viewport,.ag-theme-alpine .ag-pinned-left-cols-container,.ag-theme-alpine .ag-pinned-right-cols-container{background:var(--bg-card)!important}
.ag-theme-alpine .ag-row{background:var(--bg-card)!important;color:var(--t1)!important;border-bottom-color:var(--border)!important}
.ag-theme-alpine .ag-row-odd{background:var(--bg-secondary)!important}
.ag-theme-alpine .ag-row-hover,.ag-theme-alpine .ag-row-hover.ag-row-even,.ag-theme-alpine .ag-row-hover.ag-row-odd{background:var(--bg-hover)!important}
.ag-theme-alpine .ag-cell{color:var(--t1)!important}
.ag-theme-alpine .ag-paging-panel{background:var(--bg-card)!important;color:var(--t1)!important;border-top-color:var(--border)!important}
.ag-theme-alpine .ag-menu,.ag-theme-alpine .ag-filter,.ag-theme-alpine .ag-filter-body-wrapper{background:var(--bg-card)!important;color:var(--t1)!important;border-color:var(--border)!important}
.ag-theme-alpine input.ag-input-field-input{background:var(--bg-input)!important;color:var(--t1)!important;border-color:var(--border)!important}

/* ═══════ LANDING ════════════════════════════════════════════════════════ */
.landing-page{min-height:100vh;display:flex!important;flex-direction:row!important;background:var(--bg-body);position:relative;overflow:hidden}
.landing-bg-gradient{position:absolute;inset:0;background:radial-gradient(ellipse 70% 55% at 15% 20%,rgba(168,85,247,.14),transparent 55%),radial-gradient(ellipse 60% 50% at 85% 75%,rgba(99,102,241,.1),transparent 50%);pointer-events:none;z-index:0}
.landing-left,.landing-right{flex:1!important;display:flex!important;align-items:center!important;justify-content:center!important;padding:2rem!important;min-width:0!important;position:relative;z-index:1}
.landing-container{width:100%;max-width:420px}
.landing-card{background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:1.4rem;box-shadow:var(--cs);margin-bottom:1rem}
.landing-header{text-align:center;margin-bottom:1.4rem}
.landing-logo{display:flex;justify-content:center;margin-bottom:.85rem}
.logo-icon{
  width:60px;height:60px;border-radius:15px;background:var(--grad);
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 0 24px var(--glow);overflow:hidden;
}
.logo-icon img{width:48px;height:48px;object-fit:contain}
.landing-title{font-size:1.4rem;font-weight:800;color:var(--t1);margin-bottom:.25rem}
.landing-subtitle{font-size:.82rem;color:var(--t3)}
.welcome-badge{
  display:inline-flex;align-items:center;gap:.35rem;padding:.25rem .7rem;border-radius:20px;
  background:var(--nab);border:1px solid var(--nab2);font-size:.75rem;font-weight:600;color:var(--acc);margin-bottom:.75rem;
}
.badge-pulse{width:6px;height:6px;border-radius:50%;background:var(--acc);animation:pulseDot 2s infinite}
.landing-user-info{display:flex;align-items:center;gap:.8rem}
.landing-avatar{position:relative;width:48px;height:48px;flex-shrink:0}
.avatar-ring{position:absolute;inset:0;border-radius:50%;border:2px solid var(--acc);opacity:.5}
.avatar-placeholder{width:48px;height:48px;border-radius:50%;background:var(--grad);display:flex;align-items:center;justify-content:center;font-size:1rem;font-weight:800;color:#fff}
.landing-details h3{font-size:.95rem;font-weight:700;color:var(--t1)}
.landing-details p{font-size:.77rem;color:var(--t3)}
.landing-role{display:inline-block;margin-top:.25rem;padding:.17rem .55rem;border-radius:5px;font-size:.7rem;font-weight:600;background:var(--chip);color:var(--acc);border:1px solid var(--border)}
.landing-stats-container{margin:.9rem 0}
.stats-grid{display:grid;grid-template-columns:1fr;gap:.55rem}
.landing-stat-card{background:var(--bg-secondary);border:1px solid var(--border);border-radius:10px;padding:.7rem;display:flex;gap:.55rem;align-items:center}
.stat-icon-wrapper{position:relative;width:34px;height:34px;flex-shrink:0}
.stat-icon-bg{position:absolute;inset:0;border-radius:7px;background:var(--grad);opacity:.15}
.stat-icon{width:18px;height:18px;position:relative;margin:8px;stroke:var(--acc);fill:none;stroke-width:2}
.stat-content{flex:1;min-width:0}
.stat-mini{display:flex;align-items:center;gap:.3rem;font-size:.72rem;color:var(--t3)}
.stats-secondary{display:flex;justify-content:center;gap:1.25rem;margin-top:.65rem}
.landing-actions{margin-top:.9rem}
.landing-btn{
  width:100%;padding:.72rem;border-radius:11px;font-size:.88rem;font-weight:700;cursor:pointer;border:none;
  transition:all .2s;display:flex;align-items:center;justify-content:center;gap:.45rem;position:relative;overflow:hidden;
}
.btn-primary-enhanced{background:var(--grad);color:#fff;box-shadow:0 3px 14px var(--glow)}
.btn-primary-enhanced:hover{box-shadow:0 5px 20px var(--glow);transform:translateY(-1px)}
.btn-primary-enhanced:disabled{opacity:.5;cursor:not-allowed;transform:none}
.btn-shine{position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.15),transparent);transition:left .5s}
.landing-btn:hover .btn-shine{left:100%}
.btn-icon svg{width:20px;height:20px;stroke:#fff;fill:none;stroke-width:2}
.landing-note{display:flex;align-items:flex-start;gap:.35rem;margin-top:.6rem;font-size:.74rem;color:var(--t3)}
.landing-note svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;flex-shrink:0;margin-top:1px}
.landing-footer{text-align:center;font-size:.72rem;color:var(--t3);margin-top:.4rem}
.landing-branding{max-width:440px}
.landing-brand-title{font-size:2rem;font-weight:900;line-height:1.15;color:var(--t1);letter-spacing:-.02em}
.landing-brand-title span{background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.gradient-text{background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.landing-brand-subtitle{font-size:.88rem;font-weight:600;color:var(--t2);margin-top:.55rem;line-height:1.45}
.landing-brand-intro{font-size:.8rem;color:var(--t3);margin-top:.5rem;line-height:1.6;max-width:400px}
.live-badge{display:inline-flex;align-items:center;gap:.35rem;padding:.22rem .65rem;border-radius:20px;background:rgba(22,163,74,.12);border:1px solid rgba(22,163,74,.28);font-size:.72rem;font-weight:700;color:#16a34a;margin-top:.65rem}
body[data-theme="dark"] .live-badge,body[data-theme="duralux-dark"] .live-badge{background:rgba(34,197,94,.1);border-color:rgba(34,197,94,.25);color:#22c55e}
.landing-features{margin-top:1.3rem;display:flex;flex-direction:column;gap:.7rem}
.landing-feature{display:flex;align-items:flex-start;gap:.65rem}
.landing-feature-icon{
  width:34px;height:34px;border-radius:9px;flex-shrink:0;background:var(--nab);
  border:1px solid var(--nab2);display:flex;align-items:center;justify-content:center;color:var(--acc);
}
.landing-feature-icon svg{width:18px;height:18px;stroke:var(--acc);fill:none;stroke-width:2}
.landing-feature-title{font-weight:700;font-size:.86rem;color:var(--t1)}
.landing-feature-desc{font-size:.76rem;color:var(--t3);margin-top:.12rem}

/* Console login (dev mode) */
.dev-console{
  position:fixed;bottom:12px;right:12px;z-index:9999;
  background:var(--bg-card);border:1px solid var(--border);border-radius:10px;
  padding:.65rem .9rem;display:flex;align-items:center;gap:.5rem;
  box-shadow:var(--cs);font-size:.75rem;
}
.dev-console input{
  padding:.3rem .6rem;border-radius:6px;border:1px solid var(--border);
  background:var(--bg-input);color:var(--t1);font-size:.75rem;width:200px;
}
.dev-console button{
  padding:.3rem .7rem;border-radius:6px;background:var(--grad);color:#fff;
  border:none;font-size:.74rem;font-weight:700;cursor:pointer;
}
.dev-console-label{font-size:.68rem;color:var(--t3);font-weight:600;text-transform:uppercase;letter-spacing:.04em}

/* Animate in */
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes slideUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
@keyframes spin{to{transform:rotate(360deg)}}
.animate-fade-in{animation:fadeIn .55s ease forwards}
.animate-slide-up{animation:slideUp .7s ease forwards}

/* Responsive */
@media(max-width:1200px){
  .charts-section.charts-3{grid-template-columns:repeat(2,1fr)}
  .chart-card.span2{grid-column:span 1}
}
@media(max-width:900px){.charts-section{grid-template-columns:1fr}}
@media(max-width:768px){
  .sidebar{width:180px;min-width:180px}
  .landing-page{flex-direction:column!important}
  .top-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:.85rem;margin-bottom:1rem}
}
.stat-detail{
  position:fixed;
  background:var(--bg-card)!important;
  border:1px solid var(--border-s);
  border-radius:12px;
  padding:.85rem 1rem;
  box-shadow:0 12px 40px rgba(0,0,0,.25);
  z-index:999999;
  width:250px;
  font-size:.75rem;
  line-height:1.7;
  opacity:0;
  pointer-events:none;
  transition:opacity .2s;
}
.stat-detail.visible{opacity:1!important;pointer-events:auto}
.stat-card{overflow:visible!important;z-index:1;}
.stat-card:hover{z-index:10;}
.stat-detail{
  position:fixed!important;
  background:var(--bg-card);border:1px solid var(--border-s);border-radius:10px;
  padding:.75rem 1rem;box-shadow:0 8px 32px rgba(0,0,0,.28);
  z-index:999999;min-width:230px;max-width:280px;font-size:.75rem;line-height:1.65;
  opacity:0;pointer-events:none;transition:opacity .18s;white-space:normal;
  top:0;left:0;
}
.stat-eye{position:absolute;top:8px;right:8px;width:22px;height:22px;border-radius:50%;background:var(--bg-secondary);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .18s;z-index:2;}
.stat-eye:hover{border-color:var(--border-s);background:var(--bg-hover)}
.stat-eye svg{width:13px;height:13px;stroke:var(--t3);fill:none;stroke-width:2;pointer-events:none}
.stat-eye.active svg{stroke:var(--acc)}.stat-eye{position:absolute;top:8px;right:8px;width:22px;height:22px;border-radius:50%;background:var(--bg-secondary);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .18s;z-index:2;}
.stat-eye:hover{border-color:var(--border-s);background:var(--bg-hover)}
.stat-eye svg{width:13px;height:13px;stroke:var(--t3);fill:none;stroke-width:2;pointer-events:none}
.stat-eye.active svg{stroke:var(--acc)}
.stat-detail-title{font-weight:800;font-size:.78rem;color:var(--t1);margin-bottom:.4rem;padding-bottom:.3rem;border-bottom:1px solid var(--border)}
.stat-detail-row{display:flex;justify-content:space-between;gap:.5rem;padding:.07rem 0}
.stat-detail-row span:first-child{color:var(--t3)}
.stat-detail-row span:last-child{font-weight:700;color:var(--t1)}
.stat-detail-note{margin-top:.4rem;font-size:.68rem;color:var(--t3);font-style:italic;border-top:1px solid var(--border);padding-top:.3rem}
.period-btn{
  padding:.2rem .55rem;border-radius:6px;font-size:.7rem;font-weight:600;
  background:var(--bg-secondary);border:1px solid var(--border);
  color:var(--t3);cursor:pointer;transition:all .15s;
}
.period-btn:hover{border-color:var(--border-s);color:var(--t1)}
.period-btn.active{background:var(--grad);border-color:transparent;color:#fff}
.pf-tab{
  padding:.45rem 1.2rem;border-radius:8px;font-size:.82rem;font-weight:700;
  background:var(--bg-card);border:2px solid var(--border);
  color:var(--t2);cursor:pointer;transition:all .18s;
}
.pf-tab:hover{border-color:var(--border-s);color:var(--t1)}
.pf-tab.active{background:var(--grad);border-color:transparent;color:#fff;box-shadow:0 2px 10px var(--glow)}
.status-tile-selected::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:#fff;opacity:.5}
.stat-card.tile-active{box-shadow:0 0 0 2px var(--acc),var(--ch)!important;transform:translateY(-2px)}

.stat-card.tile-dimmed{opacity:.38;transform:none!important;box-shadow:var(--cs)!important}
.lm-tile.selected::after{content:'✓ Selected';position:absolute;bottom:7px;right:10px;font-size:.62rem;font-weight:700;color:var(--acc);background:var(--nab);border:1px solid var(--nab2);padding:1px 7px;border-radius:20px;}
.stat-card.tile-active::after{content:'✓';position:absolute;top:6px;right:8px;font-size:.7rem;font-weight:900;color:var(--acc);}

/* Date filters inside main filters panel */
.filters-date-divider{font-size:.68rem;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.06em;margin:.75rem 0 .55rem;padding-top:.65rem;border-top:1px dashed var(--border)}
.filter-bar-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:.55rem .65rem;align-items:end}
.fb-group{display:flex;flex-direction:column;gap:.22rem}
.fb-group-label{font-size:.65rem;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.05em}
.fb-select{padding:.42rem .65rem;border-radius:8px;border:1px solid var(--border);background:var(--bg-input);color:var(--t1);font-size:.8rem;width:100%;cursor:pointer}
.glk-date-hint{font-size:.71rem;color:var(--t3);margin:.35rem 0 .5rem;line-height:1.4}
.glk-date-rule{border:1px dashed var(--border);border-radius:10px;padding:.65rem .75rem;margin-bottom:.55rem;background:var(--bg-secondary)}
.glk-rule-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem}
.glk-rule-title{font-size:.74rem;font-weight:800;color:var(--t1)}
.glk-rule-remove{padding:.2rem .55rem;border-radius:6px;font-size:.68rem;font-weight:700;background:rgba(220,38,38,.08);border:1px solid rgba(220,38,38,.25);color:#dc2626;cursor:pointer;border:none}
.glk-add-rule-btn{padding:.38rem .85rem;border-radius:8px;font-size:.76rem;font-weight:700;background:var(--nab);border:1px solid var(--nab2);color:var(--acc);cursor:pointer;margin-top:.35rem}
.glk-compare-row{display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;margin-top:.75rem;padding-top:.65rem;border-top:1px dashed var(--border)}
.glk-compare-toggle{display:flex;align-items:center;gap:.45rem;font-size:.78rem;font-weight:600;color:var(--t2);cursor:pointer;margin:0}
.glk-compare-toggle input{width:15px;height:15px;accent-color:var(--acc)}
.glk-compare-year-sel{max-width:110px;padding:.38rem .55rem!important}
.glk-compare-banner{display:none;grid-template-columns:1fr auto 1fr;gap:.85rem;align-items:stretch;margin-bottom:1rem;padding:.85rem 1rem;background:var(--bg-card);border:1px solid var(--border-s);border-radius:12px;box-shadow:var(--cs)}
.glk-compare-banner.visible{display:grid}
.glk-compare-col{padding:.65rem .75rem;border-radius:9px;background:var(--bg-secondary);border:1px solid var(--border)}
.glk-compare-col.primary{border-color:var(--nab2);background:var(--nab)}
.glk-compare-col-label{font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--t3);margin-bottom:.35rem}
.glk-compare-metric{display:flex;justify-content:space-between;gap:.5rem;font-size:.74rem;padding:.12rem 0}
.glk-compare-metric span:first-child{color:var(--t3)}
.glk-compare-metric span:last-child{font-weight:800;color:var(--t1)}
.glk-compare-vs{display:flex;align-items:center;justify-content:center;font-size:.82rem;font-weight:900;color:var(--acc)}
.glk-compare-delta{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:.5rem .85rem;padding-top:.55rem;border-top:1px solid var(--border);font-size:.72rem;font-weight:700;color:var(--t2)}
@media(max-width:900px){.glk-compare-banner.visible{grid-template-columns:1fr}.glk-compare-vs{padding:.35rem 0}}
</style>
</head>
<body>

<!-- ═══════ LANDING PAGE ══════════════════════════════════════════════ -->
<div id="landingPage" class="landing-page" style="display:none;">
  <div class="theme-toggle active-fs glk-fs-btn" id="glkLandingFsBtn" onclick="glkToggleFullscreen();return false;" title="Minimize">
    <svg id="glkLandingFsIcon" viewBox="0 0 24 24"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="14" y1="10" x2="21" y2="3"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
  </div>
  <div class="landing-bg-gradient"></div>
  <!-- LEFT — Branding -->
  <div class="landing-left animate-fade-in">
    <div class="landing-branding">
      <div class="landing-brand-icon">
        <img src="http://sharedspaces:8086/sites/GKA/SiteAssets/du.jpg" alt="du Logo">
      </div>
      <h1 class="landing-brand-title gradient-text">Sales Excellence &amp; Governance Portal</h1>
      <p class="landing-brand-subtitle">Executive portal for sales performance, pipeline visibility, and governance.</p>
      <p class="landing-brand-intro">A unified view for GLK leadership and sales teams — quarter performance, forecasts, pipeline movement, and deal quality in one place.</p>
      <span class="live-badge"><span class="badge-pulse"></span> Real-time data</span>
      <div class="landing-features">
        <div class="landing-feature">
          <div class="landing-feature-icon"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg></div>
          <div>
            <div class="landing-feature-title">Performance Bridge</div>
            <div class="landing-feature-desc">Quarter and year-to-date view of actuals, forecast, and gap to target</div>
          </div>
        </div>
        <div class="landing-feature">
          <div class="landing-feature-icon"><svg viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 8 12 3 7 8"/></svg></div>
          <div>
            <div class="landing-feature-title">Trends &amp; Live Pipeline</div>
            <div class="landing-feature-desc">Historical performance trends and live pipeline visibility across the sales hierarchy</div>
          </div>
        </div>
        <div class="landing-feature">
          <div class="landing-feature-icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></div>
          <div>
            <div class="landing-feature-title">Pipeline Governance</div>
            <div class="landing-feature-desc">Deal quality oversight, status discipline, and stale pipeline identification</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- RIGHT — Login Card -->
  <div class="landing-right">
    <div class="landing-container">
      <div class="landing-header animate-slide-up">
        <div class="landing-logo">
          <div class="logo-icon">
            <img src="http://sharedspaces:8086/sites/GKA/SiteAssets/du.jpg" alt="du Logo">
          </div>
        </div>
        <h1 class="landing-title">Welcome Back</h1>
        <p class="landing-subtitle">Sign in to access the portal</p>
      </div>

      <div class="landing-card animate-slide-up" style="animation-delay:.2s;">
        <div class="welcome-badge"><span class="badge-pulse"></span><span>Welcome Back</span></div>
        <div class="landing-user-info">
          <div class="landing-avatar">
            <div class="avatar-ring"></div>
            <div class="avatar-placeholder" id="lAvatar">?</div>
          </div>
          <div class="landing-details">
            <h3 id="lName">Loading...</h3>
            <p id="lEmail">Verifying access...</p>
            <p id="lRole" class="landing-role">—</p>
          </div>
        </div>

        <div class="landing-stats-container">
          <div class="stats-grid">
            <div class="landing-stat-card">
              <div class="stat-icon-wrapper">
                <div class="stat-icon-bg"></div>
                <svg class="stat-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div class="stat-content">
                <div class="stat-label">Last visit</div>
                <div class="stat-value" id="lLastVisit" style="font-size:.85rem;font-weight:800;color:var(--sc)">—</div>
              </div>
            </div>
          </div>
          <div class="stats-secondary">
            <div class="stat-mini"><svg style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Secure session</span></div>
            <div class="stat-mini"><svg style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg><span>Enterprise access</span></div>
          </div>
        </div>

        <div class="landing-actions">
          <button type="button" id="launchBtn" class="landing-btn btn-primary-enhanced" disabled>
            <span class="btn-icon"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg></span>
            <span class="btn-text">Verifying access...</span>
            <span class="btn-shine"></span>
          </button>
          <p class="landing-note" id="accessNote">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>Please wait while we verify your permissions...</span>
          </p>
        </div>
      </div>
      <div class="landing-footer animate-fade-in" style="animation-delay:.6s;">
        <p>Sales Excellence &amp; Governance Portal · GLK Enterprise</p>
      </div>
    </div>
  </div>
</div>

<!-- ═══════ PAGE LOAD SPINNER ═════════════════════════════════════════ -->
<div id="glkLoader">
  <div class="glk-spinner"></div>
  <div id="glkLoaderText">Loading your pipeline…</div>
</div>

<!-- ═══════ MAIN DASHBOARD ════════════════════════════════════════════ -->
<div class="portal-shell" id="dashboardContent" style="display:none;">
  <!-- Header -->
  <div class="header">
    <div class="logo-section">
      <div class="logo">
        <img src="http://sharedspaces:8086/sites/GKA/SiteAssets/du.jpg" alt="du Logo">
      </div>
      <span class="header-title">Sales Excellence &amp; Governance Portal</span>
    </div>
    <div class="header-center">
      <div class="live-badge-pill"><span class="status-dot"></span><span>Live</span></div>
      <div class="date-badge">
        <svg style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span id="currentDate">Loading...</span>
      </div>
<div class="date-badge" id="dbUserBadge" style="color:var(--acc);font-weight:600;">—</div>
<div class="date-badge" id="selectionBadge" style="color:var(--acc2);font-weight:600;display:none;"></div>
    </div>
    <div class="header-actions">
      <select class="color-scheme-selector" id="colorSchemeSelector" onchange="changeTheme(event)">
        <option value="magenta">&#9670; Magenta</option>
        <option value="duralux">&#9670; Duralux</option>
      </select>
      <div class="theme-toggle active-fs glk-fs-btn" id="glkFullscreenBtn" onclick="glkToggleFullscreen()" title="Minimize">
        <svg id="glkFullscreenIcon" viewBox="0 0 24 24"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="14" y1="10" x2="21" y2="3"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
      </div>
      <div class="theme-toggle" onclick="toggleTheme()" title="Light/Dark">
        <svg id="themeIcon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </div>
    </div>
  </div>

  <!-- Main Container -->
  <div class="main-container">
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar" style="position:relative;">
      <div class="sidebar-toggle-btn" id="sidebarToggleBtn" onclick="toggleSidebar()" title="Toggle Sidebar">
        <svg id="sidebarToggleIcon" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/><polyline points="9 18 3 12 9 6"/></svg>
      </div>
      <div class="nav-items">
       <div class="nav-section-label">Portal</div>
<div class="nav-item active" id="navDashboard" data-glk-nav="navDashboard" onclick="glkShowDashboard();return false;">
  <div class="nav-icon"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg></div>
  <div class="nav-label">Pipeline Dashboard</div>
</div>
<div class="nav-item" id="navMobileQtd" data-glk-nav="navMobileQtd" style="display:none;" onclick="glkShowMobileQtd();return false;">
  <div class="nav-icon"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg></div>
  <div class="nav-label">Performance Bridge</div>
</div>
<div class="nav-item" id="navRevenueRec" data-glk-nav="navRevenueRec" style="display:none;" onclick="glkShowRevenueRec();return false;">
  <div class="nav-icon"><svg viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 8 12 3 7 8"/></svg></div>
  <div class="nav-label">Trends</div>
</div>
<div class="nav-item" id="navGovernance" data-glk-nav="navGovernance" style="display:none;" onclick="glkShowGovernance();return false;">
  <div class="nav-icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></div>
  <div class="nav-label">Pipeline Governance</div>
</div>
      </div>
    </div>

    <!-- Content -->
    <div class="content">
      <div id="dashboard-view" class="dashboard-section">
        <div id="dashboardLoadingOverlay" class="dashboard-loading-overlay">
          <div class="glk-spinner"></div>
          <div id="dashboardLoadingText">Loading pipeline from SharePoint…</div>
        </div>
<!-- PRODUCT FAMILY TABS -->
        <div id="pfTabs" style="display:flex;gap:.5rem;margin-bottom:1rem;flex-wrap:wrap;">
          <button type="button" onclick="selectPF('Fixed')" id="pfBtn_Fixed" class="pf-tab active">Fixed</button>
          <button type="button" onclick="selectPF('Mobile')" id="pfBtn_Mobile" class="pf-tab">Mobile</button>
          <button type="button" onclick="selectPF('Broadcast')" id="pfBtn_Broadcast" class="pf-tab">Broadcast</button>
          <button type="button" onclick="selectPF('DataMena')" id="pfBtn_DataMena" class="pf-tab">DataMena</button>
        </div>
        <!-- TOP STAT TILES -->
        <div class="glk-compare-banner" id="glkCompareBanner"></div>
<div class="top-stats" id="topStats" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr))"></div>
        <!-- FILTERS -->
        <div class="filters-section">
          <div class="filters-grid" id="filtersGrid"></div>
          <div class="glk-compare-row" id="glkThisYearRow" style="margin-top:.65rem;">
            <label class="glk-compare-toggle">
              <input type="checkbox" id="glkThisYearToggle" checked onchange="glkToggleThisYear()">
              This year <span style="font-weight:400;color:var(--t3);">(Expected Activation · current year)</span>
            </label>
          </div>
          <div class="filters-date-divider">Date filters</div>
          <div id="glkDateRulesWrap"></div>
          <button type="button" class="glk-add-rule-btn" onclick="glkAddDateRule()">+ Add date criterion</button>
          <div class="glk-compare-row" id="glkCompareRow">
            <label class="glk-compare-toggle">
              <input type="checkbox" id="glkCompareToggle" onchange="glkToggleCompare()">
              Compare to another year <span style="font-weight:400;color:var(--t3);">(same filters &amp; date fields)</span>
            </label>
            <select id="glkCompareYear" class="fb-select glk-compare-year-sel" onchange="onDateFilterChange()" style="display:none;"></select>
          </div>
          <div class="filter-actions">
            <button type="button" class="reset-btn" onclick="resetAll()">
              <svg viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.95"/></svg>
              Reset All Filters
            </button>
          </div>
        </div>

        <!-- HEAD DIRECTOR TILES -->
        <div id="hd-section-nav">
          <h2 class="section-title">
            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Head Director Performance
            <span id="hdBadge" style="background:var(--nab);border:1px solid var(--nab2);color:var(--acc);padding:2px 10px;border-radius:20px;font-size:.75rem;font-weight:700;">0</span>
          </h2>
          <div class="hd-grid" id="hdGrid"></div>
        </div>

        <!-- ACCOUNT DIRECTOR TILES -->
        <div id="adSection" style="display:none;margin-top:1rem;">
          <h2 class="section-title">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a6 6 0 0 1 12 0v2"/></svg>
            Account Directors
            <span id="adBadge" style="background:var(--nab);border:1px solid var(--nab2);color:var(--acc);padding:2px 10px;border-radius:20px;font-size:.75rem;font-weight:700;">0</span>
            <span id="adContext" style="font-size:.78rem;color:var(--t3);font-weight:400;"></span>
          </h2>
          <div class="ad-grid" id="adGrid"></div>
        </div>

        <!-- ACCOUNT MANAGER ROWS -->
        <div id="amSection" style="display:none;margin-top:1rem;" class="am-section">
          <h2 class="section-title">
            <svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            Account Managers
            <span id="amBadge" style="background:var(--nab);border:1px solid var(--nab2);color:var(--acc);padding:2px 10px;border-radius:20px;font-size:.75rem;font-weight:700;">0</span>
            <span id="amContext" style="font-size:.78rem;color:var(--t3);font-weight:400;"></span>
          </h2>
          <div class="manager-list" id="amList"></div>
        </div>

        <!-- CHARTS -->
        <div id="charts-nav" style="margin-top:1rem;">
          <div style="text-align:center;margin-bottom:.85rem;">
            <button type="button" class="export-btn" onclick="toggleCharts()">
              <svg id="chartsToggleIcon" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="9" x2="9" y2="15"/><line x1="15" y1="6" x2="15" y2="15"/><line x1="12" y1="12" x2="12" y2="15"/></svg>
              <span id="chartsToggleText">Show Analytics Charts</span>
            </button>
          </div>
         <div id="chartsSection" style="display:none;">

            <!-- ROW 1: Revenue Trend full width -->
            <div style="display:grid;grid-template-columns:1fr;gap:.85rem;margin-bottom:.85rem;">
              <div class="chart-card">
                <div class="chart-title"><svg viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/></svg>Revenue Trend</div>
                <div class="chart-container" style="height:280px;"><canvas id="chartTrend"></canvas></div>
                <div id="trendControlsWrap"></div>
              </div>
            </div>

            <!-- ROW 2b: Forecast Pie full width -->
            <div style="display:grid;grid-template-columns:1fr;gap:.85rem;margin-bottom:.85rem;">
              <div class="chart-card">
                <div class="chart-title" style="justify-content:space-between;">
                  <span style="display:flex;flex-direction:column;gap:.15rem;">
                    <span style="display:flex;align-items:center;gap:.35rem;"><svg viewBox="0 0 24 24"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>Pipeline Mix</span>
                    <span style="font-size:.68rem;font-weight:600;color:var(--t3);">All opp. statuses · Lead / Opportunity / Proposed = forecast stages</span>
                  </span>
                </div>
                <div class="chart-container" style="height:380px;"><canvas id="chartForecastPie"></canvas></div>
                <div id="forecastPieControlsWrap"></div>
              </div>
            </div>

            <!-- ROW 2c: Forecast Bridge — hidden (replaced by Mobile QTD Bridge nav) -->
            <div id="bridgeSectionWrap" style="display:none!important;">
            <div style="display:grid;grid-template-columns:1fr;gap:.85rem;margin-bottom:.85rem;">
              <div class="chart-card">
                <div class="chart-title" style="justify-content:space-between;flex-wrap:wrap;gap:.5rem;">
                  <span style="display:flex;flex-direction:column;gap:.15rem;">
                    <span style="display:flex;align-items:center;gap:.35rem;"><svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>Forecast Bridge</span>
                    <span style="font-size:.68rem;font-weight:600;color:var(--t3);">Won+Billed → Top 10 in-forecast (asc) → Others → Gap vs Target · Best adds Out Forecast</span>
                  </span>
                  <div style="display:flex;align-items:center;gap:.45rem;flex-wrap:wrap;">
                    <label style="font-size:.72rem;color:var(--t2);font-weight:700;">Target (AED)</label>
                    <input type="number" id="bridgeTargetInp" value="10000000" min="0" step="100000" onchange="glkSetBridgeTarget(this.value)" style="width:120px;padding:.28rem .5rem;border-radius:6px;border:1px solid var(--border);background:var(--bg-input);color:var(--t1);font-size:.72rem;font-weight:700;">
                  </div>
                </div>
                <div class="chart-container" style="height:380px;"><canvas id="chartBridge"></canvas></div>
                <div id="bridgeControlsWrap"></div>
              </div>
            </div>
            </div><!-- /bridgeSectionWrap -->

            <!-- ROW 2: Billed/Lost/Pipeline (half) | TCV by Probability donut (half) -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:.85rem;margin-bottom:.85rem;">
              <div class="chart-card">
                <div class="chart-title"><svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>Billed / Lost / Pipeline</div>
                <div class="chart-container" style="height:300px;"><canvas id="chartWinLoss"></canvas></div>
              </div>
              <div class="chart-card">
                <div class="chart-title"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>TCV by Closure Probability</div>
                <div class="chart-container" style="height:300px;"><canvas id="chartProbTCV"></canvas></div>
              </div>
            </div>

            <!-- ROW 3: Leaderboard full width with metric toggle -->
            <div style="display:grid;grid-template-columns:1fr;gap:.85rem;margin-bottom:.85rem;">
              <div class="chart-card">
                <div class="chart-title" style="justify-content:space-between;">
                  <span style="display:flex;align-items:center;gap:.35rem;"><svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>Leaderboard</span>
                  <div style="display:flex;gap:.35rem;" id="lbMetricToggle"></div>
                </div>
                <div id="lbControlsWrap"></div>
                <div class="chart-container" style="height:420px;"><canvas id="chartLeaderboard"></canvas></div>
              </div>
            </div>

            
         

            <!-- ROW 4: Vertical Performance (half) | MRC/GA Trend (half) -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:.85rem;margin-bottom:.85rem;">
              <div class="chart-card">
                <div class="chart-title" style="justify-content:space-between;">
                  <span style="display:flex;align-items:center;gap:.35rem;"><svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>Vertical Performance</span>
                  <div style="display:flex;gap:.3rem;">
                    <button type="button" id="vertBtnTCV" onclick="setVertMetric('tcv')" style="padding:.2rem .6rem;border-radius:6px;font-size:.7rem;font-weight:700;border:1px solid var(--border);cursor:pointer;background:var(--grad);color:#fff;">TCV</button>
                    <button type="button" id="vertBtnCount" onclick="setVertMetric('count')" style="padding:.2rem .6rem;border-radius:6px;font-size:.7rem;font-weight:700;border:1px solid var(--border);cursor:pointer;background:var(--bg-secondary);color:var(--t3);">Count</button>
                  </div>
                </div>
                <div class="chart-container" style="height:320px;"><canvas id="chartVertical"></canvas></div>
              </div>
              <div class="chart-card">
                <div class="chart-title"><svg viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/></svg><span id="gaTrendTitle">MRC Trend</span></div>
                <div class="chart-container" style="height:280px;"><canvas id="chartGA"></canvas></div>
                <div id="gaControlsWrap"></div>
              </div>
            </div>
            <!-- ROW 5: Top Customers/Services full width -->
   <div style="display:grid;grid-template-columns:1fr;gap:.85rem;margin-bottom:.85rem;">
              <div class="chart-card">
                <div class="chart-title" style="justify-content:space-between;">
                  <span id="topChartTitle" style="display:flex;align-items:center;gap:.35rem;">
                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                    Top 10 Customers by TCV
                  </span>
                  <div style="display:flex;gap:.35rem;align-items:center;">
                    <button type="button" id="topChartBtnCust" onclick="setTopChart('customers')" style="padding:.25rem .8rem;border-radius:6px;font-size:.72rem;font-weight:700;border:1px solid var(--border);cursor:pointer;background:var(--grad);color:#fff;">Top Customers</button>
                    <button type="button" id="topChartBtnSvc" onclick="setTopChart('services')" style="padding:.25rem .8rem;border-radius:6px;font-size:.72rem;font-weight:700;border:1px solid var(--border);cursor:pointer;background:var(--bg-secondary);color:var(--t3);">Top Services</button>
                    <span id="svcSubToggle" style="display:none;gap:.35rem;">
                      <button type="button" id="svcBtnTCV" onclick="setSvcMetric('tcv')" style="padding:.25rem .7rem;border-radius:6px;font-size:.72rem;font-weight:700;border:1px solid var(--border);cursor:pointer;background:var(--grad);color:#fff;">TCV</button>
                      <button type="button" id="svcBtnBids" onclick="setSvcMetric('bids')" style="padding:.25rem .7rem;border-radius:6px;font-size:.72rem;font-weight:700;border:1px solid var(--border);cursor:pointer;background:var(--bg-secondary);color:var(--t3);">Bids</button>
                    </span>
                  </div>
                </div>
                <div class="chart-container" style="height:360px;"><canvas id="chartTopCustomers"></canvas></div>
              </div>
            </div>
          </div>
        </div>


        <!-- TABLE -->
        <div id="table-nav" class="table-section" style="margin-top:1rem;">
          <div class="table-header">
            <h3 class="table-title">
              <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              Detailed Bid Records
            </h3>
            <div class="table-actions">
              <button type="button" class="export-btn" onclick="exportExcel()">
                <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export to Excel
              </button>
              <input type="text" class="search-box" id="searchInp" placeholder="Search all columns..." oninput="gridSearch(this.value)">
            </div>
          </div>
          <div id="myGrid" class="ag-theme-alpine" style="height:580px;width:100%;"></div>
        </div>

      </div><!-- /dashboard-view -->

      <!-- MOBILE QTD BRIDGE VIEW -->
      <div id="mobile-qtd-view" class="dashboard-section" style="display:none;margin:0;padding:0;">
        <div class="filters-section" style="margin-bottom:1rem;">
          <div class="mq-controls-toolbar">
            <h2 class="section-title" style="margin-top:0;">
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
              <span id="mqSectionTitle">Performance Bridge</span>
            </h2>
            <button type="button" id="mqControlsToggleBtn" class="mq-controls-toggle-btn" onclick="mqToggleControlsPanel()" title="Show or hide filters, report upload, and account search">
              <span id="mqControlsToggleLabel">Hide controls</span>
              <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
          </div>
          <div class="mq-bridge-state" id="mqBridgeStateBar">
            <span class="mq-state-chip mq-state-pf">Mobile Net Adds</span>
            <span class="mq-state-sep">›</span>
            <span class="mq-state-chip mq-state-period">QTD Bridge</span>
            <span class="mq-state-sep">›</span>
            <span class="mq-state-chip mq-state-case">Most Likely</span>
          </div>
          <div id="mqControlsPanel">
          <p id="mqSectionDesc" style="font-size:.78rem;color:var(--t3);margin:0 0 .85rem;">GLK report loads from <strong>SharePoint › SiteAssets</strong>. Use <strong>Replace File</strong> to publish an updated workbook — everyone loads the new version on refresh.</p>

          <!-- SharePoint report source -->
          <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;margin-bottom:.85rem;padding:.75rem 1rem;background:var(--bg-secondary);border:1px solid var(--border);border-radius:10px;">
            <input type="file" id="mobileReportInp" accept=".xlsx,.xls,.xlsm,.csv" style="display:none;" onchange="glkMobileReportUpload(this.files[0])">
            <button type="button" class="reset-btn" id="mobileReportRefreshBtn" onclick="glkMobileReportRefreshFromSharePoint()" title="Reload the workbook from SharePoint">
              <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
              Refresh from SharePoint
            </button>
            <button type="button" class="export-btn glk-admin-only" id="mobileReportReplaceBtn" onclick="document.getElementById('mobileReportInp').click()">
              <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              Replace File
            </button>
            <a id="mobileReportSpLink" href="http://sharedspaces:8086/sites/GKA/SiteAssets/Copy%20of%20WorkCell%20Dashboard%20(22-Aug-2026%20GLK).xlsx" target="_blank" rel="noopener" style="font-size:.72rem;color:var(--acc);text-decoration:none;font-weight:600;">Open in SharePoint ↗</a>
            <div id="mobileReportMeta" style="flex:1 1 100%;font-size:.75rem;color:var(--t2);font-weight:600;margin-top:.15rem;">Last uploaded: —</div>
          </div>

          <!-- Bridge controls -->
          <div class="mq-bridge-controls">
            <div class="mq-control-grid">
              <div class="mq-control-block">
                <div class="mq-control-head"><span class="mq-control-step">1</span><span class="mq-control-label">Product family</span><button type="button" class="mq-info-btn" id="mqInfoPf" onclick="mqShowFieldInfo(event,'pf')" title="Help">i</button></div>
                <div class="mq-control-tabs">
                  <button type="button" id="mqPfMobile" class="pf-tab active" onclick="glkSetMqProductFamily('mobile')">Mobile</button>
                  <button type="button" id="mqPfFixed" class="pf-tab" onclick="glkSetMqProductFamily('fixed')">Fixed</button>
                  <button type="button" id="mqPfRevenue" class="pf-tab" disabled title="Coming soon">Revenue <span class="mq-soon-tag">Soon</span></button>
                </div>
              </div>
              <div class="mq-control-block" id="mqPeriodGroup">
                <div class="mq-control-head"><span class="mq-control-step">2</span><span class="mq-control-label" id="mqPeriodGroupLabel">Net Add Lines</span><button type="button" class="mq-info-btn" id="mqInfoPeriod" onclick="mqShowFieldInfo(event,'period')" title="Help">i</button></div>
                <div class="mq-control-tabs">
                  <button type="button" id="mqPeriodQtd" class="pf-tab active" onclick="glkSetMqPeriod('qtd')">QTD Bridge</button>
                  <button type="button" id="mqPeriodYtd" class="pf-tab" onclick="glkSetMqPeriod('ytd')">YTD Bridge</button>
                </div>
                <div id="mqFutureQuarterWrap" class="glk-compare-row" style="display:none;margin-top:.45rem;">
                  <label class="glk-compare-toggle">
                    <input type="checkbox" id="mqFutureQuarterToggle" onchange="glkToggleMqFutureQuarter()">
                    Next quarter pipeline view <span style="font-weight:400;color:var(--t3);">(Won · Needle Movers · Churn — no actuals or target yet)</span>
                  </label>
                  <button type="button" class="mq-info-btn" onclick="mqShowFieldInfo(event,'futureq')" title="Help">i</button>
                </div>
                <div id="mqYtdManualPanel" style="display:none;margin-top:.55rem;padding:.55rem .65rem;background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.35);border-radius:8px;font-size:.72rem;line-height:1.45;">
                  <div style="display:flex;align-items:center;justify-content:space-between;gap:.5rem;flex-wrap:wrap;margin-bottom:.35rem;">
                    <div style="font-weight:700;color:#b45309;">Net Add Lines YTD — enter missing targets (saved in this browser)</div>
                    <button type="button" class="export-btn" onclick="mqApplyYtdManualTargets()" style="font-size:.68rem;padding:.25rem .55rem;">Save &amp; apply</button>
                  </div>
                  <div id="mqYtdManualBody" style="margin-top:.25rem;"></div>
                  <div id="mqYtdVertWarnRow" style="display:none;color:#92400e;margin-top:.35rem;">
                    YTD bridge <strong>target bar</strong> uses Overall only. Select a vertical → update targets in the Excel file.
                  </div>
                </div>
              </div>
              <div class="mq-control-block" id="mqAggRevGroup" style="display:none;">
                <div class="mq-control-head"><span class="mq-control-step">3</span><span class="mq-control-label">Aggregated Revenue</span><button type="button" class="mq-info-btn" onclick="mqShowFieldInfo(event,'agg')" title="Help">i</button></div>
                <div class="mq-control-tabs">
                  <button type="button" id="mqPeriodQtg" class="pf-tab" onclick="glkSetMqPeriod('qtg')">QTG</button>
                  <button type="button" id="mqPeriodYtg" class="pf-tab" onclick="glkSetMqPeriod('ytg')">YTG</button>
                </div>
              </div>
              <div class="mq-control-block">
                <div class="mq-control-head"><span class="mq-control-step">4</span><span class="mq-control-label">Scenario</span><button type="button" class="mq-info-btn" onclick="mqShowFieldInfo(event,'scenario')" title="Help">i</button></div>
                <div class="mq-control-tabs">
                  <button type="button" id="mqCaseWorst" class="pf-tab active" onclick="glkSetMobileQtdCase('worst')">Most Likely</button>
                  <button type="button" id="mqCaseBest" class="pf-tab" onclick="glkSetMobileQtdCase('best')">Upside</button>
                </div>
              </div>
              <div class="mq-control-block" id="mqHeadDirectorBlock">
                <div class="mq-control-head"><span class="mq-control-step">5</span><span class="mq-control-label">Head director</span><button type="button" class="mq-info-btn" onclick="mqShowFieldInfo(event,'hd')" title="Help">i</button></div>
                <div class="mq-control-tabs">
                  <button type="button" id="mqHd_all" class="pf-tab active" onclick="glkSetMqHeadDirector('')">All</button>
                  <button type="button" id="mqHd_khalid" class="pf-tab" onclick="glkSetMqHeadDirector('khalid')">Khaled</button>
                  <button type="button" id="mqHd_amir" class="pf-tab" onclick="glkSetMqHeadDirector('amir')">Amer</button>
                  <button type="button" id="mqHd_kamil" class="pf-tab" onclick="glkSetMqHeadDirector('kamil')">Kamil</button>
                </div>
              </div>
              <div class="mq-control-block" id="mqReportLevelBlock">
                <div class="mq-control-head"><span class="mq-control-step">6</span><span class="mq-control-label">Report level</span><button type="button" class="mq-info-btn" onclick="mqShowFieldInfo(event,'rl')" title="Help">i</button></div>
                <div class="ms-wrap" id="mqms_reportLevel">
                  <div class="ms-trigger" id="mqmst_reportLevel" onclick="event.stopPropagation();mqToggleReportLevel()">
                    <span id="mqmstext_reportLevel">GLK Overall</span>
                    <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                  </div>
                  <div class="ms-dropdown" id="mqmsd_reportLevel"></div>
                </div>
              </div>
            </div>
            <div class="mq-bridge-search" id="mqBridgeSearchWrap" style="margin-top:.65rem;padding:.55rem .65rem;background:var(--bg-card);border:1px solid var(--border);border-radius:9px;">
              <div style="display:flex;align-items:center;gap:.45rem;flex-wrap:wrap;">
                <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:var(--t3);fill:none;stroke-width:2;flex-shrink:0;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="search" id="mqBridgeSearchInp" placeholder="Search account, bid ref, customer code…" onkeydown="if(event.key==='Enter')mqRunBridgeSearch()" style="flex:1;min-width:180px;border:1px solid var(--border);border-radius:7px;padding:.35rem .55rem;font-size:.72rem;background:var(--bg-secondary);color:var(--t1);">
                <button type="button" class="export-btn" onclick="mqRunBridgeSearch()" style="font-size:.68rem;padding:.28rem .55rem;">Find in bridge</button>
                <button type="button" class="export-btn" onclick="mqClearBridgeSearch()" style="font-size:.68rem;padding:.28rem .55rem;background:transparent;color:var(--t3);">Clear</button>
                <button type="button" class="mq-info-btn" onclick="mqShowFieldInfo(event,'search')" title="Help">i</button>
              </div>
            </div>
            <div id="mqFieldInfoPop" class="mq-field-info-pop" onclick="event.stopPropagation()"></div>
            <div id="mqBridgeSearchResults" style="display:none;margin-top:.45rem;background:var(--bg-card);border:1px solid var(--border);border-radius:9px;max-height:280px;overflow-y:auto;"></div>
          </div>
          </div><!-- /mqControlsPanel -->

        </div>

        <div class="chart-card">
          <div class="chart-title" style="justify-content:space-between;flex-wrap:wrap;gap:.5rem;">
            <span style="display:flex;flex-direction:column;gap:.15rem;">
              <span style="display:flex;align-items:center;gap:.35rem;">
                <svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            <span id="mqChartTitle">Mobile Net Adds — Performance Bridge</span>
                <button type="button" id="mqBridgeInfoBtn" onclick="mqToggleBridgeInfo()" title="Full bridge help" style="width:22px;height:22px;border-radius:50%;border:1px solid var(--border-s);background:var(--nab);color:var(--acc);font-weight:800;font-size:.72rem;cursor:pointer;line-height:1;padding:0;">i</button>
              </span>
              <span id="mqBridgeSubtitle" style="font-size:.68rem;font-weight:600;color:var(--t3);">Actuals → Won → Needle Movers → Churn → Net Forecast → Gap</span>
            </span>
            <div style="display:flex;align-items:center;gap:.45rem;flex-wrap:wrap;">
              <div id="mqTargetBadge" style="font-size:.72rem;font-weight:700;color:var(--acc);padding:.25rem .65rem;background:var(--nab);border:1px solid var(--nab2);border-radius:8px;">Target: —</div>
              <button type="button" class="export-btn" onclick="mqExportBridgePpt()" title="Download bridge chart and product table as PowerPoint" style="font-size:.72rem;padding:.35rem .65rem;">
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                Export PPT
              </button>
              <button type="button" id="mqProductTableXlsxBtn" class="export-btn" onclick="mqExportMobileProductTableXlsx()" title="Export all Mobile Net Add Lines QTG tables to Excel" style="font-size:.72rem;padding:.35rem .65rem;display:none;">
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Export All Tables
              </button>
            </div>
          </div>
          <div class="mq-bridge-scroll" id="mqBridgeScroll">
            <div id="mqChartOuter">
              <div class="chart-container" id="mqChartWrap"><canvas id="chartMobileQtd"></canvas><div id="mqVertOnChart"></div></div>
              <div id="mqBracketRow"></div>
              <div id="mqXAxisStrip"></div>
            </div>
          </div>
          <div id="mqBridgeLegend"></div>
          <div id="mqMobileProductTableWrap" style="display:none;"></div>
          <input type="file" id="mqWowPriorInp" accept=".xlsx,.xls,.xlsm,.csv,.xls" style="display:none;">
          <input type="file" id="mqWowPriorBulkInp" accept=".xlsx,.xls,.xlsm,.csv,.xls" style="display:none;">
          <div id="mqBarDetailPanel" style="display:none;margin-top:.55rem;padding:.75rem 1rem;background:var(--bg-secondary);border:1px solid var(--border);border-radius:10px;font-size:.72rem;color:var(--t2);line-height:1.55;overflow-y:auto;"></div>
          <div id="mqBridgeSearchGridWrap" style="display:none;margin-top:.55rem;padding:.75rem 1rem;background:var(--bg-secondary);border:1px solid var(--border);border-radius:10px;"></div>
          <div id="mqBarDetailHint"></div>
          <div id="mqBridgeInfoPanel" style="display:none;margin-top:.65rem;padding:.85rem 1rem;background:var(--bg-secondary);border:1px solid var(--border);border-radius:10px;font-size:.72rem;color:var(--t2);line-height:1.65;max-height:420px;overflow-y:auto;"></div>
          <div id="mobileQtdControlsWrap"></div>
          <div id="mobileQtdSummaryWrap"></div>
        </div>
      </div>

      <!-- TRENDS VIEW -->
      <div id="revenue-rec-view" class="dashboard-section" style="display:none;margin:0;padding:0;">
        <div class="filters-section" style="margin-bottom:1rem;">
          <div class="mq-controls-toolbar">
            <h2 class="section-title" style="margin-top:0;margin-bottom:0!important;">
              <svg viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 8 12 3 7 8"/></svg>
              Trends
            </h2>
            <button type="button" id="rrControlsToggleBtn" class="mq-controls-toggle-btn" onclick="rrToggleControlsPanel()" title="Show or hide Excel upload and file info">
              <span id="rrControlsToggleLabel">Hide controls</span>
              <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
          </div>
          <div id="rrControlsPanel">
            <p style="font-size:.78rem;color:var(--t3);margin:0 0 .85rem;">Trends workbook loads from <strong>SharePoint › SiteAssets</strong> (same folder as Performance Bridge). Use Replace File to publish an updated workbook.</p>
            <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;margin-bottom:.85rem;padding:.75rem 1rem;background:var(--bg-secondary);border:1px solid var(--border);border-radius:10px;">
              <input type="file" id="rrReportInp" accept=".xlsx,.xls,.xlsm" style="display:none;" onchange="rrReportUpload(this.files[0])">
              <button type="button" class="export-btn glk-admin-only" id="rrReportReplaceBtn" onclick="document.getElementById('rrReportInp').click()">
                <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                Replace File
              </button>
              <button type="button" class="reset-btn" onclick="rrRefreshFromSharePoint()">
                <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                Refresh from SharePoint
              </button>
              <a id="rrReportSpLink" href="http://sharedspaces:8086/sites/GKA/SiteAssets/Copy%20of%20dummy.xlsx" target="_blank" rel="noopener" style="font-size:.72rem;color:var(--acc);text-decoration:none;font-weight:600;">Open in SharePoint ↗</a>
              <div id="rrReportMeta" style="flex:1 1 100%;font-size:.75rem;color:var(--t2);font-weight:600;margin-top:.15rem;">Last uploaded: —</div>
            </div>
          </div><!-- /rrControlsPanel -->
          <div class="rr-chart-tabs" id="rrChartTabs"></div>
          <div id="rrTrendCumulativeWrap" class="glk-compare-row" style="display:none;margin:.5rem 0 .35rem;">
            <label class="glk-compare-toggle">
              <input type="checkbox" id="rrTrendCumulative" onchange="rrToggleTrendCumulative()">
              Accumulated view <span style="font-weight:400;color:var(--t3);">(Jan → Jan+Feb → Jan+Feb+Mar…)</span>
            </label>
          </div>
            <div id="rrKpiRow" class="rr-kpi-row"></div>
            <div class="chart-card">
            <div class="rr-chart-title" style="justify-content:space-between;flex-wrap:wrap;gap:.5rem;">
              <span style="display:flex;align-items:center;gap:.4rem;">
                <svg viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 8 12 3 7 8"/></svg>
                <span id="rrChartTitle">—</span>
              </span>
              <span id="rrProjBadge" class="rr-proj-badge" style="display:none;">Projection zone</span>
            </div>
            <div id="rrChartSubtitle" class="rr-chart-subtitle"></div>
            <div id="rrChartWrap"><div class="chart-container"><canvas id="chartRevenueRec"></canvas></div></div>
            <div id="rrChartLegend" class="rr-legend-row"></div>
            <div id="rrLineExplain" style="margin-top:.65rem;padding:.7rem .85rem;background:var(--bg-secondary);border:1px solid var(--border);border-radius:9px;font-size:.72rem;line-height:1.6;color:var(--t2);"></div>
            <div id="rrChartNote" style="font-size:.66rem;color:var(--t3);margin-top:.45rem;line-height:1.5;"></div>
          </div>
        </div>
      </div><!-- /revenue-rec-view -->

      <!-- PIPELINE GOVERNANCE VIEW -->
      <div id="governance-view" class="dashboard-section pg-section" style="display:none;margin:0;padding:0;">
        <div class="filters-section">
          <div class="pg-header-row">
            <h2 class="section-title" style="margin:0;">
              <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              Pipeline Governance &amp; Cleanup
            </h2>
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
              <button type="button" class="reset-btn" onclick="pgResetAll(false)" style="font-size:.72rem;padding:.4rem .75rem;">Reset all</button>
              <button type="button" class="export-btn" id="pgRefreshBtn" onclick="pgRefreshFromSharePoint(event)" style="font-size:.72rem;padding:.4rem .75rem;">
                <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                Refresh version history
              </button>
            </div>
          </div>
          <p class="pg-subtitle">Live quarter pipeline only — full SharePoint version history per deal. <strong>Status flips</strong> = every Opp Status change (when, from → to, who). <strong>Stale queue</strong> = unchanged on current status for 1+/7+/15+ days.</p>
          <div id="pgProgressBar" class="pg-progress" style="display:none;">
            <div class="pg-progress-track"><div class="pg-progress-fill" id="pgProgressFill"></div></div>
            <div class="pg-progress-text" id="pgProgressText">Loading…</div>
          </div>
          <div class="pg-filter-panel">
            <div class="pg-control-block">
              <span class="pg-control-label">Head director</span>
              <select id="pgHdFilter" class="fb-select" onchange="pgOnHdFilterChange()"><option value="">All</option></select>
            </div>
            <div class="pg-control-block">
              <span class="pg-control-label">Account director</span>
              <select id="pgAdFilter" class="fb-select" onchange="pgOnAdFilterChange()"><option value="">All</option></select>
            </div>
            <div class="pg-control-block">
              <span class="pg-control-label">Account manager</span>
              <select id="pgAmFilter" class="fb-select" onchange="pgOnAmFilterChange()"><option value="">All</option></select>
            </div>
            <div class="pg-control-block">
              <span class="pg-control-label">Product family</span>
              <select id="pgPfFilter" class="fb-select" onchange="pgRender()">
                <option value="">All</option>
                <option value="Mobile">Mobile</option>
                <option value="Fixed">Fixed</option>
                <option value="Broadcast">Broadcast</option>
                <option value="DataMena">DataMena</option>
              </select>
            </div>
            <div class="pg-control-block pg-search-block">
              <span class="pg-control-label">Search</span>
              <input type="text" id="pgSearchInp" class="search-box" placeholder="Customer, bid ref, vertical, status…" oninput="pgRender()">
            </div>
          </div>
          <div id="pgKpiRow" class="pg-kpi-row top-stats"></div>
          <div class="pg-tab-row">
            <div class="mq-control-tabs">
              <button type="button" id="pgTabStale" class="pf-tab active" onclick="pgSetTab('stale')">Stale queue</button>
              <button type="button" id="pgTabFlips" class="pf-tab" onclick="pgSetTab('flips')">Status flips</button>
            </div>
          </div>
          <div id="pgStaleFilters" class="pg-tab-filters"></div>
          <div id="pgFlipFilters" class="pg-tab-filters" style="display:none;"></div>
          <div id="pgHdSection" class="hd-section pg-drill-section">
            <h2 class="section-title" style="margin-bottom:.75rem;">
              <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
              Head Director — Pipeline hygiene
              <span id="pgHdBadge" style="background:var(--nab);border:1px solid var(--nab2);color:var(--acc);padding:2px 10px;border-radius:20px;font-size:.75rem;font-weight:700;">0</span>
            </h2>
            <div class="hd-grid" id="pgHdGrid"></div>
          </div>
          <div id="pgAdSection" class="ad-section pg-drill-section" style="display:none;margin-top:1rem;">
            <h2 class="section-title" style="margin-bottom:.75rem;">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a6 6 0 0 1 12 0v2"/></svg>
              Account Directors
              <span id="pgAdBadge" style="background:var(--nab);border:1px solid var(--nab2);color:var(--acc);padding:2px 10px;border-radius:20px;font-size:.75rem;font-weight:700;">0</span>
              <span id="pgAdContext" style="font-size:.78rem;color:var(--t3);font-weight:400;"></span>
            </h2>
            <div class="ad-grid" id="pgAdGrid"></div>
          </div>
          <div id="pgAmSection" class="am-section pg-drill-section" style="display:none;margin-top:1rem;">
            <h2 class="section-title" style="margin-bottom:.75rem;">
              <svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              Account Managers
              <span id="pgAmBadge" style="background:var(--nab);border:1px solid var(--nab2);color:var(--acc);padding:2px 10px;border-radius:20px;font-size:.75rem;font-weight:700;">0</span>
              <span id="pgAmContext" style="font-size:.78rem;color:var(--t3);font-weight:400;"></span>
            </h2>
            <div class="manager-list" id="pgAmList"></div>
          </div>
          <div class="pg-grid-panel">
            <div class="pg-grid-head">
              <div class="pg-grid-title" id="pgGridTitle">Deal detail</div>
              <div class="pg-grid-count" id="pgGridCount"></div>
            </div>
            <div id="pgGrid" class="ag-theme-alpine" style="height:620px;width:100%;"></div>
          </div>
          <div id="pgFootnote" class="pg-footnote"></div>
        </div>
      </div><!-- /governance-view -->

    </div><!-- /content -->
  </div><!-- /main-container -->
</div><!-- /portal-shell -->

<!-- Developer Console Login -->
<div class="dev-console" id="devConsole" style="display:none;">
  <span class="dev-console-label">Dev Login</span>
  <input type="text" id="devEmailInput" placeholder="email@example.com" onkeydown="if(event.key==='Enter')devLogin()">
  <select id="devRoleInput" style="padding:.3rem .6rem;border-radius:6px;border:1px solid var(--border);background:var(--bg-input);color:var(--t1);font-size:.75rem;">
    <option value="Admin">Admin</option>
    <option value="Head Director">Head Director</option>
    <option value="Account Director">Account Director</option>
    <option value="Account Manager">Account Manager</option>
  </select>
  <button type="button" onclick="devLogin()">Login As</button>
</div>

<script>
// ══════════════════════════════════════════════════════════════════
//  CONFIG
// ══════════════════════════════════════════════════════════════════
const SP_SITE   = 'http://sharedspaces:8086/sites/GKA';
const SP_SITE_ROOT='/sites/GKA';
const SP_LIST   = 'GLK Pipeline Portal';
const SP_ACCESS = 'GKLA_ACCESS';
let SP_LIST_EDIT_FORM_BASE=null;
let SP_LIST_VIEW_FORM_BASE=null;
const SP_MOBILE_REPORT_FOLDER='/sites/GKA/SiteAssets';
const SP_MOBILE_REPORT_FILE='Copy of WorkCell Dashboard (22-Aug-2026 GLK).xlsx';
const SP_MOBILE_REPORT_PATH=SP_MOBILE_REPORT_FOLDER+'/'+SP_MOBILE_REPORT_FILE;
const SP_MOBILE_REPORT_WEB_URL=SP_SITE+'/SiteAssets/'+encodeURIComponent(SP_MOBILE_REPORT_FILE).replace(/%20/g,'%20');
const SP_TRENDS_REPORT_FILE='Copy of dummy.xlsx';
const SP_TRENDS_REPORT_PATH=SP_MOBILE_REPORT_FOLDER+'/'+SP_TRENDS_REPORT_FILE;
const SP_TRENDS_REPORT_WEB_URL=SP_SITE+'/SiteAssets/'+encodeURIComponent(SP_TRENDS_REPORT_FILE);
const MQ_IDB_NAME='GLKMobileQtdCache';
const MQ_IDB_STORE='report';
const MQ_LS_META_KEY='glk_mobile_qtd_meta';
const MQ_LS_DATA_KEY='glk_mobile_qtd_b64';
const MQ_LS_MAX_B64=1800000;
const MQ_CLR_NET='#6366f1';
const MQ_CLR_TARGET='#64748b';
const MQ_CLR_GROWTH='#22c55e';
const MQ_CLR_GAP='#ef4444';
const MQ_CLR_ACTUALS='#059669';
const MQ_CLR_WON='#7c3aed';
const MQ_CLR_INFLIGHT=['#3b82f6','#60a5fa','#2563eb','#818cf8','#a5b4fc'];
const MQ_CLR_INFLIGHT_OTHERS='#93c5fd';
const MQ_CLR_CHURN=['#b91c1c','#dc2626','#ef4444','#c2410c','#991b1b'];
const MQ_CLR_CHURN_OTHERS='#dc2626';
const MQ_HD_COLORS={
  khalid:'#ca8a04',
  amir:'#db2777',
  kamil:'#0d9488',
  other:'#78716c'
};
const MQ_HD_LEGEND=[
  {g:'khalid',c:'#ca8a04',l:'Khaled · AUH, F-NE, HUNT'},
  {g:'amir',c:'#db2777',l:'Amer · DXB'},
