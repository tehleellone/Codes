}
function mqGroupVerticalHint(bids){
  var verts={};
  (bids||[]).forEach(function(b){
    var v=b.vertical&&b.vertical!=='—'?String(b.vertical).trim():'';
    if(v) verts[v]=true;
  });
  var keys=Object.keys(verts);
  if(!keys.length) return '';
  if(keys.length===1) return keys[0];
  return keys.join(' · ');
}
function mqVerticalStackHtml(label){
