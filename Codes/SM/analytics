}

// ─── LOAD DASHBOARD ───────────────────────────────────────────────────────────
window.analyticsLoadDashboard = async function() {
    const loading = document.getElementById('analyticsLoading');
    const content = document.getElementById('analyticsContent');
    if (loading) loading.style.display = 'flex';
    if (content) content.style.display = 'none';

    try {
        if (ANALYTICS_DUMMY_MODE) {
            // DUMMY MODE: show generated data on screen — SP tracking still runs separately
            ANALYTICS_DATA = analyticsGenerateDummyData();
            if (loading) loading.style.display = 'none';
            if (content) content.style.display = 'block';
            analyticsRenderAll();
            return;
        }

        // REAL SP DATA
        const since = new Date(); since.setDate(since.getDate() - 90);
        const url = ANALYTICS_SP_URL +
            `/_api/web/lists/getbytitle('${ANALYTICS_LIST}')/items?` +
            `$select=ID,Title,UserEmail,UserRole,SessionStart,SessionEnd,SessionDuration,PageViews,PagesVisited,LastPageVisited,DeviceType,Browser,DayOfWeek,WeekNumber,Month&` +
            `$filter=SessionStart ge '${since.toISOString()}'&$orderby=SessionStart desc&$top=5000`;

        const res = await fetch(url, {
            headers: { 'Accept': 'application/json;odata=verbose' }, credentials: 'include'
        });
        if (!res.ok) throw new Error('SP fetch failed: ' + res.status);
        const data = await res.json();
        ANALYTICS_DATA = data.d.results.map(r => ({
            id:        r.ID,
            user:      r.Title           || 'Unknown',
            email:     r.UserEmail       || '',
            role:      r.UserRole        || 'Unknown',
            start:     r.SessionStart    ? new Date(r.SessionStart) : null,
            end:       r.SessionEnd      ? new Date(r.SessionEnd)   : null,
            duration:  r.SessionDuration || 0,
            pageViews: r.PageViews       || 0,
            pages:     r.PagesVisited    || '',
            lastPage:  r.LastPageVisited || '',
            device:    r.DeviceType      || '',
            browser:   r.Browser         || '',
            dow:       r.DayOfWeek       || '',
            week:      r.WeekNumber      || 0,
            month:     r.Month           || ''
        }));

        if (loading) loading.style.display = 'none';
        if (content) content.style.display = 'block';
        analyticsRenderAll();
    } catch(e) {
        if (loading) loading.innerHTML = `
            <div style="text-align:center;color:var(--danger);">
                <i data-lucide="alert-circle" style="width:48px;height:48px;margin-bottom:1rem;"></i>
                <div style="font-size:18px;font-weight:600;">Failed to load analytics</div>
                <div style="font-size:13px;color:var(--t3);margin-top:8px;">${e.message}</div>
                <button onclick="analyticsLoadDashboard()" class="export-btn" style="margin-top:1rem;">Retry</button>
            </div>`;
        if (typeof lucide !== 'undefined') lucide.createIcons();
    }
};

window.analyticsExport = function() {
    const data=analyticsGetFiltered();
    if(!data.length) return;
    const header='User,Email,Role,SessionStart,SessionEnd,Duration(min),PageViews,PagesVisited,LastPage,Device,Browser,DayOfWeek,Month\n';
    const rows=data.map(d=>[d.user,d.email,d.role,d.start?.toISOString()||'',d.end?.toISOString()||'',d.duration,d.pageViews,`"${d.pages}"`,d.lastPage,d.device,d.browser,d.dow,d.month].join(',')).join('\n');
    const blob=new Blob([header+rows],{type:'text/csv'});
    const a=document.createElement('a'); a.href=URL.createObjectURL(blob);
    a.download=`portal_analytics_${new Date().toISOString().split('T')[0]}.csv`; a.click();
};
