// ─── FILTER STATE ─────────────────────────────────────────────────────────────
var ANALYTICS_ROLE_FILTER = [];  // empty = All roles

function analyticsGetFiltered() {
    const period = document.getElementById('analyticsPeriodFilter')?.value || '30';
    const cutoff = new Date(); cutoff.setDate(cutoff.getDate() - parseInt(period));
    let data = ANALYTICS_DATA.filter(d => d.start && d.start >= cutoff);
    if (ANALYTICS_ROLE_FILTER.length > 0) {
        data = data.filter(d => ANALYTICS_ROLE_FILTER.includes(d.role));
    }
    return data;
}

window.analyticsChangePeriod = function() { analyticsRenderAll(); };

window.analyticsToggleRoleDropdown = function(e) {
    e.stopPropagation();
    var panel = document.getElementById('analyticsRolePanel');
    if (!panel) return;
    var isOpen = panel.style.display !== 'none';
    panel.style.display = isOpen ? 'none' : 'block';
};

// Close dropdown when clicking outside
document.addEventListener('click', function(e) {
    var wrap = document.getElementById('analyticsRoleDropdownWrap');
    if (wrap && !wrap.contains(e.target)) {
        var panel = document.getElementById('analyticsRolePanel');
        if (panel) panel.style.display = 'none';
    }
});

window.analyticsRoleCheckboxChange = function(cb) {
    var allCb = document.querySelector('#analyticsRolePanel input[value="All"]');
    var roleCbs = Array.from(document.querySelectorAll('#analyticsRolePanel input[type="checkbox"]:not([value="All"])'));

    if (cb.value === 'All') {
        // All checked → uncheck others
        roleCbs.forEach(function(r) { r.checked = false; });
    } else {
        // Role checked → uncheck All
        if (allCb) allCb.checked = false;
        // If nothing selected → revert to All
        var anyChecked = roleCbs.some(function(r) { return r.checked; });
        if (!anyChecked && allCb) allCb.checked = true;
    }

    // Update button label
    var selected = roleCbs.filter(function(r) { return r.checked; });
    var btnText = document.getElementById('analyticsRoleBtnText');
    if (btnText) {
        if (selected.length === 0) btnText.textContent = 'All Roles';
        else if (selected.length === 1) btnText.textContent = selected[0].value;
        else btnText.textContent = selected.length + ' roles selected';
    }

    // Apply filter
    ANALYTICS_ROLE_FILTER = selected.map(function(r) { return r.value; });
    analyticsRenderAll();
};

window.analyticsResetRoleFilter = function() {
    var allCb = document.querySelector('#analyticsRolePanel input[value="All"]');
    var roleCbs = document.querySelectorAll('#analyticsRolePanel input[type="checkbox"]:not([value="All"])');
    if (allCb) allCb.checked = true;
    roleCbs.forEach(function(r) { r.checked = false; });
    var btnText = document.getElementById('analyticsRoleBtnText');
    if (btnText) btnText.textContent = 'All Roles';
    ANALYTICS_ROLE_FILTER = [];
    analyticsRenderAll();
};

window.analyticsApplyRoleFilter = function() {
    // kept for backward compat — now handled by analyticsRoleCheckboxChange
    analyticsRenderAll();
};

// ─── KPIs ─────────────────────────────────────────────────────────────────────
function analyticsRenderKPIs() {
    const data = analyticsGetFiltered();
    const totalSessions  = data.length;
    const uniqueUsers    = new Set(data.map(d=>d.user)).size;
    const avgDuration    = totalSessions>0 ? Math.round(data.reduce((s,d)=>s+d.duration,0)/totalSessions) : 0;
    const totalPageViews = data.reduce((s,d)=>s+d.pageViews,0);

    const dowCounts = {};
    data.forEach(d=>{ if(d.dow) dowCounts[d.dow]=(dowCounts[d.dow]||0)+1; });
    const mostActiveDay = Object.entries(dowCounts).sort((a,b)=>b[1]-a[1])[0]?.[0] || '—';

    const now = new Date();
    const weekStart = new Date(now); weekStart.setDate(now.getDate()-now.getDay());
    const lastWeekStart = new Date(weekStart); lastWeekStart.setDate(weekStart.getDate()-7);
    const thisWeek = data.filter(d=>d.start>=weekStart).length;
    const lastWeek = data.filter(d=>d.start>=lastWeekStart&&d.start<weekStart).length;
    const weekTrend = lastWeek>0 ? ((thisWeek-lastWeek)/lastWeek*100).toFixed(0) : (thisWeek>0?100:0);

    document.getElementById('analyticsKPIs').innerHTML = `
    <div class="top-stats" style="margin-bottom:1.5rem;">
        <div class="stat-card">
            <div class="stat-label">Total Sessions</div>
            <div class="stat-value">${totalSessions}</div>
            <div class="stat-subtitle">Portal logins</div>
            <div class="stat-breakdown">
                <div class="breakdown-item"><div class="breakdown-label">This Week</div><div class="breakdown-value" style="color:${weekTrend>=0?'#10b981':'#ef4444'}">${weekTrend>=0?'+':''}${weekTrend}%</div></div>
                <div class="breakdown-item"><div class="breakdown-label">Count</div><div class="breakdown-value">${thisWeek}</div></div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Unique Users</div>
            <div class="stat-value">${uniqueUsers}</div>
            <div class="stat-subtitle">Active in period</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Avg Session</div>
            <div class="stat-value">${avgDuration}<span style="font-size:1rem;font-weight:600"> min</span></div>
            <div class="stat-subtitle">Per visit duration</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Total Page Views</div>
            <div class="stat-value">${totalPageViews}</div>
            <div class="stat-subtitle">Across all sessions</div>
            <div class="stat-breakdown">
                <div class="breakdown-item"><div class="breakdown-label">Avg/Session</div><div class="breakdown-value">${totalSessions>0?(totalPageViews/totalSessions).toFixed(1):0}</div></div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Peak Day</div>
            <div class="stat-value" style="font-size:1.2rem;">${mostActiveDay}</div>
            <div class="stat-subtitle">Most active day</div>
        </div>
        <div class="stat-card" style="cursor:pointer;" onclick="document.getElementById('analyticsRoleSelect').querySelectorAll('option').forEach(o=>o.selected=(o.value==='Service Manager'));analyticsApplyRoleFilter();">
            <div class="stat-label">SM Sessions</div>
            <div class="stat-value">${data.filter(d=>d.role==='Service Manager').length}</div>
            <div class="stat-subtitle">Service Managers</div>
        </div>
        <div class="stat-card" style="cursor:pointer;" onclick="document.getElementById('analyticsRoleSelect').querySelectorAll('option').forEach(o=>o.selected=(o.value==='Line Manager'));analyticsApplyRoleFilter();">
            <div class="stat-label">LM Sessions</div>
            <div class="stat-value">${data.filter(d=>d.role==='Line Manager').length}</div>
            <div class="stat-subtitle">Line Managers</div>
        </div>
    </div>`;
}

// ─── CHARTS ───────────────────────────────────────────────────────────────────
function analyticsRenderCharts() {
    const data   = analyticsGetFiltered();
    const colors = analyticsGetColors();

    Object.values(ANALYTICS_CHART_INSTANCES).forEach(c=>{ try{c.destroy();}catch(e){} });
    ANALYTICS_CHART_INSTANCES = {};

    // 1. Daily Active Users
    const dauData = (() => {
        const days=[]; const counts=[];
        for(let i=29;i>=0;i--){
            const d=new Date(); d.setDate(d.getDate()-i);
            const key=d.toISOString().split('T')[0];
            days.push(d.toLocaleString('en-US',{month:'short',day:'numeric'}));
            counts.push(new Set(data.filter(s=>s.start&&s.start.toISOString().split('T')[0]===key).map(s=>s.user)).size);
        }
        return {days,counts};
    })();

    // 2. Sessions by User (top 15)
    const userSessions = (() => {
        const map={};
        data.forEach(d=>{ map[d.user]=(map[d.user]||0)+1; });
        return Object.entries(map).sort((a,b)=>b[1]-a[1]).slice(0,15);
    })();

    // 3. Avg duration by user
    const userDuration = (() => {
        const map={}; const cnt={};
        data.forEach(d=>{ map[d.user]=(map[d.user]||0)+d.duration; cnt[d.user]=(cnt[d.user]||0)+1; });
        return Object.entries(map).map(([u,t])=>([u,Math.round(t/cnt[u])])).sort((a,b)=>b[1]-a[1]).slice(0,15);
    })();

    // 4. Page module popularity
    const pageCount={};
    data.forEach(d=>{ (d.pages||'').split(',').filter(Boolean).forEach(p=>{ pageCount[p]=(pageCount[p]||0)+1; }); });
    const pageSorted=Object.entries(pageCount).sort((a,b)=>b[1]-a[1]);

    // 5. Day of week
    const DAYS_ORDER=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
    const dowMap={};
    data.forEach(d=>{ if(d.dow) dowMap[d.dow]=(dowMap[d.dow]||0)+1; });

    // 6. Role distribution
    const roleMap={};
    data.forEach(d=>{ roleMap[d.role]=(roleMap[d.role]||0)+1; });

    // 7. Monthly trend
    const weeklyMap={};
    data.forEach(d=>{ if(d.month) weeklyMap[d.month]=(weeklyMap[d.month]||0)+1; });
    const weeklyLabels=Object.keys(weeklyMap).sort();

