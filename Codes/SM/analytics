function analyticsGenerateDummyData() {
    const users = [
        { name:'Tehleel Lone',     email:'tehleel@du.ae',      role:'Admin' },
        { name:'Anood Al Marama',  email:'anood@du.ae',        role:'Line Manager' },
        { name:'Suraj Pujari',     email:'suraj@du.ae',        role:'Line Manager' },
        { name:'Mohamed Sobhi',    email:'sobhi@du.ae',        role:'Line Manager' },
        { name:'Yaser Hamood',     email:'yaser@du.ae',        role:'Service Manager' },
        { name:'Ahmed Al Rashid',  email:'ahmed@du.ae',        role:'Service Manager' },
        { name:'Sara Al Mansoori', email:'sara@du.ae',         role:'Service Manager' },
        { name:'Khalid Nasser',    email:'khalid@du.ae',       role:'Service Manager' },
        { name:'Priya Sharma',     email:'priya@du.ae',        role:'Service Manager' },
        { name:'Omar Farooq',      email:'omar@du.ae',         role:'Service Manager' },
        { name:'Rania Al Zaabi',   email:'rania@du.ae',        role:'Line Manager' },
        { name:'James Wilson',     email:'james@du.ae',        role:'Service Manager' },
    ];
    const pages = ['Dashboard','Customer Service','Pending Requests','Transfer Requests','AM/AD Dashboard','Lead Management','Activities','Events'];
    const devices = ['Desktop','Desktop','Desktop','Mobile','Tablet'];
    const browsers = ['Chrome','Edge','Chrome','Chrome','Firefox','Safari'];
    const dows = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
    const months = ['Nov-25','Dec-25','Jan-26','Feb-26'];

    const records = [];
    const now = new Date();

    // Generate ~300 sessions over last 90 days
    users.forEach(u => {
        // Each user gets different session frequency
        const freq = u.role==='Admin'?40 : u.role==='Line Manager'?28 : 18;
        for (let s=0; s<freq; s++) {
            const daysAgo = Math.floor(Math.random()*85) + 1;
            const start = new Date(now);
            start.setDate(start.getDate() - daysAgo);
            start.setHours(7 + Math.floor(Math.random()*11), Math.floor(Math.random()*60));
            const duration = Math.floor(Math.random()*45) + 3;
            const end = new Date(start.getTime() + duration*60000);
            const numPages = Math.floor(Math.random()*6)+1;
            const visitedPages = [];
            visitedPages.push('Dashboard');
            for (let p=1;p<numPages;p++) {
                const pg = pages[Math.floor(Math.random()*pages.length)];
                if (!visitedPages.includes(pg)) visitedPages.push(pg);
            }
            const dow = dows[start.getDay()===0?6:start.getDay()-1];
            const wk  = Math.floor(daysAgo/7)+1;
            const m   = months[Math.floor((90-daysAgo)/22.5)];
            records.push({
                id: records.length+1,
                user: u.name, email: u.email, role: u.role,
                start, end, duration,
                pageViews: numPages,
                pages: visitedPages.join(','),
                lastPage: visitedPages[visitedPages.length-1],
                device: devices[Math.floor(Math.random()*devices.length)],
                browser: browsers[Math.floor(Math.random()*browsers.length)],
                dow, week: wk, month: m
            });
        }
    });

    // Sort newest first
    return records.sort((a,b) => b.start - a.start);
}

// ─── SESSION STATE ─────────────────────────────────────────────────────────────
var ANALYTICS_SESSION = {
    itemId:       null,       // SharePoint item ID once created
    startTime:    null,       // Date object
    pageViews:    0,
    pagesVisited: [],
    lastPage:     'Dashboard',
    heartbeatTimer: null,
    active:       false
};

var ANALYTICS_DATA  = [];    // All logs loaded for dashboard
var ANALYTICS_CHART_INSTANCES = {};

// ─── SESSION START (called from init after Launch Dashboard) ──────────────────
var ANALYTICS_SP_ITEM_TYPE = 'SP.Data.Portal_x005F_Access_x005F_LogListItem';

window.analyticsStartSession = async function() {
    if (ANALYTICS_SESSION.active) return;

    // ANALYTICS_DUMMY_MODE only affects the dashboard display — session tracking ALWAYS writes to SP
    try {
        const ctx    = window.USER_CONTEXT || {};
        const now    = new Date();
        const dow    = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][now.getDay()];
        const wk     = getISOWeek(now);
        const month  = now.toLocaleString('en-US',{month:'short'})+'-'+String(now.getFullYear()).slice(2);
        const ua     = navigator.userAgent;
        const device = /Mobi|Android/i.test(ua)?'Mobile':/Tablet|iPad/i.test(ua)?'Tablet':'Desktop';
        const browser= /Edg/i.test(ua)?'Edge':/Chrome/i.test(ua)?'Chrome':/Firefox/i.test(ua)?'Firefox':/Safari/i.test(ua)?'Safari':'Other';

        const digest = await analyticsGetDigest();
        if (!digest) { console.warn('[Analytics] Could not get SP digest'); return; }

        try {
            const typeRes = await fetch(ANALYTICS_SP_URL + `/_api/web/lists/getbytitle('${ANALYTICS_LIST}')?$select=ListItemEntityTypeFullName`, {
                headers:{'Accept':'application/json;odata=verbose'}, credentials:'include'
            });
            if (typeRes.ok) {
                const typeData = await typeRes.json();
                ANALYTICS_SP_ITEM_TYPE = typeData.d.ListItemEntityTypeFullName;
            }
        } catch(e) { /* use default */ }

        const payload = {
            __metadata: { type: ANALYTICS_SP_ITEM_TYPE },
            Title:           ctx.userName  || 'Unknown',
            UserEmail:       ctx.userEmail || '',
            UserRole:        ctx.role      || 'Unknown',
            SessionStart:    now.toISOString(),
            SessionEnd:      now.toISOString(),
            SessionDuration: 0,
            PageViews:       1,
            PagesVisited:    'Dashboard',
            LastPageVisited: 'Dashboard',
            DeviceType:      device,
            Browser:         browser,
            DayOfWeek:       dow,
            WeekNumber:      wk,
            Month:           month
        };

        const res = await fetch(ANALYTICS_SP_URL + `/_api/web/lists/getbytitle('${ANALYTICS_LIST}')/items`, {
            method: 'POST',
            headers: {
                'Accept': 'application/json;odata=verbose',
                'Content-Type': 'application/json;odata=verbose',
                'X-RequestDigest': digest
            },
            credentials: 'include',
            body: JSON.stringify(payload)
        });

        if (res.ok) {
            const data = await res.json();
            ANALYTICS_SESSION.itemId       = data.d.ID;
            ANALYTICS_SESSION.startTime    = now;
            ANALYTICS_SESSION.pageViews    = 1;
            ANALYTICS_SESSION.pagesVisited = ['Dashboard'];
            ANALYTICS_SESSION.lastPage     = 'Dashboard';
            ANALYTICS_SESSION.active       = true;
            ANALYTICS_SESSION.heartbeatTimer = setInterval(analyticsHeartbeat, 5 * 60 * 1000);
            window.addEventListener('beforeunload', analyticsEndSession);
            console.log('[Analytics] Session started, SP ID:', ANALYTICS_SESSION.itemId);
        } else {
            const errText = await res.text();
            console.warn('[Analytics] SP write failed:', res.status, errText.slice(0,200));
        }
    } catch(e) { console.warn('[Analytics] Session start failed:', e.message); }
};

window.analyticsTrackPage = function(pageName) {
    if (!ANALYTICS_SESSION.active) return;
    ANALYTICS_SESSION.pageViews++;
    if (!ANALYTICS_SESSION.pagesVisited.includes(pageName)) ANALYTICS_SESSION.pagesVisited.push(pageName);
    ANALYTICS_SESSION.lastPage = pageName;
};

async function analyticsHeartbeat() {
    if (!ANALYTICS_SESSION.active || !ANALYTICS_SESSION.itemId) return;
    try {
        const mins   = Math.round((new Date() - ANALYTICS_SESSION.startTime) / 60000);
        const digest = await analyticsGetDigest();
        if (!digest) return;
        await fetch(ANALYTICS_SP_URL + `/_api/web/lists/getbytitle('${ANALYTICS_LIST}')/items(${ANALYTICS_SESSION.itemId})`, {
            method: 'POST',
            headers: { 'Accept':'application/json;odata=verbose','Content-Type':'application/json;odata=verbose','X-RequestDigest':digest,'X-HTTP-Method':'MERGE','If-Match':'*' },
            credentials: 'include',
            body: JSON.stringify({
                __metadata: { type: ANALYTICS_SP_ITEM_TYPE },
                SessionEnd:      new Date().toISOString(),
                SessionDuration: mins,
                PageViews:       ANALYTICS_SESSION.pageViews,
                PagesVisited:    ANALYTICS_SESSION.pagesVisited.join(','),
                LastPageVisited: ANALYTICS_SESSION.lastPage
            })
        });
    } catch(e) { /* silent */ }
}

function analyticsEndSession() {
    if (!ANALYTICS_SESSION.active || !ANALYTICS_SESSION.itemId) return;
    clearInterval(ANALYTICS_SESSION.heartbeatTimer);
    const mins = Math.round((new Date() - ANALYTICS_SESSION.startTime) / 60000);
    const body = JSON.stringify({
        __metadata: { type: ANALYTICS_SP_ITEM_TYPE },
        SessionEnd:      new Date().toISOString(),
        SessionDuration: mins,
        PageViews:       ANALYTICS_SESSION.pageViews,
        PagesVisited:    ANALYTICS_SESSION.pagesVisited.join(','),
        LastPageVisited: ANALYTICS_SESSION.lastPage
    });
    if (navigator.sendBeacon) {
        navigator.sendBeacon(ANALYTICS_SP_URL + `/_api/web/lists/getbytitle('${ANALYTICS_LIST}')/items(${ANALYTICS_SESSION.itemId})`, new Blob([body],{type:'application/json'}));
    }
}

async function analyticsGetDigest() {
    try {
        const res = await fetch(ANALYTICS_SP_URL + '/_api/contextinfo', {
            method:'POST', headers:{'Accept':'application/json;odata=verbose'}, credentials:'include'
        });
        const data = await res.json();
        return data.d.GetContextWebInformation.FormDigestValue;
    } catch(e) { return null; }
}

function getISOWeek(d) {
    const date = new Date(d); date.setHours(0,0,0,0);
    date.setDate(date.getDate()+3-(date.getDay()+6)%7);
    const week1 = new Date(date.getFullYear(),0,4);
    return 1+Math.round(((date.getTime()-week1.getTime())/86400000-3+(week1.getDay()+6)%7)/7);
}

