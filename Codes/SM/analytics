        });
        const dowVals=DAYS_ORDER.map(d=>dowMap[d]||0);
        ANALYTICS_CHART_INSTANCES.dow = new Chart(document.getElementById('acDOW'),{
            type:'bar', data:{labels:DAYS_ORDER.map(d=>d.slice(0,3)),datasets:[{label:'Sessions',data:dowVals,backgroundColor:dowVals.map((_,i)=>i<5?colors.primary+'bb':colors.warn+'bb'),borderRadius:4}]},
            options:analyticsChartOpts(colors,false)
        });
        if(weeklyLabels.length) ANALYTICS_CHART_INSTANCES.monthly = new Chart(document.getElementById('acMonthly'),{
            type:'line', data:{labels:weeklyLabels,datasets:[{label:'Sessions',data:weeklyLabels.map(k=>weeklyMap[k]),borderColor:colors.accent,backgroundColor:colors.accent+'22',fill:true,tension:0.4}]},
            options:analyticsChartOpts(colors,false)
        });
        const roleEntries=Object.entries(roleMap);
        if(roleEntries.length) ANALYTICS_CHART_INSTANCES.role = new Chart(document.getElementById('acRole'),{
            type:'doughnut', data:{labels:roleEntries.map(r=>r[0]),datasets:[{data:roleEntries.map(r=>r[1]),backgroundColor:['#a855f7','#10b981','#f59e0b','#3b82f6','#ef4444'],borderWidth:0}]},
            options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'right',labels:{color:colors.text,font:{size:11},boxWidth:12}}}}
        });
        const devEntries=Object.entries(deviceMap);
        if(devEntries.length) ANALYTICS_CHART_INSTANCES.device = new Chart(document.getElementById('acDevice'),{
            type:'doughnut', data:{labels:devEntries.map(d=>d[0]),datasets:[{data:devEntries.map(d=>d[1]),backgroundColor:['#4c6fff','#10b981','#f59e0b'],borderWidth:0}]},
            options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'right',labels:{color:colors.text,font:{size:11},boxWidth:12}}}}
        });
    },100);
}

function analyticsChartOpts(colors, horizontal) {
    return {
        responsive:true, maintainAspectRatio:false,
        indexAxis: horizontal?'y':'x',
        plugins:{legend:{display:false}},
        scales:{
            x:{ticks:{color:colors.text,font:{size:10},maxRotation:45},grid:{color:colors.grid}},
            y:{ticks:{color:colors.text,font:{size:10}},grid:{color:colors.grid}}
        }
    };
}

function analyticsGetColors() {
    const theme=document.body.getAttribute('data-theme');
    const isDark=theme==='dark'||theme==='duralux-dark';
    const isDuralux=theme==='duralux'||theme==='duralux-dark';
    return {
        text:    isDark?'#f3e8ff':(isDuralux?'#0f1a3e':'#1e1133'),
        grid:    isDark?'rgba(255,255,255,0.08)':'rgba(0,0,0,0.06)',
        primary: isDuralux?'#4c6fff':(isDark?'#c084fc':'#a855f7'),
        accent:  '#10b981', warn:'#f59e0b'
    };
}

// ─── LEAGUE TABLE ──────────────────────────────────────────────────────────────
function analyticsRenderLeagueTable() {
    const data = analyticsGetFiltered();
    const users = {};
    data.forEach(d=>{
        if(!users[d.user]) users[d.user]={user:d.user,role:d.role,sessions:0,totalDuration:0,totalPages:0,lastSeen:null,modules:new Set()};
        const u=users[d.user];
        u.sessions++; u.totalDuration+=d.duration; u.totalPages+=d.pageViews;
        if(!u.lastSeen||(d.start&&d.start>u.lastSeen)) u.lastSeen=d.start;
        (d.pages||'').split(',').filter(Boolean).forEach(p=>u.modules.add(p));
    });
    const rows=Object.values(users).sort((a,b)=>b.sessions-a.sessions);
    const maxSessions=rows.length>0?Math.max(...rows.map(r=>r.sessions)):1;
    const now=new Date();

    document.getElementById('analyticsLeagueTable').innerHTML = rows.map((u,i)=>{
        const avgDur   = u.sessions>0?Math.round(u.totalDuration/u.sessions):0;
        const avgPgs   = u.sessions>0?(u.totalPages/u.sessions).toFixed(1):0;
        const daysSince= u.lastSeen?Math.floor((now-u.lastSeen)/86400000):999;
        const lastStr  = daysSince===0?'Today':daysSince===1?'Yesterday':`${daysSince}d ago`;
        const lastColor= daysSince<=3?'#10b981':daysSince<=7?'var(--warning)':'var(--danger)';
        const utilBar  = Math.round((u.sessions/maxSessions)*100);
        const rankClass= i===0?'rank-1':i===1?'rank-2':i===2?'rank-3':'rank-other';
        const tag      = i===0?'Top User':i===1?'High Usage':'Regular';
        return `
        <div class="manager-row">
            <div class="rank-badge ${rankClass}">${i+1}</div>
            <div class="manager-name-col"><div class="manager-name">${u.user}</div><div class="manager-tag">${u.role}</div></div>
            <div class="stat-col"><div class="stat-label">Sessions</div><div class="stat-value">${u.sessions}</div></div>
            <div class="stat-col"><div class="stat-label">Avg Duration</div><div class="stat-value">${avgDur}<span style="font-size:.7rem"> min</span></div></div>
            <div class="stat-col"><div class="stat-label">Avg Pages</div><div class="stat-value">${avgPgs}</div></div>
            <div class="stat-col"><div class="stat-label">Modules</div><div class="stat-value">${u.modules.size}</div></div>
            <div class="stat-col"><div class="stat-label">Last Seen</div><div class="stat-value" style="font-size:.8rem;color:${lastColor}">${lastStr}</div></div>
            <div class="progress-bar-col" style="min-width:140px;">
                <div class="progress-label">Usage: ${utilBar}%</div>
                <div class="progress-bar"><div class="progress-fill" style="width:${utilBar}%"></div></div>
            </div>
        </div>`;
    }).join('') || `<div style="text-align:center;padding:2rem;color:var(--t3);">No data in this period</div>`;
}

// ─── INACTIVE USERS ────────────────────────────────────────────────────────────
function analyticsRenderInactiveAlert() {
    const now=new Date();
    const cutoff14=new Date(); cutoff14.setDate(cutoff14.getDate()-14);
    const activeRecently=new Set(ANALYTICS_DATA.filter(d=>d.start&&d.start>=cutoff14).map(d=>d.user));
    const allLoggedIn=new Set(ANALYTICS_DATA.map(d=>d.user));
    const inactive=[...allLoggedIn].filter(u=>!activeRecently.has(u));

    const container=document.getElementById('analyticsInactive');
    if(!inactive.length){
        container.innerHTML=`<div style="display:flex;align-items:center;gap:10px;color:#10b981;padding:1rem;"><i data-lucide="check-circle" style="width:20px;height:20px;"></i><span style="font-weight:600;">All users active in the last 14 days</span></div>`;
    } else {
        container.innerHTML=inactive.map(u=>{
            const userSess=ANALYTICS_DATA.filter(d=>d.user===u);
            const last=userSess.sort((a,b)=>b.start-a.start)[0];
            const days=last?.start?Math.floor((now-last.start)/86400000):'?';
            return `
            <div style="display:flex;align-items:center;justify-content:space-between;padding:.65rem 1rem;background:rgba(239,68,68,0.06);border-radius:8px;border:1px solid rgba(239,68,68,0.2);margin-bottom:.5rem;">
                <div style="display:flex;align-items:center;gap:12px;">
                    <div style="width:8px;height:8px;border-radius:50%;background:#ef4444;"></div>
                    <div><div style="font-weight:700;color:var(--t1);font-size:.9rem;">${u}</div><div style="font-size:.75rem;color:var(--t3);">${last?.role||'Unknown'} · ${userSess.length} total sessions</div></div>
                </div>
                <div style="text-align:right;"><div style="font-weight:700;color:#ef4444;">${days} days ago</div><div style="font-size:.7rem;color:var(--t3);">Last seen</div></div>
            </div>`;
        }).join('');
    }
    if(typeof lucide!=='undefined') lucide.createIcons();
}

// ─── RECENT SESSIONS ──────────────────────────────────────────────────────────
function analyticsRenderRecentSessions() {
    const recent=ANALYTICS_DATA.slice(0,50);
    document.getElementById('analyticsRecentBody').innerHTML=recent.map(d=>{
        const start=d.start?d.start.toLocaleString('en-GB',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}):'—';
        return `
        <tr>
            <td style="font-weight:600;color:var(--t1);">${d.user}</td>
            <td><span style="background:var(--chip);color:var(--acc);padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700;">${d.role}</span></td>
            <td style="color:var(--t3);font-size:12px;">${start}</td>
            <td style="font-weight:600;">${d.duration?d.duration+' min':'<1 min'}</td>
